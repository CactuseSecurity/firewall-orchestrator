# top-level editorconfig file 
# should be the same file as the one for solution in roles directory

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.cs]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
# CA1822 (mark members as static): only for members that are not part of an API, public instance methods stay as they are
dotnet_code_quality.CA1822.api_surface = private, internal

# Analyzer rules that the code base is free of. Raised to warning so that the build (TreatWarningsAsErrors)
# rejects new findings instead of SonarCloud reporting them later. Only add rules here once all findings are fixed.
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1825.severity = warning
dotnet_diagnostic.CA1829.severity = warning
dotnet_diagnostic.CA1854.severity = warning
dotnet_diagnostic.CA1860.severity = warning
dotnet_diagnostic.CA1861.severity = warning
dotnet_diagnostic.CA2263.severity = warning
dotnet_diagnostic.SYSLIB1045.severity = warning

# Build-side counterparts of SonarCloud rules (IDE rules need EnforceCodeStyleInBuild, see roles/Directory.Build.props)
# CA1052 = S1118 (static holder types), CA2201 = S112 (reserved exception types), CA2208 = S3928 (argument exceptions)
dotnet_diagnostic.CA1052.severity = warning
dotnet_diagnostic.CA2201.severity = warning
dotnet_diagnostic.CA2208.severity = warning
# IDE0044 = S2933 (readonly field), IDE0051 = S1144 (unused private member), IDE0052 = S4487 (unread private member),
# IDE0060 = S1172 (unused parameter, like Sonar only for non-public members)
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_code_quality_unused_parameters = non_public

[*.razor]
indent_style = space
indent_size = 4
