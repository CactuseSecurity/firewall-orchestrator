#
# LDAP Defaults
#

# See ldap.conf(5) for details
# This file should be world readable but not world writable.

BASE    {{ openldap_path }}
{% if openldap_server_enable_ssl %}
URI     ldaps://{{ openldap_server }}:{{ openldap_port }}
TLS_REQCERT {{ 'never' if internalca_preserve_ldap_certificate | default(false) | bool else 'demand' }}
TLS_CACERT {{ openldap_server_cert if internalca_preserve_ldap_certificate | default(false) | bool else internalca_ca_certificate_local }}
{% endif %}
{% if not openldap_server_enable_ssl %}
URI     ldap://{{ openldap_server }}:{{ openldap_port }}
{% endif %}

#SIZELIMIT      12
#TIMELIMIT      15
#DEREF          never
{% if ansible_facts['os_family'] == 'RedHat' %}
# This if block is outdated
TLS_CACERTDIR /etc/openldap/cacerts
TLS_CACERT {{ openldap_server_cert if internalca_preserve_ldap_certificate | default(false) | bool else internalca_ca_certificate_local }}
{% endif %}
{% if ansible_facts['os_family'] == 'Debian' %}
TLS_CACERTDIR {{ openldap_server_cert_path }}
TLS_CACERT {{ openldap_server_cert if internalca_preserve_ldap_certificate | default(false) | bool else internalca_ca_certificate_local }}
{% endif %}
