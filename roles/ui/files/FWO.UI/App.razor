@using FWO.Ui.Data
@using FWO.Ui.Services

@inject UiClientAddress clientAddress

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <ErrorBoundary>
                <ChildContent>
                    <AuthorizeView Context="appAuthState">
                        <Authorized Context="appAuthorizedState">
                            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                                <NotAuthorized Context="permissionDeniedAuthState">
                                    <div class="row m-4 justify-content-center">
                                        <h2>Sorry @(permissionDeniedAuthState?.User?.Identity?.Name), this page cannot be accessed with your permissions.</h2>
                                    </div>
                                </NotAuthorized>
                            </AuthorizeRouteView>
                        </Authorized>
                        <NotAuthorized Context="appNotAuthorizedState">
                            <Login></Login>
                        </NotAuthorized>
                    </AuthorizeView>
                </ChildContent>
                <ErrorContent>
                    <p>Something went wrong while loading the component.</p>
                </ErrorContent>
            </ErrorBoundary>
        </Found>
        <NotFound>
            <div class="row m-4 justify-content-center">
                <h2>Sorry, there's nothing at this address.</h2>
            </div>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code
{
    /// <summary>
    /// Address of the browser, read by _Host.cshtml while the page is requested.
    /// </summary>
    [Parameter]
    public string? ClientAddress { get; set; }

    protected override void OnInitialized()
    {
        clientAddress.Set(ClientAddress);
    }
}
