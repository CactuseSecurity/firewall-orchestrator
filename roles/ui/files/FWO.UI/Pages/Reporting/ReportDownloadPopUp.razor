@using System.Text

@inject UserConfig userConfig
@inject IJSRuntime JSRuntime

<PopUp Title="@(userConfig.GetText("export_report_download"))" Show="@Show" Size=PopupSize.Small OnClose="() => Close()">
    <Body>
        <div class="d-flex flex-column align ms-1 me-1">
            @if(Downloading)
            {
                <Exporting/>
            }
            else
            {
                @if (ReportFile?.Csv != null)
                {
                    <btn class="btn btn-sm btn-info m-1"
                    @onclick="@(async _ => { await DownloadText(ReportFile.Name + ".csv", "text/csv", ReportFile.Csv); })">
                        @(userConfig.GetText("download_csv"))
                    </btn>
                }
                @if (ReportFile?.Pdf != null)
                {
                    @*TODO: application/pdf would be correct but Firefox ignores the new tab request in this case*@
                    <btn class="btn btn-sm btn-info m-1"
                    @onclick="@(async _ => { await DownloadBase64(ReportFile.Name + ".pdf", "application/octet-stream", ReportFile.Pdf); })">
                        @(userConfig.GetText("download_pdf"))
                    </btn>
                }
                @if (ReportFile?.Html != null)
                {
                    <btn class="btn btn-sm btn-info m-1"
                    @onclick="@(async _ => { await DownloadText(ReportFile.Name + ".html", "text/html", ReportFile.Html); })">
                        @(userConfig.GetText("download_html"))
                    </btn>
                }
                @if (ReportFile?.Json != null && ShowJson)
                {
                    <btn class="btn btn-sm btn-info m-1"
                    @onclick="@(async _ => { await DownloadText(ReportFile.Name + ".json", "application/json", ReportFile.Json); })">
                        @(userConfig.GetText("download_json"))
                    </btn>
                }
            }
        </div>
    </Body>
    <Footer>
        @if(!Downloading)
        {
            <button type="button" class="btn btn-sm btn-danger" @onclick="() => Close()">@(DisplayService.DisplayButton(userConfig, "close", Icons.Cancel))</button>
        }
    </Footer>
</PopUp>

@code {
    // the payload travels to the browser over the circuit, so a large report on a slow connection can
    // easily outlast the one minute default for a js interop call. an export that took minutes to
    // build must not be thrown away because the transfer was a little slower than that default.
    private const int kDownloadTimeoutMinutes = 10;

    private bool Downloading = false;

    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    [Parameter]
    public string Title { get; set; } = "EMPTY_TITLE";

    [Parameter]
    public ReportFile? ReportFile { get; set; }

    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public bool ShowJson { get; set; }

    [Parameter]
    public Action OnClose { get; set; } = new Action(() => { });

    private void Close()
    {
        Show = false;
        // the exported formats are the largest objects this circuit holds. both callers refill them
        // when the dialog is opened again, so release them here instead of keeping every format of
        // every report exported during the session resident for the rest of the session.
        ReportFile?.ReleaseContent();
        OnClose();
    }

    private async Task DownloadText(string fileName, string contentType, string? content)
    {
        if (content == null)
        {
            return;
        }
        await DownloadStream(fileName, contentType, Encoding.UTF8.GetBytes(content));
    }

    private async Task DownloadBase64(string fileName, string contentType, string? base64Content)
    {
        if (base64Content == null)
        {
            return;
        }
        await DownloadStream(fileName, contentType, Convert.FromBase64String(base64Content));
    }

    /// <summary>
    /// Hands the payload to the browser as a stream. The encoded copy is scoped to this call instead
    /// of being pinned as an interop argument, and streaming avoids the base64 inflation that a
    /// byte[] argument would add to the interop message on top of it. The call only completes once the
    /// browser has pulled the whole stream, so it is given its own generous timeout.
    /// </summary>
    private async Task DownloadStream(string fileName, string contentType, byte[] data)
    {
        try
        {
            Downloading = true;
            await InvokeAsync(StateHasChanged);

            using MemoryStream stream = new(data);
            using DotNetStreamReference streamReference = new(stream);
            await JSRuntime.InvokeVoidAsync("DownloadFileFromStream", TimeSpan.FromMinutes(kDownloadTimeoutMinutes),
                fileName, contentType, streamReference);
        }
        catch (Exception exception)
        {
            // a swallowed failure here is indistinguishable from a download that never started, and
            // Debug.WriteLine is compiled out of the release build - so it has to be reported properly
            Log.WriteError("Report Download", $"Transferring {fileName} to the browser failed.", exception);
            DisplayMessageInUi(exception, userConfig.GetText("download"), userConfig.GetText("download_failed"), true);
        }
        finally
        {
            Downloading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
