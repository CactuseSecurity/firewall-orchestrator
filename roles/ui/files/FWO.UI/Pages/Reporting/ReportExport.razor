@using System.Text
@using FWO.Report
@using System.Reflection
@using System.Linq
@using FWO.Report.Filter
@using System.IO

@inject ApiConnection apiConnection
@inject UserConfig userConfig

<button type="button" class="btn btn-sm btn-dark" @onclick='() =>
        { if (ReportToExport != null) { ShowExportDialog = true; reportExportFile = new ReportFile { Name = "Report", OwningUserId = userConfig.User.DbId }; }
        else { DisplayMessageInUi(null, userConfig.GetText("export_report"), userConfig.GetText("E1002"), true); } }'>
    @(DisplayService.DisplayButton(userConfig, "export_report", Icons.Export))
</button>

<PopUp Title="@(userConfig.GetText("export_report"))" Show="@ShowExportDialog" Size=PopupSize.Medium OnClose="() => ShowExportDialog = false">
    <Body>
        <div>
            <div class="input-group input-group-sm mb-2">
                <div class="input-group-prepend">
                    <div class="input-group-text">@(userConfig.GetText("report_name")):</div>
                </div>
                <input class="form-control" @bind:event="oninput" @bind="reportExportFile.Name" />
            </div>
            <div class="card">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <div class="mb-1">@(userConfig.GetText("export_as"))</div>
                        <div class="form-check">
                            @if (PdfAvailable())
                            {
                                <input class="form-check-input" type="checkbox" id="reportExportPdf" @bind="ExportPdf">
                            }
                            else
                            {
                                ExportPdf = false;
                                <input disabled class="form-check-input" type="checkbox" id="reportExportPdf">
                            }
                            <label class="form-check-label" for="reportExportPdf">
                                PDF
                            </label>
                            @if (ExportPdf)
                            {
                                <div>
                                    @(userConfig.GetText("page_format")):
                                    <Dropdown ElementType="PaperFormat" @bind-SelectedElement="SelectedPaperFormat" Elements="Enum.GetValues<PaperFormat>()"></Dropdown>
                                    @if (SelectedPaperFormat == PaperFormat.Custom)
                                    {
                                        <div class="input-group input-group-sm mb-2 mt-2">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">@(userConfig.GetText("width"))</span>
                                            </div>
                                            <input @bind="PaperSizeWidth" min="1" max="1000000" type="number" class="form-control">
                                        </div>
                                        <div class="input-group input-group-sm mb-1">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">@(userConfig.GetText("height"))</span>
                                            </div>
                                            <input @bind="PaperSizeHeight" min="1" max="1000000" type="number" class="form-control">
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="form-check">
                            @if (HtmlAvailable())
                            {
                                <input class="form-check-input" type="checkbox" id="reportExportHtml" @bind="ExportHtml">
                            }
                            else
                            {
                                ExportHtml = false;
                                <input disabled class="form-check-input" type="checkbox" id="reportExportHtml">
                            }
                            <label class="form-check-label" for="reportExportHtml">
                                HTML
                            </label>
                        </div>
                        <div class="form-check">
                            @if (csvAvailable())
                            {
                                <input class="form-check-input" type="checkbox" id="reportExportCsv" @bind="ExportCsv">
                            }
                            else
                            {
                                ExportCsv = false;
                                <input disabled class="form-check-input" type="checkbox" id="reportExportCsv">
                            }
                            <label class="form-check-label" for="reportExportCsv">
                                CSV
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="reportExportJson" @bind="ExportJson">
                            <label class="form-check-label" for="reportExportJson">
                                JSON
                            </label>
                        </div>
                    </li>
                    <li class="list-group-item">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="reportExportArchive" @bind="ExportArchive">
                            <label class="form-check-label" for="reportExportArchive">
                                @(userConfig.GetText("archive")) @(userConfig.GetText("includes_json"))
                            </label>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </Body>
    <Footer>
        @if (!Exporting)
        {
            <button type="button" class="btn btn-sm btn-primary" @onclick="async () => 
                    { Exporting = true; await Export(); ShowExportDialog = false; ShowExportDownloadDialog = true; Exporting = false; }">
                @(DisplayService.DisplayButton(userConfig, "export", Icons.Export))</button>
            <button type="button" class="btn btn-sm btn-secondary" @onclick="() => ShowExportDialog = false">
                @(DisplayService.DisplayButton(userConfig, "cancel", Icons.Cancel))</button>
        }
        else
        {
            <Exporting/>
        }
    </Footer>
</PopUp>

<ReportDownloadPopUp Title="@(userConfig.GetText("export_report_download"))" ReportFile="reportExportFile"
    Show="ShowExportDownloadDialog" ShowJson="ExportJson" OnClose="CloseExportDownloadDialog" />

@code
{
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    [Parameter]
    public ReportBase? ReportToExport { get; set; }

    private bool ExportPdf = false;
    private bool ExportJson = false;
    private bool ExportHtml = false;
    private bool ExportCsv = false;
    private bool ExportArchive = false;
    private ReportFile reportExportFile = new ReportFile();
    private PaperFormat SelectedPaperFormat = PaperFormat.A4;

    private bool ShowExportDialog = false;
    private bool ShowExportDownloadDialog = false;

    /// <summary>
    /// Closes the download dialog and drops the html the export left cached on the report. The next
    /// export rebuilds it; keeping it would hold the rendered report for the rest of the session.
    /// </summary>
    private void CloseExportDownloadDialog()
    {
        ShowExportDownloadDialog = false;
        ReportToExport?.ReleaseExportCache();
    }

    private bool Exporting = false;

    private int PaperSizeWidth = 0;
    private int PaperSizeHeight = 0;



    private bool csvAvailable()
    {
        if (ReportToExport is ReportBase report
            && report.ReportType.SupportsCsvExport(report.ReportData.WorkflowFilter.DetailedView))
        {
            return true;
        }
        else
        {
            return false;
        }
    }

    /// <summary>
    /// Determines whether HTML export is available for the current report.
    /// </summary>
    private bool HtmlAvailable()
    {
        return ReportToExport is ReportBase report
            && report.ReportType.SupportsHtmlExport();
    }

    /// <summary>
    /// Determines whether PDF export is available for the current report.
    /// </summary>
    private bool PdfAvailable()
    {
        return ReportToExport is ReportBase report
            && report.ReportType.SupportsPdfExport();
    }

    private async Task Export()
    {
        if (reportExportFile.Sanitize())
        {
            DisplayMessageInUi(null, userConfig.GetText("export_report"), userConfig.GetText("U0001"), true);
        }
        if (ReportToExport != null)
        {
            await Task.Run(async () =>
            {
                try
                {
                    if (!ReportToExport.GotObjectsInReport)
                    {
                        await GetReportObjectsForExport();
                    }

                    ConvertToHtml();

                    await ConvertToPdf();

                    ConvertToCsv();
                    
                    ExportToJson();

                    if (ExportArchive)
                    {
                        var queryVariables = new
                        {
                            report_name = reportExportFile.Name,
                            report_start_time = DateTime.Now, // TODO: Change to correct dates
                            report_end_time = DateTime.Now,
                            report_owner_id = reportExportFile.OwningUserId,
                            report_csv = reportExportFile.Csv,
                            report_pdf = reportExportFile.Pdf,
                            report_html = reportExportFile.Html,
                            report_json = reportExportFile.Json,
                            report_type = (int?)ReportToExport.ReportType,
                            description = ReportToExport.SetDescription(),
                            read_only = false
                        };

                        await apiConnection.SendQueryAsync<object>(ReportQueries.addGeneratedReport, queryVariables);
                    }
                }
                catch (Exception exception)
                {
                    DisplayMessageInUi(exception, userConfig.GetText("export_report"), "", true);
                }
            });
        }
        else
        {
            DisplayMessageInUi(null, userConfig.GetText("export_report"), userConfig.GetText("E1002"), true);
        }
    }

    /// <summary>
    /// Gets all report objects using the role required by App Rules reports when an authentication
    /// state is available.
    /// </summary>
    private async Task GetReportObjectsForExport()
    {
        if (ReportToExport == null)
        {
            return;
        }

        if (authenticationStateTask == null || ReportToExport.ReportType != ReportType.AppRules)
        {
            await FetchReportObjects();
            return;
        }

        AuthenticationState authenticationState = await authenticationStateTask;
        await apiConnection.RunWithBestRoleForReport(authenticationState.User, ReportToExport.ReportType,
            async () =>
            {
                await FetchReportObjects();
                return true;
            });
    }

    /// <summary>
    /// Gets all objects needed by the report export.
    /// </summary>
    private Task FetchReportObjects()
    {
        return ReportToExport!.GetObjectsInReport(int.MaxValue, apiConnection, _ => Task.CompletedTask);
    }

    private async Task ConvertToPdf()
    {
        if (ReportToExport != null && ExportPdf && PdfAvailable())
        {
            ReportToExport.CustomHeight = PaperSizeHeight;
            ReportToExport.CustomWidth = PaperSizeWidth;

            string html = ReportToExport.ExportToHtml();
            reportExportFile.Pdf = await ReportToExport.ToPdf(html, SelectedPaperFormat);
        }
    }

    private void ConvertToHtml()
    {
        if (ReportToExport != null && ExportHtml && HtmlAvailable())
        {
            reportExportFile.Html = ReportToExport.ExportToHtml();
        }
    }

    private void ConvertToCsv()
    {
        if (ReportToExport != null &&ExportCsv && csvAvailable())
        {
            reportExportFile.Csv = ReportToExport.ExportToCsv();
        }
    }

    private void ExportToJson()
    {
        if (ReportToExport != null && (ExportJson || ExportArchive))
        {
            reportExportFile.Json = ReportToExport.ExportToJson();
        }
    }
}
