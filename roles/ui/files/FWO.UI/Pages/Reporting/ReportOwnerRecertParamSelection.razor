@using FWO.Api.Client
@using FWO.Api.Client.Queries
@using FWO.Data
@using FWO.Data.Report
@using FWO.Data.Workflow
@using FWO.Logging

@inject ApiConnection apiConnection
@inject UserConfig userConfig

@if (UseFormLayout)
{
    <div class="form-group row mt-2">
        <label class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("parameters")):</label>
        <div class="col-sm-8">
            @Fields
        </div>
    </div>
}
else
{
    <div class="p-3">
        @Fields
    </div>
}

@code
{
    [Parameter]
    public ModellingFilter ModellingFilter { get; set; } = new();

    [Parameter]
    public EventCallback<ModellingFilter> ModellingFilterChanged { get; set; }

    [Parameter]
    public IEnumerable<string>? AvailableAddInfoNames { get; set; }

    [Parameter]
    public bool UseFormLayout { get; set; }

    [Parameter]
    public bool UseLightText { get; set; } = true;

    private string CheckboxLabelClass => UseLightText ? "form-check-label text-white" : "form-check-label";

    private RenderFragment Fields => @<text>
        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("C1000"))">
            <input class="form-check-input" id="allOwners" type="checkbox"
                   checked="@ModellingFilter.ShowAllOwners" @onchange="ToggleShowAllOwners" />
            <label class="@CheckboxLabelClass" for="allOwners">@(userConfig.GetText("show_all_owners"))</label>
        </div>
        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("C1002"))">
            <input class="form-check-input" id="showInactiveRecertOwners" type="checkbox"
                   checked="@ModellingFilter.ShowInactiveRecertOwners" @onchange="ToggleShowInactiveRecertOwners" />
            <label class="@CheckboxLabelClass" for="showInactiveRecertOwners">@(userConfig.GetText("show_inactive_recert_owners"))</label>
        </div>
        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("C1003"))">
            <input class="form-check-input" id="mergeOwnerRecertTables" type="checkbox"
                   checked="@ModellingFilter.MergeOwnerRecertTables" @onchange="ToggleMergeOwnerRecertTables" />
            <label class="@CheckboxLabelClass" for="mergeOwnerRecertTables">@(userConfig.GetText("merge_owner_recert_tables"))</label>
        </div>
        <AddInfoFilterEditor AddInfoFilter="ModellingFilter.OwnerAddInfoFilter"
                           AddInfoFilterChanged="HandleAddInfoFilterChanged"
                           AvailableAddInfoNames="availableAddInfoNames"
                           IdPrefix="ownerLabel"
                           UseFormLayout="UseFormLayout"
                           UseLightText="UseLightText"
                           AllowFreeText="true"
                           DefaultMode="AddInfoFilterMode.display_only"
                           TooltipTextKey="C1004" />
    </text>;

    private List<string> availableAddInfoNames = new();
    private bool availableAddInfoNamesLoaded;

    protected override async Task OnParametersSetAsync()
    {
        SyncLegacyAddInfoFilter();

        if (AvailableAddInfoNames != null)
        {
            availableAddInfoNames = NormalizeAvailableAddInfoNames(AvailableAddInfoNames);
            availableAddInfoNamesLoaded = true;
            return;
        }

        if (!availableAddInfoNamesLoaded)
        {
            availableAddInfoNames = await LoadAvailableAddInfoNames();
            availableAddInfoNamesLoaded = true;
        }
    }

    private async Task ToggleShowAllOwners(ChangeEventArgs args)
    {
        ModellingFilter.ShowAllOwners = args.Value as bool? ?? false;
        await ModellingFilterChanged.InvokeAsync(ModellingFilter);
    }

    private async Task ToggleShowInactiveRecertOwners(ChangeEventArgs args)
    {
        ModellingFilter.ShowInactiveRecertOwners = args.Value as bool? ?? false;
        await ModellingFilterChanged.InvokeAsync(ModellingFilter);
    }

    private async Task ToggleMergeOwnerRecertTables(ChangeEventArgs args)
    {
        ModellingFilter.MergeOwnerRecertTables = args.Value as bool? ?? false;
        await ModellingFilterChanged.InvokeAsync(ModellingFilter);
    }

    private void SyncLegacyAddInfoFilter()
    {
        if (!string.IsNullOrWhiteSpace(ModellingFilter.OwnerAdditionalInfoKey) && string.IsNullOrWhiteSpace(ModellingFilter.OwnerAddInfoFilter.Name))
        {
            ModellingFilter.OwnerAddInfoFilter.Name = ModellingFilter.OwnerAdditionalInfoKey;
            ModellingFilter.OwnerAddInfoFilter.Mode = AddInfoFilterMode.display_only;
        }

        if (!string.IsNullOrWhiteSpace(ModellingFilter.OwnerAddInfoFilter.Name))
        {
            ModellingFilter.OwnerAdditionalInfoKey = ModellingFilter.OwnerAddInfoFilter.Name;
        }
    }

    private async Task HandleAddInfoFilterChanged(AddInfoFilter addInfoFilter)
    {
        ModellingFilter.OwnerAddInfoFilter = new(addInfoFilter);
        ModellingFilter.OwnerAdditionalInfoKey = ModellingFilter.OwnerAddInfoFilter.Name;
        await ModellingFilterChanged.InvokeAsync(ModellingFilter);
    }

    private List<string> NormalizeAvailableAddInfoNames(IEnumerable<string> addInfoNames)
    {
        return addInfoNames
            .Where(addInfoName => !string.IsNullOrWhiteSpace(addInfoName))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(addInfoName => addInfoName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task<List<string>> LoadAvailableAddInfoNames()
    {
        try
        {
            List<FwoOwner> owners = await apiConnection.SendQueryAsync<List<FwoOwner>>(OwnerQueries.getOwners);
            return NormalizeAvailableAddInfoNames(owners.SelectMany(owner => owner.AdditionalInfo?.Keys ?? Enumerable.Empty<string>()));
        }
        catch (Exception exception)
        {
            Log.WriteError(nameof(ReportOwnerRecertParamSelection), "Loading available owner additional info names failed.", exception);
            return [];
        }
    }
}
