@using FWO.Data.Workflow
@using FWO.Data
@using FWO.Data.Flow
@using FWO.Ui.Display
@using FWO.Ui.Shared
@using FWO.Ui.Services

@inject UserConfig userConfig
@inject ApiConnection apiConnection

<PopUp Title="@(userConfig.GetText("approval_task_details_edit"))" Show="@Display" Size="PopupSize.XLarge" OnClose="Close">
    <Body>
        @if (Display)
        {
            List<List<WfReqTask>> taskGroups = GetTaskGroups().ToList();
            bool accessToggleShown = false;
            @foreach (List<WfReqTask> taskGroup in taskGroups)
            {
                WfReqTask task = taskGroup[0];
                @if (IsAccessTask(task) && !accessToggleShown)
                {
                    accessToggleShown = true;
                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="ToggleAccessElementDisplay">
                            @(DisplayService.DisplayButton(userConfig, NextDisplayModeTextKey(), Icons.Swap))
                        </button>
                    </div>
                }
                <details class="card mb-3" open="@DetailsOpen(task)">
                    <summary class="card-header d-flex justify-content-between align-items-center">
                        <span class="d-flex align-items-start flex-wrap flex-grow-1 gap-2">
                            <small class="text-muted mr-2 text-nowrap" style="min-width: 10rem;">@(userConfig.GetText("id")): @TaskIds(taskGroup)</small>
                            <strong class="mr-2">@task.Title</strong>
                            @if (CanEdit(taskGroup, WorkflowEditableFieldKeys.Title))
                            {
                                <button type="button" class="btn btn-sm btn-warning" @onclick:stopPropagation @onclick="() => OpenTextEditor(task, WorkflowEditableFieldKeys.Title, task.Title)">@(DisplayService.DisplayButton(userConfig, "edit", Icons.Edit))</button>
                            }
                            @if (taskGroup.Count > 1)
                            {
                                <span class="badge badge-secondary ml-2">@taskGroup.Count</span>
                            }
                        </span>
                        <span>@States.GetName(task.StateId)</span>
                    </summary>
                    <div class="card-body">
                        <CascadingValue Value="@CreateTaskViewContext()">
                            @if (IsAccessTask(task))
                            {
                                <ApprovalTaskAccessBody Task="task" TaskGroup="taskGroup" />
                            }
                            else if (IsGroupTask(task))
                            {
                                <ApprovalGroupTaskBody Task="task" TaskGroup="taskGroup" />
                            }
                            else
                            {
                                <ApprovalObjectTaskBody Task="task" TaskGroup="taskGroup" />
                            }
                        </CascadingValue>
                    </div>
                </details>
            }
        }
    </Body>
    <Footer>
        <div class="d-flex justify-content-center align-items-center">
            <div class="btn-group mr-2">
                @foreach (WfStateAction action in OfferedActions)
                {
                    @if (WfHandler.CanPerformActionOnActTicket(action))
                    {
                        <button type="button" class="btn btn-sm btn-dark" @onclick:preventDefault @onclick="() => RunWithProgress(() => PerformTicketAction(action))">@action.ButtonText</button>
                    }
                }
            </div>
            <button type="button" class="btn btn-sm btn-primary" @onclick="Close">@(userConfig.GetText("ok"))</button>
        </div>
    </Footer>
</PopUp>
<InProgress Display="workInProgress" />

<RuleActionEditor @bind-Display="displayRuleActionEditor" SelectedRuleAction="selectedRuleAction"
    RuleActions="ruleActions" Saved="SaveRuleAction" />
<OwnerEditor @bind-Display="displayOwnerEditor" SelectedOwner="selectedOwner"
    Owners="OwnerOptions" Saved="SaveOwner" />
<TrackingEditor @bind-Display="displayTrackingEditor" SelectedTracking="selectedTracking"
    Trackings="trackings" Saved="SaveTracking" />
<ManagementEditor @bind-Display="displayManagementEditor" SelectedManagement="selectedManagement"
    Managements="ManagementOptions" Saved="SaveManagement" />
<TargetDatesEditor @bind-Display="displayTargetDatesEditor"
    Model="targetDatesEditorModel"
    AllowCreateTimeObjectTask="CanCreateTimeObjectTask"
    CreateTimeObjectTaskRequested="OpenCreateTimeObjectTaskEditor"
    Saved="SaveTargetDates" />
<TimeObjectTaskEditor @bind-Display="displayTimeObjectTaskEditor"
    Model="newTimeObjectTaskModel"
    ShowBeginDate="@AccessTaskVisibility.ShowValidFrom"
    ShowEndDate="@AccessTaskVisibility.ShowValidTo"
    Saved="CreateTimeObjectTask" />
<TextEditor @bind-Display="displayTextEditor" Text="@textEditorValue" TextKey="@textEditorKey"
    Multiline="@textEditorMultiline" Rows="5" Saved="SaveText" />
<ApprovalTaskElementsEditor @bind-Display="displayElementsEditor" Task="@(editingElementsTask ?? new WfReqTask())"
    FieldKey="@editingElementsField" TicketTasks="WfHandler.ActTicket.Tasks" IpProtos="ipProtocols"
    SelectableIpProtos="selectableIpProtocols" Saved="SaveElements" CreateObjectTaskRequested="OpenObjectTaskEditor" />
<ApprovalObjectTaskEditor Display="displayObjectTaskEditor" DisplayChanged="HandleObjectTaskEditorDisplayChanged"
    Task="newObjectTask" ObjectKind="newObjectTaskKind" IsModify="objectTaskIsModify" SelectableIpProtos="selectableIpProtocols"
    DisplayIpProtos="ipProtocols" Saved="SaveObjectTask" />
<TimeObjectTaskDeleteConfirmation @bind-Display="displayDeleteFormerTimeObjectTask"
    Title="@(userConfig.GetText("delete_time_object_task"))"
    Message="@(userConfig.GetText("delete_time_object_task_message"))"
    Confirmed="DeleteFormerTimeObjectTask" />
<TimeObjectTaskDeleteConfirmation @bind-Display="displayDeleteObjectTask"
    Title="@(userConfig.GetText("delete_task"))" Message="@(userConfig.GetText("delete_unreferenced_object_task_message"))"
    Confirmed="DeleteObjectTask" />

@code {
    [Parameter] public bool Display { get; set; }
    [Parameter] public EventCallback<bool> DisplayChanged { get; set; }
    [Parameter] public WfHandler WfHandler { get; set; } = new();
    [Parameter] public WfStateDict States { get; set; } = new();
    [Parameter] public Func<WfReqTask, string, Task> EditField { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public IReadOnlyList<WfStateAction> OfferedActions { get; set; } = [];
    [Parameter] public Func<WfStateAction, Task> PerformTicketAction { get; set; } = _ => Task.CompletedTask;

    private ApproverAllowedChangesConfig AllowedChanges =>
        ApproverAllowedChangesConfig.Parse(userConfig.ReqAllowedChangesByApprover);

    private AccessTaskFieldVisibilityConfig AccessTaskVisibility =>
        TicketFieldVisibilityConfig.Parse(userConfig.ReqTicketFieldVisibility).AccessTask;

    private ApprovalTaskElementDisplayMode accessElementDisplayMode = ApprovalTaskElementDisplayMode.Resolved;
    private List<ComplianceNetworkZone> networkZones = [];
    private List<IpProtocol> ipProtocols = [];
    private List<IpProtocol> selectableIpProtocols = [];

    private List<RuleAction> ruleActions = [];
    private List<Tracking> trackings = [];
    private bool displayOwnerEditor;
    private WfReqTask? editingOwnerTask;
    private FwoOwner selectedOwner = new();
    private bool displayRuleActionEditor;
    private WfReqTask? editingRuleActionTask;
    private RuleAction? selectedRuleAction;
    private bool displayTrackingEditor;
    private WfReqTask? editingTrackingTask;
    private Tracking? selectedTracking;
    private bool displayManagementEditor;
    private WfReqTask? editingManagementTask;
    private Management? selectedManagement;
    private bool displayTargetDatesEditor;
    private WfReqTask? editingTargetDatesTask;
    private WfReqTask? formerTimeObjectTask;
    private long? formerTimeObjectSelectorId;
    private long? formerTimeObjectElementId;
    private TargetDatesEditorModel targetDatesEditorModel = new();
    private bool displayTimeObjectTaskEditor;
    private TargetDatesEditorModel newTimeObjectTaskModel = new();
    private bool displayDeleteFormerTimeObjectTask;
    private WfReqTask? pendingFormerTimeObjectTask;
    private bool displayTextEditor;
    private bool displayElementsEditor;
    private WfReqTask? editingElementsTask;
    private string editingElementsField = WorkflowEditableFieldKeys.Source;
    private bool displayObjectTaskEditor;
    private bool objectTaskIsExisting;
    private bool objectTaskIsModify;
    private WfReqTask newObjectTask = new();
    private ObjectTaskKind newObjectTaskKind = ObjectTaskKind.Network;
    private bool displayDeleteObjectTask;
    private WfReqTask? pendingObjectTask;
    private bool workInProgress;
    private WfReqTask? editingTextTask;
    private string textEditorKey = "title";
    private string textEditorValue = "";
    private bool textEditorMultiline;

    private List<FwoOwner> OwnerOptions => WfHandler.AllOwners.Where(owner => owner.Id != 0).ToList();
    private List<Management> ManagementOptions => WfHandler.Managements;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ruleActions = await apiConnection.SendQueryAsync<List<RuleAction>>(StmQueries.getRuleActions) ?? [];
            trackings = await apiConnection.SendQueryAsync<List<Tracking>>(StmQueries.getTracking) ?? [];
            List<IpProtocol> protocols = await apiConnection.SendQueryAsync<List<IpProtocol>>(StmQueries.getIpProtocols) ?? [];
            ipProtocols = ProtocolDisplayHelper.CustomSortProtocols(protocols, null, false);
            selectableIpProtocols = ProtocolDisplayHelper.CustomSortProtocols(
                ProtocolDisplayHelper.GetSelectableProtocols(protocols),
                ProtocolDisplayHelper.ParseProtocolNames(userConfig.ReducedProtocolSetProtocols),
                userConfig.ReducedProtocolSet);
            if (userConfig.DesignatedZoneMatrixId > 0)
            {
                networkZones = await apiConnection.SendQueryAsync<List<ComplianceNetworkZone>>(
                    NetworkZoneQueries.getNetworkZonesForMatrix,
                    new { criterionId = userConfig.DesignatedZoneMatrixId }) ?? [];
            }
        }
        catch
        {
            // The IDs remain useful as a fallback when the lookup data is unavailable.
            ruleActions = [];
            trackings = [];
            ipProtocols = [];
            selectableIpProtocols = [];
        }
    }

    private IEnumerable<List<WfReqTask>> GetTaskGroups()
    {
        IEnumerable<WfReqTask> tasks = WfHandler.ActTicket.Tasks
            .Where(task => task.TaskType == WfTaskType.access.ToString()
                || WfObjectTaskHelper.IsManagementObjectTask(task.TaskType));

        if (!userConfig.ReqDisplayBundledTasksAsOne || !userConfig.ReqConsiderBundling)
        {
            return tasks.Select(task => new List<WfReqTask> { task });
        }

        return tasks.GroupBy(task =>
        {
            if (WfObjectTaskHelper.IsManagementObjectTask(task.TaskType))
            {
                return $"task:{task.Id}";
            }

            string bundleId = task.GetAddInfoValue(AdditionalInfoKeys.FlowBundleId);
            return string.IsNullOrWhiteSpace(bundleId)
                ? $"task:{task.Id}"
                : $"bundle:{bundleId}:state:{task.StateId}";
        }).Select(group => group.OrderBy(task => task.Id).ToList());
    }

    private static bool IsAccessTask(WfReqTask task) => task.TaskType == WfTaskType.access.ToString();

    private static bool IsGroupTask(WfReqTask task) => task.TaskType == WfTaskType.group_create.ToString()
        || task.TaskType == WfTaskType.group_modify.ToString()
        || task.TaskType == WfTaskType.group_delete.ToString();

    private static string? DetailsOpen(WfReqTask task) => IsAccessTask(task) ? "open" : null;

    private ApprovalTaskViewContext CreateTaskViewContext() => new(
        new ApprovalTaskDisplayLogic(
        WfHandler,
        userConfig,
        ruleActions,
        trackings,
        ipProtocols,
        networkZones,
        accessElementDisplayMode),
        AccessTaskVisibility,
        ipProtocols,
        CanEdit,
        CanEditTimeObject,
        EditableTimeObjectField,
        OpenOwnerEditor,
        OpenRuleActionEditor,
        OpenTrackingEditor,
        OpenManagementEditor,
        OpenElementsEditor,
        OpenGroupMembersEditor,
        OpenExistingObjectTaskEditor,
        (task, field, value) => OpenTextEditor(task, field, value),
        (task, field) => OpenTargetDatesEditor(task, field));

    private bool CanEdit(IEnumerable<WfReqTask> tasks, string fieldKey)
    {
        List<WfReqTask> taskList = tasks.ToList();
        if (taskList.Count == 0
            || taskList.Any(task => !WfHandler.CanActOnReqTaskInCurrentPhase(task))
            || taskList.Any(WfObjectTaskHelper.HasFlowDbReference))
        {
            return false;
        }

        WfReqTask? firstTask = taskList.FirstOrDefault();
        WfTaskType taskType = Enum.TryParse(firstTask?.TaskType ?? "", true, out WfTaskType parsedTaskType)
            ? parsedTaskType
            : WfTaskType.access;
        return ApproverAllowedChangesAccess.CanEditTaskField(AllowedChanges, new()
        {
            IsApprovalPhase = true,
            ApproveReqTaskMode = true,
            ReadOnlyMode = WfHandler.ReadOnlyMode,
            TaskType = taskType,
            HasImplementationTasks = taskList.Any(task => task.ImplementationTasks.Count > 0)
        }, fieldKey);
    }

    private Task OpenOwnerEditor(WfReqTask task)
    {
        editingOwnerTask = task;
        FwoOwner? owner = task.Owners.FirstOrDefault()?.Owner;
        selectedOwner = OwnerOptions.FirstOrDefault(candidate => candidate.Id == owner?.Id) ?? new FwoOwner();
        displayOwnerEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task OpenRuleActionEditor(WfReqTask task)
    {
        editingRuleActionTask = task;
        selectedRuleAction = ruleActions.FirstOrDefault(action => action.Id == task.RuleAction);
        displayRuleActionEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task OpenTrackingEditor(WfReqTask task)
    {
        editingTrackingTask = task;
        selectedTracking = trackings.FirstOrDefault(tracking => tracking.Id == task.Tracking);
        displayTrackingEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task OpenManagementEditor(WfReqTask task)
    {
        editingManagementTask = task;
        selectedManagement = ManagementOptions.FirstOrDefault(management => management.Id == task.ManagementId);
        displayManagementEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task OpenTargetDatesEditor(WfReqTask task, string fieldKey)
    {
        editingTargetDatesTask = task;
        WfReqElement? timeElement = TimeObjectElementHelper.Find(task.Elements);
        long? timeObjectId = timeElement == null
            ? null
            : TimeObjectReferenceResolver.GetSelectorId(timeElement);
        long? ticketElementId = null;
        WfReqElement? parallelTimeElement = TimeObjectReferenceResolver.FindParallelTimeElement(
            WfHandler.ActTicket.Tasks, task, timeObjectId, ticketElementId);
        string? timeObjectName = timeElement?.Name;
        if (parallelTimeElement != null)
        {
            timeObjectName ??= parallelTimeElement.Name;
            timeObjectId = TimeObjectReferenceResolver.GetSelectorId(parallelTimeElement);
            ticketElementId = parallelTimeElement.Id;
        }
        long? referencedObjectTaskId = timeElement?.ObjectTaskId;
        formerTimeObjectTask = referencedObjectTaskId is > 0
            ? WfHandler.ActTicket.Tasks.FirstOrDefault(candidate => candidate.Id == referencedObjectTaskId.Value)
            : parallelTimeElement == null
                ? null
                : WfHandler.ActTicket.Tasks.FirstOrDefault(candidate => candidate.Elements.Any(element =>
                    element.Id == parallelTimeElement.Id));
        formerTimeObjectSelectorId = timeObjectId;
        formerTimeObjectElementId = parallelTimeElement?.Id;
        targetDatesEditorModel = new TargetDatesEditorModel
        {
            BeginDate = parallelTimeElement?.StartTime ?? task.TargetBeginDate,
            EndDate = parallelTimeElement?.EndTime ?? task.TargetEndDate,
            FlowTimeObjectId = timeObjectId,
            TicketElementId = parallelTimeElement?.Id ?? ticketElementId,
            FlowTimeObjectName = timeObjectName,
            TicketTimeObjects = GetTicketTimeObjects(),
            TicketTimeObjectElementIds = GetTicketTimeObjectElementIds(),
            ShowBeginDate = AccessTaskVisibility.ShowValidFrom,
            ShowEndDate = AccessTaskVisibility.ShowValidTo
        };
        displayTargetDatesEditor = true;
        return RefreshAfterEditorOpen();
    }

    private bool CanCreateTimeObjectTask => editingTargetDatesTask != null
        && (CanEdit([editingTargetDatesTask], WorkflowEditableFieldKeys.ValidFrom)
            || CanEdit([editingTargetDatesTask], WorkflowEditableFieldKeys.ValidTo));

    private Task OpenCreateTimeObjectTaskEditor()
    {
        if (!CanCreateTimeObjectTask)
        {
            return Task.CompletedTask;
        }

        newTimeObjectTaskModel = new TargetDatesEditorModel
        {
            BeginDate = AccessTaskVisibility.ShowValidFrom ? targetDatesEditorModel.BeginDate : null,
            EndDate = AccessTaskVisibility.ShowValidTo ? targetDatesEditorModel.EndDate : null,
            ShowBeginDate = AccessTaskVisibility.ShowValidFrom,
            ShowEndDate = AccessTaskVisibility.ShowValidTo
        };
        displayTimeObjectTaskEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task OpenTextEditor(WfReqTask task, string fieldKey, string value)
    {
        editingTextTask = task;
        textEditorKey = fieldKey;
        textEditorValue = value;
        textEditorMultiline = fieldKey != WorkflowEditableFieldKeys.Title;
        displayTextEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task OpenElementsEditor(WfReqTask task, string fieldKey)
    {
        editingElementsTask = task;
        editingElementsField = fieldKey;
        displayElementsEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task OpenGroupMembersEditor(WfReqTask task)
    {
        string fieldKey = task.GetNwObjectElements(ElemFieldType.source).Any()
            ? WorkflowEditableFieldKeys.Source
            : WorkflowEditableFieldKeys.Services;
        return OpenElementsEditor(task, fieldKey);
    }

    private Task OpenExistingObjectTaskEditor(WfReqTask task)
    {
        newObjectTask = task;
        objectTaskIsExisting = true;
        objectTaskIsModify = task.TaskType == WfTaskType.object_modify.ToString();
        newObjectTaskKind = WfObjectTaskHelper.GetKind(WfObjectTaskHelper.GetRequestedElement(task)
            ?? WfObjectTaskHelper.GetOriginalElement(task));
        displayObjectTaskEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task OpenObjectTaskEditor()
    {
        if (editingElementsTask == null)
        {
            return Task.CompletedTask;
        }

        newObjectTask = new WfReqTask
        {
            TicketId = WfHandler.ActTicket.Id,
            TaskNumber = WfHandler.ActTicket.HighestTaskNumber() + 1,
            TaskType = WfTaskType.object_create.ToString(),
            RequestAction = RequestAction.create.ToString(),
            StateId = editingElementsTask.StateId,
            ManagementId = editingElementsTask.ManagementId,
            Locked = true,
            Title = userConfig.GetText("task")
        };
        newObjectTaskKind = editingElementsField == WorkflowEditableFieldKeys.Services
            ? ObjectTaskKind.Service
            : ObjectTaskKind.Network;
        objectTaskIsExisting = false;
        objectTaskIsModify = false;
        displayElementsEditor = false;
        displayObjectTaskEditor = true;
        return RefreshAfterEditorOpen();
    }

    private Task SaveObjectTask(WfReqTask task)
    {
        return RunWithProgress(() => SaveObjectTaskCore(task));
    }

    private async Task HandleObjectTaskEditorDisplayChanged(bool display)
    {
        displayObjectTaskEditor = display;
        if (!display)
        {
            objectTaskIsExisting = false;
            objectTaskIsModify = false;
        }
        if (!display && editingElementsTask != null)
        {
            displayElementsEditor = true;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveObjectTaskCore(WfReqTask task)
    {
        if (!objectTaskIsModify)
        {
            task.Title = task.Elements.FirstOrDefault()?.Name ?? task.Title;
        }
        WfHandler.SetReqTaskEnv(task);
        if (objectTaskIsExisting)
        {
            await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        }
        else
        {
            await WfHandler.AddReqTask(allowLockedApprovalUpdate: true);
        }
        await RefreshAccessTasksUsingObject(task);
        displayObjectTaskEditor = false;
        objectTaskIsExisting = false;
        objectTaskIsModify = false;
        displayElementsEditor = editingElementsTask != null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Refreshes the object snapshots in access tasks after an object task was changed.
    /// </summary>
    /// <param name="objectTask">The saved object task.</param>
    private async Task RefreshAccessTasksUsingObject(WfReqTask objectTask)
    {
        WfReqElement? requested = WfObjectTaskHelper.GetRequestedElement(objectTask);
        if (requested == null || !WfObjectTaskHelper.IsObjectTask(objectTask.TaskType))
        {
            return;
        }

        List<WfReqTask> affectedTasks = WfHandler.ActTicket.Tasks
            .Where(task => task.TaskType == WfTaskType.access.ToString())
            .Where(task => task.Elements.Any(element => element.ObjectTaskId == objectTask.Id))
            .ToList();

        foreach (WfReqTask accessTask in affectedTasks)
        {
            bool changed = false;
            foreach (WfReqElement element in accessTask.Elements.Where(element => element.ObjectTaskId == objectTask.Id))
            {
                CopyObjectSnapshot(element, requested);
                changed = true;
            }

            if (changed)
            {
                WfHandler.SetReqTaskEnv(accessTask);
                await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
            }
        }
    }

    /// <summary>
    /// Copies the changed object data while preserving the access element identity and action.
    /// </summary>
    private static void CopyObjectSnapshot(WfReqElement target, WfReqElement source)
    {
        string field = target.Field;
        long elementId = target.Id;
        long taskId = target.TaskId;
        string requestAction = target.RequestAction;
        long? objectTaskId = target.ObjectTaskId;
        target.IpString = source.IpString ?? source.Cidr?.CidrString;
        target.IpEnd = source.IpEnd ?? source.CidrEnd?.CidrString;
        target.Cidr = source.Cidr;
        target.CidrEnd = source.CidrEnd;
        target.Port = source.Port;
        target.PortEnd = source.PortEnd;
        target.ProtoId = source.ProtoId;
        target.NetworkId = source.NetworkId ?? target.NetworkId;
        target.ServiceId = source.ServiceId ?? target.ServiceId;
        target.FlowNetworkObjectId = source.FlowNetworkObjectId ?? target.FlowNetworkObjectId;
        target.FlowNetworkGroupId = source.FlowNetworkGroupId ?? target.FlowNetworkGroupId;
        target.FlowServiceObjectId = source.FlowServiceObjectId ?? target.FlowServiceObjectId;
        target.FlowServiceGroupId = source.FlowServiceGroupId ?? target.FlowServiceGroupId;
        target.TimeObjId = source.TimeObjId ?? target.TimeObjId;
        target.FlowTimeObjectId = source.FlowTimeObjectId ?? target.FlowTimeObjectId;
        target.GroupName = source.GroupName;
        target.Name = source.Name;
        target.Field = field;
        target.Id = elementId;
        target.TaskId = taskId;
        target.RequestAction = requestAction;
        target.ObjectTaskId = objectTaskId;
    }

    private static bool SamePositiveId(long? left, long? right)
    {
        return left is > 0 && left == right;
    }

    private Task DeleteObjectTask()
    {
        return RunWithProgress(DeleteObjectTaskCore);
    }

    private async Task DeleteObjectTaskCore()
    {
        if (pendingObjectTask == null)
        {
            return;
        }

        WfHandler.SetReqTaskEnv(pendingObjectTask);
        await WfHandler.ConfDeleteReqTask(allowLockedApprovalUpdate: true);
        pendingObjectTask = null;
        displayDeleteObjectTask = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task SaveElements(string fieldKey, IReadOnlyList<NwObjectElement> sources,
        IReadOnlyList<NwObjectElement> destinations, IReadOnlyList<NwServiceElement> services)
    {
        return RunWithProgress(() => SaveElementsCore(fieldKey, sources, destinations, services));
    }

    private async Task SaveElementsCore(string fieldKey, IReadOnlyList<NwObjectElement> sources,
        IReadOnlyList<NwObjectElement> destinations, IReadOnlyList<NwServiceElement> services)
    {
        if (editingElementsTask == null)
        {
            return;
        }

        WfHandler.SetReqTaskEnv(editingElementsTask);
        WfReqTask activeTask = WfHandler.ActReqTask;
        ElemFieldType field = fieldKey switch
        {
            WorkflowEditableFieldKeys.Source => ElemFieldType.source,
            WorkflowEditableFieldKeys.Destination => ElemFieldType.destination,
            _ => ElemFieldType.service
        };
        List<WfReqTask> formerObjectTasks = activeTask.Elements
            .Where(element => element.Field == field.ToString() && element.TaskId > 0)
            .Where(element => element.ObjectTaskId is > 0)
            .Select(element => WfHandler.ActTicket.Tasks.FirstOrDefault(task => task.Id == element.ObjectTaskId))
            .Where(task => task != null && WfObjectTaskHelper.IsManagementObjectTask(task.TaskType))
            .Cast<WfReqTask>()
            .DistinctBy(task => task.Id)
            .ToList();
        List<WfReqElement> replacement = field switch
        {
            ElemFieldType.source => sources.Select(element => element.ToReqElement(field)).ToList(),
            ElemFieldType.destination => destinations.Select(element => element.ToReqElement(field)).ToList(),
            _ => services.Select(element => element.ToReqElement()).ToList()
        };
        HashSet<long> retainedIds = replacement.Where(element => element.Id > 0).Select(element => element.Id).ToHashSet();
        activeTask.RemovedElements.AddRange(activeTask.Elements
            .Where(element => element.Field == field.ToString() && element.Id > 0 && !retainedIds.Contains(element.Id))
            .Where(element => activeTask.RemovedElements.All(removed => removed.Id != element.Id)));
        activeTask.Elements = activeTask.Elements
            .Where(element => element.Field != field.ToString())
            .Concat(replacement)
            .ToList();
        await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        if (IsGroupTask(activeTask))
        {
            await RefreshAccessTasksUsingGroup(activeTask);
        }
        editingElementsTask = null;
        WfReqTask? formerObjectTask = formerObjectTasks.FirstOrDefault(task => !IsObjectTaskReferenced(task));
        if (formerObjectTask != null)
        {
            pendingObjectTask = formerObjectTask;
            displayDeleteObjectTask = true;
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Refreshes access snapshots that were selected from a group task.
    /// </summary>
    private async Task RefreshAccessTasksUsingGroup(WfReqTask groupTask)
    {
        List<WfReqElement> currentElements = groupTask.Elements
            .Where(element => element.Field == ElemFieldType.source.ToString()
                || element.Field == ElemFieldType.service.ToString())
            .Where(element => element.RequestAction != RequestAction.delete.ToString())
            .ToList();

        foreach (WfReqTask accessTask in WfHandler.ActTicket.Tasks.Where(task =>
            task.TaskType == WfTaskType.access.ToString()))
        {
            bool changed = false;
            foreach (WfReqElement accessElement in accessTask.Elements.Where(element =>
                element.ObjectTaskId == groupTask.Id))
            {
                WfReqElement? currentElement = FindGroupMemberByReference(accessElement, currentElements);
                if (currentElement != null)
                {
                    CopyObjectSnapshot(accessElement, currentElement);
                    changed = true;
                }
            }

            if (changed)
            {
                WfHandler.SetReqTaskEnv(accessTask);
                await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
            }
        }
    }

    private static WfReqElement? FindGroupMemberByReference(WfReqElement accessElement,
        IEnumerable<WfReqElement> currentElements)
    {
        IEnumerable<WfReqElement> candidates = currentElements.Where(element => element.Field == accessElement.Field);
        if (accessElement.Field == ElemFieldType.service.ToString())
        {
            return candidates.FirstOrDefault(element =>
                SamePositiveId(element.ServiceId, accessElement.ServiceId)
                || SamePositiveId(element.FlowServiceObjectId, accessElement.FlowServiceObjectId)
                || SamePositiveId(element.FlowServiceGroupId, accessElement.FlowServiceGroupId));
        }

        return candidates.FirstOrDefault(element =>
            SamePositiveId(element.NetworkId, accessElement.NetworkId)
            || SamePositiveId(element.FlowNetworkObjectId, accessElement.FlowNetworkObjectId)
            || SamePositiveId(element.FlowNetworkGroupId, accessElement.FlowNetworkGroupId));
    }

    private bool IsObjectTaskReferenced(WfReqTask objectTask)
    {
        return WfHandler.ActTicket.Tasks
            .Where(task => task.Id != objectTask.Id)
            .SelectMany(task => task.Elements)
            .Any(element => element.ObjectTaskId == objectTask.Id);
    }

    private Task RefreshAfterEditorOpen()
    {
        try
        {
            return InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // Private callbacks are also exercised on an unrendered component in unit tests.
            return Task.CompletedTask;
        }
    }

    private async Task RunWithProgress(Func<Task> action)
    {
        if (workInProgress)
        {
            return;
        }

        workInProgress = true;
        await RefreshAfterOperation();
        try
        {
            await action();
        }
        finally
        {
            workInProgress = false;
            await RefreshAfterOperation();
        }
    }

    private async Task RefreshAfterOperation()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // Unit tests can invoke callbacks before the component has a render handle.
        }
    }

