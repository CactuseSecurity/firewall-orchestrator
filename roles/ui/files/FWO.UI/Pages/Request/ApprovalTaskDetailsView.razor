    protected override void OnParametersSet()
    {
        ConfigureEditorService();
    }

    /// <summary>Runs the compliance check of the access tasks when the view of a ticket is opened.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!Display)
        {
            compliance.Reset();
            // a retained component must not open the next ticket with the filter active
            showOnlyNotAllowed = false;
            return;
        }
        await compliance.UpdateAsync(WfHandler);
    }

    /// <summary>Repeats the compliance check after a change of the ticket, without blocking the change.</summary>
    private async Task UpdateComplianceAfterChange()
    {
        try
        {
            if (await compliance.UpdateAsync(WfHandler))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception exception)
        {
            Log.WriteError("Approval task view", "Compliance check could not be repeated.", exception);
        }
    }

    private void OpenComplianceReasons(ApprovalTaskCompliance taskCompliance)
    {
        shownCompliance = taskCompliance;
    }

    /// <summary>Buttons for the access tasks: recheck compliance and toggle the element display.</summary>
    private RenderFragment AccessTaskButtons =>
        @<text>
            @if (compliance.IsConfigured)
            {
                <button type="button" class="btn btn-sm @(showOnlyNotAllowed ? "btn-danger" : "btn-outline-danger") mr-2 approval-compliance-filter"
                        aria-pressed="@(showOnlyNotAllowed ? "true" : "false")" @onclick="ToggleNotAllowedFilter" @onclick:stopPropagation="true">
                    @(DisplayService.DisplayButton(userConfig, "approval_compliance_filter_not_allowed", Icons.Filter))
                </button>
            }
            @RecheckComplianceButton
            <button type="button" class="btn btn-sm btn-primary approval-task-display-toggle" @onclick="ToggleAccessElementDisplay">
                @(DisplayService.DisplayButton(userConfig, NextDisplayModeTextKey(), Icons.Swap))
            </button>
        </text>;

    private bool showOnlyNotAllowed;

    private void ToggleNotAllowedFilter()
    {
        showOnlyNotAllowed = !showOnlyNotAllowed;
    }

    /// <summary>
    /// Whether the task group is displayed: with the filter for not allowed access tasks, access tasks are only displayed
    /// if they are not allowed; other tasks are always displayed. Without a configured policy check the filter button
    /// is not offered, so the filter is ignored and nothing is hidden.
    /// </summary>
    private bool IsShown(List<WfReqTask> taskGroup)
    {
        return !showOnlyNotAllowed
            || !compliance.IsConfigured
            || taskGroup.Count == 0
            || !IsAccessTask(taskGroup[0])
            || compliance.ComplianceOf(taskGroup)?.IsCompliant == false;
    }

    /// <summary>Button checking all access tasks again; only shown if a policy check is configured.</summary>
    private RenderFragment RecheckComplianceButton => builder =>
    {
        if (!compliance.IsConfigured)
        {
            return;
        }
        builder.OpenComponent<ApprovalComplianceRecheckButton>(0);
        builder.AddComponentParameter(1, nameof(ApprovalComplianceRecheckButton.Loading), compliance.IsLoading);
        builder.AddComponentParameter(2, nameof(ApprovalComplianceRecheckButton.Class), "mr-2");
        builder.AddComponentParameter(3, nameof(ApprovalComplianceRecheckButton.Recheck),
            EventCallback.Factory.Create(this, RecheckCompliance));
        builder.CloseComponent();
    };

    private async Task RecheckCompliance()
    {
        try
        {
            await compliance.RecheckAsync(WfHandler);
        }
        catch (Exception exception)
        {
            Log.WriteError("Approval task view", "Compliance check could not be repeated.", exception);
        }
    }

