    internal Task OpenTrackingEditor(WfReqTask task) => RunEditorOperation(() => editorService.OpenTrackingEditor(task));
    internal Task OpenManagementEditor(WfReqTask task) => RunEditorOperation(() => editorService.OpenManagementEditor(task));
    internal Task OpenTargetDatesEditor(WfReqTask task, string fieldKey) => RunEditorOperation(() => editorService.OpenTargetDatesEditor(task, fieldKey));
