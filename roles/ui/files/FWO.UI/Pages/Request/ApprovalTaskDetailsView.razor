    protected override void OnParametersSet()
    {
        ConfigureEditorService();
    }

    protected override async Task OnInitializedAsync()
    {
        ConfigureEditorService();
        await editorService.InitializeAsync(apiConnection);
    }

    private void ConfigureEditorService() => editorService.Configure(WfHandler, userConfig, RefreshAfterOperation);

    private IEnumerable<List<WfReqTask>> GetTaskGroups()
    {
        ConfigureEditorService();
        return editorService.GetTaskGroups();
    }

    private static bool IsAccessTask(WfReqTask task) => ApprovalTaskDetailsEditorService.IsAccessTask(task);

    private static bool IsGroupTask(WfReqTask task) => ApprovalTaskDetailsEditorService.IsGroupTask(task);

