    private Task InvokeEditor(Func<Task> operation)
    {
        ConfigureEditorService();
        return operation();
    }

    private T InvokeEditor<T>(Func<T> operation)
    {
        ConfigureEditorService();
        return operation();
    }

    private void InvokeEditor(Action operation)
    {
        ConfigureEditorService();
        operation();
    }

    private async Task RunEditorOperation(Func<Task> operation)
    {
        ConfigureEditorService();
        await operation();
    }

    private async Task Close()
    {
        Display = false;
        await DisplayChanged.InvokeAsync(false);
        await Closed();
    }

    private void ClosePopup() => _ = Close();
