    {
        ConfigureEditorService();
        return operation();
    }

    private void InvokeEditor(Action operation)
    {
        ConfigureEditorService();
        operation();
    }

    private async Task RunEditorOperation(Func<Task> operation)
    {
        ConfigureEditorService();
        await operation();
