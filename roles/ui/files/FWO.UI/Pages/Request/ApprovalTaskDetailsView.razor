    private string TaskDisplayTitle(WfReqTask task)
    {
        string taskType = string.IsNullOrWhiteSpace(task.TaskType)
            ? userConfig.GetText("task")
            : userConfig.GetText(task.TaskType);
        return string.IsNullOrWhiteSpace(task.Title) || !ShowTitle(task) ? taskType : $"{taskType}: {task.Title}";
    }

    /// <summary>The title of access tasks can be hidden in the settings; other tasks always show it.</summary>
    private bool ShowTitle(WfReqTask task) => !IsAccessTask(task) || AccessTaskVisibility.ShowTitle;

    private RenderFragment TaskHeader(WfReqTask task, IEnumerable<WfReqTask> taskGroup) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "d-flex align-items-center flex-wrap gap-2");
        builder.OpenElement(2, "small");
        builder.AddAttribute(3, "class", "text-dark mr-2 text-nowrap");
        builder.AddContent(4, $"{userConfig.GetText("id")}: {TaskIds(taskGroup)}");
        builder.CloseElement();
        if (CanShowTaskPromotion(task))
        {
            builder.OpenElement(5, "button");
            builder.AddAttribute(6, "type", "button");
            builder.AddAttribute(7, "class", "btn btn-sm btn-warning");
            builder.AddAttribute(8, "onclick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this,
                () => RunWithProgress(() => OpenTaskPromotion(task))));
            builder.AddEventStopPropagationAttribute(9, "onclick", true);
            builder.AddContent(10, DisplayService.DisplayButton(userConfig, "promote", Icons.ChangeState));
            builder.CloseElement();
        }
        builder.AddContent(11, TaskActionButtons([.. taskGroup]));
        if (ShowTitle(task) && CanEdit(taskGroup, WorkflowEditableFieldKeys.Title))
        {
            builder.OpenElement(111, "button");
            builder.AddAttribute(112, "type", "button");
            builder.AddAttribute(113, "class", "btn btn-sm btn-secondary");
            builder.AddAttribute(114, "onclick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this,
                () => OpenTextEditor(task, WorkflowEditableFieldKeys.Title, task.Title)));
            builder.AddEventStopPropagationAttribute(115, "onclick", true);
            builder.AddContent(116, DisplayService.DisplayButton(userConfig, "edit", Icons.Edit));
            builder.CloseElement();
        }
        builder.OpenElement(117, "strong");
        builder.AddAttribute(118, "class", "mr-2");
        builder.AddContent(119, TaskDisplayTitle(task));
        builder.CloseElement();
        if (taskGroup.Count() > 1)
        {
            builder.OpenElement(120, "span");
            builder.AddAttribute(121, "class", "badge badge-secondary ml-2");
            builder.AddContent(122, taskGroup.Count());
            builder.CloseElement();
        }
        builder.OpenElement(123, "span");
        builder.AddAttribute(124, "class", "ml-auto");
        builder.AddContent(125, States.GetName(task.StateId));
        builder.CloseElement();
        if (compliance.IsConfigured && IsAccessTask(task))
        {
            builder.OpenComponent<ApprovalComplianceButton>(126);
            builder.AddComponentParameter(127, nameof(ApprovalComplianceButton.Compliance), compliance.ComplianceOf(taskGroup));
            builder.AddComponentParameter(128, nameof(ApprovalComplianceButton.Loading), compliance.IsLoading);
            builder.AddComponentParameter(129, nameof(ApprovalComplianceButton.Class), "btn-sm");
            builder.AddComponentParameter(130, nameof(ApprovalComplianceButton.ShowReasons),
                EventCallback.Factory.Create<ApprovalTaskCompliance>(this, OpenComplianceReasons));
            builder.CloseComponent();
        }
        builder.CloseElement();
    };

    private bool CanShowTaskPromotion(WfReqTask task)
    {
        return CanPromoteTasks && !WfHandler.ReadOnlyMode && WfHandler.CanActOnReqTaskInCurrentPhase(task);
    }

    /// <summary>The configured request task actions offered for a task or a bundle displayed as one.</summary>
    private IReadOnlyList<WfStateAction> VisibleTaskActions(IReadOnlyList<WfReqTask> taskGroup) =>
        WorkflowTaskActions.VisibleForRequestTasks(WfHandler, taskGroup);

    /// <summary>Performs a configured task action on every task of the group and reloads the ticket afterwards.</summary>
    private Task PerformTaskAction(IReadOnlyList<WfReqTask> taskGroup, WfStateAction action)
    {
        return RunWithProgress(() => WorkflowTaskActions.PerformOnRequestTasks(WfHandler, action, taskGroup));
    }

    private RenderFragment TaskActionButtons(IReadOnlyList<WfReqTask> taskGroup) =>
        WorkflowTaskActions.Buttons(VisibleTaskActions(taskGroup), action => PerformTaskAction(taskGroup, action));

    private bool displayTaskPromotion;

    private async Task OpenTaskPromotion(WfReqTask task)
    {
        WfHandler.SelectReqTaskPopUp(task, ObjAction.displayPromote);
        displayTaskPromotion = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task CloseTaskPromotion()
    {
        displayTaskPromotion = false;
        return Task.CompletedTask;
    }

    private bool CancelTaskPromotion()
    {
        displayTaskPromotion = false;
        return true;
    }

    private async Task PromoteSelectedTask(WfStatefulObject task)
    {
        await WfHandler.PromoteReqTask(task);
        displayTaskPromotion = false;
        await InvokeAsync(StateHasChanged);
    }

