    private async Task SaveTargetDatesCore(TargetDatesEditorModel model)
    {
        if (editingTargetDatesTask == null)
        {
            return;
        }

        foreach (WfReqTask task in GetTasksToUpdate(editingTargetDatesTask))
        {
            WfHandler.SetReqTaskEnv(task);
            ApplyTimeObjectModel(model);
            await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        }
        bool offerFormerTimeObjectDeletion = ShouldOfferFormerTimeObjectDeletion(model);
        editingTargetDatesTask = null;
        if (offerFormerTimeObjectDeletion)
        {
            pendingFormerTimeObjectTask = formerTimeObjectTask;
            displayDeleteFormerTimeObjectTask = true;
        }
        formerTimeObjectTask = null;
        formerTimeObjectSelectorId = null;
        formerTimeObjectElementId = null;
        await InvokeAsync(StateHasChanged);
    }

    private Task CreateTimeObjectTask(TargetDatesEditorModel model)
    {
        return RunWithProgress(() => CreateTimeObjectTaskCore(model));
    }

    private async Task CreateTimeObjectTaskCore(TargetDatesEditorModel model)
    {
        if (editingTargetDatesTask == null || !CanCreateTimeObjectTask)
        {
            return;
        }

        WfReqTask sourceTask = editingTargetDatesTask;
        string timeObjectName = TimeObjectNamingHelper.BuildDisplayName(
            model.FlowTimeObjectName?.Trim(),
            TimeObjectOrigin.Approver,
            TimeObjectNamingHelper.ParseSuffixes(userConfig.ReqTimeObjectOriginSuffixes));
        WfReqElement timeElement = new()
        {
            Field = ElemFieldType.time.ToString(),
            RequestAction = RequestAction.create.ToString(),
            Name = timeObjectName,
            StartTime = model.BeginDate,
            EndTime = model.EndDate
        };
        WfReqTask newTask = new()
        {
            TicketId = WfHandler.ActTicket.Id,
            TaskNumber = WfHandler.ActTicket.HighestTaskNumber() + 1,
            TaskType = WfTaskType.object_create.ToString(),
            RequestAction = RequestAction.create.ToString(),
            StateId = sourceTask.StateId,
            Title = timeObjectName,
            ManagementId = sourceTask.ManagementId,
            TargetBeginDate = model.BeginDate,
            TargetEndDate = model.EndDate,
            Locked = true,
            Elements = [timeElement],
            Approvals =
            [
                new WfApproval
                {
                    StateId = sourceTask.StateId,
                    TenantId = WfHandler.ActTicket.TenantId,
                    ApproverGroup = sourceTask.Approvals.FirstOrDefault()?.ApproverGroup ?? "",
                    InitialApproval = true
                }
            ]
        };

        InitializeNewObjectTaskState(newTask);
        WfHandler.SelectReqTask(newTask, ObjAction.add);
        await WfHandler.AddReqTask(allowLockedApprovalUpdate: true);
        WfReqTask? createdTask = WfHandler.ActTicket.Tasks.FirstOrDefault(task => task.TaskNumber == newTask.TaskNumber);
        WfReqElement? createdElement = createdTask == null ? null : TimeObjectElementHelper.Find(createdTask.Elements);
        if (createdTask == null || createdElement == null)
        {
            WfHandler.SetReqTaskEnv(sourceTask);
            return;
        }

        TargetDatesEditorModel updatedModel = new(targetDatesEditorModel)
        {
            BeginDate = createdElement.StartTime,
            EndDate = createdElement.EndTime,
            FlowTimeObjectId = TimeObjectReferenceResolver.GetSelectorId(createdElement),
            TicketElementId = createdElement.Id,
            FlowTimeObjectName = createdElement.Name,
            TicketTimeObjects = GetTicketTimeObjects(),
            TicketTimeObjectElementIds = GetTicketTimeObjectElementIds()
        };
        targetDatesEditorModel = updatedModel;
        WfHandler.SetReqTaskEnv(sourceTask);
        displayTimeObjectTaskEditor = false;
        displayTargetDatesEditor = true;
        await InvokeAsync(StateHasChanged);
    }

    private void InitializeNewObjectTaskState(WfReqTask task)
    {
        int initialState = WfHandler.ActStateMatrix.LowestInputState;
        task.StateId = initialState;
        foreach (WfApproval approval in task.Approvals)
        {
            approval.StateId = initialState;
        }
    }

    private bool ShouldOfferFormerTimeObjectDeletion(TargetDatesEditorModel model)
    {
        if (formerTimeObjectTask?.Id is not > 0 || formerTimeObjectSelectorId == model.FlowTimeObjectId
            || model.FlowTimeObjectId == null)
        {
            return false;
        }

        WfReqTask? accessTask = editingTargetDatesTask;
        if (accessTask == null)
        {
            return false;
        }

        return !WfHandler.ActTicket.Tasks
            .Where(task => task.TaskType == WfTaskType.access.ToString()
                && task.Id != formerTimeObjectTask.Id && task.Id != accessTask.Id)
            .Any(UsesFormerTimeObject);
    }

    private bool UsesFormerTimeObject(WfReqTask task)
    {
        WfReqElement? timeElement = TimeObjectElementHelper.Find(task.Elements);
        if (timeElement == null || formerTimeObjectTask == null)
        {
            return false;
        }

        return timeElement.ObjectTaskId == formerTimeObjectTask.Id
            || (formerTimeObjectElementId is > 0 && timeElement.TimeObjId == -formerTimeObjectElementId.Value)
            || TimeObjectReferenceResolver.FindParallelTimeTask(
                WfHandler.ActTicket.Tasks, task, null, null)?.Id == formerTimeObjectTask.Id;
    }

