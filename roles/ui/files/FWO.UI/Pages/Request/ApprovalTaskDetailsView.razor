    private Task SaveElements(string fieldKey, IReadOnlyList<NwObjectElement> sources, IReadOnlyList<NwObjectElement> destinations, IReadOnlyList<NwServiceElement> services) => InvokeEditor(() => editorService.SaveElements(fieldKey, sources, destinations, services));
    internal Task SaveElementsCore(string fieldKey, IReadOnlyList<NwObjectElement> sources, IReadOnlyList<NwObjectElement> destinations, IReadOnlyList<NwServiceElement> services) => InvokeEditor(() => editorService.SaveElementsCore(fieldKey, sources, destinations, services));
    internal bool IsObjectTaskReferenced(WfReqTask task) => InvokeEditor(() => editorService.IsObjectTaskReferenced(task));
    private Task RunWithProgress(Func<Task> action) => InvokeEditor(() => editorService.RunWithProgress(action));
    private Task RefreshAfterOperation() => RefreshAfterOperationCore();

    private async Task RefreshAfterOperationCore()
    {
        try
        {
            if (Display)
            {
                // Sets the loading state at once; the check itself runs in the background.
                _ = UpdateComplianceAfterChange();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // Unit tests can invoke callbacks before the component has a render handle.
        }
    }

