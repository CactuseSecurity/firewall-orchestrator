    private Task RunWithProgress(Func<Task> action) => InvokeEditor(() => editorService.RunWithProgress(action));
    private Task RefreshAfterOperation() => RefreshAfterOperationCore();

    private async Task RefreshAfterOperationCore()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // Unit tests can invoke callbacks before the component has a render handle.
        }
    }

