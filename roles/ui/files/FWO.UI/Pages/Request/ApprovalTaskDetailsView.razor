@using FWO.Data.Workflow
@using FWO.Data
@using FWO.Data.Flow
@using FWO.Ui.Display
@using FWO.Ui.Shared
@using FWO.Ui.Services

@inject UserConfig userConfig
@inject ApiConnection apiConnection

<PopUp Title="@ApprovalTaskViewTitle" Show="@Display" Size="PopupSize.XLarge" OnClose="ClosePopup">
    <Body>
        @if (Display)
        {
            List<List<WfReqTask>> taskGroups = GetTaskGroups().ToList();
            bool accessToggleShown = false;
            @foreach (List<WfReqTask> taskGroup in taskGroups)
            {
                WfReqTask task = taskGroup[0];
                @if (IsAccessTask(task) && !accessToggleShown)
                {
                    accessToggleShown = true;
                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-sm btn-primary approval-task-display-toggle" @onclick="ToggleAccessElementDisplay">
                            @(DisplayService.DisplayButton(userConfig, NextDisplayModeTextKey(), Icons.Swap))
                        </button>
                    </div>
                }
                <Collapse StartToggled="@(!IsAccessTask(task))" Style="secondary" UseHtmlTitle="true" TitleWithHtml="@TaskHeader(task, taskGroup)">
                    <div class="card-body">
                        <CascadingValue Value="@CreateTaskViewContext()">
                            @if (IsAccessTask(task))
                            {
                                <ApprovalTaskAccessBody Task="task" TaskGroup="taskGroup" />
                            }
                            else if (IsGroupTask(task))
                            {
                                <ApprovalGroupTaskBody Task="task" TaskGroup="taskGroup" />
                            }
                            else if (task.TaskType == WfTaskType.generic.ToString())
                            {
                                <ApprovalGenericTaskBody Task="task" TaskGroup="taskGroup" />
                            }
                            else if (task.TaskType == WfTaskType.new_interface.ToString())
                            {
                                <ApprovalInterfaceTaskBody Task="task" TaskGroup="taskGroup" />
                            }
                            else
                            {
                                <ApprovalObjectTaskBody Task="task" TaskGroup="taskGroup" />
                            }
                        </CascadingValue>
                    </div>
                </Collapse>
            }
        }
    </Body>
    <Footer>
        <WorkflowTaskDetailsFooter OfferedActions="OfferedActions"
            CanShowAction="CanPerformTicketAction"
            PerformAction="PerformTicketAction"
            CanPromoteTicket="CanPromoteTicket"
            PromoteTicket="PromoteTicket"
            ShowCancel="ShowCancel"
            Close="Close"
            CloseButtonClass="workflow-task-details-close approval-task-details-close" />
    </Footer>
</PopUp>
<RuleActionEditor @bind-Display="displayRuleActionEditor" SelectedRuleAction="selectedRuleAction"
    RuleActions="ruleActions" Saved="SaveRuleAction" />
<OwnerEditor @bind-Display="displayOwnerEditor" SelectedOwner="selectedOwner"
    Owners="GetOwnerOptions()" Saved="SaveOwner" />
<TrackingEditor @bind-Display="displayTrackingEditor" SelectedTracking="selectedTracking"
    Trackings="trackings" Saved="SaveTracking" />
<ManagementEditor @bind-Display="displayManagementEditor" SelectedManagement="selectedManagement"
    Managements="ManagementOptions" Saved="SaveManagement" />
<TargetDatesEditor @bind-Display="displayTargetDatesEditor"
    Model="targetDatesEditorModel"
    AllowCreateTimeObjectTask="CanCreateTimeObjectTask"
    CreateTimeObjectTaskRequested="OpenCreateTimeObjectTaskEditor"
    Saved="SaveTargetDates" />
<TimeObjectTaskEditor @bind-Display="displayTimeObjectTaskEditor"
    Model="newTimeObjectTaskModel"
    ShowBeginDate="@AccessTaskVisibility.ShowValidFrom"
    ShowEndDate="@AccessTaskVisibility.ShowValidTo"
    Saved="CreateTimeObjectTask" />
<TextEditor @bind-Display="displayTextEditor" Text="@textEditorValue" TextKey="@textEditorKey"
    Multiline="@textEditorMultiline" Rows="5" Saved="SaveText" />
<ApprovalTaskElementsEditor @bind-Display="displayElementsEditor" Task="@(editingElementsTask ?? new WfReqTask())"
    FieldKey="@editingElementsField" TicketTasks="WfHandler.ActTicket.Tasks" IpProtos="ipProtocols"
    SelectableIpProtos="selectableIpProtocols" Saved="SaveElements" CreateObjectTaskRequested="OpenObjectTaskEditor" />
<ApprovalObjectTaskEditor Display="displayObjectTaskEditor" DisplayChanged="HandleObjectTaskEditorDisplayChanged"
    Task="newObjectTask" ObjectKind="newObjectTaskKind" IsModify="objectTaskIsModify" SelectableIpProtos="selectableIpProtocols"
    DisplayIpProtos="ipProtocols" Saved="SaveObjectTask" />
<TimeObjectTaskDeleteConfirmation @bind-Display="displayDeleteFormerTimeObjectTask"
    Title="@(userConfig.GetText("delete_time_object_task"))"
    Message="@(userConfig.GetText("delete_time_object_task_message"))"
    Confirmed="DeleteFormerTimeObjectTask" />
<TimeObjectTaskDeleteConfirmation @bind-Display="displayDeleteObjectTask"
    Title="@(userConfig.GetText("delete_task"))" Message="@(userConfig.GetText("delete_unreferenced_object_task_message"))"
    Confirmed="DeleteObjectTask" />
<PromoteObject @bind-Promote="displayTaskPromotion" CloseParent="CloseTaskPromotion"
    CancelParent="CancelTaskPromotion" ObjectName="@WfHandler.ActReqTask.Title"
    Save="PromoteSelectedTask" StatefulObject="WfHandler.ActReqTask"
    StateMatrix="WfHandler.ActStateMatrix" States="States" />
<InProgress Display="workInProgress" />

@code {
    [Parameter] public bool Display { get; set; }
    [Parameter] public EventCallback<bool> DisplayChanged { get; set; }
    [Parameter] public WfHandler WfHandler { get; set; } = new();
    [Parameter] public WfStateDict States { get; set; } = new();
    [Parameter] public Func<WfReqTask, string, Task> EditField { get; set; } = (_, _) => Task.CompletedTask;
    [Parameter] public IReadOnlyList<WfStateAction> OfferedActions { get; set; } = [];
    [Parameter] public Func<WfStateAction, Task> PerformTicketAction { get; set; } = _ => Task.CompletedTask;
    [Parameter] public bool CanPromoteTicket { get; set; }
    [Parameter] public bool CanPromoteTasks { get; set; }
    [Parameter] public bool ShowCancel { get; set; }
    [Parameter] public Func<Task> PromoteTicket { get; set; } = DefaultInit.DoNothing;
    [Parameter] public Func<Task> Closed { get; set; } = DefaultInit.DoNothing;

    private readonly ApprovalTaskDetailsEditorService editorService = new();

    private bool CanPerformTicketAction(WfStateAction action) => WfHandler.CanPerformActionOnActTicket(action);

    private string ApprovalTaskViewTitle
    {
        get
        {
            string requester = WfHandler.ActTicket.Requester?.Name ?? "";
            string metadata = $"{userConfig.GetText("id")}: {WfHandler.ActTicket.Id}, {userConfig.GetText("state")}: {States.GetName(WfHandler.ActTicket.StateId)}";
            if (!string.IsNullOrWhiteSpace(requester))
            {
                metadata += $", {userConfig.GetText("requester")}: {requester}";
            }
            return $"{userConfig.GetText("ticket")}: {WfHandler.ActTicket.Title} ({metadata})";
        }
    }

    private string TaskDisplayTitle(WfReqTask task)
    {
        string taskType = string.IsNullOrWhiteSpace(task.TaskType)
            ? userConfig.GetText("task")
            : userConfig.GetText(task.TaskType);
        return string.IsNullOrWhiteSpace(task.Title) ? taskType : $"{taskType}: {task.Title}";
    }

    private RenderFragment TaskHeader(WfReqTask task, IEnumerable<WfReqTask> taskGroup) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "d-flex align-items-center flex-wrap gap-2");
        builder.OpenElement(2, "small");
        builder.AddAttribute(3, "class", "text-dark mr-2 text-nowrap");
        builder.AddContent(4, $"{userConfig.GetText("id")}: {TaskIds(taskGroup)}");
        builder.CloseElement();
        if (CanShowTaskPromotion(task))
        {
            builder.OpenElement(5, "button");
            builder.AddAttribute(6, "type", "button");
            builder.AddAttribute(7, "class", "btn btn-sm btn-warning");
            builder.AddAttribute(8, "onclick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this,
                () => RunWithProgress(() => OpenTaskPromotion(task))));
            builder.AddEventStopPropagationAttribute(9, "onclick", true);
            builder.AddContent(10, DisplayService.DisplayButton(userConfig, "promote", Icons.ChangeState));
            builder.CloseElement();
        }
        if (CanEdit(taskGroup, WorkflowEditableFieldKeys.Title))
        {
            builder.OpenElement(11, "button");
            builder.AddAttribute(12, "type", "button");
            builder.AddAttribute(13, "class", "btn btn-sm btn-secondary");
            builder.AddAttribute(14, "onclick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this,
                () => OpenTextEditor(task, WorkflowEditableFieldKeys.Title, task.Title)));
            builder.AddEventStopPropagationAttribute(15, "onclick", true);
            builder.AddContent(16, DisplayService.DisplayButton(userConfig, "edit", Icons.Edit));
            builder.CloseElement();
        }
        builder.OpenElement(17, "strong");
        builder.AddAttribute(18, "class", "mr-2");
        builder.AddContent(19, TaskDisplayTitle(task));
        builder.CloseElement();
        if (taskGroup.Count() > 1)
        {
            builder.OpenElement(20, "span");
            builder.AddAttribute(21, "class", "badge badge-secondary ml-2");
            builder.AddContent(22, taskGroup.Count());
            builder.CloseElement();
        }
        builder.OpenElement(23, "span");
        builder.AddAttribute(24, "class", "ml-auto");
        builder.AddContent(25, States.GetName(task.StateId));
        builder.CloseElement();
        builder.CloseElement();
    };

    private bool CanShowTaskPromotion(WfReqTask task)
    {
        return CanPromoteTasks && !WfHandler.ReadOnlyMode && WfHandler.CanActOnReqTaskInCurrentPhase(task);
    }

    private bool displayTaskPromotion;

    private async Task OpenTaskPromotion(WfReqTask task)
    {
        WfHandler.SelectReqTaskPopUp(task, ObjAction.displayPromote);
        displayTaskPromotion = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task CloseTaskPromotion()
    {
        displayTaskPromotion = false;
        return Task.CompletedTask;
    }

    private bool CancelTaskPromotion()
    {
        displayTaskPromotion = false;
        return true;
    }

    private async Task PromoteSelectedTask(WfStatefulObject task)
    {
        await WfHandler.PromoteReqTask(task);
        displayTaskPromotion = false;
        await InvokeAsync(StateHasChanged);
    }

