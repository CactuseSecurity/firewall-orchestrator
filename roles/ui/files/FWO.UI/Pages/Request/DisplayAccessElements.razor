@using FWO.Ui.Display
@using FWO.Data.Flow
@using FWO.Data.Workflow


@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.WorkflowRolesList}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject UserConfig userConfig


<hr />
@if(InitComplete)
{
    @if (ShowAnyFlowCatalog)
    {
        <div class="bg-secondary p-2">
            <div class="form-group row col-sm-12">
                <div class="col-sm-4">
                    @if (ShowSourceFlowCatalog)
                    {
                        <div class="form-group row">
                            <label class="col-sm-3">@(userConfig.GetText("object_catalog")):</label>
                            <div class="col-sm-8">
                                <Dropdown ElementType="NetworkObject" @bind-SelectedElement="newSourceNetwork" ElementToString="@(n => n.Name)" Elements="nwObjects" Nullable="true">
                                    <ElementTemplate Context="nwObject">
                                        @nwObject.Name
                                    </ElementTemplate>
                                </Dropdown>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-sm-4">
                    @if (ShowDestinationFlowCatalog)
                    {
                        <div class="form-group row">
                            <label class="col-sm-3">@(userConfig.GetText("object_catalog")):</label>
                            <div class="col-sm-8">
                                <Dropdown ElementType="NetworkObject" @bind-SelectedElement="newDestinationNetwork" ElementToString="@(n => n.Name)" Elements="nwObjects" Nullable="true">
                                    <ElementTemplate Context="nwObject">
                                        @nwObject.Name
                                    </ElementTemplate>
                                </Dropdown>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-sm-4">
                    @if (ShowServiceFlowCatalog)
                    {
                        <div class="form-group row">
                            <label class="col-sm-3">@(userConfig.GetText("service_catalog")):</label>
                            <div class="col-sm-8">
                                <Dropdown ElementType="NetworkService" @bind-SelectedElement="newService" ElementToString="@(s => s.Name)" Elements="nwServices" Nullable="true">
                                    <ElementTemplate Context="nwService">
                                        @nwService.Name
                                    </ElementTemplate>
                                </Dropdown>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    <div class="form-group row col-sm-12 mh-13">
        <div class="col-sm-4">
            <label class="col-sm-12 col-form-label col-form-label-sm">@(userConfig.GetText("source"))*:</label>
            @if (CanEditSources && ShowManualObjects)
            {
                <IpSelector IpAddresses="Sources" @bind-IpsToAdd="SourcesToAdd" @bind-IpsToDelete="SourcesToDelete" WithLabel="false"/>
            }
            else if (CanEditSources && ShowFlowObjects)
            {
                <EditList ElementType="NwObjectElement" Elements="Sources.ToArray()" ElementsToAdd="SourcesToAdd" ElementsToDelete="SourcesToDelete" StdLayout="false">
                    <Display>
                        <div class="row">
                            <div class="mh-13 col-sm-12 border bg-transparent">@DisplayNetworkElementForCatalog(context)</div>
                        </div>
                    </Display>
                </EditList>
            }
            else
            {
                <div class="list-group">
                    @foreach(var source in Sources.Where(HasNetworkObjectReference))
                    {
                        <div class="list-group-item border bg-secondary">
                            <div class="d-flex align-items-center">
                                <span class="flex-grow-1">@DisplayNetworkObject(source) <small class="text-muted" title="@(userConfig.GetText("element_origin"))">(@ElementOrigin(source))</small></span>
                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowNetworkDetails(source, ElemFieldType.source)">@(DisplayService.DisplayButton(userConfig, "details", Icons.Display))</button>
                            </div>
                        </div>
                    }
                    @foreach(var source in Sources.Where(x => !HasNetworkObjectReference(x)))
                    {
                        <div class="list-group-item border bg-secondary">
                            <div class="d-flex align-items-center">
                                <span class="flex-grow-1">@DisplayNetworkElement(source) <small class="text-muted" title="@(userConfig.GetText("element_origin"))">(@ElementOrigin(source))</small></span>
                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowNetworkDetails(source, ElemFieldType.source)">@(DisplayService.DisplayButton(userConfig, "details", Icons.Display))</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-sm-4">
            <label for="taskDest" class="col-sm-12 col-form-label col-form-label-sm">@(userConfig.GetText("destination"))*:</label>
            @if (CanEditDestinations && ShowManualObjects)
            {
                <IpSelector IpAddresses="Destinations" @bind-IpsToAdd="DestinationsToAdd" @bind-IpsToDelete="DestinationsToDelete" WithLabel="false"/>
            }
            else if (CanEditDestinations && ShowFlowObjects)
            {
                <EditList ElementType="NwObjectElement" Elements="Destinations.ToArray()" ElementsToAdd="DestinationsToAdd" ElementsToDelete="DestinationsToDelete" StdLayout="false">
                    <Display>
                        <div class="row">
                            <div class="mh-13 col-sm-12 border bg-transparent">@DisplayNetworkElementForCatalog(context)</div>
                        </div>
                    </Display>
                </EditList>
            }
            else
            {
                <div class="list-group">
                    @foreach(var destination in Destinations.Where(HasNetworkObjectReference))
                    {
                        <div class="list-group-item border bg-secondary">
                            <div class="d-flex align-items-center">
                                <span class="flex-grow-1">@DisplayNetworkObject(destination) <small class="text-muted" title="@(userConfig.GetText("element_origin"))">(@ElementOrigin(destination))</small></span>
                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowNetworkDetails(destination, ElemFieldType.destination)">@(DisplayService.DisplayButton(userConfig, "details", Icons.Display))</button>
                            </div>
                        </div>
                    }
                    @foreach(var destination in Destinations.Where(x => !HasNetworkObjectReference(x)))
                    {
                        <div class="list-group-item border bg-secondary">
                            <div class="d-flex align-items-center">
                                <span class="flex-grow-1">@DisplayNetworkElement(destination) <small class="text-muted" title="@(userConfig.GetText("element_origin"))">(@ElementOrigin(destination))</small></span>
                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowNetworkDetails(destination, ElemFieldType.destination)">@(DisplayService.DisplayButton(userConfig, "details", Icons.Display))</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-sm-4">
            <label for="taskService" class="col-sm-12 col-form-label col-form-label-sm">@(userConfig.GetText("service"))*:</label>
            @if (CanEditServices && ShowManualServices)
            {
                <ServiceSelector Services="Services" @bind-ServicesToAdd="ServicesToAdd" @bind-ServicesToDelete="ServicesToDelete" IpProtos="SelectableIpProtos" TaskId="TaskId" WithLabel="false"/>
            }
            else if (CanEditServices && ShowFlowServices)
            {
                <EditList ElementType="NwServiceElement" Elements="Services.ToArray()" ElementsToAdd="ServicesToAdd" ElementsToDelete="ServicesToDelete" StdLayout="false">
                    <Display>
                        <div class="border bg-transparent">@DisplayServiceElementForCatalog(context)</div>
                    </Display>
                </EditList>
            }
            else
            {
                <div class="list-group">
                    @foreach(var service in Services.Where(HasServiceObjectReference))
                    {
                        <div class="list-group-item border bg-secondary d-flex align-items-center">
                            <span class="flex-grow-1">@DisplayNetworkService(service) <small class="text-muted" title="@(userConfig.GetText("element_origin"))">(@ElementOrigin(service))</small></span>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowServiceDetails(service)">@(DisplayService.DisplayButton(userConfig, "details", Icons.Display))</button>
                        </div>
                    }
                    @foreach(var service in Services.Where(x => !HasServiceObjectReference(x)))
                    {
                        <div class="list-group-item border bg-secondary">
                            <div class="d-flex align-items-center">
                                <span class="flex-grow-1">@DisplayServiceElement(service) <small class="text-muted" title="@(userConfig.GetText("element_origin"))">(@ElementOrigin(service))</small></span>
                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowServiceDetails(service)">@(DisplayService.DisplayButton(userConfig, "details", Icons.Display))</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <Loading/>
}

        <DisplayFlowElementDetails Display="displayDetails" DisplayChanged="SetDisplayDetails"
            Title="@detailsTitle" NetworkObject="selectedNetworkObject" NetworkGroup="selectedNetworkGroup"
            NetworkObjects="flowNwObjects" NetworkFallback="networkFallback" ServiceObject="selectedServiceObject" ServiceGroup="selectedServiceGroup" ServiceObjects="flowSvcObjects"
            ServiceFallback="serviceFallback" IpProtocols="IpProtos" NetworkGroupMode="networkGroupMode" ServiceGroupMode="serviceGroupMode" />

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    [Parameter]
    public List<NwObjectElement> Sources { get; set; } = [];

    [Parameter]
    public List<NwObjectElement> SourcesToAdd { get; set; } = [];

    [Parameter]
    public EventCallback<List<NwObjectElement>> SourcesToAddChanged { get; set; }

    [Parameter]
    public List<NwObjectElement> SourcesToDelete { get; set; } = [];
        
    [Parameter]
    public EventCallback<List<NwObjectElement>> SourcesToDeleteChanged { get; set; }

    [Parameter]
    public List<NwObjectElement> Destinations { get; set; } = [];

    [Parameter]
    public List<NwObjectElement> DestinationsToAdd { get; set; } = [];

    [Parameter]
    public EventCallback<List<NwObjectElement>> DestinationsToAddChanged { get; set; }

    [Parameter]
    public List<NwObjectElement> DestinationsToDelete { get; set; } = [];

    [Parameter]
    public EventCallback<List<NwObjectElement>> DestinationsToDeleteChanged { get; set; }

    [Parameter]
    public List<NwServiceElement> Services { get; set; } = [];

    [Parameter]
    public List<NwServiceElement> ServicesToAdd { get; set; } = [];

    [Parameter]
    public EventCallback<List<NwServiceElement>> ServicesToAddChanged { get; set; }

    [Parameter]
    public List<NwServiceElement> ServicesToDelete { get; set; } = [];

    [Parameter]
    public EventCallback<List<NwServiceElement>> ServicesToDeleteChanged { get; set; }

    [Parameter]
    public List<IpProtocol> IpProtos { get; set; } = [];

    [Parameter]
    public List<IpProtocol> SelectableIpProtos { get; set; } = [];

    [Parameter]
    public long TaskId { get; set; } = 0;

    [Parameter]
    public List<WfReqTask> TicketTasks { get; set; } = [];

    [Parameter]
    public bool EditMode { get; set; } = false;

    [Parameter]
    public bool EditSources { get; set; } = false;

    [Parameter]
    public bool EditDestinations { get; set; } = false;

    [Parameter]
    public bool EditServices { get; set; } = false;

    private bool InitComplete = false;
    private bool CanEditSources => EditMode || EditSources;
    private bool CanEditDestinations => EditMode || EditDestinations;
    private bool CanEditServices => EditMode || EditServices;
    private FlowIntegrationConfig FlowIntegration => FlowIntegrationConfig.Parse(userConfig.ReqFlowIntegration);
    private bool ShowManualObjects => !userConfig.ReqUseFlowDb || ShowsManualSelection(FlowIntegration.SelectObjects);
    private bool ShowManualServices => !userConfig.ReqUseFlowDb || ShowsManualSelection(FlowIntegration.SelectServices);
    private bool ShowFlowObjects => userConfig.ReqUseFlowDb && ShowsFlowDbSelection(FlowIntegration.SelectObjects);
    private bool ShowFlowServices => userConfig.ReqUseFlowDb && ShowsFlowDbSelection(FlowIntegration.SelectServices);
    private bool ShowSourceFlowCatalog => CanEditSources && ShowFlowObjects;
    private bool ShowDestinationFlowCatalog => CanEditDestinations && ShowFlowObjects;
    private bool ShowServiceFlowCatalog => CanEditServices && ShowFlowServices;
    private bool ShowAnyFlowCatalog => ShowSourceFlowCatalog || ShowDestinationFlowCatalog || ShowServiceFlowCatalog;
    private List<NetworkObject> nwObjects = [];
    private List<NetworkService> nwServices = [];
    private List<FlowNwObject> flowNwObjects = [];
    private List<FlowSvcObject> flowSvcObjects = [];
    private List<FlowNwGroup> flowNwGroups = [];
    private List<FlowSvcGroup> flowSvcGroups = [];
    private bool displayDetails = false;
    private string detailsTitle = "";
    private FlowNwObject? selectedNetworkObject;
    private FlowNwGroup? selectedNetworkGroup;
    private FlowSvcObject? selectedServiceObject;
    private FlowSvcGroup? selectedServiceGroup;
    private List<NwObjectElement> networkFallback = [];
    private List<NwServiceElement> serviceFallback = [];
    private bool networkGroupMode = false;
    private bool serviceGroupMode = false;
    

    private NetworkObject? newSourceNetworkInt = null;
    private NetworkObject? newSourceNetwork
    {
        get => newSourceNetworkInt;
        set
        {
            if(value != null && value.Id != 0)
            {
                AddSelectedNetworkElement(SourcesToAdd, BuildNetworkElement(value));
            }
            newSourceNetworkInt = null;
            StateHasChanged();
        }
    }

    private NetworkObject? newDestinationNetworkInt = null;
    private NetworkObject? newDestinationNetwork
    {
        get => newDestinationNetworkInt;
        set
        {
            if(value != null && value.Id != 0)
            {
                AddSelectedNetworkElement(DestinationsToAdd, BuildNetworkElement(value));
            }
            newDestinationNetworkInt = null;
            StateHasChanged();
        }
    }

    private NetworkService? newServiceInt = null;
    private NetworkService? newService
    {
        get => newServiceInt;
        set
        {
            if(value != null && value.Id != 0)
            {
                AddSelectedServiceElement(ServicesToAdd, BuildServiceElement(value));
            }
            newServiceInt = null;
            StateHasChanged();
        }
    }

    private string DisplayNetworkObject(NwObjectElement element)
    {
        if (!string.IsNullOrWhiteSpace(element.GroupName))
        {
            return element.GroupName;
        }
        string? catalogName = nwObjects.FirstOrDefault(nwObject => IsMatchingNetworkObject(nwObject, element))?.Name;
        if (!string.IsNullOrWhiteSpace(catalogName))
        {
            return catalogName;
        }
        if (!string.IsNullOrWhiteSpace(element.Name))
        {
            return element.Name;
        }
        return element.FlowNetworkObjectId?.ToString()
            ?? element.FlowNetworkGroupId?.ToString()
            ?? element.NetworkId?.ToString()
            ?? "";
    }

    private string DisplayNetworkElementForCatalog(NwObjectElement element)
    {
        return HasNetworkObjectReference(element)
            ? DisplayNetworkObject(element)
            : DisplayNetworkElement(element);
    }

    private string DisplayNetworkService(NwServiceElement element)
    {
        if (!string.IsNullOrWhiteSpace(element.GroupName))
        {
            return element.GroupName;
        }
        string? catalogName = nwServices.FirstOrDefault(service => IsMatchingNetworkService(service, element))?.Name;
        if (!string.IsNullOrWhiteSpace(catalogName))
        {
            return catalogName;
        }
        if (!string.IsNullOrWhiteSpace(element.Name))
        {
            return element.Name;
        }
        return element.FlowServiceObjectId?.ToString()
            ?? element.FlowServiceGroupId?.ToString()
            ?? element.ServiceId?.ToString()
            ?? "";
    }

    private string DisplayServiceElement(NwServiceElement element)
    {
        if (!string.IsNullOrEmpty(element.GroupName))
        {
            return element.GroupName;
        }
        if (!string.IsNullOrWhiteSpace(element.Name))
        {
            return element.Name;
        }
        return DisplayBase.DisplayService(element, IpProtos);
    }

    private string DisplayServiceElementForCatalog(NwServiceElement element)
    {
        return HasServiceObjectReference(element)
            ? DisplayNetworkService(element)
            : DisplayServiceElement(element);
    }

    private static string DisplayNetworkElement(NwObjectElement element)
    {
        if (!string.IsNullOrWhiteSpace(element.GroupName))
        {
            return element.GroupName;
        }
        if (!string.IsNullOrWhiteSpace(element.Name))
        {
            return element.Name;
        }
        return NwObjDisplay.DisplayIp(element.IpString, element.IpEndString);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (NeedsFlowCatalog())
            {
                await LoadFlowCatalogData();
            }
            InitComplete = true;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("fetch_data"), "", true);
        }
    }

    private async Task LoadFlowCatalogData()
    {
        if (NeedsNetworkFlowCatalog() || NeedsNetworkDetails())
        {
            await LoadNetworkCatalogData();
        }
        if (NeedsServiceFlowCatalog() || NeedsServiceDetails())
        {
            await LoadServiceCatalogData();
        }
        if (NeedsNetworkDetails())
        {
            flowNwGroups = await apiConnection.SendQueryAsync<List<FlowNwGroup>>(FlowQueries.getFlowAddressGroups) ?? [];
        }
        if (NeedsServiceDetails())
        {
            flowSvcGroups = await apiConnection.SendQueryAsync<List<FlowSvcGroup>>(FlowQueries.getFlowServiceGroups) ?? [];
        }
    }

    private async Task LoadNetworkCatalogData()
    {
        flowNwObjects = await apiConnection.SendQueryAsync<List<FlowNwObject>>(FlowQueries.getFlowRequestNwObjectCatalog) ?? [];
        if (NeedsNetworkFlowCatalog())
        {
            nwObjects = [.. flowNwObjects.Where(IsSelectable).Select(ToNetworkObject)];
        }
    }

    private async Task LoadServiceCatalogData()
    {
        flowSvcObjects = await apiConnection.SendQueryAsync<List<FlowSvcObject>>(FlowQueries.getFlowRequestSvcObjectCatalog) ?? [];
        if (NeedsServiceFlowCatalog())
        {
            nwServices = [.. flowSvcObjects.Where(IsSelectable).Select(ToNetworkService)];
        }
    }

    private NwObjectElement BuildNetworkElement(NetworkObject networkObject)
    {
        NwObjectElement element = new()
        {
            NetworkId = userConfig.ReqUseFlowDb ? null : networkObject.Id,
            FlowNetworkObjectId = userConfig.ReqUseFlowDb ? networkObject.FlowNetworkObjectId ?? networkObject.Id : null,
            Name = networkObject.Name,
            TaskId = TaskId
        };
        if (!string.IsNullOrWhiteSpace(networkObject.IP))
        {
            element.IpString = networkObject.IP;
        }
        if (!string.IsNullOrWhiteSpace(networkObject.IpEnd))
        {
            element.IpEndString = networkObject.IpEnd;
        }
        return element;
    }

    private static void AddSelectedNetworkElement(List<NwObjectElement> elementsToAdd, NwObjectElement element)
    {
        elementsToAdd.Add(element);
    }

    private NwServiceElement BuildServiceElement(NetworkService networkService)
    {
        return new()
        {
            ServiceId = userConfig.ReqUseFlowDb ? null : networkService.Id,
            FlowServiceObjectId = userConfig.ReqUseFlowDb ? networkService.FlowServiceObjectId ?? networkService.Id : null,
            Name = networkService.Name,
            Port = networkService.DestinationPort,
            PortEnd = networkService.DestinationPortEnd,
            ProtoId = networkService.ProtoId ?? 0,
            TaskId = TaskId
        };
    }

    private static void AddSelectedServiceElement(List<NwServiceElement> elementsToAdd, NwServiceElement element)
    {
        elementsToAdd.Add(element);
    }

    private static bool HasNetworkObjectReference(NwObjectElement element)
    {
        return HasId(element.NetworkId) || HasNetworkFlowReference(element);
    }

    private static bool HasServiceObjectReference(NwServiceElement element)
    {
        return HasId(element.ServiceId) || HasServiceFlowReference(element);
    }

    private bool NeedsFlowCatalog()
    {
        return NeedsNetworkFlowCatalog() || NeedsServiceFlowCatalog();
    }

    private bool NeedsNetworkFlowCatalog()
    {
        return userConfig.ReqUseFlowDb
            && (ShowFlowObjects && (CanEditSources || CanEditDestinations)
                || Sources.Any(HasNetworkFlowReference)
                || Destinations.Any(HasNetworkFlowReference));
    }

    private bool NeedsServiceFlowCatalog()
    {
        return userConfig.ReqUseFlowDb
            && (ShowFlowServices && CanEditServices
                || Services.Any(HasServiceFlowReference));
    }

    private static bool HasNetworkFlowReference(NwObjectElement element)
    {
        return HasId(element.FlowNetworkObjectId) || HasId(element.FlowNetworkGroupId);
    }

    private static bool HasServiceFlowReference(NwServiceElement element)
    {
        return HasId(element.FlowServiceObjectId) || HasId(element.FlowServiceGroupId);
    }

    private string ElementOrigin(NwObjectElement element)
    {
        if (HasNetworkFlowReference(element))
        {
            return userConfig.GetText("FromFlowDb");
        }
        return IsFromAnotherTicketTask(element.TaskId) || IsNetworkElementFromTicket(element)
            || IsGroupFromTicket(element.GroupName ?? element.Name)
            ? userConfig.GetText("from_ticket")
            : userConfig.GetText("Manually");
    }

    private string ElementOrigin(NwServiceElement element)
    {
        if (HasServiceFlowReference(element))
        {
            return userConfig.GetText("FromFlowDb");
        }
        return IsFromAnotherTicketTask(element.TaskId) || IsServiceElementFromTicket(element)
            || IsGroupFromTicket(element.GroupName ?? element.Name)
            ? userConfig.GetText("from_ticket")
            : userConfig.GetText("Manually");
    }

    private bool IsFromAnotherTicketTask(long elementTaskId)
    {
        return elementTaskId != 0
            && TicketTasks.Any(task => task.Id == elementTaskId && task.Id != TaskId);
    }

    private bool IsGroupFromTicket(string? groupName)
    {
        return !string.IsNullOrWhiteSpace(groupName)
            && TicketTasks.Any(task => IsNetworkGroupTask(task) && IsGroupTaskForName(task, groupName));
    }

    private bool IsNetworkElementFromTicket(NwObjectElement element)
    {
        return TicketTasks
            .Where(task => task.Id != TaskId)
            .SelectMany(task => task.GetNwObjectElements(ElemFieldType.source)
                .Concat(task.GetNwObjectElements(ElemFieldType.destination)))
            .Any(taskElement => MatchesNetworkElement(taskElement, element)
                || string.Equals(taskElement.Name?.Trim(), element.Name?.Trim(), StringComparison.OrdinalIgnoreCase)
                    && string.Equals(taskElement.IpString, element.IpString, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(taskElement.IpEndString, element.IpEndString, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsServiceElementFromTicket(NwServiceElement element)
    {
        return TicketTasks
            .Where(task => task.Id != TaskId)
            .SelectMany(task => task.GetServiceElements())
            .Any(taskElement => MatchesServiceElement(taskElement, element)
                || string.Equals(taskElement.Name?.Trim(), element.Name?.Trim(), StringComparison.OrdinalIgnoreCase)
                    && taskElement.Port == element.Port
                    && taskElement.PortEnd == element.PortEnd
                    && taskElement.ProtoId == element.ProtoId);
    }

    private bool NeedsNetworkDetails()
    {
        return !EditMode && userConfig.ReqUseFlowDb
            && (Sources.Any(element => NeedsNetworkDetails(element, ElemFieldType.source))
                || Destinations.Any(element => NeedsNetworkDetails(element, ElemFieldType.destination)));
    }

    private bool NeedsNetworkDetails(NwObjectElement element, ElemFieldType field)
    {
        return HasNetworkFlowReference(element) || IsNetworkGroupElement(element, field);
    }

    private bool NeedsServiceDetails()
    {
        return !EditMode && userConfig.ReqUseFlowDb && Services.Any(NeedsServiceDetails);
    }

    private bool NeedsServiceDetails(NwServiceElement element)
    {
        return HasServiceFlowReference(element) || IsServiceGroupElement(element);
    }

    private void ShowNetworkDetails(NwObjectElement element, ElemFieldType field)
    {
        networkGroupMode = IsNetworkGroupElement(element, field);
        selectedNetworkObject = HasId(element.FlowNetworkObjectId)
            ? flowNwObjects.FirstOrDefault(flowObject => flowObject.Id == element.FlowNetworkObjectId)
            : null;
        string groupName = element.GroupName ?? element.Name ?? "";
        selectedNetworkGroup = HasId(element.FlowNetworkGroupId)
            ? flowNwGroups.FirstOrDefault(group => group.Id == element.FlowNetworkGroupId)
            : flowNwGroups.FirstOrDefault(group => string.Equals(group.Name, groupName, StringComparison.OrdinalIgnoreCase));
        networkFallback = MatchingNetworkElements(element, field);
        string? localGroupName = selectedNetworkGroup?.Name ?? element.GroupName ?? element.Name;
        networkFallback.AddRange(GetLocalGroupElements(localGroupName));
        selectedServiceObject = null;
        selectedServiceGroup = null;
        serviceFallback = [];
        serviceGroupMode = false;
        detailsTitle = DisplayNetworkElement(element);
        displayDetails = true;
    }

    private void ShowServiceDetails(NwServiceElement element)
    {
        selectedServiceObject = HasId(element.FlowServiceObjectId)
            ? flowSvcObjects.FirstOrDefault(flowObject => flowObject.Id == element.FlowServiceObjectId)
            : null;
        string groupName = element.GroupName ?? element.Name ?? "";
        selectedServiceGroup = HasId(element.FlowServiceGroupId)
            ? flowSvcGroups.FirstOrDefault(group => group.Id == element.FlowServiceGroupId)
            : flowSvcGroups.FirstOrDefault(group => string.Equals(group.Name, groupName, StringComparison.OrdinalIgnoreCase));
        serviceFallback = MatchingServiceElements(element);
        string? localGroupName = selectedServiceGroup?.Name ?? element.GroupName ?? element.Name;
        serviceFallback.AddRange(GetLocalServiceGroupElements(localGroupName));
        serviceGroupMode = IsServiceGroupElement(element);
        selectedNetworkObject = null;
        selectedNetworkGroup = null;
        networkFallback = [];
        networkGroupMode = false;
        detailsTitle = DisplayServiceElement(element);
        displayDetails = true;
    }

    private List<NwObjectElement> MatchingNetworkElements(NwObjectElement element, ElemFieldType field)
    {
        List<NwObjectElement> matches = [element];
        if (!HasNetworkFlowReference(element) && !HasId(element.NetworkId) && string.IsNullOrWhiteSpace(element.GroupName))
        {
            return matches;
        }
        matches.AddRange(TicketTasks.SelectMany(task => task.GetNwObjectElements(field))
            .Where(taskElement => MatchesNetworkElement(taskElement, element)));
        return matches;
    }

    private List<NwObjectElement> GetLocalGroupElements(string? groupName)
    {
        if (string.IsNullOrWhiteSpace(groupName))
        {
            return [];
        }

        List<WfReqTask> groupTasks = [.. TicketTasks
            .Where(IsNetworkGroupTask)
            .Where(task => IsGroupTaskForName(task, groupName))];
        return [.. groupTasks
            // Group-definition tasks store address members in the canonical source field,
            // regardless of whether the group is used as source or destination in an access task.
            .SelectMany(task => task.GetNwObjectElements(ElemFieldType.source))];
    }

    private static bool IsNetworkGroupTask(WfReqTask task)
    {
        return task.TaskType is nameof(WfTaskType.group_create) or nameof(WfTaskType.group_modify);
    }

    private static bool IsGroupTaskForName(WfReqTask task, string groupName, ElemFieldType? field = null)
    {
        if (!IsNetworkGroupTask(task))
        {
            return false;
        }

        string normalizedGroupName = groupName.Trim();
        return string.Equals(task.GetAddInfoValue(AdditionalInfoKeys.GrpName).Trim(), normalizedGroupName, StringComparison.OrdinalIgnoreCase)
            || task.Elements.Any(element => (!field.HasValue || element.Field == field.Value.ToString())
                && (string.Equals(element.GroupName?.Trim(), normalizedGroupName, StringComparison.OrdinalIgnoreCase)
                || string.Equals(element.Name?.Trim(), normalizedGroupName, StringComparison.OrdinalIgnoreCase)));
    }

    private List<NwServiceElement> MatchingServiceElements(NwServiceElement element)
    {
        List<NwServiceElement> matches = [element];
        if (!HasServiceFlowReference(element) && !HasId(element.ServiceId) && string.IsNullOrWhiteSpace(element.GroupName))
        {
            return matches;
        }
        matches.AddRange(TicketTasks
            .SelectMany(task => task.GetServiceElements())
            .Where(taskElement => MatchesServiceElement(taskElement, element)));
        return matches;
    }

    private List<NwServiceElement> GetLocalServiceGroupElements(string? groupName)
    {
        if (string.IsNullOrWhiteSpace(groupName))
        {
            return [];
        }

        List<WfReqTask> groupTasks = [.. TicketTasks
            .Where(IsNetworkGroupTask)
            .Where(task => IsGroupTaskForName(task, groupName, ElemFieldType.service))];
        return [.. groupTasks
            .SelectMany(task => task.GetServiceElements())];
    }

    private static bool MatchesNetworkElement(NwObjectElement taskElement, NwObjectElement element)
    {
        return HasId(element.FlowNetworkObjectId) && taskElement.FlowNetworkObjectId == element.FlowNetworkObjectId
            || HasId(element.FlowNetworkGroupId) && taskElement.FlowNetworkGroupId == element.FlowNetworkGroupId
            || HasId(element.NetworkId) && taskElement.NetworkId == element.NetworkId
            || !string.IsNullOrWhiteSpace(element.GroupName)
                && string.Equals(taskElement.GroupName?.Trim(), element.GroupName?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private bool IsNetworkGroupElement(NwObjectElement element, ElemFieldType field)
    {
        return HasId(element.FlowNetworkGroupId)
            || !string.IsNullOrWhiteSpace(element.GroupName)
            || TicketTasks.Any(task => (task.TaskType is nameof(WfTaskType.group_create) or nameof(WfTaskType.group_modify))
                && IsGroupTaskForName(task, element.Name ?? "", field));
    }

    private static bool MatchesServiceElement(NwServiceElement taskElement, NwServiceElement element)
    {
        return HasId(element.FlowServiceObjectId) && taskElement.FlowServiceObjectId == element.FlowServiceObjectId
            || HasId(element.FlowServiceGroupId) && taskElement.FlowServiceGroupId == element.FlowServiceGroupId
            || HasId(element.ServiceId) && taskElement.ServiceId == element.ServiceId
            || !string.IsNullOrWhiteSpace(element.GroupName)
                && string.Equals(taskElement.GroupName?.Trim(), element.GroupName?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private bool IsServiceGroupElement(NwServiceElement element)
    {
        return HasId(element.FlowServiceGroupId)
            || !string.IsNullOrWhiteSpace(element.GroupName)
            || TicketTasks.Any(task => IsNetworkGroupTask(task)
                && string.Equals(task.GetAddInfoValue(AdditionalInfoKeys.GrpName).Trim(), element.Name?.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private Task SetDisplayDetails(bool display)
    {
        displayDetails = display;
        return Task.CompletedTask;
    }

    private static bool HasId(long? id)
    {
        return id.HasValue && id.Value != 0;
    }

    private static bool ShowsFlowDbSelection(string selection)
    {
        return selection is FlowIntegrationObjectSelectionOptions.FromFlowDb or FlowIntegrationObjectSelectionOptions.Both;
    }

    private static bool ShowsManualSelection(string selection)
    {
        return selection is FlowIntegrationObjectSelectionOptions.Manually or FlowIntegrationObjectSelectionOptions.Both;
    }

    private static bool IsMatchingNetworkObject(NetworkObject networkObject, NwObjectElement element)
    {
        return HasId(element.FlowNetworkObjectId) && networkObject.FlowNetworkObjectId == element.FlowNetworkObjectId
            || HasId(element.NetworkId) && networkObject.Id == element.NetworkId;
    }

    private static bool IsMatchingNetworkService(NetworkService networkService, NwServiceElement element)
    {
        return HasId(element.FlowServiceObjectId) && networkService.FlowServiceObjectId == element.FlowServiceObjectId
            || HasId(element.ServiceId) && networkService.Id == element.ServiceId;
    }

    private static bool IsSelectable(FlowNwObject nwObject)
    {
        return FlowObjectEligibility.IsRequestable(nwObject);
    }

    private static bool IsSelectable(FlowSvcObject svcObject)
    {
        return FlowObjectEligibility.IsRequestable(svcObject);
    }

    private static NetworkObject ToNetworkObject(FlowNwObject nwObject)
    {
        return new()
        {
            Id = nwObject.Id,
            Name = nwObject.Name ?? BuildNetworkObjectName(nwObject),
            IP = nwObject.IpStart ?? "",
            IpEnd = nwObject.IpEnd ?? "",
            FlowNetworkObjectId = nwObject.Id
        };
    }

    private NetworkService ToNetworkService(FlowSvcObject svcObject)
    {
        return new()
        {
            Id = svcObject.Id,
            Name = !string.IsNullOrWhiteSpace(svcObject.Name) ? svcObject.Name : BuildServiceObjectName(svcObject),
            DestinationPort = svcObject.PortStart,
            DestinationPortEnd = svcObject.PortEnd,
            ProtoId = svcObject.ProtoId,
            FlowServiceObjectId = svcObject.Id
        };
    }

    private static string BuildNetworkObjectName(FlowNwObject nwObject)
    {
        return string.IsNullOrWhiteSpace(nwObject.IpEnd) || nwObject.IpEnd == nwObject.IpStart
            ? nwObject.IpStart ?? ""
            : $"{nwObject.IpStart}-{nwObject.IpEnd}";
    }

    private string BuildServiceObjectName(FlowSvcObject svcObject)
    {
        string portLabel = svcObject.PortEnd.HasValue && svcObject.PortEnd != svcObject.PortStart
            ? $"{svcObject.PortStart}-{svcObject.PortEnd}"
            : $"{svcObject.PortStart}";
        string protocolLabel = IpProtos.FirstOrDefault(protocol => protocol.Id == svcObject.ProtoId)?.Name ?? $"{svcObject.ProtoId}";
        return $"{portLabel}/{protocolLabel}";
    }

    private void DeleteSource(NwObjectElement obj)
    {
        Sources.Remove(obj);
        StateHasChanged();
    }

    private void DeleteDestination(NwObjectElement obj)
    {
        Destinations.Remove(obj);
        StateHasChanged();
    }

    private void DeleteService(NwServiceElement obj)
    {
        Services.Remove(obj);
        StateHasChanged();
    }
}
