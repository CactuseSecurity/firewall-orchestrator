@using System.Globalization
@using FWO.Data.Workflow

@inject UserConfig userConfig

@if (ShowTargetBeginDate || ShowTargetEndDate)
{
    <div class="@LayoutClass">
        @if (ShowTargetBeginDate)
        {
            <div class="@DateColumnClass">
                <div class="form-group row mt-2">
                    <label class="@DateLabelClass col-form-label col-form-label-sm">@(userConfig.GetText("valid_from")):</label>
                    <div class="@DateValueClass">
                        @if (CanEditTargetBeginDate && (ShowManualTimeObjectSelection || ForceManualTimeObjectSelection))
                        {
                            <TimeInputFields Value="@TargetBeginDate" ValueChanged="HandleTargetBeginDateChanged"
                                ValidChanged="HandleTargetBeginDateValidChanged" InputValid="@targetBeginDateValid"
                                Precision="@ActiveTimeObjectPrecision" DefaultStartTimeInput="@DefaultStartTimeInput"
                                DefaultEndTimeInput="@DefaultEndTimeInput" DateInputId="@BeginDateInputId"
                                TimeInputId="@BeginTimeInputId" HourInputId="@BeginHourInputId" />
                        }
                        else
                        {
                            <label class="col-sm-12 h-100 border bg-secondary">@FormatDateTimeDisplay(TargetBeginDate, isEndDate: false)</label>
                        }
                    </div>
                </div>
            </div>
        }
        @if (ShowTargetEndDate)
        {
            <div class="@DateColumnClass">
                <div class="form-group row mt-2">
                    <label class="@DateLabelClass col-form-label col-form-label-sm">@(userConfig.GetText("valid_to")):</label>
                    <div class="@DateValueClass">
                        @if (CanEditTargetEndDate && (ShowManualTimeObjectSelection || ForceManualTimeObjectSelection))
                        {
                            <TimeInputFields Value="@TargetEndDate" ValueChanged="HandleTargetEndDateChanged"
                                ValidChanged="HandleTargetEndDateValidChanged" InputValid="@EndDateInputValid"
                                Precision="@ActiveTimeObjectPrecision" IsEndValue="true" DisplayEndDateAsInclusive="true"
                                DefaultStartTimeInput="@DefaultStartTimeInput" DefaultEndTimeInput="@DefaultEndTimeInput"
                                DateInputId="@EndDateInputId" TimeInputId="@EndTimeInputId" HourInputId="@EndHourInputId" />
                        }
                        else
                        {
                            <label class="col-sm-12 h-100 border bg-secondary">@FormatDateTimeDisplay(TargetEndDate, isEndDate: true)</label>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code
{
    [Parameter]
    public DateTime? TargetBeginDate { get; set; }

    [Parameter]
    public EventCallback<DateTime?> TargetBeginDateChanged { get; set; }

    [Parameter]
    public DateTime? TargetEndDate { get; set; }

    [Parameter]
    public EventCallback<DateTime?> TargetEndDateChanged { get; set; }

    [Parameter]
    public bool CanEditTargetBeginDate { get; set; }

    [Parameter]
    public bool CanEditTargetEndDate { get; set; }

    [Parameter]
    public bool ShowTargetBeginDate { get; set; } = true;

    [Parameter]
    public bool ShowTargetEndDate { get; set; } = true;

    [Parameter]
    public EventCallback<bool> TargetDatesValidChanged { get; set; }

    [Parameter]
    public bool FullWidthLayout { get; set; }

    /// <summary>
    /// Bootstrap column class used by the validity labels.
    /// </summary>
    [Parameter]
    public string DateLabelClass { get; set; } = "col-sm-4";

    /// <summary>
    /// Bootstrap column class used by the validity input values.
    /// </summary>
    [Parameter]
    public string DateValueClass { get; set; } = "col-sm-8";

    /// <summary>
    /// Allows a dedicated object-task editor to enter validity dates even when normal request-task
    /// time-object selection is restricted to the Flow DB.
    /// </summary>
    [Parameter]
    public bool ForceManualTimeObjectSelection { get; set; }

    [Parameter]
    public string DefaultStartTimeInput { get; set; } = kDefaultBeginTime;

    [Parameter]
    public string DefaultEndTimeInput { get; set; } = kDefaultEndTime;

    [Parameter]
    public bool ValidateDateOrder { get; set; }

    [Parameter]
    public string? BeginDateInputId { get; set; }

    [Parameter]
    public string? BeginTimeInputId { get; set; }

    [Parameter]
    public string? BeginHourInputId { get; set; }

    [Parameter]
    public string? EndDateInputId { get; set; }

    [Parameter]
    public string? EndTimeInputId { get; set; }

    [Parameter]
    public string? EndHourInputId { get; set; }

    private const string kDefaultBeginTime = "00:00:00";
    private const string kDefaultEndTime = "23:59:59";

    private bool targetBeginDateValid = true;
    private bool targetEndDateValid = true;
    private DateTime? displayedTargetBeginDate;
    private DateTime? displayedTargetEndDate;
    private FlowIntegrationConfig ActiveFlowIntegration => FlowIntegrationConfig.Parse(userConfig.ReqFlowIntegration);
    private string ActiveTimeObjectPrecision => ActiveFlowIntegration.TimeObjectPrecision.Trim().ToLowerInvariant();
    private bool ShowManualTimeObjectSelection => !userConfig.ReqUseFlowDb || ActiveFlowIntegration.SelectTimeObjects is
        FlowIntegrationObjectSelectionOptions.Manually or FlowIntegrationObjectSelectionOptions.Both;
    private string LayoutClass => FullWidthLayout ? "d-flex flex-column w-100" : "row";
    private string DateColumnClass => FullWidthLayout ? "w-100 flex-shrink-0" : "col-sm-3";
    private bool DateOrderValid => !ValidateDateOrder || !TargetBeginDate.HasValue || !TargetEndDate.HasValue
        || TargetBeginDate <= TargetEndDate;
    private bool EndDateInputValid => targetEndDateValid && DateOrderValid;

    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    protected override void OnParametersSet()
    {
        if (TargetBeginDate != displayedTargetBeginDate)
        {
            targetBeginDateValid = true;
            displayedTargetBeginDate = TargetBeginDate;
        }
        if (TargetEndDate != displayedTargetEndDate)
        {
            targetEndDateValid = true;
            displayedTargetEndDate = TargetEndDate;
        }
    }

    private async Task HandleTargetBeginDateChanged(DateTime? value)
    {
        await TargetBeginDateChanged.InvokeAsync(value);
    }

    private async Task HandleTargetEndDateChanged(DateTime? value)
    {
        await TargetEndDateChanged.InvokeAsync(value);
    }

    private async Task HandleTargetBeginDateValidChanged(bool valid)
    {
        targetBeginDateValid = valid;
        await NotifyTargetDatesValid();
    }

    private async Task HandleTargetEndDateValidChanged(bool valid)
    {
        targetEndDateValid = valid;
        await NotifyTargetDatesValid();
    }

    private async Task NotifyTargetDatesValid()
    {
        await TargetDatesValidChanged.InvokeAsync(targetBeginDateValid && EndDateInputValid);
    }

    private string FormatDateTimeDisplay(DateTime? dateTime, bool isEndDate)
    {
        if (!dateTime.HasValue)
        {
            return "";
        }
        try
        {
            return TimeObjectDisplayHelper.FormatValue(dateTime, ActiveTimeObjectPrecision, isEndDate, dateFormat: "dd.MM.yyyy");
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("display"), "", true);
            return SafeDateTimeDisplay(dateTime);
        }
    }

    private static string SafeDateTimeDisplay(DateTime? dateTime)
    {
        return dateTime?.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) ?? "";
    }

}
