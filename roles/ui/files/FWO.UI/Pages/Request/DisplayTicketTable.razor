@using FWO.Ui.Services

@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.WorkflowRolesList}, {Roles.Auditor}")]

@inject UserConfig userConfig

@* read-only users can open the request dialog, only requesters and admins can save it *@
@if(Phase == WorkflowPhases.request && CanOpenChangeDialogs())
{
    <button type="button" class="btn btn-success m-2" @onclick="AddTicket">@(DisplayService.DisplayButton(userConfig, "add_new_request", Icons.Add))</button>
}

<div class="m-2 vheight75">
    <Table class="table table-bordered th-bg-secondary th-bg-secondary sticky-header bs-overflow" TableItem="WfTicket" Items="WfHandler.TicketList" PageSize="0" ColumnReorder="true">
        <Column TableItem="WfTicket" Title="@(userConfig.GetText("actions"))" Field="(x => x.Id)" Sortable="false" Filterable="false">
            <Template>
                <div class="btn-group">
                    @if (CanEditTicketInPhase(context))
                    {
                        <button type="button" class="btn btn-sm btn-warning" @onclick="async () => await EditTicket(context)">@(DisplayService.DisplayButton(userConfig, "edit", Icons.Edit))</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="async () => await ShowTicketDetails(context)">@(DisplayService.DisplayButton(userConfig, "details", Icons.Display))</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary" @onclick="async () => await ShowTicketDetails(context)">@(DisplayService.DisplayButton(userConfig, "details", Icons.Display))</button>
                    }
                </div>
            </Template>
        </Column>
        <Column TableItem="WfTicket" Title="@(userConfig.GetText("id"))" Field="@(x => x.Id)" Sortable="true" Filterable="true" />
        <Column TableItem="WfTicket" Title="@(userConfig.GetText("title"))" Field="@(x => x.Title)" Sortable="true" Filterable="true" />
        <Column TableItem="WfTicket" Title="@(userConfig.GetText("tasks"))" Field="@(x => x.Id)" Sortable="true" Filterable="false" >
            <Template>
                @if(Phase < WorkflowPhases.implementation)
                {
                    @(context.Tasks.Count)
                }
                else
                {
                    @(context.NumberImplTasks())
                }
            </Template>
        </Column>
        @if (TicketFieldVisibility.ShowRequester)
        {
            <Column TableItem="WfTicket" Title="@(userConfig.GetText("requester"))" Field="@(x => x.Requester)" Sortable="true" Filterable="true" >
                <Template>
                    @(context.Requester?.Name)
                </Template>
            </Column>
        }
        <Column TableItem="WfTicket" Title="@(userConfig.GetText("state"))" Field="@(x => x.StateId)" Sortable="true" Filterable="false" >
            <Template>
                @(States.GetName(context.StateId))
            </Template>
        </Column>
        @if (TicketFieldVisibility.ShowPriority)
        {
            <Column TableItem="WfTicket" Title="@(userConfig.GetText("priority"))" Field="@(x => x.Priority)" Sortable="true" Filterable="false" >
                <Template>
                    @(WfHandler.PrioList.FirstOrDefault(x => x.NumPrio == context.Priority)?.Name)
                </Template>
            </Column>
        }
        @if (TicketFieldVisibility.ShowDeadline)
        {
            <Column TableItem="WfTicket" Title="@(userConfig.GetText("deadline"))" Field="@(x => x.Deadline)" Sortable="true" Filterable="true" />
        }
        @if (TicketFieldVisibility.HandlerDisplayMode != TicketHandlerDisplayMode.None)
        {
            <Column TableItem="WfTicket" Title="@(userConfig.GetText("current_handlers"))" Field="@(x => x.Id)" Sortable="false" Filterable="false">
                <Template>
                    @(DisplayHandlers(context))
                </Template>
            </Column>
        }
        <Column TableItem="WfTicket" Title="@(userConfig.GetText("created"))" Field="@(x => x.CreationDate)" Sortable="true" Filterable="true" />
        @if (Overview)
        {
            <Column TableItem="WfTicket" Title="@(userConfig.GetText("closed"))" Field="@(x => x.CompletionDate)" Sortable="true" Filterable="true" />
        }
    </Table>
</div>

<DisplayTicket Phase="Phase" States="States" WfHandler="WfHandler" ResetParent="Reset" OpenApprovalTaskDetails="openApprovalTaskDetails"
    StartPhase="StartPhase" StartImplPhase="StartImplPhase"/>


@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;
    
    [Parameter]
    public WorkflowPhases Phase { get; set; } = WorkflowPhases.request;

    [Parameter]
    public WfStateDict States { get; set; } = new ();

    [Parameter]
    public WfHandler WfHandler { get; set; } = new ();

    [Parameter]
    public Func<Task> ResetParent { get; set; } = DefaultInit.DoNothing;

    [Parameter]
    public Func<WfReqTask, Task> StartPhase { get; set; } = DefaultInit.DoNothing;

    [Parameter]
    public Func<WfImplTask, Task> StartImplPhase { get; set; } = DefaultInit.DoNothing;

    /// <summary>
    /// A ticket overview only displays tickets, also to users who could change them elsewhere.
    /// </summary>
    [Parameter]
    public bool Overview { get; set; } = false;


    private async Task Reset()
    {
        openApprovalTaskDetails = false;
        WfHandler.ResetTicketActions();
        await ResetParent();
        StateHasChanged();
    }

    private async Task ShowTicketDetails(WfTicket ticket)
    {
        openApprovalTaskDetails = false;
        await WfHandler.SelectTicket(ticket, ObjAction.display, true);
    }

    private async Task AddTicket()
    {
        openApprovalTaskDetails = false;
        await WfHandler.SelectTicket(new (){ Requester = userConfig.User }, ObjAction.add);
    }

    private async Task EditTicket(WfTicket ticket)
    {
        openApprovalTaskDetails = UseTaskDetailsView;
        await WfHandler.SelectTicket(ticket, ObjAction.edit, true);
    }

    private TicketFieldVisibilityConfig TicketFieldVisibility => TicketFieldVisibilityConfig.Parse(userConfig.ReqTicketFieldVisibility);

    private string DisplayHandlers(WfTicket ticket)
    {
        IEnumerable<UiUser?> handlers = TicketFieldVisibility.HandlerDisplayMode == TicketHandlerDisplayMode.CurrentPhase
            ? GetCurrentPhaseHandlers(ticket)
            : GetAllActiveTaskHandlers(ticket);

        return string.Join(", ", handlers
            .Where(handler => handler != null)
            .GroupBy(HandlerKey)
            .Select(group => group.First()!.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name)));
    }

    private IEnumerable<UiUser?> GetCurrentPhaseHandlers(WfTicket ticket)
    {
        foreach (WfReqTask task in ticket.Tasks.Where(IsInCurrentPhase))
        {
            if (Phase < WorkflowPhases.implementation)
            {
                yield return task.CurrentHandler;
            }
            else
            {
                foreach (WfImplTask implTask in task.ImplementationTasks.Where(IsInCurrentPhase))
                {
                    yield return implTask.CurrentHandler;
                }
            }
        }
    }

    private IEnumerable<UiUser?> GetAllActiveTaskHandlers(WfTicket ticket)
    {
        foreach (WfReqTask task in ticket.Tasks.Where(task => task.StateId < WfHandler.MasterStateMatrix.MinTicketCompleted))
        {
            yield return task.CurrentHandler;
            foreach (WfImplTask implTask in task.ImplementationTasks)
            {
                yield return implTask.CurrentHandler;
            }
        }
    }

    private bool IsInCurrentPhase(WfStatefulObject statefulObject)
    {
        StateMatrix matrix = WfHandler.StateMatrix(
            statefulObject is WfReqTask task ? task.TaskType : ((WfImplTask)statefulObject).TaskType);
        return statefulObject.StateId >= matrix.LowestInputState && statefulObject.StateId < matrix.LowestEndState;
    }

    private static string HandlerKey(UiUser? handler)
    {
        return handler?.DbId > 0
            ? $"id:{handler.DbId}"
            : $"dn:{handler?.Dn ?? handler?.Name ?? ""}";
    }

    /// <summary>
    /// Checks whether the dialogs for changing tickets are offered: on a phase page also to read-only users,
    /// who only lack the right to save, but never on an overview.
    /// </summary>
    private bool CanOpenChangeDialogs()
    {
        return !Overview || !WfHandler.ReadOnlyMode;
    }

    /// <summary>
    /// Checks whether the ticket is open for changes in this phase. Read-only users open it in the same dialog,
    /// where saving stays reserved to the phase roles. In the request phase, users who may save only get it for tickets
    /// they may change.
    /// </summary>
    private bool CanEditTicketInPhase(WfTicket ticket)
    {
        return CanOpenChangeDialogs()
            && (Phase != WorkflowPhases.request || ticket.Editable || WfHandler.ReadOnlyMode)
            && ticket.StateId >= WfHandler.MasterStateMatrix.LowestInputState
            && ticket.StateId < WfHandler.MasterStateMatrix.LowestEndState;
    }

    private bool UseTaskDetailsView => (Phase == WorkflowPhases.approval
        && userConfig.ReqApprovalEditMode == ApprovalEditMode.AccessTaskView)
        || (Phase == WorkflowPhases.planning
        && userConfig.ReqPlannerEditMode == PlannerEditMode.PlanningView);

    private bool openApprovalTaskDetails;
}
