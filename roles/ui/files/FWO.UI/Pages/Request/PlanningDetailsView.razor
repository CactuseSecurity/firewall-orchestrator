@using FWO.Data.Workflow
@using FWO.Data
@using FWO.Ui.Services
@using FWO.Ui.Pages.Request

@inject UserConfig userConfig
@inject ApiConnection apiConnection

<PopUp Title="@PlanningViewTitle" Show="@Display" Size="@(ListView ? PopupSize.FullScreen : PopupSize.XLarge)" OnClose="ClosePopup">
    <Body>
        @if (Display && ListView)
        {
            <CascadingValue Value="@CreateTaskViewContext()">
                <PlanningTaskListView WfHandler="WfHandler" States="States" ResetParent="Reset"
                    AddImplementationTask="OpenImplementationTaskCreation"
                    DeleteImplementationTask="OpenDeleteConfirmation"
                    PerformRequestTaskAction="PerformRequestTaskGroupAction" />
            </CascadingValue>
        }
        else if (Display)
        {
            @foreach (List<WfReqTask> taskGroup in TaskGroups())
            {
                WfReqTask requestTask = taskGroup[0];
                <div class="mb-1">
                    <Collapse @key="requestTask.Id" StartToggled="false" Style="secondary" UseHtmlTitle="true"
                              TitleWithHtml="@RequestTaskHeader(taskGroup)" ContentClass="p-1">
                        <div>
                            @if (RequestTaskDetailsExpanded(requestTask))
                            {
                                <div class="ms-2 mb-1">
                                    <CascadingValue Value="@CreateTaskViewContext()">
                                        @if (IsAccessTask(requestTask))
                                        {
                                            <ApprovalTaskAccessBody Task="requestTask" TaskGroup="taskGroup" />
                                        }
                                        else if (IsGroupTask(requestTask))
                                        {
                                            <ApprovalGroupTaskBody Task="requestTask" TaskGroup="taskGroup" />
                                        }
                                        else if (requestTask.TaskType == WfTaskType.generic.ToString())
                                        {
                                            <ApprovalGenericTaskBody Task="requestTask" TaskGroup="taskGroup" />
                                        }
                                        else if (requestTask.TaskType == WfTaskType.new_interface.ToString())
                                        {
                                            <ApprovalInterfaceTaskBody Task="requestTask" TaskGroup="taskGroup" />
                                        }
                                        else
                                        {
                                            <ApprovalObjectTaskBody Task="requestTask" TaskGroup="taskGroup" />
                                        }
                                    </CascadingValue>
                                </div>
                            }
                            @* the implementation tasks of a bundle usually belong to its first task; each is edited on its own request task *@
                            @foreach (WfReqTask implementedTask in ImplementedTasks(taskGroup))
                            {
                                <div class="ms-2" @key="implementedTask.Id">
                                    <PlanningImplementationTaskDetails ImplementationTasks="implementedTask.ImplementationTasks"
                                        RequestTask="implementedTask" WfHandler="WfHandler" States="States" Phase="@Phase" ResetParent="Reset"
                                        DeleteImplementationTask="@OpenDeleteConfirmation" />
                                </div>
                            }
                        </div>
                    </Collapse>
                </div>
            }
        }
    </Body>
    <Footer>
        <WorkflowTaskDetailsFooter OfferedActions="OfferedActions"
            CanShowAction="CanShowOfferedAction"
            PerformAction="PerformTicketAction"
            CanPromoteTicket="CanPromoteTicket"
            PromoteTicket="PromoteTicket"
            ShowCancel="ShowCancel"
            Close="Close" />
    </Footer>
</PopUp>
<PlanningImplementationTaskCreationView @bind-Display="displayImplementationTaskCreation"
    RequestTask="@creationRequestTask" ImplementationTask="@creationImplementationTask"
    WfHandler="WfHandler" States="States" Phase="@Phase" ResetParent="Reset" />
<DeleteObject @bind-Display="WfHandler.DisplayDeleteImplTaskMode" ResetParent="Reset"
    Delete="WfHandler.ConfDeleteImplTask" ObjectName="@WfHandler.ActImplTask.Title" />
<OwnerEditor @bind-Display="editorService.displayOwnerEditor" SelectedOwner="editorService.selectedOwner"
    Owners="editorService.OwnerOptions()" Saved="SaveOwner" />

@code
{
    [Parameter] public bool Display { get; set; }
    [Parameter] public EventCallback<bool> DisplayChanged { get; set; }
    [Parameter] public WfHandler WfHandler { get; set; } = new();
    [Parameter] public WfStateDict States { get; set; } = new();
    [Parameter] public WorkflowPhases Phase { get; set; } = WorkflowPhases.planning;
    [Parameter] public IReadOnlyList<WfStateAction> OfferedActions { get; set; } = [];
    [Parameter] public Func<WfStateAction, Task> PerformTicketAction { get; set; } = _ => Task.CompletedTask;
    [Parameter] public bool CanPromoteTicket { get; set; }
    [Parameter] public Func<Task> PromoteTicket { get; set; } = DefaultInit.DoNothing;
    [Parameter] public bool ShowCancel { get; set; }
    [Parameter] public Func<Task> ResetParent { get; set; } = DefaultInit.DoNothing;
    [Parameter] public Func<Task> Closed { get; set; } = DefaultInit.DoNothing;
    /// <summary>Shows every request and implementation task as one table row instead of one card per task.</summary>
    [Parameter] public bool ListView { get; set; }

    private readonly ApprovalTaskDetailsEditorService editorService = new();
    private readonly HashSet<long> collapsedRequestTaskDetails = [];
    private long collapsedDetailsTicketId = -1;
    private bool displayImplementationTaskCreation;
    private WfReqTask creationRequestTask = new();
    private WfImplTask creationImplementationTask = new();

    protected override async Task OnInitializedAsync()
    {
        editorService.Configure(WfHandler, userConfig, ResetParent);
        editorService.ReadOnlyDisplay = true;
        editorService.PlannerOwnerChangesAllowed = userConfig.ReqAllowOwnerChangesByPlanner;
        await editorService.InitializeAsync(apiConnection);
    }

    protected override void OnParametersSet()
    {
        if (!Display)
        {
            collapsedDetailsTicketId = -1;
            collapsedRequestTaskDetails.Clear();
            return;
        }

        if (WfHandler.ActTicket.Id == collapsedDetailsTicketId)
        {
            return;
        }

        collapsedDetailsTicketId = WfHandler.ActTicket.Id;
        collapsedRequestTaskDetails.Clear();
        foreach (WfReqTask requestTask in WfHandler.ActTicket.Tasks)
        {
            collapsedRequestTaskDetails.Add(requestTask.Id);
        }
    }

    private ApprovalTaskViewContext CreateTaskViewContext()
    {
        editorService.Configure(WfHandler, userConfig, ResetParent);
        editorService.PlannerOwnerChangesAllowed = userConfig.ReqAllowOwnerChangesByPlanner;
        return editorService.CreateTaskViewContext();
    }

    private Task SaveOwner(FwoOwner owner) => editorService.SaveOwner(owner);

    private bool CanShowOfferedAction(WfStateAction action)
    {
        return WfHandler.CanPerformActionOnActTicket(action)
            && (!WfHandler.ReadOnlyMode || WfStateAction.IsReadonlyType(action.ActionType));
    }

    /// <summary>
    /// The request tasks, bundled tasks displayed as one forming one group; as in the access task view, access tasks
    /// come first, otherwise the tasks are in id order.
    /// </summary>
    private List<List<WfReqTask>> TaskGroups() => ApprovalTaskDetailsEditorService.AccessTasksFirst(
        ApprovalTaskBundleHelper.GroupTasks(WfHandler.ActTicket.Tasks.OrderBy(task => task.Id), userConfig));

    /// <summary>The tasks of a group whose implementation tasks are shown; a single task is always shown.</summary>
    private static IEnumerable<WfReqTask> ImplementedTasks(List<WfReqTask> taskGroup) => taskGroup.Count == 1
        ? taskGroup
        : taskGroup.Where(task => task.ImplementationTasks.Count > 0);

    private static bool IsAccessTask(WfReqTask task) => ApprovalTaskDetailsEditorService.IsAccessTask(task);

    private static bool IsGroupTask(WfReqTask task) => ApprovalTaskDetailsEditorService.IsGroupTask(task);

    private bool RequestTaskDetailsExpanded(WfReqTask requestTask) => !collapsedRequestTaskDetails.Contains(requestTask.Id);

    private bool CanMutateRequestTask(WfReqTask requestTask) => WorkflowTaskActions.CanChangeRequestTasks(WfHandler, [requestTask]);

    private void ToggleRequestTaskDetails(WfReqTask requestTask)
    {
        if (!collapsedRequestTaskDetails.Add(requestTask.Id))
        {
            collapsedRequestTaskDetails.Remove(requestTask.Id);
        }
    }

    private async Task Close()
    {
        await DisplayChanged.InvokeAsync(false);
        await Closed();
    }

    private void ClosePopup() => _ = Close();

    /// <summary>The configured request task actions; for a bundle displayed as one they apply to all its tasks.</summary>
    private RenderFragment RequestTaskActionButtons(IReadOnlyList<WfReqTask> taskGroup) =>
        WorkflowTaskActions.Buttons(WorkflowTaskActions.VisibleForRequestTasks(WfHandler, taskGroup),
            action => PerformRequestTaskGroupAction(taskGroup, action));

    /// <summary>Performs a configured action on all tasks of a bundle displayed as one, then reloads the ticket and resets the view.</summary>
    private async Task PerformRequestTaskGroupAction(IReadOnlyList<WfReqTask> taskGroup, WfStateAction action)
    {
        await WorkflowTaskActions.PerformOnRequestTasks(WfHandler, action, taskGroup);
        await Reset();
    }

    private async Task Reset()
    {
        WfHandler.ResetImplTaskActions();
        await ResetParent();
    }

    private async Task OpenImplementationTaskCreation(WfReqTask requestTask)
    {
        if (!CanMutateRequestTask(requestTask))
        {
            return;
        }
        // a merged bundle request task is a transient copy; the new task belongs to the first bundled task with its id
        WfReqTask ownerTask = WfHandler.ActTicket.Tasks.FirstOrDefault(task => task.Id == requestTask.Id) ?? requestTask;
        WfHandler.SelectReqTask(ownerTask, ObjAction.display);
        WfImplTask implementationTask = new(requestTask, false)
        {
            TaskNumber = ownerTask.HighestImplTaskNumber() + 1,
            ManagementId = requestTask.ManagementId
        };
        WfHandler.SelectImplTask(implementationTask, ObjAction.add);
        creationRequestTask = requestTask;
        creationImplementationTask = WfHandler.ActImplTask;
        displayImplementationTaskCreation = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenDeleteConfirmation(WfImplTask implementationTask)
    {
        if (!CanMutateImplementationTask(implementationTask))
        {
            return;
        }
        WfHandler.SelectImplTaskPopUp(implementationTask, ObjAction.displayDelete);
        await InvokeAsync(StateHasChanged);
    }

    private bool CanMutateImplementationTask(WfImplTask implementationTask)
    {
        WfReqTask? requestTask = WfHandler.ActTicket.Tasks.FirstOrDefault(task =>
            task.ImplementationTasks.Any(candidate =>
                ReferenceEquals(candidate, implementationTask)
                || (implementationTask.Id != 0 && candidate.Id == implementationTask.Id)));
        return requestTask != null
            && CanMutateRequestTask(requestTask)
            && WfHandler.CanActOnImplTaskInCurrentPhase(implementationTask);
    }

    private string PlanningViewTitle => TaskDetailsViewTitle.Build(userConfig, WfHandler.ActTicket, States);

    private RenderFragment RequestTaskHeader(List<WfReqTask> taskGroup) => builder =>
    {
        WfReqTask requestTask = taskGroup[0];
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "d-flex align-items-center flex-wrap gap-2");
        builder.OpenElement(2, "small");
        builder.AddAttribute(3, "class", "text-dark mr-2 text-nowrap");
        builder.AddContent(4, $"{userConfig.GetText("id")}: {ApprovalTaskDetailsEditorService.TaskIds(taskGroup)}");
        builder.CloseElement();
        builder.AddContent(5, RequestTaskActionButtons(taskGroup));
        builder.OpenElement(6, "strong");
        builder.AddAttribute(7, "class", "mr-2");
        builder.AddContent(8, string.IsNullOrWhiteSpace(requestTask.Title) ? userConfig.GetText("task") : requestTask.Title);
        builder.CloseElement();
        if (taskGroup.Count > 1)
        {
            builder.OpenElement(24, "span");
            builder.AddAttribute(25, "class", "badge badge-secondary");
            builder.AddContent(26, taskGroup.Count);
            builder.CloseElement();
        }
        builder.OpenElement(9, "span");
        builder.AddAttribute(10, "class", "ms-auto");
        builder.AddContent(11, States.GetName(requestTask.StateId));
        builder.CloseElement();
        builder.OpenElement(12, "button");
        builder.AddAttribute(13, "type", "button");
        builder.AddAttribute(14, "class", "btn btn-sm btn-light ml-2");
        builder.AddAttribute(15, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this,
            () => ToggleRequestTaskDetails(requestTask)));
        builder.AddEventStopPropagationAttribute(16, "onclick", true);
        builder.AddContent(17, DisplayService.DisplayButton(userConfig, "details",
            RequestTaskDetailsExpanded(requestTask) ? Icons.CollapseUp : Icons.CollapseDown));
        builder.CloseElement();
        if (WorkflowTaskActions.CanChangeRequestTasks(WfHandler, taskGroup))
        {
            builder.OpenElement(18, "button");
            builder.AddAttribute(19, "type", "button");
            builder.AddAttribute(20, "class", "btn btn-sm btn-success ml-2");
            builder.AddAttribute(21, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this,
                () => OpenImplementationTaskCreation(ApprovalTaskBundleHelper.CreationRequestTask(taskGroup))));
            builder.AddEventStopPropagationAttribute(22, "onclick", true);
            builder.AddContent(23, DisplayService.DisplayButtonWithTooltip(userConfig, "add", Icons.Add,
                userConfig.GetText("implementation")));
            builder.CloseElement();
        }
        builder.CloseElement();
    };
}

