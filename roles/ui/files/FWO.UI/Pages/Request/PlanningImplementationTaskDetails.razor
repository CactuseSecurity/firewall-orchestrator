@using FWO.Ui.Services
@using FWO.Ui.Display
@using Microsoft.AspNetCore.Components.Rendering
@using FWO.Data.Flow
@using FWO.Ui.Shared

@inject UserConfig userConfig
@inject ApiConnection apiConnection

@if (ImplementationTasks.Count > 0)
{
    @foreach (WfImplTask implementationTask in ImplementationTasks.OrderBy(task => task.Id))
    {
        string timeRestriction = TimeRestriction(implementationTask);
        <div>
            <Collapse @key="implementationTask.Id" StartToggled="@(!IsInitiallyExpanded)" Style="secondary" HeaderClass="bg-secondary-subtle text-dark" Class="mb-1"
                      UseHtmlTitle="true" TitleWithHtml="@ImplementationTaskHeader(implementationTask)">
                <div class="card-body">
                    @if (IsRuleImplementationTask(implementationTask))
                    {
                        <div class="form-group row">
                            @ReadOnlyValue(userConfig.GetText("management"), ManagementName(implementationTask),
                                edit: CanEditImplementationTask(implementationTask) ? () => OpenManagementEditor(implementationTask) : null)
                            @ReadOnlyValue(userConfig.GetText("device"), DeviceName(implementationTask),
                                edit: CanEditImplementationTask(implementationTask) ? () => OpenDeviceEditor(implementationTask) : null)
                            @if (ShowsFreeText(implementationTask))
                            {
                                @ReadOnlyValue(userConfig.GetText("free_text"), implementationTask.FreeText ?? "", "col-xl-6 col-lg-6 mb-2",
                                    CanEditImplementationTask(implementationTask) && CanEditFreeText(implementationTask) ? () => OpenFreeTextEditor(implementationTask) : null)
                            }
                        </div>
                    }
                    else if (WfObjectTaskHelper.IsManagementObjectTask(implementationTask.TaskType))
                    {
                        <div class="form-group row">
                            @ReadOnlyValue(userConfig.GetText("management"), ManagementName(implementationTask),
                                edit: CanEditImplementationTask(implementationTask) ? () => OpenManagementEditor(implementationTask) : null)
                        </div>
                    }
                    else if (implementationTask.TaskType == WfTaskType.new_interface.ToString())
                    {
                        <div class="form-group row">
                            @ReadOnlyValue(userConfig.GetText("owner"), OwnerName(), "col-xl-6 col-lg-6 mb-2")
                            @if (!string.IsNullOrWhiteSpace(WfHandler.GetRequestingOwner()))
                            {
                                @ReadOnlyValue(userConfig.GetText("requesting_owner"), WfHandler.GetRequestingOwner(), "col-xl-6 col-lg-6 mb-2")
                            }
                        </div>
                    }
                    @if (!IsRuleImplementationTask(implementationTask) && ShowsFreeText(implementationTask))
                    {
                        <div class="form-group row">
                            @ReadOnlyValue(userConfig.GetText("free_text"), implementationTask.FreeText ?? "", "col-xl-6 col-lg-6 mb-2",
                                CanEditImplementationTask(implementationTask) && CanEditFreeText(implementationTask) ? () => OpenFreeTextEditor(implementationTask) : null)
                        </div>
                    }
                    <div class="form-group row">
                    @if (IsRuleTask(implementationTask))
                    {
                        @ReadOnlyValue(userConfig.GetText("rule_action"), RuleActionName(implementationTask))
                        @ReadOnlyValue(userConfig.GetText("track"), TrackingName(implementationTask))
                    }
                    @if (!string.IsNullOrWhiteSpace(timeRestriction))
                    {
                        @ReadOnlyValue(userConfig.GetText("time_restriction"), timeRestriction, cssClass: "col-xl-6 col-lg-6 mb-2")
                    }
                    </div>
                    @if (implementationTask.TaskType == WfTaskType.access.ToString()
                        || implementationTask.TaskType == WfTaskType.rule_modify.ToString())
                    {
                        <div class="form-group row">
                            @ReadOnlyValue(userConfig.GetText("rule_position"),
                                RulePositionDisplayHelper.Format(implementationTask.RulePosition, userConfig), "col-12")
                        </div>
                        <div class="form-group row mt-2">
                            @ImplementationElementValue(userConfig.GetText("source"), implementationTask, ElemFieldType.source)
                            @ImplementationElementValue(userConfig.GetText("destination"), implementationTask, ElemFieldType.destination)
                            @ImplementationElementValue(userConfig.GetText("services"), implementationTask, ElemFieldType.service)
                        </div>
                    }
                    else if (implementationTask.TaskType == WfTaskType.group_create.ToString()
                        || implementationTask.TaskType == WfTaskType.group_modify.ToString())
                    {
                        <div class="form-group row">
                            @ReadOnlyValue(userConfig.GetText("name"), GroupName(implementationTask), "col-xl-6 col-lg-6 mb-2",
                                CanEditImplementationTask(implementationTask) ? () => OpenNameEditor(implementationTask) : null)
                        </div>
                        <div class="form-group row">
                            @ImplementationMembersValue(implementationTask)
                        </div>
                    }
                    else if (implementationTask.TaskType == WfTaskType.rule_delete.ToString())
                    {
                        <div class="form-group row">
                            @ReadOnlyValue(userConfig.GetText("rule_uid"), RuleUid(implementationTask), "col-xl-6 col-lg-6 mb-2")
                        </div>
                    }
                    else if (WfObjectTaskHelper.IsObjectTask(implementationTask.TaskType)
                        && !IsTimeObjectTask(implementationTask))
                    {
                        <div class="form-group row">
                            <div class="col-12">
                                <DisplayObjectTaskElement ReqTask="@CreateEditorTask(implementationTask)"
                                    IsModify="false" EditMode="false" DisplayIpProtos="ipProtocols">
                                    <ObjectNamePrefix>
                                        @if (CanEditImplementationTask(implementationTask))
                                        {
                                            <button type="button" class="btn btn-sm btn-secondary mr-2"
                                                @onclick="() => OpenNameEditor(implementationTask)">
                                                @(DisplayService.DisplayButton(userConfig, "edit", Icons.Edit))
                                            </button>
                                        }
                                    </ObjectNamePrefix>
                                </DisplayObjectTaskElement>
                            </div>
                        </div>
                    }
                </div>
            </Collapse>
        </div>
    }
}

<PlanningImplTaskEditors Editor="Editor" />

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    [Parameter] public List<WfImplTask> ImplementationTasks { get; set; } = [];
    [Parameter] public WfReqTask RequestTask { get; set; } = new();
    [Parameter] public WfHandler WfHandler { get; set; } = new();
    [Parameter] public WfStateDict States { get; set; } = new();
    [Parameter] public WorkflowPhases Phase { get; set; } = WorkflowPhases.planning;
    [Parameter] public Func<Task> ResetParent { get; set; } = DefaultInit.DoNothing;
    [Parameter] public bool CreationMode { get; set; }
    [Parameter] public Func<WfImplTask, Task> DeleteImplementationTask { get; set; } = _ => Task.CompletedTask;

    private List<RuleAction> ruleActions = [];
    private List<Tracking> trackings = [];
    private PlanningImplTaskEditor? editor;
    private List<IpProtocol> ipProtocols = [];
    private const int kMaxDisplayedElements = PlanningImplTaskDisplayLogic.kMaxDisplayedElements;
    private PlanningImplTaskDisplayLogic ImplLogic => new(WfHandler, userConfig, ruleActions, trackings, ipProtocols);
    private AccessTaskFieldVisibilityConfig accessVisibility = new();

    /// <summary>Editor of management, device, free text and name; in creation mode the changes stay in the new task.</summary>
    private PlanningImplTaskEditor Editor => editor ??= new(new PlanningImplTaskEditorCallbacks
    {
        WfHandler = () => WfHandler,
        DisplayLogic = () => ImplLogic,
        CanEdit = (implementationTask, _) => CanEditImplementationTask(implementationTask),
        Save = SaveImplementationTask,
        Refresh = () => InvokeAsync(StateHasChanged)
    });
    private bool IsInitiallyExpanded => CreationMode || RequestTask.TaskType == WfTaskType.access.ToString();

    /// <summary>Parses the configured field visibility once, as it is applied to the time restriction of every implementation task.</summary>
    protected override void OnParametersSet()
    {
        accessVisibility = TicketFieldVisibilityConfig.Parse(userConfig.ReqTicketFieldVisibility).AccessTask;
    }

    /// <summary>Loads the rule actions, trackings and protocols displayed for the implementation tasks.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            ruleActions = await apiConnection.SendQueryAsync<List<RuleAction>>(StmQueries.getRuleActions);
            trackings = await apiConnection.SendQueryAsync<List<Tracking>>(StmQueries.getTracking);
            List<IpProtocol> protocols = await apiConnection.SendQueryAsync<List<IpProtocol>>(StmQueries.getIpProtocols);
            ipProtocols = ProtocolDisplayHelper.CustomSortProtocols(protocols, null, false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("fetch_data"), "", true);
        }
    }

    /// <summary>Opens the management editor of an implementation task of the request task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private Task OpenManagementEditor(WfImplTask implementationTask) => Editor.OpenManagement(implementationTask, RequestTask);

    /// <summary>Opens the free text editor of an implementation task of the request task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private Task OpenFreeTextEditor(WfImplTask implementationTask) => Editor.OpenFreeText(implementationTask, RequestTask);

    /// <summary>Opens the name editor of a group, object or time object implementation task of the request task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private Task OpenNameEditor(WfImplTask implementationTask) => Editor.OpenName(implementationTask, RequestTask);

    /// <summary>Opens the device editor of a rule implementation task of the request task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private Task OpenDeviceEditor(WfImplTask implementationTask) => Editor.OpenDevice(implementationTask, RequestTask);

    /// <summary>
    /// Creates a request task holding the elements of an implementation task for the request task editors; for object
    /// tasks only the first created or modified element.
    /// </summary>
    /// <param name="implementationTask">The implementation task.</param>
    private static WfReqTask CreateEditorTask(WfImplTask implementationTask)
    {
        IEnumerable<WfImplElement> elements = implementationTask.ImplElements;
        if (WfObjectTaskHelper.IsObjectTask(implementationTask.TaskType))
        {
            List<WfImplElement> requestedElements = implementationTask.ImplElements
                .Where(element => element.ImplAction == RequestAction.create.ToString()
                    || element.ImplAction == RequestAction.modify.ToString())
                .Take(1)
                .ToList();
            if (requestedElements.Count > 0)
            {
                elements = requestedElements;
            }
        }

        WfReqTask editorTask = new()
        {
            Id = implementationTask.Id,
            TaskType = implementationTask.TaskType,
            Elements = elements.Select(ToRequestElement).ToList()
        };
        return editorTask;
    }

    /// <summary>Converts an implementation element into a request element.</summary>
    /// <param name="element">The implementation element.</param>
    private static WfReqElement ToRequestElement(WfImplElement element)
    {
        return new WfReqElement
        {
            Id = element.Id,
            TaskId = element.ImplTaskId,
            Field = element.Field,
            RequestAction = element.ImplAction,
            IpString = element.IpString,
            IpEnd = element.IpEnd,
            Port = element.Port,
            PortEnd = element.PortEnd,
            ProtoId = element.ProtoId,
            NetworkId = element.NetworkId,
            ServiceId = element.ServiceId,
            FlowNetworkObjectId = element.FlowNetworkObjectId,
            FlowNetworkGroupId = element.FlowNetworkGroupId,
            FlowServiceObjectId = element.FlowServiceObjectId,
            FlowServiceGroupId = element.FlowServiceGroupId,
            GroupName = element.GroupName ?? "",
            Name = element.Name,
            ObjectTaskId = element.ObjectTaskId,
            StartTime = element.StartTime,
            EndTime = element.EndTime,
            TimeObjId = element.TimeObjId,
            FlowTimeObjectId = element.FlowTimeObjectId
        };
    }

    /// <summary>Renders the members of a group implementation task, each with its change badge; a placeholder if there are none.</summary>
    /// <param name="implementationTask">The group implementation task.</param>
    private RenderFragment ImplementationMembersValue(WfImplTask implementationTask) => builder =>
    {
        List<PlanningImplElementRow> members = ImplLogic.GroupMemberRows(implementationTask);

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "col-12 d-flex align-items-start");
        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "col-form-label col-form-label-sm mr-2 mb-2 text-nowrap");
        builder.AddAttribute(4, "style", "min-width: 10rem;");
        builder.AddContent(5, userConfig.GetText("members") + ":");
        builder.CloseElement();
        builder.OpenElement(6, "div");
        builder.AddAttribute(7, "class", "list-group flex-grow-1");
        if (members.Count == 0)
        {
            AddMemberListRow(builder, "-", "");
        }
        else
        {
            foreach (PlanningImplElementRow member in members)
            {
                AddMemberListRow(builder, MemberDisplay(member), member.Action);
            }
        }
        builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>Shows a member as "name (content)"; the content is omitted if it repeats the name in any case.</summary>
    private static string MemberDisplay(PlanningImplElementRow member) =>
        string.Equals(member.Name, member.Content, StringComparison.OrdinalIgnoreCase)
            ? member.Name
            : TaskListHelper.NameWithDetail(member.Name, member.Content);

    /// <summary>Adds a member row, with a badge marking it as added, removed or unchanged if an action is given.</summary>
    /// <param name="builder">The render tree builder.</param>
    /// <param name="value">The displayed member.</param>
    /// <param name="action">The member action; empty for no badge.</param>
    private void AddMemberListRow(RenderTreeBuilder builder, string value, string action)
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "list-group-item border bg-secondary d-flex align-items-start");
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "class", "border bg-secondary px-2 py-1 d-inline-block flex-grow-1 text-break");
        builder.AddContent(4, value);
        builder.CloseElement();
        if (!string.IsNullOrWhiteSpace(action))
        {
            TaskListBadge badge = TaskListHelper.MemberChangeBadge(action, userConfig);
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", $"badge {badge.CssClass} ml-2 text-nowrap");
            builder.AddAttribute(7, "style", "min-width: 7rem;");
            builder.AddContent(8, badge.Text);
            builder.CloseElement();
        }
        builder.CloseElement();
    }

    /// <summary>Saves the edited task; in creation mode it only replaces the new task, which is saved by the creation view.</summary>
    private async Task SaveImplementationTask()
    {
        if (CreationMode)
        {
            int index = ImplementationTasks.FindIndex(task => task.TaskNumber == WfHandler.ActImplTask.TaskNumber);
            if (index >= 0)
            {
                ImplementationTasks[index] = new WfImplTask(WfHandler.ActImplTask);
            }
            await InvokeAsync(StateHasChanged);
            return;
        }
        await WfHandler.ChangeImplTask();
        await ResetParent();
    }

    /// <summary>Returns the title of an implementation task: the management of management object tasks, otherwise the device.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private string ImplementationTaskTitle(WfImplTask implementationTask)
    {
        if (WfObjectTaskHelper.IsManagementObjectTask(implementationTask.TaskType))
        {
            return ManagementName(implementationTask);
        }

        string deviceName = DeviceName(implementationTask);
        return string.IsNullOrWhiteSpace(deviceName)
            ? userConfig.GetText("implementation")
            : deviceName;
    }

    /// <summary>Renders the header line of an implementation task: id, configured actions (not in creation mode), title, state and a delete button if the task may be changed.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private RenderFragment ImplementationTaskHeader(WfImplTask implementationTask) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "d-flex align-items-center flex-wrap gap-2");
        builder.OpenElement(2, "small");
        builder.AddAttribute(3, "class", "text-dark mr-2 text-nowrap");
        builder.AddContent(4, $"{userConfig.GetText("id")}: {implementationTask.Id}");
        builder.CloseElement();
        if (!CreationMode)
        {
            builder.AddContent(5, ImplementationTaskActionButtons(implementationTask));
        }
        builder.OpenElement(6, "strong");
        builder.AddAttribute(7, "class", "mr-2");
        builder.AddContent(8, ImplementationTaskTitle(implementationTask));
        builder.CloseElement();
        builder.OpenElement(9, "span");
        builder.AddAttribute(10, "class", "ms-auto");
        builder.AddContent(11, States.GetName(implementationTask.StateId));
        builder.CloseElement();
        if (!CreationMode && CanEditImplementationTask(implementationTask))
        {
            builder.OpenElement(12, "button");
            builder.AddAttribute(13, "type", "button");
            builder.AddAttribute(14, "class", "btn btn-sm btn-danger ml-2");
            builder.AddAttribute(15, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this,
                () => DeleteImplementationTask(implementationTask)));
            builder.AddEventStopPropagationAttribute(16, "onclick", true);
            builder.AddContent(17, DisplayService.DisplayButton(userConfig, "delete", Icons.Delete));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    /// <summary>Renders the buttons of the configured actions of an implementation task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private RenderFragment ImplementationTaskActionButtons(WfImplTask implementationTask) =>
        WorkflowTaskActions.Buttons(WorkflowTaskActions.VisibleForImplementationTask(WfHandler, implementationTask, RequestTask),
            action => PerformImplementationTaskAction(implementationTask, action));

    /// <summary>Performs a configured action on an implementation task, then reloads the ticket and resets the parent, also if the action fails.</summary>
    private async Task PerformImplementationTaskAction(WfImplTask implementationTask, WfStateAction action)
    {
        try
        {
            await WorkflowTaskActions.PerformOnImplementationTask(WfHandler, action, implementationTask, RequestTask);
        }
        finally
        {
            await ResetParent();
        }
    }

    /// <summary>Returns the name of the rule action of an implementation task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private string RuleActionName(WfImplTask implementationTask) => ImplLogic.RuleActionName(implementationTask);

    /// <summary>Returns the name of the tracking of an implementation task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private string TrackingName(WfImplTask implementationTask) => ImplLogic.TrackingName(implementationTask);

    /// <summary>Returns whether the task orders a time object.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private static bool IsTimeObjectTask(WfImplTask implementationTask) => PlanningImplTaskDisplayLogic.IsTimeObjectTask(implementationTask);

    /// <summary>Returns whether the task is implemented on a device: a rule task or a rule delete task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private static bool IsRuleImplementationTask(WfImplTask implementationTask) => PlanningImplTaskDisplayLogic.IsRuleImplementationTask(implementationTask);

    /// <summary>Returns whether the task creates or changes a rule.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private static bool IsRuleTask(WfImplTask implementationTask) => PlanningImplTaskDisplayLogic.IsRuleTask(implementationTask);

    /// <summary>Returns whether the free text field is shown: if the free text is displayed anyway or the user may add one.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private bool ShowsFreeText(WfImplTask implementationTask) =>
        PlanningImplTaskDisplayLogic.ShowsFreeText(implementationTask, CanEditImplementationTask(implementationTask));

    /// <summary>Returns whether the planner may change the free text; management object tasks keep it.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private static bool CanEditFreeText(WfImplTask implementationTask) => PlanningImplTaskDisplayLogic.CanEditFreeText(implementationTask);

    /// <summary>A new implementation task only needs a changeable request task, an existing one must be changeable itself.</summary>
    private bool CanEditImplementationTask(WfImplTask implementationTask) => CreationMode
        ? WorkflowTaskActions.CanChangeRequestTasks(WfHandler, [RequestTask])
        : WorkflowTaskActions.CanChangeImplementationTask(WfHandler, implementationTask, RequestTask);

    /// <summary>Returns the uid of the rule deleted by a rule delete task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private static string RuleUid(WfImplTask implementationTask) => PlanningImplTaskDisplayLogic.RuleUid(implementationTask);

    /// <summary>Returns the name of the management of an implementation task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private string ManagementName(WfImplTask implementationTask) => ImplLogic.ManagementName(implementationTask, RequestTask);

    /// <summary>Returns the group name of a group task, falling back to the group name ordered by the request task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private string GroupName(WfImplTask implementationTask) => PlanningImplTaskDisplayLogic.GroupName(implementationTask, RequestTask);

    /// <summary>Returns the first owner of the request task; empty if it has none.</summary>
    private string OwnerName()
    {
        return RequestTask.Owners.FirstOrDefault()?.Owner.Display() ?? "";
    }

    /// <summary>Returns the name of the device of an implementation task.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private string DeviceName(WfImplTask implementationTask) => ImplLogic.DeviceName(implementationTask, RequestTask);

    /// <summary>Renders the source, destination or service elements of an implementation task as a name and content table.</summary>
    /// <param name="label">The label of the field.</param>
    /// <param name="implementationTask">The implementation task.</param>
    /// <param name="field">The element field.</param>
    private RenderFragment ImplementationElementValue(string label, WfImplTask implementationTask, ElemFieldType field) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "col-xl-4 col-lg-6 mb-2");
        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "d-flex align-items-start mb-1");
        builder.OpenElement(4, "label");
        builder.AddAttribute(5, "class", "col-form-label col-form-label-sm mr-2 mb-0 text-nowrap");
        builder.AddAttribute(6, "style", "min-width: 10rem;");
        builder.AddContent(7, label + ":");
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(13, "div");
        builder.AddAttribute(14, "class", "border bg-secondary d-block text-break");
        builder.OpenElement(15, "table");
        builder.AddAttribute(16, "class", "table table-sm table-borderless mb-0");
        builder.OpenElement(17, "thead");
        builder.OpenElement(18, "tr");
        AddTableHeader(builder, 19, "name");
        AddTableHeader(builder, 21, "content");
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(27, "tbody");
        AddElementRows(builder, ElementRows(implementationTask, field));
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>Returns the displayed elements of a field: services, or the network objects of source or destination.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    /// <param name="field">The element field.</param>
    private List<PlanningImplElementRow> ElementRows(WfImplTask implementationTask, ElemFieldType field) => field == ElemFieldType.service
        ? ImplLogic.ServiceDisplayRows(implementationTask)
        : ImplLogic.NetworkDisplayRows(implementationTask, field);

    /// <summary>Adds the displayed element rows: a placeholder if there are none, otherwise the first elements and a truncation row.</summary>
    private static void AddElementRows(RenderTreeBuilder builder, List<PlanningImplElementRow> elements)
    {
        if (elements.Count == 0)
        {
            AddEmptyTableRow(builder, 29, 2);
        }
        foreach (PlanningImplElementRow element in elements.Take(kMaxDisplayedElements))
        {
            AddTableRow(builder, element.Name, element.Content);
        }
        AddTruncationRow(builder, elements.Count);
    }

    /// <summary>Adds a localized header cell.</summary>
    /// <param name="builder">The render tree builder.</param>
    /// <param name="sequence">The first of the two sequence numbers used.</param>
    /// <param name="textKey">The text key of the header.</param>
    private void AddTableHeader(RenderTreeBuilder builder, int sequence, string textKey)
    {
        builder.OpenElement(sequence, "th");
        builder.AddContent(sequence + 1, userConfig.GetText(textKey));
        builder.CloseElement();
    }

    /// <summary>Adds a table row with two cells.</summary>
    /// <param name="builder">The render tree builder.</param>
    /// <param name="firstValue">The value of the first cell.</param>
    /// <param name="secondValue">The value of the second cell.</param>
    private static void AddTableRow(RenderTreeBuilder builder, string firstValue, string secondValue)
    {
        builder.OpenElement(100, "tr");
        builder.OpenElement(101, "td");
        builder.AddContent(102, firstValue);
        builder.CloseElement();
        builder.OpenElement(103, "td");
        builder.AddContent(104, secondValue);
        builder.CloseElement();
        builder.CloseElement();
    }

    /// <summary>Adds a placeholder row spanning all columns.</summary>
    /// <param name="builder">The render tree builder.</param>
    /// <param name="sequence">The first of the four sequence numbers used.</param>
    /// <param name="columnCount">The number of columns spanned.</param>
    private static void AddEmptyTableRow(RenderTreeBuilder builder, int sequence, int columnCount)
    {
        builder.OpenElement(sequence, "tr");
        builder.OpenElement(sequence + 1, "td");
        builder.AddAttribute(sequence + 2, "colspan", columnCount);
        builder.AddContent(sequence + 3, "-");
        builder.CloseElement();
        builder.CloseElement();
    }

    /// <summary>Adds a row with the number of elements not displayed, if there are more than the displayed maximum.</summary>
    /// <param name="builder">The render tree builder.</param>
    /// <param name="elementCount">The number of elements.</param>
    private static void AddTruncationRow(RenderTreeBuilder builder, int elementCount)
    {
        if (elementCount <= kMaxDisplayedElements)
        {
            return;
        }
        AddTableRow(builder, "…", $"(+{elementCount - kMaxDisplayedElements})");
    }

    /// <summary>Returns the time restriction of an implementation task, leaving out the dates hidden by the configured visibility.</summary>
    /// <param name="implementationTask">The implementation task.</param>
    private string TimeRestriction(WfImplTask implementationTask) => ImplLogic.TimeRestriction(implementationTask, RequestTask, accessVisibility);

    /// <summary>Renders a labeled value, with an edit button if an edit callback is given; a placeholder for an empty value.</summary>
    /// <param name="label">The label.</param>
    /// <param name="value">The value.</param>
    /// <param name="cssClass">The CSS classes of the field.</param>
    /// <param name="edit">Opens the editor of the value; null if it cannot be edited.</param>
    private RenderFragment ReadOnlyValue(string label, string value, string cssClass = "col-xl-3 col-lg-6 mb-2", Func<Task>? edit = null) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"{cssClass} d-flex align-items-start");
        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "col-form-label col-form-label-sm mr-2 mb-0 text-nowrap");
        builder.AddAttribute(4, "style", "min-width: 10rem;");
