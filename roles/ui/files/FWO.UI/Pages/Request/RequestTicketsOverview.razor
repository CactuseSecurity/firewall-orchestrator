@using FWO.Ui.Services
@using FWO.Compliance
@using FWO.Middleware.Client
@using FWO.Api.Client

@page "/request/ticketsoverview"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}, {Roles.Requester}")]

@inject ApiConnection apiConnection
@inject UserConfig userConfig
@inject MiddlewareClient middlewareClient

<h3>@(userConfig.GetText("all_readonly"))</h3>
<hr />

@if(InitComplete && accessAllowed)
{
    <DisplayTicketTable Phase="WorkflowPhases.request" States="states" WfHandler="wfHandler" ResetParent="Reset" Overview="true"/>
}
else if(InitComplete)
{
    <div></div>
}
else
{
    <Loading/>
}

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;
    
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private WfHandler wfHandler = new ();
    private WfStateDict states = new ();
    private List<int>? OwnerIds = null;
    private bool InitComplete = false;
    private bool accessAllowed = true;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            accessAllowed = userConfig.CanUseAnyRole(Roles.Admin, Roles.Requester, Roles.Auditor);
            if (!accessAllowed)
            {
                InitComplete = true;
                return;
            }

            await states.Init(apiConnection);

            // also without owner based requests the apps decide which tickets of other requesters a user may change,
            // admins change all tickets anyway
            if (!userConfig.CanUseAnyRole(Roles.Admin))
            {
                OwnerIds = (await ModellingHandlerBase.GetResponsibleApps(authenticationStateTask!, userConfig, apiConnection, DisplayMessageInUi)).ConvertAll(x => x.Id);
            }
            wfHandler = new (DisplayMessageInUi, userConfig, authenticationStateTask!.Result.User, apiConnection, middlewareClient, WorkflowPhases.request, new ComplianceRequestedRulePolicyChecker(userConfig, apiConnection, middlewareClient)){ RestrictToResponsibleRequests = true };
            await Reset();
            InitComplete = true;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("fetch_requests"), "", true);
        }
    }

    private async Task Reset()
    {
        try
        {
            wfHandler.ReadOnlyMode = true;
            await wfHandler.Init(true, OwnerIds, true);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("init_environment"), "", true);
        }
    }
}
