@using System.Text
@using FWO.Data.DeviceSpecificSettings
@using FWO.Services.DeviceSpecificSettings

@inject ApiConnection apiConnection
@inject UserConfig userConfig
@inject GlobalConfig globalConfig
@inject IJSRuntime jsRuntime

<PopUp Title="@(userConfig.GetText("dss_snapshots"))" Show="@Display" Size=PopupSize.Large OnClose="ClosePopup" HelpPage="settings/devicespecificsettings">
    <Body>
        @if (Display)
        {
            <div class="text-muted small mb-2">@(userConfig.GetText("dss_snapshots_intro"))</div>
            <ExecutionModeAuthorizeView Roles="@Roles.Admin">
                <Authorized>
                    <div class="row g-2 mb-3 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label small" for="dss-snapshot-name">@(userConfig.GetText("name"))*:</label>
                            <input id="dss-snapshot-name" class="form-control form-control-sm" maxlength="@DeviceSpecificSettingsSnapshotSummary.kMaxNameLength" @bind="newName" />
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small" for="dss-snapshot-description">@(userConfig.GetText("description")):</label>
                            <input id="dss-snapshot-description" class="form-control form-control-sm" maxlength="@DeviceSpecificSettingsSnapshotSummary.kMaxDescriptionLength" @bind="newDescription" />
                        </div>
                        <div class="col-sm-3">
                            <button type="button" class="btn btn-sm btn-success" disabled="@(working || string.IsNullOrWhiteSpace(newName))" @onclick="AddSnapshot">
                                @(DisplayService.DisplayButton(userConfig, "dss_save_snapshot", Icons.Add))
                            </button>
                        </div>
                    </div>
                </Authorized>
            </ExecutionModeAuthorizeView>
            @if (snapshots == null)
            {
                <Loading />
            }
            else if (snapshots.Count == 0)
            {
                <div class="small">@(userConfig.GetText("dss_no_snapshots"))</div>
            }
            else
            {
                <Table class="table table-bordered table-sm th-bg-secondary table-responsive overflow-auto sticky-header"
                       TableItem="DeviceSpecificSettingsSnapshotSummary" Items="snapshots" PageSize="0">
                    <Column TableItem="DeviceSpecificSettingsSnapshotSummary" Title="@(userConfig.GetText("action"))" Field="@(snapshot => snapshot.Id)" Sortable="false" Filterable="false">
                        <Template>
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-primary" disabled="@working" @onclick="() => Apply(context)">
                                    @(DisplayService.DisplayButton(userConfig, "dss_apply_snapshot", Icons.Import))
                                </button>
                                <button type="button" class="btn btn-sm btn-primary" disabled="@working" @onclick="() => Download(context)">
                                    @(DisplayService.DisplayButton(userConfig, "download", Icons.Download))
                                </button>
                                <ExecutionModeAuthorizeView Roles="@Roles.Admin">
                                    <Authorized Context="authorized">
                                        <button type="button" class="btn btn-sm btn-danger" disabled="@working" @onclick="() => RequestDelete(context)">
                                            @(DisplayService.DisplayButton(userConfig, "delete", Icons.Delete))
                                        </button>
                                    </Authorized>
                                </ExecutionModeAuthorizeView>
                            </div>
                        </Template>
                    </Column>
                    <Column TableItem="DeviceSpecificSettingsSnapshotSummary" Title="@(userConfig.GetText("name"))" Field="@(snapshot => snapshot.Name)" Sortable="true" Filterable="true" />
                    <Column TableItem="DeviceSpecificSettingsSnapshotSummary" Title="@(userConfig.GetText("description"))" Field="@(snapshot => snapshot.Description)" Sortable="true" Filterable="true" />
                    <Column TableItem="DeviceSpecificSettingsSnapshotSummary" Title="@(userConfig.GetText("dss_fwo_version"))" Field="@(snapshot => snapshot.FwoVersion)" Sortable="true" Filterable="true" />
                    <Column TableItem="DeviceSpecificSettingsSnapshotSummary" Title="@(userConfig.GetText("created"))" Field="@(snapshot => snapshot.Created)" Sortable="true" Filterable="false">
                        <Template>@context.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</Template>
                    </Column>
                </Table>
            }
        }
    </Body>
    <Footer>
        <button type="button" class="btn btn-sm btn-secondary" disabled="@working" @onclick="Close">@(DisplayService.DisplayButton(userConfig, "close", Icons.Close))</button>
    </Footer>
</PopUp>
<ConfirmDelete @bind-Display="deleteMode" PerformAction="Delete" Title="@(userConfig.GetText("delete"))" DeleteMessage="@deleteMessage" />

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    [Parameter]
    public bool Display { get; set; }

    [Parameter]
    public EventCallback<bool> DisplayChanged { get; set; }

    /// <summary>Called with the package and name of the snapshot to apply; the caller opens the import preview.</summary>
    [Parameter]
    public EventCallback<(DeviceSpecificSettingsPackage Package, string Name)> ApplySnapshot { get; set; }

    /// <summary>Characters not allowed in file names on common client systems.</summary>
    private const string kInvalidFileNameCharacters = "\"*/:<>?\\|";

    /// <summary>Most snapshots listed, newest first.</summary>
    private const int kMaxListedSnapshots = 1000;

    private List<DeviceSpecificSettingsSnapshotSummary>? snapshots;
    private string newName = "";
    private string newDescription = "";
    private bool working;
    private bool wasDisplayed;
    private bool deleteMode;
    private string deleteMessage = "";
    private DeviceSpecificSettingsSnapshotSummary? snapshotToDelete;

    /// <summary>Reloads the list every time the dialog is opened.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Display && !wasDisplayed)
        {
            wasDisplayed = true;
            newName = "";
            newDescription = "";
            snapshots = null;
            await LoadSnapshots();
        }
        wasDisplayed = Display;
    }

    private DeviceSpecificSettingsSnapshotService SnapshotService => new(apiConnection);

    private async Task LoadSnapshots()
    {
        try
        {
            snapshots = await SnapshotService.GetSnapshotsAsync(null, kMaxListedSnapshots, 0);
        }
        catch (Exception exception)
        {
            snapshots = [];
            DisplayMessageInUi(exception, userConfig.GetText("dss_snapshots"), "", true);
        }
    }

    /// <summary>Stores the current settings as a new snapshot.</summary>
    private async Task AddSnapshot()
    {
        working = true;
        try
        {
            DeviceSpecificSettingsTransferService transferService = new(apiConnection, new DeviceSpecificSettingsManager(apiConnection), globalConfig.ProductVersion);
            DeviceSpecificSettingsExportResult export = await transferService.ExportAsync();
            await SnapshotService.AddSnapshotAsync(newName, newDescription, export.Package);
            ReportExportWarnings(export.Warnings, "dss_snapshots");
            newName = "";
            newDescription = "";
            await LoadSnapshots();
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("dss_snapshots"), userConfig.GetText("E5304"), true);
        }
        finally
        {
            working = false;
        }
    }

    /// <summary>Hands the snapshot's package to the import preview.</summary>
    private async Task Apply(DeviceSpecificSettingsSnapshotSummary snapshot)
    {
        DeviceSpecificSettingsPackage? package = await LoadPackage(snapshot);
        if (package != null)
        {
            await Close();
            await ApplySnapshot.InvokeAsync((package, snapshot.Name));
        }
    }

    /// <summary>Downloads the snapshot's package as a file that can be imported elsewhere.</summary>
    private async Task Download(DeviceSpecificSettingsSnapshotSummary snapshot)
    {
        DeviceSpecificSettingsPackage? package = await LoadPackage(snapshot);
        if (package != null)
        {
            try
            {
                byte[] content = Encoding.UTF8.GetBytes(DeviceSpecificSettingsPackageJson.Serialize(package));
                await jsRuntime.InvokeVoidAsync("DownloadFile", SnapshotFileName(snapshot.Name), "application/json", content);
            }
            catch (Exception exception)
            {
                DisplayMessageInUi(exception, userConfig.GetText("dss_snapshots"), "", true);
            }
        }
    }

    private async Task<DeviceSpecificSettingsPackage?> LoadPackage(DeviceSpecificSettingsSnapshotSummary snapshot)
    {
        try
        {
            DeviceSpecificSettingsSnapshotData data = await SnapshotService.GetSnapshotAsync(snapshot.Id)
                ?? throw new KeyNotFoundException($"Snapshot {snapshot.Id} no longer exists.");
            return DeviceSpecificSettingsPackageJson.FromStorage(data.Content);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("dss_snapshots"), "", true);
            return null;
        }
    }

    private void RequestDelete(DeviceSpecificSettingsSnapshotSummary snapshot)
    {
        snapshotToDelete = snapshot;
        deleteMessage = userConfig.GetText("U5123") + snapshot.Name + "?";
        deleteMode = true;
    }

    private async Task Delete()
    {
        if (snapshotToDelete == null)
        {
            return;
        }
        try
        {
            await SnapshotService.DeleteSnapshotAsync(snapshotToDelete.Id);
            deleteMode = false;
            snapshotToDelete = null;
            await LoadSnapshots();
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("dss_snapshots"), "", true);
        }
    }

    private void ReportExportWarnings(List<string> warnings, string titleKey)
    {
        if (warnings.Count > 0)
        {
            DisplayMessageInUi(null, userConfig.GetText(titleKey), $"{userConfig.GetText("dss_export_warnings")} {string.Join(" ", warnings)}", true);
        }
    }

    /// <summary>File name of a snapshot download: the snapshot name with characters not allowed in file names replaced.</summary>
    public static string SnapshotFileName(string snapshotName)
    {
        string safeName = string.Concat(snapshotName.Select(character =>
            character < ' ' || kInvalidFileNameCharacters.Contains(character) ? '_' : character));
        return safeName + DeviceSpecificSettingsPackageJson.kFileSuffix;
    }

    private async Task Close()
    {
        Display = false;
        wasDisplayed = false;
        await DisplayChanged.InvokeAsync(false);
    }

    private void ClosePopup() => _ = Close();
}
