@using FWO.Config.Api.Data
@using FWO.Data.Modelling
@using FWO.Ui.Services

@inject UserConfig userConfig

<div class="form-group row col-sm-12">
    <div class="col-sm-2">
        <div class="form-group row">
            <label class="col-sm-6 col-form-label col-form-label-sm">@(userConfig.GetText("id")):</label>
            <label class="col-sm-6 col-form-label col-form-label-sm">@(ActAction.Id)</label>
        </div>
    </div>
    <div class="col-sm-10">
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5512"))">
            <label class="col-sm-3 col-form-label col-form-label-sm">@(userConfig.GetText("name"))*:</label>
            <input type="text" class="col-sm-9" @bind="ActAction.Name" />
        </div>
    </div>
</div>
<div class="form-group row col-sm-12 mt-2">
    <div class="col-sm-4">
        <div class="form-group row">
            <label class="col-sm-4 col-form-label col-form-label-sm">@(userConfig.GetText("action_type"))*:</label>
            <div class="col-sm-8">
                <Dropdown ElementType="string"
                          SelectedElement="ActAction.ActionType"
                          SelectedElementChanged="OnActionTypeChanged"
                          ElementToString="@(a => userConfig.GetText(a))"
                          Elements="Enum.GetNames(typeof(StateActionTypes))">
                    <ElementTemplate Context="action">
                        @(userConfig.GetText(action))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5513"))">
            <label class="col-sm-4 col-form-label col-form-label-sm">@(userConfig.GetText("event")):</label>
            <div class="col-sm-8">
                <Dropdown ElementType="string" @bind-SelectedElement="ActAction.Event" ElementToString="@(e => userConfig.GetText(e))" Elements="SelectableEvents">
                    <ElementTemplate Context="eventt">
                        @(userConfig.GetText(eventt))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </div>
    </div>
    @if (ActAction.Event == StateActionEvents.OfferButton.ToString())
    {
        <div class="col-sm-4">
            <div class="form-group row">
                <label class="col-sm-4 col-form-label col-form-label-sm">@(userConfig.GetText("button_text")):</label>
                <input type="text" class="col-sm-8" @bind="ActAction.ButtonText" />
            </div>
        </div>
    }
</div>
<div class="form-group row col-sm-12 mt-2">
    <div class="col-sm-4">
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5514"))">
            <label class="col-sm-4 col-form-label col-form-label-sm">@(userConfig.GetText("phase")):</label>
            <div class="col-sm-8">
                <Dropdown ElementType="string"
                          SelectedElement="selectedPhase"
                          SelectedElementChanged="OnPhaseChanged"
                          ElementToString="@(p => userConfig.GetText(p))"
                          Elements="Enum.GetNames(typeof(WorkflowPhases))"
                          Nullable="true"
                          NoneSelectedText="@(userConfig.GetText("all"))">
                    <ElementTemplate Context="phase">
                        @(userConfig.GetText(phase))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5515"))">
            <label class="col-sm-4 col-form-label col-form-label-sm">@(userConfig.GetText("scope")):</label>
            <div class="col-sm-8">
                <Dropdown ElementType="string" SelectedElement="ActAction.Scope" SelectedElementChanged="OnScopeChanged" ElementToString="@(s => userConfig.GetText(s))" Elements="SelectableScopes">
                    <ElementTemplate Context="scope">
                        @(userConfig.GetText(scope))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </div>
    </div>
    @if (ActAction.Scope == WfObjectScopes.RequestTask.ToString() || ActAction.Scope == WfObjectScopes.ImplementationTask.ToString())
    {
        <div class="col-sm-4">
            <div class="form-group row">
                <label class="col-sm-4 col-form-label col-form-label-sm">@(userConfig.GetText("task_type")):</label>
                <div class="col-sm-8">
                    <Dropdown ElementType="WfTaskType?"
                              SelectedElement="selectedTaskType"
                              SelectedElementChanged="OnTaskTypeChanged"
                              ElementToString="@(t => userConfig.GetText(t?.ToString() ?? "undefined"))"
                              Elements="AvailableTaskTypes.Where(x => x != WfTaskType.master).Cast<WfTaskType?>()"
                              Nullable="true"
                              NoneSelectedText="@(userConfig.GetText("all"))">
                        <ElementTemplate Context="type">
                            @(userConfig.GetText(type?.ToString() ?? "undefined"))
                        </ElementTemplate>
                    </Dropdown>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public WfStateAction ActAction { get; set; } = new();

    [Parameter]
    public List<WfTaskType> AvailableTaskTypes { get; set; } = [];

    [Parameter]
    public EventCallback<string?> ActionTypeChanged { get; set; }

    [Parameter]
    public EventCallback<string?> ScopeChanged { get; set; }

    private string? selectedPhase;
    private WfTaskType? selectedTaskType;

    private IEnumerable<string> SelectableScopes => GetSelectableScopes()
        .Select(scope => scope.ToString());

    private IEnumerable<string> SelectableEvents => GetSelectableEvents()
        .Select(actionEvent => actionEvent.ToString());

    protected override void OnParametersSet()
    {
        selectedPhase = string.IsNullOrWhiteSpace(ActAction.Phase) ? null : ActAction.Phase;
        selectedTaskType = Enum.TryParse(ActAction.TaskType, out WfTaskType tmpTaskType)
            ? tmpTaskType
            : null;
    }

    private async Task OnActionTypeChanged(string? actionType)
    {
        await ActionTypeChanged.InvokeAsync(actionType);
        NormalizeScopeForActionType();
        NormalizeEventForActionType();
    }

    private Task OnPhaseChanged(string? phase)
    {
        selectedPhase = phase;
        ActAction.Phase = phase ?? "";
        return Task.CompletedTask;
    }

    private async Task OnScopeChanged(string? scope)
    {
        ActAction.Scope = scope ?? "";
        if (ActAction.Scope != WfObjectScopes.RequestTask.ToString() && ActAction.Scope != WfObjectScopes.ImplementationTask.ToString())
        {
            selectedTaskType = null;
            ActAction.TaskType = "";
        }
        await ScopeChanged.InvokeAsync(scope);
    }

    private List<WfObjectScopes> GetSelectableScopes()
    {
        List<WfObjectScopes> allowedScopes = GetAllowedScopes(ActAction.ActionType);
        if (Enum.TryParse(ActAction.Scope, out WfObjectScopes currentScope) && !allowedScopes.Contains(currentScope))
        {
            allowedScopes.Insert(0, currentScope);
        }
        return allowedScopes;
    }

    private static List<WfObjectScopes> GetAllowedScopes(string actionType)
    {
        return actionType switch
        {
            nameof(StateActionTypes.AddApproval) => new() { WfObjectScopes.RequestTask },
            nameof(StateActionTypes.BundleTasks) => new() { WfObjectScopes.Ticket },
            nameof(StateActionTypes.CreateFlow) => new() { WfObjectScopes.Ticket, WfObjectScopes.RequestTask },
            nameof(StateActionTypes.UpdateConnectionOwner) => new() { WfObjectScopes.Ticket },
            nameof(StateActionTypes.UpdateConnectionRelease) => new() { WfObjectScopes.Ticket },
            nameof(StateActionTypes.UpdateConnectionReject) => new() { WfObjectScopes.Ticket },
            _ => Enum.GetValues<WfObjectScopes>().ToList()
        };
    }

    private List<StateActionEvents> GetSelectableEvents()
    {
        List<StateActionEvents> allowedEvents = GetAllowedEvents(ActAction.ActionType);
        if (Enum.TryParse(ActAction.Event, out StateActionEvents currentEvent) && !allowedEvents.Contains(currentEvent))
        {
            allowedEvents.Insert(0, currentEvent);
        }
        return allowedEvents;
    }

    private static List<StateActionEvents> GetAllowedEvents(string actionType)
    {
        return actionType switch
        {
            nameof(StateActionTypes.DisplayConnection) => new() { StateActionEvents.OfferButton },
            nameof(StateActionTypes.TrafficPathAnalysis) => new() { StateActionEvents.OfferButton },
            _ => Enum.GetValues<StateActionEvents>().ToList()
        };
    }

    private void NormalizeScopeForActionType()
    {
        List<WfObjectScopes> allowedScopes = GetAllowedScopes(ActAction.ActionType);
        if (!Enum.TryParse(ActAction.Scope, out WfObjectScopes currentScope) || !allowedScopes.Contains(currentScope))
        {
            ActAction.Scope = allowedScopes[0].ToString();
            selectedTaskType = null;
            ActAction.TaskType = "";
        }
    }

    private void NormalizeEventForActionType()
    {
        List<StateActionEvents> allowedEvents = GetAllowedEvents(ActAction.ActionType);
        if (!Enum.TryParse(ActAction.Event, out StateActionEvents currentEvent) || !allowedEvents.Contains(currentEvent))
        {
            ActAction.Event = allowedEvents[0].ToString();
        }
    }

    private Task OnTaskTypeChanged(WfTaskType? taskType)
    {
        selectedTaskType = taskType;
        ActAction.TaskType = taskType?.ToString() ?? "";
        return Task.CompletedTask;
    }
}
