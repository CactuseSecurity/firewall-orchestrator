@page "/settings/compliance"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@using FWO.Data.Middleware
@using FWO.Middleware.Client
@using FWO.Ui.Data
@using RestSharp
@using FWO.Logging;

@implements IDisposable
@inject MiddlewareClient MiddlewareClient
@inject ApiConnection ApiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig

<div class="input-group">
    <h3>@(userConfig.GetText("compliance"))</h3>
    <HelpLink Page="settings/compliance" />
</div>
@(userConfig.GetText("U5324"))
<hr />
<SettingsRow LabelKey="fix_criteria" TooltipKey="H5813">
    <button type="button" class="btn btn-sm btn-primary" @onclick="EditFixCrit">@(userConfig.GetText("edit_fix_crit"))</button>
</SettingsRow>
<hr />
@if (configData != null)
{
    <form onsubmit="return false">
        <SettingsRow LabelKey="complianceCheckSleepTime" TooltipKey="H5801" LabelFor="complianceCheckSleepTime">
            <input id="complianceCheckSleepTime" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.ComplianceCheckSleepTime" />
        </SettingsRow>
        <SettingsRow LabelKey="complianceCheckStartAt" TooltipKey="H5802" LabelFor="complianceCheckStartTime">
            <input id="complianceCheckStartTime" type="time" step="60" class="form-control form-control-sm w-auto" @bind="complianceCheckStartTime" />
            <input type="date" class="form-control form-control-sm w-auto" @bind="complianceCheckStartDate" />
        </SettingsRow>
        <SettingsRow LabelKey="policy" TooltipKey="H5810" Marked="true">
            <div class="settings-input-md">
                <Dropdown ElementType="CompliancePolicy" ElementToString="@(p => p.Name)" @bind-SelectedElement="actPolicy" Elements="policies">
                    <ElementTemplate Context="policy">
                        @policy.Name
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="complianceCheckMaxPrintedViolations" TooltipKey="H5814" LabelFor="complianceCheckMaxPrintedViolations">
            <input id="complianceCheckMaxPrintedViolations" type="text" class="form-control form-control-sm settings-input-sm" @bind="configData!.ComplianceCheckMaxPrintedViolations" />
        </SettingsRow>
        <SettingsRow LabelKey="complianceCheckRelevantManagements" TooltipKey="H5816" LabelFor="complianceCheckRelevantManagements">
            <input id="complianceCheckRelevantManagements" type="text" class="form-control form-control-sm settings-input-md" @bind="configData!.ComplianceCheckRelevantManagements" />
        </SettingsRow>
        <SettingsRow LabelKey="complianceCheckShowShortColumsInComplianceReports" TooltipKey="H5836" LabelFor="cbx_show_short_columns">
            <div class="form-check form-switch">
                <input id="cbx_show_short_columns" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ShowShortColumnsInComplianceReports" />
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="complianceDiffFilterExistingViolations" TooltipKey="H5914" LabelFor="cbx_compliance_diff_filter_existing_violations">
            <div class="form-check form-switch">
                <input id="cbx_compliance_diff_filter_existing_violations" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ComplianceDiffFilterExistingViolations" />
            </div>
        </SettingsRow>
    </form>
    <hr />
    <SettingsRow LabelKey="complianceCheckElementsPerFetch" TooltipKey="H5843" LabelFor="complianceCheckElementsPerFetch">
        <input id="complianceCheckElementsPerFetch" type="text" class="form-control form-control-sm settings-input-sm" @bind="configData!.ComplianceCheckElementsPerFetch" />
    </SettingsRow>
    <SettingsRow LabelKey="complianceCheckAvailableProcessors" TooltipKey="H5844" LabelFor="complianceCheckAvailableProcessors">
        <input id="complianceCheckAvailableProcessors" type="text" class="form-control form-control-sm settings-input-sm" @bind="configData!.ComplianceCheckAvailableProcessors" />
    </SettingsRow>
    <hr />
    <ExecutionModeAuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <SettingsRow LabelKey="H5846" TooltipKey="H5845" AlignTop="true">
                <button type="button" class="btn btn-sm btn-danger" disabled="@violationsDeleteRunning" @onclick="DeleteAllViolations">
                    @if (violationsDeleteRunning)
                    {
                        <Loading Size="SpinnerSize.Small" CssClass="me-2" />
                    }
                    @(userConfig.GetText("delete"))
                </button>
                @if (violationsDeleteStatus != null && violationsDeleteStatus.Status == ComplianceCheckExecutionStatus.Succeeded)
                {
                    <span class="@Icons.Check text-success fs-4"></span>
                }
                else if (violationsDeleteStatus != null && violationsDeleteStatus.Status == ComplianceCheckExecutionStatus.Failed)
                {
                    <span class="@Icons.CrossLarge text-danger fs-4"></span>
                    <div class="@GetStatusCssClasses(violationsDeleteStatus.Status) w-100" role="alert">
                        <div>@violationsDeleteStatus.Message</div>
                    </div>
                }
            </SettingsRow>
            <SettingsRow LabelKey="H5849" TooltipKey="H5848" AlignTop="true">
                <button type="button" class="btn btn-sm btn-primary" disabled="@complianceCheckRunning" @onclick="RunComplianceCheck">
                    @if (complianceCheckRunning)
                    {
                        <Loading Size="SpinnerSize.Small" CssClass="me-2" />
                    }
                    @userConfig.GetText("H5850")
                </button>
                @if (complianceCheckStatus != null && complianceCheckStatus.Status == ComplianceCheckExecutionStatus.Succeeded)
                {
                    <span class="@Icons.Check text-success fs-4"></span>
                }
                else if (complianceCheckStatus != null && complianceCheckStatus.Status == ComplianceCheckExecutionStatus.Failed)
                {
                    <span class="@Icons.CrossLarge text-danger fs-4"></span>
                    <div class="@GetStatusCssClasses(complianceCheckStatus.Status) w-100" role="alert">
                        <div>@complianceCheckStatus.Message</div>
                    </div>
                }
            </SettingsRow>
        </Authorized>
        <NotAuthorized>
            <SettingsRow LabelKey="H5846" TooltipKey="H5845">
                <button type="button" class="btn btn-sm btn-danger" disabled>@(userConfig.GetText("delete"))</button>
            </SettingsRow>
            <SettingsRow LabelKey="H5849" TooltipKey="H5848">
                <button type="button" class="btn btn-sm btn-primary" disabled>@(userConfig.GetText("H5850"))</button>
            </SettingsRow>
        </NotAuthorized>
    </ExecutionModeAuthorizeView>
    <hr />
    <div class="pb-5">
        <ExecutionModeAuthorizeView Roles="@Roles.Admin">
            <Authorized>
                <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(userConfig.GetText("save"))</button>
            </Authorized>
            <NotAuthorized>
                <button type="button" class="btn btn-sm btn-primary" disabled>@(userConfig.GetText("save"))</button>
            </NotAuthorized>
        </ExecutionModeAuthorizeView>
    </div>
    <br />
}
else
{
    <Loading />
}
<ComplianceFixCriteria @bind-Display="EditFixCritMode" />

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private DateTime complianceCheckStartDate = DateTime.Today;
    private DateTime complianceCheckStartTime = DateTime.UtcNow.AddSeconds(-DateTime.UtcNow.Second);
    private bool EditFixCritMode = false;
    private List<CompliancePolicy> policies = [];
    private CompliancePolicy? actPolicy;
    private bool complianceCheckRunning;
    private bool violationsDeleteRunning;
    private string? complianceCheckJobId;
    private ComplianceCheckJobStatus? complianceCheckStatus;
    private ComplianceCheckJobStatus? violationsDeleteStatus;
    private PeriodicTimer? compliancePollingTimer;
    private CancellationTokenSource? compliancePollingCts;

    private static string DeleteAllQuery => ComplianceQueries.deleteAllViolations;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configData = await globalConfig.GetEditableConfig();
            complianceCheckStartDate = complianceCheckStartTime = configData.ComplianceCheckStartAt;
            policies = await ApiConnection.SendQueryAsync<List<CompliancePolicy>>(ComplianceQueries.getPolicies) ?? [];
            if (configData.ComplianceCheckPolicyId > 0)
            {
                actPolicy = policies.FirstOrDefault(p => p.Id == configData.ComplianceCheckPolicyId);
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    private void EditFixCrit()
    {
        EditFixCritMode = true;
    }

    private async Task Save()
    {
        try
        {
            if (configData != null)
            {
                configData.ComplianceCheckStartAt = complianceCheckStartDate.Date.Add(complianceCheckStartTime.TimeOfDay);
                configData.ComplianceCheckPolicyId = actPolicy?.Id ?? 0;
                await globalConfig.WriteToDatabase(configData, ApiConnection);
                DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
            }
            else
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    /// <summary>
    /// Sends a query to delete all violations using the specified API connection.
    /// </summary>
    /// <returns>
    /// A task that represents the asynchronous operation.
    /// </returns>
    private async Task DeleteAllViolations()
    {
        violationsDeleteStatus = new()
        {
            Status = ComplianceCheckExecutionStatus.Running
        };

        violationsDeleteRunning = true;

        try
        {
            await ApiConnection.SendQueryAsync<DeleteAllViolationsResult>(DeleteAllQuery);
            violationsDeleteStatus.Status = ComplianceCheckExecutionStatus.Succeeded;
        }
        catch (Exception ex)
        {
            violationsDeleteStatus.Status = ComplianceCheckExecutionStatus.Failed;
            violationsDeleteStatus.Message = ex.Message;
        }
        finally
        {
            await Task.Delay(250);
            violationsDeleteRunning = false;
        }

    }

    /// <summary>
    /// Sends a query to the middleware server to run a compliance check
    /// </summary>
    /// <returns>
    /// A task that represents the asynchronous operation.
    /// </returns>
    private async Task RunComplianceCheck()
    {
        complianceCheckStatus = new()
        {
            Status = ComplianceCheckExecutionStatus.Running
        };

        complianceCheckRunning = true;

        try
        {
            RestResponse<ComplianceCheckStartResult> response = await MiddlewareClient.StartComplianceCheck();

            if (!response.IsSuccessful || string.IsNullOrWhiteSpace(response.Data?.JobId))
            {
                InvalidOperationException invalidOperation = new(response.ErrorMessage ?? response.StatusDescription ?? "Compliance check start failed.");

                DisplayMessageInUi(invalidOperation, userConfig.GetText("H5849"), response.Content ?? string.Empty, true);

                return;
            }

            complianceCheckJobId = response.Data.JobId;

            await StartComplianceStatusPolling();
        }
        catch (Exception exception)
        {
            complianceCheckStatus.Status = ComplianceCheckExecutionStatus.Failed;
            complianceCheckStatus.Message = exception.Message;
            DisplayMessageInUi(exception, userConfig.GetText("H5849"), exception.Message, true);
        }
    }

    private async Task StartComplianceStatusPolling()
    {
        compliancePollingCts?.CancelAsync();
        compliancePollingTimer?.Dispose();

        compliancePollingCts = new CancellationTokenSource();
        compliancePollingTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        await RefreshComplianceStatus();
        _ = PollComplianceStatus(compliancePollingCts.Token);
    }

    private async Task PollComplianceStatus(CancellationToken token)
    {
        PeriodicTimer? timer = compliancePollingTimer;

        if (timer == null)
        {
            return;
        }

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshComplianceStatus();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException opCancelEx)
        {
            Log.WriteDebug(userConfig.GetText("H5849"), "Compliance Polling stopped.", opCancelEx.Message);
        }
        catch (Exception ex)
        {
            Log.WriteError(userConfig.GetText("H5849"), ex.Message, ex);
            DisplayMessageInUi(ex, userConfig.GetText("H5849"), ex.Message, true);
        }

    }

    private async Task RefreshComplianceStatus()
    {
        if (string.IsNullOrWhiteSpace(complianceCheckJobId))
        {
            return;
        }

        RestResponse<ComplianceCheckJobStatus> response = await MiddlewareClient.GetComplianceCheckStatus(complianceCheckJobId);

        if (!response.IsSuccessful || response.Data == null)
        {
            InvalidOperationException invalidOperationException = new(response.ErrorMessage ?? response.StatusDescription ?? "Compliance status fetch failed.");

            DisplayMessageInUi(invalidOperationException, userConfig.GetText("H5849"), response.Content ?? string.Empty, true);

            StopComplianceStatusPolling();

            complianceCheckRunning = false;

            return;
        }

        complianceCheckStatus = response.Data;
        complianceCheckRunning = complianceCheckStatus.Status is ComplianceCheckExecutionStatus.Queued or ComplianceCheckExecutionStatus.Running;

        if (!complianceCheckRunning)
        {
            StopComplianceStatusPolling();
        }
    }

    private void StopComplianceStatusPolling()
    {
        compliancePollingCts?.Cancel();
        compliancePollingTimer?.Dispose();
        compliancePollingTimer = null;

        if (compliancePollingCts != null)
        {
            compliancePollingCts.Dispose();
            compliancePollingCts = null;
        }
    }

    private string GetStatusCssClasses(ComplianceCheckExecutionStatus complianceCheckStatus)
    {
        return complianceCheckStatus switch
        {
            ComplianceCheckExecutionStatus.Succeeded => "alert alert-success",
            ComplianceCheckExecutionStatus.Failed => "alert alert-danger",
            _ => "alert alert-info"
        };
    }

    /// <summary>
    /// Stop compliance status polling component is disposed.
    /// </summary>
    public void Dispose()
    {
        StopComplianceStatusPolling();
    }
}
