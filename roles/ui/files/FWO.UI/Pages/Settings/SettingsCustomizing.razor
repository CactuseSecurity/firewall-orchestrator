@using System.Text.Json
@using FWO.Data.Workflow
@using FWO.Services.Workflow


@page "/settings/workflowcustomizing"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig

<div class="input-group">
    <h3>@(userConfig.GetText("customizing"))</h3>
    <HelpLink Page="settings/workflowcustomizing"/>
</div>
@(userConfig.GetText("U5314"))
<hr />

@if (InitComplete && configData != null)
{
    <form onsubmit="return false">
        <SettingsRow LabelKey="reqAvailableTaskTypes" TooltipKey="H5562" AlignTop="true">
            <div class="settings-check-grid">
                @foreach (WfTaskType type in Enum.GetValues(typeof(WfTaskType)))
                {
                    @if(type != WfTaskType.master)
                    {
                        <div class="form-check">
                            <input id="cbx_@type.ToString()" type="checkbox" class="form-check-input" @bind="taskTypesActiveDict[type]" />
                            <label for="cbx_@type.ToString()" class="form-check-label">@(userConfig.GetText(type.ToString()))</label>
                        </div>
                    }
                }
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="reqTicketFieldVisibility" TooltipKey="H5579a" AlignTop="true">
            <div class="settings-check-grid">
                <div class="form-check">
                    <input id="cbx_show_ticket_requester" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.ShowRequester" />
                    <label for="cbx_show_ticket_requester" class="form-check-label">@(userConfig.GetText("requester"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_ticket_priority" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.ShowPriority" />
                    <label for="cbx_show_ticket_priority" class="form-check-label">@(userConfig.GetText("priority"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_ticket_deadline" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.ShowDeadline" />
                    <label for="cbx_show_ticket_deadline" class="form-check-label">@(userConfig.GetText("deadline"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_ticket_reason" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.ShowReason" />
                    <label for="cbx_show_ticket_reason" class="form-check-label">@(userConfig.GetText("reason"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_ticket_comments" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.ShowComments" />
                    <label for="cbx_show_ticket_comments" class="form-check-label">@(userConfig.GetText("comments"))</label>
                </div>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="displayed_handlers_in_ticket_list" TooltipKey="H5556" LabelFor="sel_ticket_handler_display_mode">
            <div class="settings-input-md">
                <Dropdown Id="sel_ticket_handler_display_mode" ElementType="TicketHandlerDisplayMode"
                          @bind-SelectedElement="ticketFieldVisibilityConfig.HandlerDisplayMode"
                          ElementToString="TicketHandlerDisplayModeText"
                          Elements="Enum.GetValues<TicketHandlerDisplayMode>()">
                    <ElementTemplate Context="mode">
                        @(TicketHandlerDisplayModeText(mode))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="reqAccessTaskFieldVisibility" TooltipKey="H5579b" AlignTop="true">
            <div class="settings-check-grid">
                <div class="form-check">
                    <input id="cbx_show_access_task_management" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowManagement" />
                    <label for="cbx_show_access_task_management" class="form-check-label">@(userConfig.GetText("management"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_access_task_owner" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowOwner" />
                    <label for="cbx_show_access_task_owner" class="form-check-label">@(userConfig.GetText("owner"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_access_task_rule_action" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowRuleAction" />
                    <label for="cbx_show_access_task_rule_action" class="form-check-label">@(userConfig.GetText("rule_action"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_access_task_tracking" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowTracking" />
                    <label for="cbx_show_access_task_tracking" class="form-check-label">@(userConfig.GetText("track"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_access_task_valid_from" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowValidFrom" />
                    <label for="cbx_show_access_task_valid_from" class="form-check-label">@(userConfig.GetText("valid_from"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_access_task_valid_to" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowValidTo" />
                    <label for="cbx_show_access_task_valid_to" class="form-check-label">@(userConfig.GetText("valid_to"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_access_task_reason" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowReason" />
                    <label for="cbx_show_access_task_reason" class="form-check-label">@(userConfig.GetText("reason"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_access_task_free_text" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowFreeText" />
                    <label for="cbx_show_access_task_free_text" class="form-check-label">@(userConfig.GetText("free_text"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_show_access_task_comments" type="checkbox" class="form-check-input" @bind="ticketFieldVisibilityConfig.AccessTask.ShowComments" />
                    <label for="cbx_show_access_task_comments" class="form-check-label">@(userConfig.GetText("comments"))</label>
                </div>
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="reqPriorities" TooltipKey="H5563" AlignTop="true">
            <div class="w-100 vheight75">
                <Table class="table table-bordered th-bg-secondary table-responsive overflow-auto sticky-header" TableItem="WfPriority" Items="prioList" PageSize="0" ColumnReorder="true">
                    <Column TableItem="WfPriority" Title="@(userConfig.GetText("numeric_prio"))" Field="@(x => x.NumPrio)" Sortable="true" Filterable="true" />
                    <Column Context="prio" TableItem="WfPriority" Title="@(userConfig.GetText("name"))" Field="@(x => x.Name)" Sortable="true" Filterable="true" >
                        <Template>
                            <input type="text" class="form-control form-control-sm" @bind="prio.Name">
                        </Template>
                    </Column>
                    <Column Context="prio" TableItem="WfPriority" Title="@(userConfig.GetText("ticket_deadline"))" Field="@(x => x.TicketDeadline)" Sortable="true" Filterable="true" >
                        <Template>
                            <input type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="prio.TicketDeadline">
                        </Template>
                    </Column>
                    <Column Context="prio" TableItem="WfPriority" Title="@(userConfig.GetText("approval_deadline_days"))" Field="@(x => x.ApprovalDeadline)" Sortable="true" Filterable="true" >
                        <Template>
                            <input type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="prio.ApprovalDeadline">
                        </Template>
                    </Column>
                </Table>
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="reqOwnerBased" TooltipKey="H5568" LabelFor="cbx_owner_based">
            <div class="form-check form-switch">
                <input id="cbx_owner_based" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ReqOwnerBased">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="reqVisibilityBased" TooltipKey="H5579" LabelFor="cbx_visibility_based">
            <div class="form-check form-switch">
                <input id="cbx_visibility_based" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ReqVisibilityBased">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="reqReducedView" TooltipKey="H5570" LabelFor="cbx_reduced_view">
            <div class="form-check form-switch">
                <input id="cbx_reduced_view" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ReqReducedView">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="reqShowCompliance" TooltipKey="H5569" LabelFor="cbx_show_compliance">
            <div class="form-check form-switch">
                <input id="cbx_show_compliance" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ReqShowCompliance">
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="reqUseFlowDb" TooltipKey="H5564" LabelFor="cbx_use_flow_db">
            <div class="form-check form-switch">
                <input id="cbx_use_flow_db" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ReqUseFlowDb">
            </div>
            <button type="button" class="btn btn-sm btn-warning" @onclick="() => editFlowIntegrationMode = true">
                @(DisplayService.DisplayButton(userConfig, "flow_integration", Icons.Edit))
            </button>
        </SettingsRow>
        <SettingsRow LabelKey="api_ticket_initial_state" TooltipKey="H5546">
            <div class="settings-input-md">
                <Dropdown ElementType="int?" @bind-SelectedElement="selectedApiTicketInitialStateId" ElementToString="StateDisplayName"
                          Elements="stateIds.Select(stateId => (int?)stateId)" Nullable="true" NoneSelectedText="@(userConfig.GetText("use_default"))">
                    <ElementTemplate Context="stateId">
                        @(StateDisplayName(stateId))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="reqCreateRequestTaskSortConfig" TooltipKey="C9034">
            <button type="button" class="btn btn-sm btn-warning" @onclick="() => editCreateRequestTaskSortConfigMode = true">
                @(DisplayService.DisplayButton(userConfig, "edit", Icons.Edit))
            </button>
        </SettingsRow>
        <SettingsRow LabelKey="reqActivatePathAnalysis" TooltipKey="H5567" LabelFor="cbx_activate_path_analysis">
            <div class="form-check form-switch">
                <input id="cbx_activate_path_analysis" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ReqActivatePathAnalysis">
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="reqAllowedChangesByApprover" TooltipKey="H5576">
            <button type="button" class="btn btn-sm btn-warning" @onclick="() => editAllowedChangesByApproverMode = true">
                @(DisplayService.DisplayButton(userConfig, "edit", Icons.Edit))
            </button>
        </SettingsRow>
        <SettingsRow LabelKey="approval_edit_mode" TooltipKey="H5576a" LabelFor="sel_approval_edit_mode">
            <div class="settings-input-md">
                <Dropdown Id="sel_approval_edit_mode" ElementType="ApprovalEditMode"
                          @bind-SelectedElement="configData!.ReqApprovalEditMode"
                          ElementToString="ApprovalEditModeText"
                          Elements="Enum.GetValues<ApprovalEditMode>()">
                    <ElementTemplate Context="mode">
                        @(ApprovalEditModeText(mode))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="reqImplicitApprovalComment" TooltipKey="H5582a" LabelFor="txt_implicit_approval_comment" AlignTop="true">
            <textarea id="txt_implicit_approval_comment" class="form-control form-control-sm settings-input-lg" rows="2" @bind="configData!.ReqImplicitApprovalComment"></textarea>
        </SettingsRow>
        <SettingsRow LabelKey="time_object_origin_suffixes" TooltipKey="H5576b">
            <button type="button" class="btn btn-sm btn-warning" @onclick="() => editTimeObjectOriginSuffixesMode = true">
                @(DisplayService.DisplayButton(userConfig, "edit", Icons.Edit))
            </button>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="reqDeviceInput" Tooltip="@(userConfig.PureLine("H5566a") + "\r\n" + userConfig.PureLine("H5571") + "\r\n" + userConfig.PureLine("H5574") + "\r\n" + userConfig.PureLine("H5577"))">
            <div class="settings-input-md">
                <Dropdown ElementType="ReqDeviceInputOptions" @bind-SelectedElement="configData!.ReqDeviceInput" ElementToString="@(o => userConfig.GetText(o.ToString()))" Elements="Enum.GetValues<ReqDeviceInputOptions>()" >
                    <ElementTemplate Context="opt">
                        @(userConfig.GetText(opt.ToString()))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="path_analysis_algorithm" LabelFor="pathAnalysisAlgorithm"
                     Tooltip="@(userConfig.PureLine("H5580") + "\r\n" + userConfig.PureLine("H5575") + "\r\n" + userConfig.PureLine("H5573") + "\r\n" + userConfig.PureLine("H5572"))">
            <select id="pathAnalysisAlgorithm" class="form-select form-select-sm settings-input-md" @bind="configData!.PathAnalysisAlgorithm">
                @foreach (PathAnalysisAlgorithm algorithm in pathAnalysisAlgorithms)
                {
                    <option value="@algorithm.Id">@AlgorithmDisplayName(algorithm)</option>
                }
            </select>
        </SettingsRow>
        <SettingsRow LabelKey="reqBundlingOptions" TooltipKey="H5566">
            <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5578"))">
                <input id="cbx_consider_bundling" type="checkbox" class="form-check-input" @bind="configData!.ReqConsiderBundling">
                <label for="cbx_consider_bundling" class="form-check-label">@(userConfig.GetText("reqConsiderBundling"))</label>
            </div>
            <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5579c"))">
                <input id="cbx_display_bundled_tasks_as_one" type="checkbox" class="form-check-input" @bind="configData!.ReqDisplayBundledTasksAsOne">
                <label for="cbx_display_bundled_tasks_as_one" class="form-check-label">@(userConfig.GetText("reqDisplayBundledTasksAsOne"))</label>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="reqCreateObjectsSeparately" TooltipKey="H5578a" LabelFor="cbx_create_objects_separately">
            <div class="form-check form-switch">
                <input id="cbx_create_objects_separately" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ReqCreateObjectsSeparately">
            </div>
        </SettingsRow>
    </form>


    <hr />
    <ExecutionModeAuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
        </Authorized>
        <NotAuthorized>
            <button type="button" class="btn btn-sm btn-primary" disabled>@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
        </NotAuthorized> 
    </ExecutionModeAuthorizeView>
    <br><br>
}
else
{
    <Loading/>
}

@if (configData != null)
{
    <AllowedChangesByApprover @bind-Display="editAllowedChangesByApproverMode" ConfigValue="@configData.ReqAllowedChangesByApprover" ConfigValueChanged="HandleAllowedChangesByApproverChanged" />
    <FlowIntegration @bind-Display="editFlowIntegrationMode" ConfigValue="@configData.ReqFlowIntegration" ConfigValueChanged="HandleFlowIntegrationChanged" />
    <TimeObjectOriginSuffixes @bind-Display="editTimeObjectOriginSuffixesMode" ConfigValue="@configData.ReqTimeObjectOriginSuffixes" ConfigValueChanged="HandleTimeObjectOriginSuffixesChanged" />
    <CreateRequestTaskSortConfigPopup @bind-Display="editCreateRequestTaskSortConfigMode" ConfigValue="@configData.ReqCreateRequestTaskSortConfig" ConfigValueChanged="HandleCreateRequestTaskSortConfigChanged" DisplayMessageInUi="DisplayMessageInUi" />
}



@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private bool InitComplete = false;
    private bool editAllowedChangesByApproverMode = false;
    private bool editFlowIntegrationMode = false;
    private bool editTimeObjectOriginSuffixesMode = false;
    private bool editCreateRequestTaskSortConfigMode = false;

    private List<WfState> states = [];
    private List<int> stateIds = [];
    private List<int> validInitialStateIds = [];
    private StateMatrixConfigurationSnapshot? masterStateMatrix;
    private List<WfTaskType> availableTaskTypes { get; set; } = [];
    private Dictionary<WfTaskType, bool> taskTypesActiveDict = [];
    private TicketFieldVisibilityConfig ticketFieldVisibilityConfig = new();

    private List<WfPriority> prioList = [];
    private int? selectedApiTicketInitialStateId;
    private List<PathAnalysisAlgorithm> pathAnalysisAlgorithms = [];
    private const string kAlgorithmTextPrefix = "path_algo_";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configData = await globalConfig.GetEditableConfig();
            states = await apiConnection.SendQueryAsync<List<WfState>>(RequestQueries.getStates) ?? [];
            masterStateMatrix = await StateMatrixConfigurationRepository.Load(apiConnection, WfTaskType.master);
            validInitialStateIds = states.Where(state => IsValidInitialState(state.Id)).Select(state => state.Id).ToList();
            stateIds = new List<int>(validInitialStateIds);
            if (configData.ReqApiTicketInitialStateId >= 0 && !stateIds.Contains(configData.ReqApiTicketInitialStateId))
            {
                stateIds.Add(configData.ReqApiTicketInitialStateId);
            }
            selectedApiTicketInitialStateId = configData.ReqApiTicketInitialStateId >= 0 ? configData.ReqApiTicketInitialStateId : null;
            availableTaskTypes = System.Text.Json.JsonSerializer.Deserialize<List<WfTaskType>>(configData.ReqAvailableTaskTypes) ?? throw new JsonException("Config data could not be parsed.");
            ticketFieldVisibilityConfig = TicketFieldVisibilityConfig.Parse(configData.ReqTicketFieldVisibility);
            taskTypesActiveDict = [];
            foreach(WfTaskType type in Enum.GetValues<WfTaskType>())
            {
                taskTypesActiveDict.Add(type, availableTaskTypes.Contains(type));
            }
            prioList = System.Text.Json.JsonSerializer.Deserialize<List<WfPriority>>(configData.ReqPriorities) ?? throw new JsonException("Config data could not be parsed.");
            List<PathAnalysisAlgorithm> algorithms = await apiConnection.SendQueryAsync<List<PathAnalysisAlgorithm>>(PathAnalysisQueries.getPathAnalysisAlgorithms) ?? [];
            // by id: none first, then the path analyses and the device selections in the order they were added
            pathAnalysisAlgorithms = [.. algorithms.OrderBy(algorithm => algorithm.Id)];
            InitComplete = true;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    private string StateDisplayName(int? stateId)
    {
        if (stateId == null)
        {
            return userConfig.GetText("use_default");
        }

        WfState? state = states.FirstOrDefault(candidate => candidate.Id == stateId.Value);
        if (state == null)
        {
            return stateId.Value.ToString();
        }

        return $"{state.Name} ({state.Id})";
    }

    private string TicketHandlerDisplayModeText(TicketHandlerDisplayMode mode)
    {
        return userConfig.GetText(mode switch
        {
            TicketHandlerDisplayMode.None => "ticket_handler_display_mode_none",
            TicketHandlerDisplayMode.CurrentPhase => "ticket_handler_display_mode_current_phase",
            TicketHandlerDisplayMode.AllActiveTasks => "ticket_handler_display_mode_all_active_tasks",
            _ => "undefined"
        });
    }

    private string ApprovalEditModeText(ApprovalEditMode mode)
    {
        return userConfig.GetText(mode switch
        {
            ApprovalEditMode.Classic => "approval_edit_mode_classic",
            ApprovalEditMode.AccessTaskView => "approval_edit_mode_access_task_view",
            _ => "undefined"
        });
    }

    private async Task Save()
    {
        try
        {
            if (configData != null)
            {
                ValidateApiTicketInitialStateSelection();
                configData.ReqApiTicketInitialStateId = selectedApiTicketInitialStateId ?? -1;
                availableTaskTypes = [];
                foreach(WfTaskType type in taskTypesActiveDict.Keys)
                {
                    if (taskTypesActiveDict[type])
                    {
                        availableTaskTypes.Add(type);
                    }
                }
                configData.ReqAvailableTaskTypes = JsonSerializer.Serialize(availableTaskTypes);
                configData.ReqPriorities = JsonSerializer.Serialize(prioList);
                configData.ReqTicketFieldVisibility = ticketFieldVisibilityConfig.ToConfigValue();
                await globalConfig.WriteToDatabase(configData, apiConnection);
                DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
            }
            else
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    /// <summary>
    /// Returns the localized name of a path analysis algorithm, derived from its API name. An algorithm without API
    /// name, e.g. added to the database manually, keeps its stored name.
    /// </summary>
    private string AlgorithmDisplayName(PathAnalysisAlgorithm algorithm)
    {
        string? apiName = PathAnalysisAlgorithmNames.GetName(algorithm.Id);
        return apiName == null ? algorithm.Name : userConfig.GetText(kAlgorithmTextPrefix + apiName);
    }

    private void ValidateApiTicketInitialStateSelection()
    {
        if (selectedApiTicketInitialStateId.HasValue && !validInitialStateIds.Contains(selectedApiTicketInitialStateId.Value))
        {
            throw new InvalidOperationException($"Configured API ticket initial state id {selectedApiTicketInitialStateId.Value} no longer resolves to an active workflow phase.");
        }
    }

    private bool IsValidInitialState(int stateId)
    {
        return masterStateMatrix != null && IsValidInitialState(masterStateMatrix, stateId);
    }

    private static bool IsValidInitialState(StateMatrixConfigurationSnapshot stateMatrix, int stateId)
    {
        return StateMatrixConfigurationRepository.GetMatchingActiveWorkflowPhases(stateMatrix, stateId).Count == 1;
    }

    private async Task HandleAllowedChangesByApproverChanged(string configValue)
    {
        try
        {
            if (configData == null)
            {
                throw new ArgumentException("Allowed approver changes were updated before the settings page was initialized.");
            }

            ConfigData singleValueConfig = await globalConfig.GetEditableConfig();
            singleValueConfig.ReqAllowedChangesByApprover = configValue;
            await globalConfig.WriteToDatabase(singleValueConfig, apiConnection);
            configData.ReqAllowedChangesByApprover = configValue;
            DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    private async Task HandleFlowIntegrationChanged(string configValue)
    {
        try
        {
            if (configData == null)
            {
                throw new ArgumentException("Flow integration settings were updated before the settings page was initialized.");
            }

            ConfigData singleValueConfig = await globalConfig.GetEditableConfig();
            singleValueConfig.ReqFlowIntegration = configValue;
            await globalConfig.WriteToDatabase(singleValueConfig, apiConnection);
            configData.ReqFlowIntegration = configValue;
            DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    private async Task HandleTimeObjectOriginSuffixesChanged(string configValue)
    {
        try
        {
            if (configData == null)
            {
                throw new ArgumentException("Time-object origin suffix settings were updated before the settings page was initialized.");
            }

            ConfigData singleValueConfig = await globalConfig.GetEditableConfig();
            singleValueConfig.ReqTimeObjectOriginSuffixes = configValue;
            await globalConfig.WriteToDatabase(singleValueConfig, apiConnection);
            configData.ReqTimeObjectOriginSuffixes = configValue;
            DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    private Task HandleCreateRequestTaskSortConfigChanged(string configValue)
    {
        try
        {
            if (configData == null)
            {
                throw new ArgumentException("Create request task sort settings were updated before the settings page was initialized.");
            }

            configData.ReqCreateRequestTaskSortConfig = configValue;
            return Task.CompletedTask;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
            return Task.CompletedTask;
        }
    }
}
