@page "/settings/defaults"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@implements IDisposable
@using FWO.Services.EventMediator.Events
@using FWO.Services.EventMediator.Interfaces
@using System.Text.Json
@using FWO.Data.Enums
@using FWO.Ui.Data.Extensions

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig
@inject IEventMediator EventMediator
@inject IInternalCaCertificateProvider certificateProvider
@inject IJSRuntime jsRuntime

<div class="input-group">
    <h3>@(userConfig.GetText("standards"))</h3>
    <HelpLink Page="settings/defaults" />
</div>
@(userConfig.GetText("U5311"))
<hr />

<h4>@userConfig.GetText("internal_ca_certificate")</h4>
<p>@userConfig.GetText("internal_ca_certificate_description")</p>

@if (!string.IsNullOrEmpty(certificatePem))
{
    <div class="d-flex gap-2 mb-2">
        <button type="button" class="btn btn-sm btn-primary" @onclick="CopyCertificateToClipboard">
            @DisplayService.DisplayButton(userConfig, "copy_to_clipboard", Icons.Clipboard)
        </button>
        <button type="button" class="btn btn-sm btn-primary" @onclick="DownloadCertificate">
            @DisplayService.DisplayButton(userConfig, "download", Icons.Download)
        </button>
    </div>
    <pre class="border rounded bg-light p-3 overflow-auto"><code>@certificatePem</code></pre>
    <hr />
}

@if (configData != null && InitComplete)
{
    <form onsubmit="return false">
        <SettingsRow LabelKey="default_language" TooltipKey="H5411" Marked="true">
            <div class="settings-input-md">
                <Dropdown ElementType="Language" ElementToString="@(l => userConfig.GetText(l.Name))" @bind-SelectedElement="selectedLanguage" Elements="globalConfig.UiLanguages">
                    <ElementTemplate Context="language">
                        @(userConfig.GetText(language.Name))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="maxMessages" TooltipKey="maxMessages" Marked="true" LabelFor="maxMessages">
            <input id="maxMessages" type="number" class="form-control form-control-sm settings-input-sm" @bind="configData!.MaxMessages">
        </SettingsRow>
        <SettingsRow LabelKey="messageViewTime" TooltipKey="H5423" Marked="true" LabelFor="messageViewTime">
            <input id="messageViewTime" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.MessageViewTime">
        </SettingsRow>
        <SettingsRow LabelKey="uiHostName" TooltipKey="H5425" LabelFor="uiHostName">
            <input id="uiHostName" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.UiHostName" />
        </SettingsRow>
        <SettingsRow LabelKey="welcomeMessage" TooltipKey="H5466" LabelFor="welcomeMessage" AlignTop="true">
            <textarea id="welcomeMessage" rows="6" class="form-control form-control-sm settings-input-lg" @bind="@configData!.WelcomeMessage" placeholder="@(userConfig.GetText("welcomeMessage"))"></textarea>
        </SettingsRow>
        <SettingsRow LabelKey="useCustomLogo" LabelFor="cbx_customLogo" AlignTop="true">
            <div class="form-check form-switch">
                <input id="cbx_customLogo" type="checkbox" role="switch" class="form-check-input" @bind="configData!.UseCustomLogo">
            </div>
            <div>
                <CustomLogoUpload AuthorizedRoles="@Roles.Admin" SupportedFileFormats=".png,.jpg,.jpeg"></CustomLogoUpload>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="color_scheme" TooltipKey="H5411a">
            <div class="settings-input-md">
                <Dropdown ElementType="ColorScheme" ElementToString="@(c => userConfig.GetText(c.Name))" @bind-SelectedElement="selectedColorScheme" Elements="ColorScheme.AvailableSchemes">
                    <ElementTemplate Context="colorScheme">
                        @(userConfig.GetText(colorScheme.Name))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modIconify" TooltipKey="H5618" LabelFor="cbx_default_iconify">
            <div class="form-check form-switch">
                <input id="cbx_default_iconify" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModIconify">
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="elementsPerFetch" TooltipKey="H5412" Marked="true" LabelFor="elementsPerFetch">
            <input id="elementsPerFetch" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.ElementsPerFetch" />
        </SettingsRow>
        <SettingsRow LabelKey="autoFillRightSidebar" TooltipKey="H5414" LabelFor="cbx_auto_fill_right_sidebar">
            <div class="form-check form-switch">
                <input id="cbx_auto_fill_right_sidebar" type="checkbox" role="switch" class="form-check-input" @bind="configData!.AutoFillRightSidebar">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="maxInitialFetchesRightSidebar" TooltipKey="H5413" LabelFor="maxInitialFetchesRightSidebar">
            <input id="maxInitialFetchesRightSidebar" type="number" min="0" class="form-control form-control-sm settings-input-sm"
                   disabled="@configData!.AutoFillRightSidebar" @bind="configData!.MaxInitialFetchesRightSidebar" />
        </SettingsRow>
        <SettingsRow LabelKey="minCollapseAllDevices" TooltipKey="H5422" Marked="true" LabelFor="minCollapseAllDevices">
            <input id="minCollapseAllDevices" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.MinCollapseAllDevices">
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="dataRetentionTime" TooltipKey="H5415" LabelFor="dataRetentionTime">
            <input id="dataRetentionTime" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.DataRetentionTime" />
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="autoDiscoverSleepTime" TooltipKey="H5426" LabelFor="autoDiscoverSleepTime">
            <input id="autoDiscoverSleepTime" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.AutoDiscoverSleepTime" />
        </SettingsRow>
        <SettingsRow LabelKey="autoDiscoverStartAt" TooltipKey="H5427" LabelFor="autoDiscoverStartTime">
            <input id="autoDiscoverStartTime" type="time" step="60" class="form-control form-control-sm w-auto" @bind="autoDiscStartTime" />
            <input type="date" class="form-control form-control-sm w-auto" @bind="autoDiscStartDate" />
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="dailyCheckStartAt" TooltipKey="H5424" LabelFor="dailyCheckStartAt">
            <input id="dailyCheckStartAt" type="time" step="60" class="form-control form-control-sm w-auto" @bind="configData!.DailyCheckStartAt" />
        </SettingsRow>
        <SettingsRow LabelKey="dailyCheckModules" TooltipKey="H5424a" AlignTop="true">
            <div class="settings-check-grid">
                @foreach (DailyCheckModule module in Enum.GetValues(typeof(DailyCheckModule)))
                {
                    <div class="form-check">
                        <input id="cbx_daily_@module.ToString()" type="checkbox" class="form-check-input" @bind="dailyCheckModulesVisibleDict[module]" />
                        <label for="cbx_daily_@module.ToString()" class="form-check-label">@(userConfig.GetText(module.ToString()))</label>
                    </div>
                }
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="maxImportDuration" TooltipKey="H5452" LabelFor="maxImportDuration">
            <input id="maxImportDuration" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.MaxImportDuration" />
        </SettingsRow>
        <SettingsRow LabelKey="maxImportInterval" TooltipKey="H5453" LabelFor="maxImportInterval">
            <input id="maxImportInterval" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.MaxImportInterval" />
        </SettingsRow>
        <SettingsRow LabelKey="importScriptTimeout" TooltipKey="H5453a" LabelFor="importScriptTimeout">
            <input id="importScriptTimeout" type="number" min="1" max="@GlobalConst.kMaxImportScriptTimeoutMinutes" class="form-control form-control-sm settings-input-sm" @bind="configData!.ImportScriptTimeout" />
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="maxRestResponseObjectLimit" TooltipKey="H5453b" LabelFor="maxRestResponseObjectLimit">
            <input id="maxRestResponseObjectLimit" type="number" min="@GlobalConst.kMinRestResponseObjectLimit" max="@GlobalConst.kMaxRestResponseObjectLimitCeiling" class="form-control form-control-sm settings-input-sm" @bind="configData!.MaxRestResponseObjectLimit" />
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="allowFullRollback" TooltipKey="H5853" LabelFor="cbx_allow_full_rollback">
            <div class="form-check form-switch">
                <input id="cbx_allow_full_rollback" type="checkbox" role="switch" class="form-check-input" @bind="configData!.AllowFullRollback">
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="reqAllowManualOwnerAdmin" TooltipKey="H5565" LabelFor="cbx_allow_manual_owner_admin">
            <div class="form-check form-switch">
                <input id="cbx_allow_manual_owner_admin" type="checkbox" role="switch" class="form-check-input" @bind="configData!.AllowManualOwnerAdmin">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="ruleOwnershipMode" TooltipKey="H5454">
            <div class="settings-input-md">
                <Dropdown ElementType="RuleOwnershipMode" @bind-SelectedElement="configData!.RuleOwnershipMode"
                          ElementToString="@(o => userConfig.GetText(o.ToString()))" Elements="Enum.GetValues(typeof(RuleOwnershipMode)).Cast<RuleOwnershipMode>()">
                    <ElementTemplate Context="opt">
                        @(userConfig.GetText(opt.ToString()))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="availableModules" TooltipKey="H5457" AlignTop="true">
            <div class="settings-check-grid">
                @foreach (Module module in Enum.GetValues(typeof(Module)))
                {
                    <div class="form-check">
                        <input id="cbx_@module.ToString()" type="checkbox" class="form-check-input" @bind="modulesVisibleDict[module]" />
                        <label for="cbx_@module.ToString()" class="form-check-label">@(module.ToString())</label>
                    </div>
                }
            </div>
        </SettingsRow>
    </form>
    <hr />
    <SettingsRow LabelKey="accesstoken_lifetime" TooltipKey="accesstoken_lifetime" LabelFor="accessTokenLifetime">
        <input id="accessTokenLifetime" type="number" min="@DynamicAccessTokenLifetimeMinValue" class="form-control form-control-sm settings-input-sm" @bind="accessTokenLifetimeValue" />
        <select class="form-select form-select-sm settings-input-sm" value="@accessTokenLifetimeUnit" @onchange="@((e) => SetDynamicTokenLifetimeMinValue(e, ref DynamicAccessTokenLifetimeMinValue, ref accessTokenLifetimeValue, ref accessTokenLifetimeUnit))">
            @foreach (TokenLifetimeUnit unit in Enum.GetValues(typeof(TokenLifetimeUnit)))
            {
                <option value="@unit">@unit.ToString(userConfig)</option>
            }
        </select>
    </SettingsRow>
    <SettingsRow LabelKey="refreshtoken_lifetime" TooltipKey="refreshtoken_lifetime" LabelFor="refreshTokenLifetime">
        <input id="refreshTokenLifetime" type="number" min="@DynamicRefreshTokenLifetimeMinValue" class="form-control form-control-sm settings-input-sm" @bind="refreshTokenLifetimeValue" />
        <select class="form-select form-select-sm settings-input-sm" value="@refreshTokenLifetimeUnit" @onchange="@((e) => SetDynamicTokenLifetimeMinValue(e, ref DynamicRefreshTokenLifetimeMinValue, ref refreshTokenLifetimeValue, ref refreshTokenLifetimeUnit))">
            @foreach (TokenLifetimeUnit unit in Enum.GetValues(typeof(TokenLifetimeUnit)))
            {
                <option value="@unit">@unit.ToString(userConfig)</option>
            }
        </select>
    </SettingsRow>
    @if (!IsTokenLifetimeValid())
    {
        <div class="settings-row">
            <span></span>
            <span class="text-danger"><span class="@Icons.Warning pe-1"></span>@(userConfig.GetText("U9037"))</span>
        </div>
    }
    <hr />
    <div class="settings-actions">
        <ExecutionModeAuthorizeView Roles="@Roles.Admin">
            <Authorized>
                <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(userConfig.GetText("save"))</button>
            </Authorized>
            <NotAuthorized>
                <button type="button" class="btn btn-sm btn-primary" disabled>@(userConfig.GetText("save"))</button>
            </NotAuthorized>
        </ExecutionModeAuthorizeView>
    </div>
    <p class="mt-4">@(userConfig.GetText("U5303"))</p>
}
else
{
    <Loading />
}



@code
{
    private const string kCertificateFileName = "fworch-internal-ca.crt";
    private const string kCertificateContentType = "application/x-pem-file";

    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private Language selectedLanguage = new Language();
    private ColorScheme selectedColorScheme = new ColorScheme();
    private DateTime autoDiscStartDate = DateTime.Today;
    private DateTime autoDiscStartTime = DateTime.Now.AddSeconds(-DateTime.Now.Second);
    private List<Module> availableModules { get; set; } = [];
    private List<DailyCheckModule> dailyCheckModules { get; set; } = [];
    private Dictionary<Module, bool> modulesVisibleDict = [];
    private Dictionary<DailyCheckModule, bool> dailyCheckModulesVisibleDict = [];
    private int accessTokenLifetimeValue = 1;
    private int refreshTokenLifetimeValue = 1;
    private TokenLifetimeUnit accessTokenLifetimeUnit = TokenLifetimeUnit.Hours;
    private TokenLifetimeUnit refreshTokenLifetimeUnit = TokenLifetimeUnit.Days;
    private bool InitComplete = false;
    private int DynamicAccessTokenLifetimeMinValue = 1;
    private int DynamicRefreshTokenLifetimeMinValue = 1;
    private string certificatePem = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadInternalCaCertificate();
        try
        {
            // Subscribe to events for file uploads and logo import
            EventMediator.Subscribe<FileUploadEvent>(nameof(FileUploadService.ReadFileToBytes), _ => OnFileUploadEvent(_.EventArgs));
            EventMediator.Subscribe<FileUploadEvent>(nameof(FileUploadService.ImportCustomLogo), _ => OnFileUploadEvent(_.EventArgs));

            configData = await globalConfig.GetEditableConfig();
            selectedLanguage = globalConfig.UiLanguages.FirstOrDefault(l => l.Name == configData.DefaultLanguage) ?? new Language();
            selectedColorScheme = ColorScheme.GetSchemeByName(configData.ColorScheme);
            autoDiscStartDate = autoDiscStartTime = configData.AutoDiscoverStartAt;
            availableModules = JsonSerializer.Deserialize<List<Module>>(string.IsNullOrEmpty(configData.AvailableModules) ? ModuleGroups.AllModulesNumList() : configData.AvailableModules) ?? throw new JsonException("Config data could not be parsed.");
            dailyCheckModules = JsonSerializer.Deserialize<List<DailyCheckModule>>(string.IsNullOrEmpty(configData.DailyCheckModules) ? DailyCheckModuleGroups.AllModulesNumList() : configData.DailyCheckModules) ?? throw new JsonException("Config data could not be parsed.");
            modulesVisibleDict = [];
            foreach (Module module in Enum.GetValues(typeof(Module)).Cast<Module>())
            {
                modulesVisibleDict.Add(module, availableModules.Contains(module));
            }
            dailyCheckModulesVisibleDict = [];
            foreach (DailyCheckModule module in Enum.GetValues(typeof(DailyCheckModule)).Cast<DailyCheckModule>())
            {
                dailyCheckModulesVisibleDict.Add(module, dailyCheckModules.Contains(module));
            }

            accessTokenLifetimeValue = configData.AccessTokenLifetime;
            accessTokenLifetimeUnit = configData.AccessTokenLifetimeUnit;
            DynamicAccessTokenLifetimeMinValue = GetTokenLifetimeMinValue(accessTokenLifetimeUnit);

            refreshTokenLifetimeValue = configData.RefreshTokenLifetime;
            refreshTokenLifetimeUnit = configData.RefreshTokenLifetimeUnit;
            DynamicRefreshTokenLifetimeMinValue = GetTokenLifetimeMinValue(refreshTokenLifetimeUnit);

            InitComplete = true;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    /// <summary>
    /// Loads the public internal CA certificate before the rest of the settings.
    /// </summary>
    /// <remarks>
    /// Awaited up front rather than after the first render: it reads one local file of a
    /// couple of kilobytes, so nothing measurable is gained by deferring it, and having the
    /// certificate present before the first render keeps its block from appearing late.
    /// It cannot hold the page back on a failure either - a failed read is reported and
    /// leaves the string empty, which hides the block instead of blocking initialization.
    /// </remarks>
    private async Task LoadInternalCaCertificate()
    {
        try
        {
            certificatePem = await certificateProvider.GetAsync();
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("internal_ca_certificate"),
                userConfig.GetText("internal_ca_certificate_load_error"), true);
        }
    }

    /// <summary>
    /// Copies the displayed PEM certificate to the browser clipboard.
    /// </summary>
    private async Task CopyCertificateToClipboard()
    {
        await jsRuntime.InvokeVoidAsync("copyText", certificatePem);
    }

    /// <summary>
    /// Downloads the displayed PEM certificate.
    /// </summary>
    private async Task DownloadCertificate()
    {
        await jsRuntime.InvokeVoidAsync("DownloadFile", kCertificateFileName,
            kCertificateContentType, certificatePem);
    }

    private void SetDynamicTokenLifetimeMinValue(ChangeEventArgs e, 
        ref int variableMinVal, 
        ref int tokenLifetimeVal, 
        ref TokenLifetimeUnit tokenLifetimeUnit)
    {
        if (Enum.TryParse<TokenLifetimeUnit>(e.Value?.ToString(), out TokenLifetimeUnit unit))
        {
            variableMinVal = GetTokenLifetimeMinValue(unit);

            if (variableMinVal > tokenLifetimeVal)
            {
                tokenLifetimeVal = variableMinVal;
            }

            tokenLifetimeUnit = unit;
        }
    }

    private bool IsTokenLifetimeValid()
    {
        if (configData == null)
        {
            return false;
        }

        int accessTokenLifetimeInMinutes = ConvertTokenLifetimeToMinutes(accessTokenLifetimeValue, accessTokenLifetimeUnit);
        int refreshTokenLifetimeInMinutes = ConvertTokenLifetimeToMinutes(refreshTokenLifetimeValue, refreshTokenLifetimeUnit);

        return accessTokenLifetimeValue >= GetTokenLifetimeMinValue(accessTokenLifetimeUnit)
            && refreshTokenLifetimeValue >= GetTokenLifetimeMinValue(refreshTokenLifetimeUnit)
            && refreshTokenLifetimeInMinutes > accessTokenLifetimeInMinutes;
    }

    private async Task Save()
    {
        try
        {
            if (configData != null)
            {
                if (!IsTokenLifetimeValid())
                {
                    DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U9037"), true);
                    return;
                }

                configData.AccessTokenLifetime = accessTokenLifetimeValue;
                configData.AccessTokenLifetimeUnit = accessTokenLifetimeUnit;

                configData.RefreshTokenLifetime = refreshTokenLifetimeValue;
                configData.RefreshTokenLifetimeUnit = refreshTokenLifetimeUnit;

                configData.DefaultLanguage = selectedLanguage.Name;
                configData.ColorScheme = selectedColorScheme.Name;
                configData.AutoDiscoverStartAt = autoDiscStartDate.Date.Add(autoDiscStartTime.TimeOfDay);
                availableModules = [];
                foreach (Module module in modulesVisibleDict.Keys)
                {
                    if (modulesVisibleDict[module])
                    {
                        availableModules.Add(module);
                    }
                }
                configData.AvailableModules = JsonSerializer.Serialize(availableModules);
                dailyCheckModules = [];
                foreach (DailyCheckModule module in dailyCheckModulesVisibleDict.Keys)
                {
                    if (dailyCheckModulesVisibleDict[module])
                    {
                        dailyCheckModules.Add(module);
                    }
                }
                configData.DailyCheckModules = JsonSerializer.Serialize(dailyCheckModules);
                // an import script is waited for with a timeout in milliseconds which has to fit
                // into an int, a larger value would let every scripted import fail immediately
                configData.ImportScriptTimeout = Math.Min(configData.ImportScriptTimeout, GlobalConst.kMaxImportScriptTimeoutMinutes);
                // the REST list endpoints apply the same bounds, so the stored value is the one in effect
                configData.MaxRestResponseObjectLimit = ConfigData.GetUsableMaxRestResponseObjectLimit(configData.MaxRestResponseObjectLimit);

                await globalConfig.WriteToDatabase(configData, apiConnection);
                DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
            }
            else
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    private void OnFileUploadEvent(FileUploadEventArgs? e)
    {
        if (e is null)
        {
            return;
        }

        if (!e.Success && e.Error is not null)
        {
            DisplayMessageInUi(e.Error.InternalException, userConfig.GetText("change_default"), e.Error.Message ?? "", true);
            return;
        }

        // Fileupload was successful and data is a base64 string
        if (e.Success && e.Data is string && configData is not null)
        {
            configData.CustomLogoData = e.Data;
        }
    }

    /// <summary>
    /// Unsubscribes from file upload events when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        EventMediator.Unsubscribe<FileUploadEvent>(nameof(FileUploadService.ReadFileToBytes));
        EventMediator.Unsubscribe<FileUploadEvent>(nameof(FileUploadService.ImportCustomLogo));
    }

    private static int ConvertTokenLifetimeToMinutes(int lifetimeValue, TokenLifetimeUnit lifetimeUnit)
    {
        int safeLifetimeValue = Math.Max(1, lifetimeValue);

        return lifetimeUnit switch
        {
            TokenLifetimeUnit.Minutes => safeLifetimeValue,
            TokenLifetimeUnit.Hours => safeLifetimeValue * 60,
            TokenLifetimeUnit.Days => safeLifetimeValue * 60 * 24,
            _ => safeLifetimeValue
        };
    }

    private static int GetTokenLifetimeMinValue(TokenLifetimeUnit lifetimeUnit)
    {
        return lifetimeUnit switch
        {
            TokenLifetimeUnit.Minutes => 5,
            TokenLifetimeUnit.Hours => 1,
            TokenLifetimeUnit.Days => 1,
            _ => 1
        };
    }
}
