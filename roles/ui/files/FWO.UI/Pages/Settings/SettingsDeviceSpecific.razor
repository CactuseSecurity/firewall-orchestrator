@using FWO.Ui.Pages.Settings
@using FWO.Data.DeviceSpecificSettings

@page "/settings/devicespecificsettings"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject UserConfig userConfig
@inject GlobalConfig globalConfig
@inject IJSRuntime JsRuntime

<div class="input-group">
    <h3>@(userConfig.GetText("dss_settings"))</h3>
    <HelpLink Page="settings/devicespecificsettings" />
</div>
@(userConfig.GetText("dss_settings_intro"))
<hr />

@if (root == null)
{
    <Loading />
}
else
{
    <div class="row">
        <div class="col-sm-3 border-end">
            <ul class="navbar-nav flex-column mb-3">
                @RenderTreeNode(root)
            </ul>
            <div class="text-muted small">
                @(userConfig.GetText("dss_hierarchy_hint"))
            </div>
        </div>

        <div class="col-sm-9">
            @if (autoPlanCheck?.RulesAutomaticWithoutAlgorithm == true)
            {
                <div class="alert alert-warning-override small"><span class="@Icons.Warning pe-1"></span>@(userConfig.GetText("U5504"))</div>
            }
            @if (autoPlanCheck?.ManualWithoutPlanningPhase.Count > 0)
            {
                <div class="alert alert-warning-override small"><span class="@Icons.Warning pe-1"></span>@(userConfig.GetText("U5505")) @(string.Join(", ", autoPlanCheck.ManualWithoutPlanningPhase.Select(taskType => userConfig.GetText(taskType))))</div>
            }
            @if (implementationModeCheck?.HasFindings == true)
            {
                @RenderImplementationModeHints(implementationModeCheck)
            }
            @if (form != null)
            {
                <div class="d-flex align-items-center gap-2 mb-3">
                    @foreach (DeviceSpecificNode crumb in form.Node.SelfAndAncestors().Reverse())
                    {
                        bool isLast = crumb == form.Node;
                        <span class="fw-@(isLast ? "bold" : "normal")">@NodeName(crumb)</span>
                        @if (!isLast)
                        {
                            <span class="text-muted">&gt;</span>
                        }
                    }
                </div>

                <form onsubmit="return false">
                    @foreach (DeviceSpecificFieldState state in form.Fields.Where(state => state.Field.Section == DeviceSpecificFieldSection.General))
                    {
                        @RenderField(state, form)
                    }
                    @RenderSection(form, DeviceSpecificFieldSection.FirewallWrite, "dss_fw_write_section", "dss_fw_write_section_intro")
                    @RenderSection(form, DeviceSpecificFieldSection.SecureChange, "dss_sc_template_section", "dss_sc_template_section_intro")
                </form>

                @if (form.HasChanges)
                {
                    <div class="alert alert-warning small">@(userConfig.GetText("dss_unsaved_hint"))</div>
                }
                <ExecutionModeAuthorizeView Roles="@Roles.Admin">
                    <Authorized>
                        <button type="button" class="btn btn-sm btn-primary" disabled="@(!form.HasChanges || saving)" @onclick="Save">
                            @(DisplayService.DisplayButton(userConfig, "save", Icons.Save))
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <button type="button" class="btn btn-sm btn-primary" disabled>@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
                    </NotAuthorized>
                </ExecutionModeAuthorizeView>
                <button type="button" class="btn btn-sm btn-secondary" disabled="@(!form.HasChanges || saving)" @onclick="form.Reset">
                    @(DisplayService.DisplayButton(userConfig, "cancel", Icons.Cancel))
                </button>
            }
            else
            {
                <Loading />
            }
        </div>
    </div>
}

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private DeviceSpecificSettingsService? service;
    private DeviceSpecificNode? root;
    private DeviceSpecificLevelForm? form;
    private readonly HashSet<string> expandedNodeIds = [];
    private string? pendingHighlightFieldId;
    private bool saving;
    private AutoPlanSettingsCheckResult? autoPlanCheck;
    private ImplementationModeSettingsCheckResult? implementationModeCheck;
    private List<Management> managements = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            service = new DeviceSpecificSettingsService(new DeviceSpecificSettingsManager(apiConnection));
            managements = await apiConnection.SendQueryAsync<List<Management>>(DeviceQueries.getManagementDetailsWithoutSecrets) ?? [];
            root = await service.LoadHierarchyAsync(managements);
            await SelectNode(root);
            await RefreshAutoPlanCheck();
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("dss_settings"), userConfig.GetText("E5301"), true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingHighlightFieldId != null && form != null)
        {
            string fieldId = pendingHighlightFieldId;
            pendingHighlightFieldId = null;
            await JsRuntime.InvokeVoidAsync("scrollToElementAndHighlight", $"dss-field-{fieldId}");
        }
    }

    private const int kFirewallTemplateRows = 6;

    private static string FieldRowId(DeviceSpecificFieldDefinition field) => $"dss-field-{field.Id}";

    /// <summary>A collapsible section of the selected level's fields, opened while one of them has unsaved changes.</summary>
    private RenderFragment RenderSection(DeviceSpecificLevelForm levelForm, DeviceSpecificFieldSection section, string titleKey, string introKey) =>
        @<div>
            @if (levelForm.Fields.Any(state => state.Field.Section == section))
            {
                <details class="mt-4" open="@levelForm.Fields.Any(state => state.Field.Section == section && state.IsChanged)">
                    <summary class="h5">@(userConfig.GetText(titleKey))</summary>
                    <div class="text-muted small mb-3">@(userConfig.GetText(introKey))</div>
                    @foreach (DeviceSpecificFieldState state in levelForm.Fields.Where(state => state.Field.Section == section))
                    {
                        @RenderField(state, levelForm)
                    }
                </details>
            }
        </div>;

    /// <summary>Renders the editor block of one field of the selected level.</summary>
    private RenderFragment RenderField(DeviceSpecificFieldState state, DeviceSpecificLevelForm levelForm) =>
        @<div id="@FieldRowId(state.Field)" class="device-specific-field border rounded p-3 mb-3" data-toggle="tooltip" title="@(userConfig.GetText(state.Field.HelpTextKey))">
            @RenderFieldHeader(state)
            @if (state.IsDormant)
            {
                @RenderDormantField(state)
            }
            else
            {
                @RenderEditableField(state, levelForm)
            }
        </div>;

    /// <summary>Label, change badge and the switch between inherited and local value.</summary>
    private RenderFragment RenderFieldHeader(DeviceSpecificFieldState state) =>
        @<div class="d-flex align-items-center justify-content-between">
            <div class="fw-semibold">@FieldLabel(state.Field)</div>
            <div class="d-flex align-items-center gap-2">
                @if (state.IsChanged)
                {
                    <span class="badge rounded-pill bg-warning text-dark">@(userConfig.GetText("unsaved_changes"))</span>
                }
                @if (state.IsDormant)
                {
                    <span class="badge rounded-pill bg-info text-dark fw-bold">@(userConfig.GetText("dss_dormant_override"))</span>
                }
                else
                {
                    @RenderOverrideSwitch(state)
                }
            </div>
        </div>;

    private RenderFragment RenderOverrideSwitch(DeviceSpecificFieldState state) =>
        @<div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill fw-bold @(state.IsLocal ? "bg-success" : "bg-secondary")">
                @(state.IsLocal ? userConfig.GetText("dss_set_here") : userConfig.GetText("dss_inherited"))
            </span>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="@($"dss-override-{state.Field.Id}")" checked="@state.IsLocal"
                       disabled="@(saving || !CanEdit)" @onchange="e => ToggleOverride(state, e.Value is true)" />
                <label class="form-check-label small" for="@($"dss-override-{state.Field.Id}")">@(userConfig.GetText("dss_override_here"))</label>
            </div>
        </div>;

    /// <summary>A stored override that no longer applies at this level: shown read-only with a button to remove it.</summary>
    private RenderFragment RenderDormantField(DeviceSpecificFieldState state) =>
        @<div>
            <div class="mt-2">
                @RenderEditor(state.Field, state.OriginalValue, true, _ => { })
            </div>
            <div class="text-muted small mt-1">@(userConfig.GetText("dss_dormant_override_hint"))</div>
            <button type="button" class="dss-clear-dormant btn btn-sm btn-outline-danger mt-2"
                    disabled="@(!CanChangeLocalValue(state))" @onclick="() => ClearDormantOverride(state)">
                @(DisplayService.DisplayButton(userConfig, "dss_clear_override", Icons.Delete))
            </button>
        </div>;

    private RenderFragment RenderEditableField(DeviceSpecificFieldState state, DeviceSpecificLevelForm levelForm) =>
        @<div>
            <div class="mt-2">
                @RenderEditor(state.Field, state.DisplayedValue, !CanChangeLocalValue(state), v => SetLocalValue(state, v),
                    state.Field.ShippedDefaultFor(levelForm.Node), levelForm.Node.Level)
            </div>
            @if (state.Field.Key == DeviceSpecificSettingKeys.AutoPlanImplementationForRules)
            {
                <div class="text-muted small mt-1">@(userConfig.GetText("dss_auto_plan_rules_hint"))</div>
            }
            @if (state.Field.ShippedDefault != null)
            {
                @RenderShippedDefaultActions(state, state.Field.ShippedDefaultFor(levelForm.Node))
            }
            @if (!state.IsLocal)
            {
                @RenderInheritedSource(state, levelForm)
            }
        </div>;

    /// <summary>
    /// For fields with a default shipped for the device type: an empty value uses that default, also after an update that
    /// corrects it. "Reset to default" empties the value again, "Edit default" takes the default over for editing.
    /// </summary>
    private RenderFragment RenderShippedDefaultActions(DeviceSpecificFieldState state, string? shippedDefault) =>
        @<div>
            @if (state.DisplayedValue.Length == 0)
            {
                <div class="text-muted small mt-1">
                    @(userConfig.GetText(EmptyValueTextKey(state.Field, shippedDefault)))
                </div>
            }
            <button type="button" class="dss-reset-default btn btn-sm btn-outline-secondary mt-2 me-2"
                    disabled="@(!CanChangeLocalValue(state) || state.LocalValue.Length == 0)" @onclick="() => ResetToShippedDefault(state)">
                @(DisplayService.DisplayButton(userConfig, "dss_reset_to_default", Icons.Undo))
            </button>
            <button type="button" class="dss-edit-default btn btn-sm btn-outline-secondary mt-2"
                    disabled="@(!CanChangeLocalValue(state) || shippedDefault == null || state.LocalValue.Length > 0)"
                    @onclick="() => EditShippedDefault(state)">
                @(DisplayService.DisplayButton(userConfig, "dss_edit_default", Icons.Edit))
            </button>
        </div>;

    /// <summary>Explains what an empty value means: the shipped default applies, or there is none.</summary>
    private static string EmptyValueTextKey(DeviceSpecificFieldDefinition field, string? shippedDefault)
    {
        if (field.Section == DeviceSpecificFieldSection.SecureChange)
        {
            return shippedDefault == null ? "dss_sc_template_no_default" : "dss_sc_template_uses_default";
        }
        return shippedDefault == null ? "dss_fw_write_not_supported" : "dss_fw_write_uses_default";
    }

    private RenderFragment RenderInheritedSource(DeviceSpecificFieldState state, DeviceSpecificLevelForm levelForm) =>
        @<div class="text-muted small mt-1">
            @if (SourceNode(state) is DeviceSpecificNode sourceNode)
            {
                @(userConfig.GetText("dss_inherited_from"))
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" disabled="@(saving || levelForm.HasChanges)"
                        @onclick="() => NavigateToSource(state.Field, sourceNode)">
                    <strong>@LevelLabel(sourceNode.Level)</strong> "@NodeName(sourceNode)" <span class="@Icons.Use"></span>
                </button>
            }
            else
            {
                @(userConfig.GetText("dss_compiled_default"))
            }
        </div>;

    /// <summary>Whether the local value of the field can be edited now: admin, not saving, and overridden at this level.</summary>
    private bool CanChangeLocalValue(DeviceSpecificFieldState state) => !saving && CanEdit && state.IsLocal;

    private RenderFragment RenderTreeNode(DeviceSpecificNode node) =>
        @<li class="nav-item @(node.Parent == null ? "" : "ms-2")">
            <button type="button" class="btn btn-sm w-100 text-start mb-1 @(form?.Node == node ? "btn-primary" : "btn-light")"
                    disabled="@(saving || (form?.HasChanges == true && form.Node != node))" @onclick="() => SelectNode(node)">
                <span class="@NodeIcon(node.Level)"></span> @NodeName(node)
            </button>
            @if (node.Children.Count > 0 && (node.Parent == null || expandedNodeIds.Contains(node.Id)))
            {
                <ul class="list-unstyled">
                    @foreach (DeviceSpecificNode child in node.Children)
                    {
                        @RenderTreeNode(child)
                    }
                </ul>
            }
        </li>;

    private static string NodeIcon(DeviceSpecificScopeType level) => level switch
    {
        DeviceSpecificScopeType.Global => Icons.Settings,
        DeviceSpecificScopeType.Gateway => Icons.Gateway,
        _ => Icons.Management
    };

    /// <summary>Loads the given node's form and expands the tree down to it. Blocked while there are unsaved edits.</summary>
    private async Task SelectNode(DeviceSpecificNode node)
    {
        if (saving || service == null || (form?.HasChanges == true && form.Node != node))
        {
            return;
        }

        foreach (DeviceSpecificNode ancestor in node.SelfAndAncestors())
        {
            expandedNodeIds.Add(ancestor.Id);
        }

        try
        {
            form = null;
            form = await service.LoadFormAsync(node);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("dss_settings"), userConfig.GetText("E5301"), true);
        }
    }

    private async Task Save()
    {
        if (saving || service == null || form == null)
        {
            return;
        }

        DeviceSpecificLevelForm formToSave = form;
        DeviceSpecificNode nodeToReload = form.Node;
        saving = true;
        try
        {
            await service.SaveAsync(formToSave);
            form = await service.LoadFormAsync(nodeToReload);
            await RefreshAutoPlanCheck();
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("dss_settings"), "", true);
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>
    /// Checks the auto plan settings of all levels against the path analysis algorithm and the planning phases. A
    /// failure only hides the hints, the settings stay editable.
    /// </summary>
    private async Task RefreshAutoPlanCheck()
    {
        if (root == null)
        {
            return;
        }
        try
        {
            autoPlanCheck = await AutoPlanSettingsCheck.LoadAndCheck(apiConnection, root, globalConfig.PathAnalysisAlgorithm);
        }
        catch (Exception exception)
        {
            autoPlanCheck = null;
            Log.WriteError("Auto Plan Settings Check", "Could not check the auto plan settings.", exception);
        }
        await RefreshImplementationModeCheck();
    }

    /// <summary>
    /// Checks the implementation mode, external ticket system and object creation settings of all levels. A failure
    /// only hides the hints, the settings stay editable.
    /// </summary>
    private async Task RefreshImplementationModeCheck()
    {
        if (root == null)
        {
            return;
        }
        try
        {
            implementationModeCheck = await ImplementationModeSettingsCheck.LoadAndCheck(apiConnection, root, managements);
        }
        catch (Exception exception)
        {
            implementationModeCheck = null;
            Log.WriteError("Implementation Mode Settings Check", "Could not check the implementation mode settings.", exception);
        }
    }

    private RenderFragment RenderImplementationModeHints(ImplementationModeSettingsCheckResult check) =>
        @<div>
            @RenderNodeHint("U5506", check.ExternalModeWithoutSystem)
            @RenderNodeHint("U5507", check.SystemWithoutExternalMode)
            @RenderNodeHint("U5508", check.GatewayDiffersInExternalMode)
            @foreach (ObjectCreationFinding finding in check.ObjectCreationFindings)
            {
                string alertClass = finding.Type == ObjectCreationFindingType.MixedCreation ? "alert alert-info small" : "alert alert-warning-override small";
                <div class="@alertClass">
                    @if (finding.Type != ObjectCreationFindingType.MixedCreation)
                    {
                        <span class="@Icons.Warning pe-1"></span>
                    }
                    @(userConfig.GetText(ObjectCreationFindingTextKey(finding.Type)))
                    @($" {finding.SuperManagement.Name} ({string.Join(", ", finding.Kinds.Select(kind => userConfig.GetText(ObjectKindTextKey(kind))))}): ")
                    @(string.Join(", ", finding.Managements.Select(management => management.Name)))
                </div>
            }
        </div>;

    private RenderFragment RenderNodeHint(string textKey, List<DeviceSpecificNode> nodes) =>
        @<div>
            @if (nodes.Count > 0)
            {
                <div class="alert alert-warning-override small"><span class="@Icons.Warning pe-1"></span>@(userConfig.GetText(textKey)) @(string.Join(", ", nodes.Select(NodeName)))</div>
            }
        </div>;

    private static string ObjectCreationFindingTextKey(ObjectCreationFindingType type) =>
        type == ObjectCreationFindingType.SuperSettingWithoutEffect ? "U5509" : "U5511";

    private static string ObjectKindTextKey(ObjectTaskKind kind) => kind switch
    {
        ObjectTaskKind.Service => "dss_service_object_creation",
        ObjectTaskKind.Time => "dss_time_object_creation",
        _ => "dss_address_object_creation"
    };

    /// <summary>
    /// Only admins can change the settings. Auditors see the same page with all editors disabled, so they cannot
    /// build up edits that they could not save.
    /// </summary>
    private bool CanEdit => userConfig.CanUseAnyRole(Roles.Admin);

    private void ToggleOverride(DeviceSpecificFieldState state, bool overrideHere)
    {
        if (saving || !CanEdit)
        {
            return;
        }

        if (overrideHere)
        {
            state.Override();
        }
        else
        {
            state.Inherit();
        }
    }

    private void SetLocalValue(DeviceSpecificFieldState state, string value)
    {
        if (!saving && CanEdit)
        {
            state.LocalValue = value;
        }
    }

    /// <summary>Empties the local value, so the default shipped for the device type applies, including later corrections of it.</summary>
    private void ResetToShippedDefault(DeviceSpecificFieldState state)
    {
        if (CanChangeLocalValue(state))
        {
            state.LocalValue = "";
        }
    }

    /// <summary>Takes the default shipped for the device type over as local value, to adapt it.</summary>
    private void EditShippedDefault(DeviceSpecificFieldState state)
    {
        if (CanChangeLocalValue(state) && form != null)
        {
            state.LocalValue = state.Field.ShippedDefaultFor(form.Node) ?? "";
        }
    }

    /// <summary>The field label, preceded by the operation for firewall write endpoints and templates, or by the task type for SecureChange templates.</summary>
    private string FieldLabel(DeviceSpecificFieldDefinition field) => field.LabelDetailTextKey == null
        ? userConfig.GetText(field.LabelTextKey)
        : $"{userConfig.GetText(field.LabelDetailTextKey)}: {userConfig.GetText(field.LabelTextKey)}";

    private void ClearDormantOverride(DeviceSpecificFieldState state)
    {
        if (!saving && CanEdit && state.IsDormant)
        {
            state.Inherit();
        }
    }

    private DeviceSpecificNode? SourceNode(DeviceSpecificFieldState state) =>
        root == null || state.InheritedSource == null ? null : DeviceSpecificSettingsData.FindNode(root, state.InheritedSource);

    /// <summary>Jumps to the node a field's value is currently inherited from, so it can be edited there.</summary>
    private async Task NavigateToSource(DeviceSpecificFieldDefinition field, DeviceSpecificNode sourceNode)
    {
        if (saving || form == null || sourceNode == form.Node || form.HasChanges)
        {
            return;
        }

        await SelectNode(sourceNode);
        pendingHighlightFieldId = field.Id;
    }

    /// <summary>The root's stored name is a fixed technical label, so it is shown localized.</summary>
    private string NodeName(DeviceSpecificNode node) => node.Parent == null ? userConfig.GetText("dss_global") : node.Name;

    private string LevelLabel(DeviceSpecificScopeType level) => level switch
    {
        DeviceSpecificScopeType.Global => userConfig.GetText("dss_global"),
        DeviceSpecificScopeType.DeviceType => userConfig.GetText("dss_device_type"),
        DeviceSpecificScopeType.Management => userConfig.GetText("dss_manager"),
        DeviceSpecificScopeType.Gateway => userConfig.GetText("dss_gateway"),
        _ => level.ToString()
    };

    /// <summary>
    /// Renders a field's control. Read-only while the field inherits its value; switching on
    /// "override here" makes it editable and reports edits via <paramref name="onChange"/>.
    /// </summary>
    /// <param name="placeholder">Grey hint shown while the value is empty, e.g. the default shipped for the device type.</param>
    /// <param name="level">Level of the edited node, which restricts the options of a select; null offers all options.</param>
    private RenderFragment RenderEditor(DeviceSpecificFieldDefinition field, string value, bool disabled, Action<string> onChange,
        string? placeholder = null, DeviceSpecificScopeType? level = null) => builder =>
    {
        Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> changeCallback =
            Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => onChange(e.Value?.ToString() ?? ""));

        switch (field.Kind)
        {
            case DeviceSpecificFieldKind.SingleSelect:
                builder.OpenElement(0, "select");
                builder.AddAttribute(1, "class", "form-select form-select-sm w-auto");
                builder.AddAttribute(2, "value", value);
                builder.AddAttribute(3, "onchange", changeCallback);
                builder.AddAttribute(4, "disabled", disabled);
                foreach (DeviceSpecificFieldOption option in level is DeviceSpecificScopeType editedLevel ? field.OptionsForLevel(editedLevel, value) : field.Options)
                {
                    builder.OpenElement(5, "option");
                    builder.AddAttribute(6, "value", option.Value);
                    builder.AddContent(7, userConfig.GetText(option.TextKey));
                    builder.CloseElement();
                }
                builder.CloseElement();
                break;

            case DeviceSpecificFieldKind.ExtTicketSystem:
                builder.OpenElement(0, "select");
                builder.AddAttribute(1, "class", "form-select form-select-sm w-auto");
                builder.AddAttribute(2, "value", value);
                builder.AddAttribute(3, "onchange", changeCallback);
                builder.AddAttribute(4, "disabled", disabled);
                builder.OpenElement(5, "option");
                builder.AddAttribute(6, "value", "");
                builder.AddContent(7, userConfig.GetText("undefined"));
                builder.CloseElement();
                foreach ((string optionValue, string name) in DeviceSpecificSettingsData.ExtTicketSystemOptions(userConfig.ExtTicketSystems, value))
                {
                    builder.OpenElement(8, "option");
                    builder.AddAttribute(9, "value", optionValue);
                    builder.AddContent(10, name);
                    builder.CloseElement();
                }
                builder.CloseElement();
                break;

            case DeviceSpecificFieldKind.TemplateText:
                builder.OpenElement(0, "textarea");
                builder.AddAttribute(1, "class", "form-control form-control-sm");
                builder.AddAttribute(2, "rows", 4);
                builder.AddAttribute(3, "placeholder", userConfig.GetText("dss_templates_placeholder"));
                builder.AddAttribute(4, "value", value);
                builder.AddAttribute(5, "onchange", changeCallback);
                builder.AddAttribute(6, "disabled", disabled);
                builder.CloseElement();
                break;

            case DeviceSpecificFieldKind.FirewallEndpoint:
                builder.AddContent(0, RenderEndpointEditor(value, disabled, onChange, placeholder));
                break;

            case DeviceSpecificFieldKind.FirewallTemplate:
            case DeviceSpecificFieldKind.SecureChangeTemplate:
                builder.OpenElement(0, "textarea");
                builder.AddAttribute(1, "class", "form-control form-control-sm font-monospace");
                builder.AddAttribute(2, "rows", kFirewallTemplateRows);
                builder.AddAttribute(3, "value", value);
                builder.AddAttribute(4, "placeholder", placeholder);
                builder.AddAttribute(5, "onchange", changeCallback);
                builder.AddAttribute(6, "disabled", disabled);
                builder.CloseElement();
                break;

            case DeviceSpecificFieldKind.StringList:
                builder.AddContent(0, RenderStringList(value, disabled, onChange));
                break;

            default:
                builder.OpenElement(0, "input");
                builder.AddAttribute(1, "type", "text");
                builder.AddAttribute(2, "class", "form-control form-control-sm w-auto");
                builder.AddAttribute(3, "value", value);
                builder.AddAttribute(4, "onchange", changeCallback);
                builder.AddAttribute(5, "disabled", disabled);
                builder.CloseElement();
                break;
        }
    };

    /// <summary>
    /// Renders an endpoint as HTTP method drop-down and path input, stored together as "METHOD path". While the value is
    /// empty, the drop-down shows the shipped default method and the path input the shipped default path in grey.
    /// </summary>
    private RenderFragment RenderEndpointEditor(string value, bool disabled, Action<string> onChange, string? shippedDefault)
    {
        (string method, string path) = FirewallWriteEndpoint.SplitSetting(value);
        (string defaultMethod, string defaultPath) = FirewallWriteEndpoint.SplitSetting(shippedDefault ?? "");
        return @<div class="input-group input-group-sm">
            <select class="dss-endpoint-method form-select form-select-sm flex-grow-0 w-auto font-monospace @(method.Length == 0 ? "text-muted" : "")"
                    value="@method" disabled="@disabled"
                    @onchange="e => onChange(DeviceSpecificSettingsData.ChangeEndpoint(value, shippedDefault, method: ChangedText(e)))">
                @if (method.Length == 0)
                {
                    <option value="">@defaultMethod</option>
                }
                @foreach (string allowedMethod in FirewallWriteEndpoint.AllowedMethods)
                {
                    <option value="@allowedMethod">@allowedMethod</option>
                }
            </select>
            <input type="text" class="dss-endpoint-path form-control form-control-sm font-monospace" value="@path" placeholder="@defaultPath"
                   disabled="@disabled" @onchange="e => onChange(DeviceSpecificSettingsData.ChangeEndpoint(value, shippedDefault, path: ChangedText(e)))" />
        </div>;
    }

    private static string ChangedText(Microsoft.AspNetCore.Components.ChangeEventArgs changeEvent) => changeEvent.Value?.ToString() ?? "";

    /// <summary>Renders a list of text inputs with add/remove buttons, stored as a comma separated value.</summary>
    private RenderFragment RenderStringList(string value, bool disabled, Action<string> onChange) => builder =>
    {
        // A plain split keeps one empty row for an empty list, so adding the first entry works.
        List<string> items = [.. value.Split(',', StringSplitOptions.TrimEntries)];
        void Update(Action<List<string>> change)
        {
            List<string> current = [.. value.Split(',', StringSplitOptions.TrimEntries)];
            change(current);
            onChange(string.Join(",", current));
        }

        builder.OpenElement(0, "div");
        for (int i = 0; i < items.Count; i++)
        {
            int idx = i;
            builder.OpenElement(1, "div");
            builder.AddAttribute(2, "class", "d-flex mb-1 gap-1");

            builder.OpenElement(3, "input");
            builder.AddAttribute(4, "type", "text");
            builder.AddAttribute(5, "class", "form-control form-control-sm");
            builder.AddAttribute(6, "value", items[idx]);
            builder.AddAttribute(7, "disabled", disabled);
            builder.AddAttribute(8, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this,
                e => Update(current => { if (idx < current.Count) current[idx] = e.Value?.ToString() ?? ""; })));
            builder.CloseElement();

            builder.OpenElement(9, "button");
            builder.AddAttribute(10, "type", "button");
            builder.AddAttribute(11, "class", "btn btn-sm btn-danger");
            builder.AddAttribute(12, "disabled", disabled);
            builder.AddAttribute(13, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this,
                () => Update(current => { if (idx < current.Count) current.RemoveAt(idx); })));
            builder.OpenElement(14, "span");
            builder.AddAttribute(15, "class", Icons.Delete);
            builder.CloseElement();
            builder.CloseElement();

            builder.CloseElement();
        }

        builder.OpenElement(20, "button");
        builder.AddAttribute(21, "type", "button");
        builder.AddAttribute(22, "class", "btn btn-sm btn-primary");
        builder.AddAttribute(23, "disabled", disabled);
        builder.AddAttribute(24, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => Update(current => current.Add(""))));
        builder.OpenElement(25, "span");
        builder.AddAttribute(26, "class", Icons.Add);
        builder.CloseElement();
        builder.CloseElement();

        builder.CloseElement();
    };
}
