@using FWO.Ui.Pages.Settings
@using FWO.Data.Provisioning

@page "/settings/fwconfigprovisioning"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject UserConfig userConfig
@inject IJSRuntime JsRuntime

<div class="input-group">
    <h3>@(userConfig.GetText("prov_settings"))</h3>
    <HelpLink Page="settings/fwconfigprovisioning" />
</div>
@(userConfig.GetText("prov_settings_intro"))
<hr />

<div class="row">
    <div class="col-sm-3 border-end">
        <ul class="navbar-nav flex-column mb-3">
            <li class="nav-item">
                <button type="button" class="btn btn-sm w-100 text-start mb-1 @(SelectedNode?.Id == "global" ? "btn-primary" : "btn-light")"
                        @onclick="SelectGlobal">
                    <span class="@Icons.Settings"></span> @(userConfig.GetText("prov_global"))
                </button>
            </li>
            @foreach (ProvisioningNode deviceType in ProvisioningSettingsData.GetChildren(allNodes, ProvisioningSettingsData.GlobalNodeKey))
            {
                <li class="nav-item ms-2">
                    <button type="button" class="btn btn-sm w-100 text-start mb-1 @(SelectedNode?.Id == deviceType.Id ? "btn-primary" : "btn-light")"
                            @onclick="() => SelectNode(deviceType)">
                        <span class="@Icons.Management"></span> @deviceType.Name
                    </button>
                    @if (expandedDeviceTypeIds.Contains(deviceType.Id))
                    {
                        @foreach (ProvisioningNode manager in ProvisioningSettingsData.GetChildren(allNodes, deviceType.Id))
                        {
                            <ul class="list-unstyled ms-3">
                                <li>
                                    <button type="button" class="btn btn-sm w-100 text-start mb-1 @(SelectedNode?.Id == manager.Id ? "btn-primary" : "btn-outline-light text-dark")"
                                            @onclick="() => SelectNode(manager)">
                                        <span class="@Icons.Management"></span> @manager.Name
                                    </button>
                                    @if (expandedManagerIds.Contains(manager.Id))
                                    {
                                        <ul class="list-unstyled ms-3">
                                            @foreach (ProvisioningNode gateway in ProvisioningSettingsData.GetChildren(allNodes, manager.Id))
                                            {
                                                <li>
                                                    <button type="button" class="btn btn-sm w-100 text-start mb-1 @(SelectedNode?.Id == gateway.Id ? "btn-primary" : "btn-outline-light text-dark")"
                                                            @onclick="() => SelectNode(gateway)">
                                                        <span class="@Icons.Gateway"></span> @gateway.Name
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            </ul>
                        }
                    }
                </li>
            }
        </ul>
        <div class="text-muted small">
            @(userConfig.GetText("prov_hierarchy_hint"))
        </div>
    </div>

    <div class="col-sm-9">
        @if (SelectedNode != null)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                @foreach ((ProvisioningNode crumb, bool isLast) in BreadcrumbChain())
                {
                    <span class="fw-@(isLast ? "bold" : "normal")">@crumb.Name</span>
                    @if (!isLast)
                    {
                        <span class="text-muted">&gt;</span>
                    }
                }
            </div>

            <form onsubmit="return false">
                @foreach (ProvisioningFieldDefinition field in VisibleFields())
                {
                    ProvisioningResolvedValue resolved = ProvisioningSettingsData.Resolve(allNodes, SelectedNode, field);
                    bool overriddenHere = resolved.IsOverriddenHere;
                    ProvisioningNode? sourceNode = resolved.SourceNode;

                    <div id="@FieldRowId(field)" class="border rounded p-3 mb-3" data-toggle="tooltip" title="@(userConfig.GetText(field.HelpTextKey))">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="fw-semibold">@(userConfig.GetText(field.LabelTextKey))</div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill fw-bold @(overriddenHere ? "bg-success" : "bg-secondary")">
                                    @(overriddenHere ? userConfig.GetText("prov_set_here") : userConfig.GetText("prov_inherited"))
                                </span>
                                @if (overriddenHere && SelectedNode.Level != ProvisioningScopeType.Global)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(userConfig.GetText("prov_reset_to_inherited"))"
                                            @onclick="() => ResetOverride(field)">
                                        <span class="@Icons.Undo"></span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="mt-2">
                            @RenderEditor(field, overriddenHere ? GetOverrideValue(field) : resolved.Value, v => SetOverrideValue(field, v))
                        </div>

                        @if (!overriddenHere && sourceNode != null)
                        {
                            <div class="text-muted small mt-1">
                                @(userConfig.GetText("prov_inherited_from"))
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => NavigateToSource(field, sourceNode)">
                                    <strong>@LevelLabel(sourceNode.Level)</strong> "@sourceNode.Name" <span class="@Icons.Use"></span>
                                </button>
                            </div>
                        }
                        else if (!overriddenHere)
                        {
                            <div class="text-muted small mt-1">
                                @(userConfig.GetText("prov_not_set"))
                            </div>
                        }
                    </div>
                }
            </form>

            <div class="alert alert-info small">
                @(userConfig.GetText("prov_mock_data_hint"))
            </div>
        }
        else
        {
            <Loading />
        }
    </div>
</div>

@code
{
    private List<ProvisioningNode> allNodes = [];
    private readonly HashSet<string> expandedDeviceTypeIds = [];
    private readonly HashSet<string> expandedManagerIds = [];

    private ProvisioningNode? SelectedNode;
    private string? pendingHighlightFieldKey;

    protected override void OnInitialized()
    {
        allNodes = ProvisioningSettingsData.BuildSampleHierarchy();
        SelectedNode = NodeById(ProvisioningSettingsData.GlobalNodeKey);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingHighlightFieldKey != null)
        {
            string fieldKey = pendingHighlightFieldKey;
            pendingHighlightFieldKey = null;
            await JsRuntime.InvokeVoidAsync("scrollToElementAndHighlight", $"prov-field-{fieldKey}");
        }
    }

    private static string FieldRowId(ProvisioningFieldDefinition field) => $"prov-field-{field.Key}";

    /// <summary>Jumps to the node a field's value is currently inherited from, so it can be edited there.</summary>
    private void NavigateToSource(ProvisioningFieldDefinition field, ProvisioningNode sourceNode)
    {
        if (SelectedNode == null || sourceNode.Id == SelectedNode.Id)
        {
            return;
        }

        SelectNode(sourceNode);
        pendingHighlightFieldKey = field.Key;
    }

    private ProvisioningNode? NodeById(string id) => ProvisioningSettingsData.NodeById(allNodes, id);

    private ProvisioningNode? ParentOf(ProvisioningNode node) => allNodes.FirstOrDefault(n => n.NodeId == node.ParentNodeId);

    private void SelectGlobal() => SelectNode(NodeById(ProvisioningSettingsData.GlobalNodeKey));

    private void SelectNode(ProvisioningNode? node)
    {
        if (node == null)
        {
            return;
        }

        SelectedNode = node;

        if (node.Level == ProvisioningScopeType.DeviceType)
        {
            expandedDeviceTypeIds.Add(node.Id);
        }
        else if (node.Level == ProvisioningScopeType.Management)
        {
            ProvisioningNode? deviceType = ParentOf(node);
            if (deviceType != null)
            {
                expandedDeviceTypeIds.Add(deviceType.Id);
            }
            expandedManagerIds.Add(node.Id);
        }
        else if (node.Level == ProvisioningScopeType.Gateway)
        {
            ProvisioningNode? manager = ParentOf(node);
            if (manager != null)
            {
                expandedManagerIds.Add(manager.Id);
                ProvisioningNode? deviceType = ParentOf(manager);
                if (deviceType != null)
                {
                    expandedDeviceTypeIds.Add(deviceType.Id);
                }
            }
        }
    }

    private IEnumerable<(ProvisioningNode node, bool isLast)> BreadcrumbChain()
    {
        if (SelectedNode == null)
        {
            yield break;
        }

        List<ProvisioningNode> chain = ProvisioningSettingsData.GetAncestryChain(allNodes, SelectedNode);
        chain.Reverse();
        for (int i = 0; i < chain.Count; i++)
        {
            yield return (chain[i], i == chain.Count - 1);
        }
    }

    private IEnumerable<ProvisioningFieldDefinition> VisibleFields()
    {
        if (SelectedNode == null)
        {
            yield break;
        }

        foreach (ProvisioningFieldDefinition field in ProvisioningSettingsData.Fields)
        {
            if (!field.AppliesToLevel(SelectedNode.Level))
            {
                continue;
            }

            if (field.FortiManagerOnly && SelectedNode.DeviceTypeGroup != ProvisioningDeviceTypeGroups.FortiManager)
            {
                continue;
            }

            yield return field;
        }
    }

    /// <summary>Clears the field on the selected scope, reverting it back to its inherited value.</summary>
    private void ResetOverride(ProvisioningFieldDefinition field)
    {
        if (SelectedNode == null || SelectedNode.Level == ProvisioningScopeType.Global)
        {
            return;
        }

        field.Clear(SelectedNode.Settings);
    }

    private string GetOverrideValue(ProvisioningFieldDefinition field)
    {
        return SelectedNode != null && field.IsSetOn(SelectedNode.Settings) ? field.Read(SelectedNode.Settings) : field.DefaultValue;
    }

    private void SetOverrideValue(ProvisioningFieldDefinition field, string value)
    {
        if (SelectedNode != null)
        {
            field.Write(SelectedNode.Settings, value);
        }
    }

    private string LevelLabel(ProvisioningScopeType level) => level switch
    {
        ProvisioningScopeType.Global => userConfig.GetText("prov_global"),
        ProvisioningScopeType.DeviceType => userConfig.GetText("prov_device_type"),
        ProvisioningScopeType.Management => userConfig.GetText("prov_manager"),
        ProvisioningScopeType.Gateway => userConfig.GetText("prov_gateway"),
        _ => level.ToString()
    };

    /// <summary>
    /// Renders a field's control. Always editable, whether the field currently shows the
    /// "set here" value or the inherited one - editing an inherited value overrides it at
    /// the selected node via <paramref name="onChange"/>.
    /// </summary>
    private RenderFragment RenderEditor(ProvisioningFieldDefinition field, string value, Action<string> onChange) => builder =>
    {
        Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> changeCallback =
            Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => onChange(e.Value?.ToString() ?? ""));

        switch (field.Kind)
        {
            case ProvisioningFieldKind.SingleSelect:
                builder.OpenElement(0, "select");
                builder.AddAttribute(1, "class", "form-select form-select-sm w-auto");
                builder.AddAttribute(2, "value", value);
                builder.AddAttribute(3, "onchange", changeCallback);
                foreach (ProvisioningFieldOption option in field.Options)
                {
                    builder.OpenElement(5, "option");
                    builder.AddAttribute(6, "value", option.Value);
                    builder.AddContent(7, option.DisplayName);
                    builder.CloseElement();
                }
                builder.CloseElement();
                break;

            case ProvisioningFieldKind.TemplateText:
                builder.OpenElement(0, "textarea");
                builder.AddAttribute(1, "class", "form-control form-control-sm");
                builder.AddAttribute(2, "rows", 4);
                builder.AddAttribute(3, "placeholder", userConfig.GetText("prov_templates_placeholder"));
                builder.AddAttribute(4, "value", value);
                builder.AddAttribute(5, "onchange", changeCallback);
                builder.CloseElement();
                break;

            case ProvisioningFieldKind.MultiSelectTags:
                builder.OpenElement(0, "div");
                builder.OpenElement(1, "input");
                builder.AddAttribute(2, "type", "text");
                builder.AddAttribute(3, "class", "form-control form-control-sm");
                builder.AddAttribute(4, "placeholder", userConfig.GetText("prov_tags_placeholder"));
                builder.AddAttribute(5, "value", value);
                builder.AddAttribute(6, "onchange", changeCallback);
                builder.CloseElement();

                if (!string.IsNullOrWhiteSpace(value))
                {
                    builder.OpenElement(8, "div");
                    builder.AddAttribute(9, "class", "mt-1");
                    foreach (string tag in value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        builder.OpenElement(10, "span");
                        builder.AddAttribute(11, "class", "badge bg-secondary me-1");
                        builder.AddContent(12, tag);
                        builder.CloseElement();
                    }
                    builder.CloseElement();
                }
                builder.CloseElement();
                break;

            case ProvisioningFieldKind.StringList:
                {
                    List<string> ParseList() => value.Split(',', StringSplitOptions.TrimEntries).ToList();
                    string BuildValue(List<string> items) => string.Join(",", items);

                    List<string> items = ParseList();

                    builder.OpenElement(0, "div");
                    for (int i = 0; i < items.Count; i++)
                    {
                        int idx = i;
                        Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> itemChangeCallback =
                            Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e =>
                            {
                                List<string> current = ParseList();
                                if (idx < current.Count)
                                {
                                    current[idx] = e.Value?.ToString() ?? "";
                                    onChange(BuildValue(current));
                                }
                            });

                        Microsoft.AspNetCore.Components.EventCallback removeCallback =
                            Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () =>
                            {
                                List<string> current = ParseList();
                                if (idx < current.Count)
                                {
                                    current.RemoveAt(idx);
                                    onChange(BuildValue(current));
                                }
                            });

                        builder.OpenElement(1, "div");
                        builder.AddAttribute(2, "class", "d-flex mb-1 gap-1");

                        builder.OpenElement(3, "input");
                        builder.AddAttribute(4, "type", "text");
                        builder.AddAttribute(5, "class", "form-control form-control-sm");
                        builder.AddAttribute(6, "value", items[idx]);
                        builder.AddAttribute(7, "onchange", itemChangeCallback);
                        builder.CloseElement();

                        builder.OpenElement(8, "button");
                        builder.AddAttribute(9, "type", "button");
                        builder.AddAttribute(10, "class", "btn btn-sm btn-danger");
                        builder.AddAttribute(11, "onclick", removeCallback);
                        builder.OpenElement(12, "span");
                        builder.AddAttribute(13, "class", Icons.Delete);
                        builder.CloseElement();
                        builder.CloseElement();

                        builder.CloseElement();
                    }

                    Microsoft.AspNetCore.Components.EventCallback addCallback =
                        Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () =>
                        {
                            List<string> current = ParseList();
                            current.Add("");
                            onChange(BuildValue(current));
                        });

                    builder.OpenElement(20, "button");
                    builder.AddAttribute(21, "type", "button");
                    builder.AddAttribute(22, "class", "btn btn-sm btn-primary");
                    builder.AddAttribute(23, "onclick", addCallback);
                    builder.OpenElement(24, "span");
                    builder.AddAttribute(25, "class", Icons.Add);
                    builder.CloseElement();
                    builder.CloseElement();

                    builder.CloseElement();
                }
                break;

            default:
                builder.OpenElement(0, "input");
                builder.AddAttribute(1, "type", "text");
                builder.AddAttribute(2, "class", "form-control form-control-sm w-auto");
                builder.AddAttribute(3, "value", value);
                builder.AddAttribute(4, "onchange", changeCallback);
                builder.CloseElement();
                break;
        }
    };
}
