@page "/settings/importer"
@using System.Text.Json
@using FWO.Services
@using FWO.Services.EventMediator.Events
@using FWO.Services.EventMediator.Interfaces
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig
@inject IEventMediator EventMediator

@implements IDisposable

<div class="input-group">
    <h3>@(userConfig.GetText("importer_settings"))</h3>
    <HelpLink Page="settings/importer" />
</div>
@(userConfig.GetText("U5311"))
<hr />

@if (configData != null)
{
    <form onsubmit="return false">
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5496"))">
            <label class="col-form-label col-sm-4">@(userConfig.GetText("importSleepTime")):</label>
            <div class="col-sm-2">
                <input type="number" min="0" @bind="configData!.ImportSleepTime" />
            </div>
        </div>
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5497"))">
            <label for="cbx_check_certificates" class="col-form-label col-sm-4">@(userConfig.GetText("importCheckCertificates")):</label>
            <div class="col-sm-1">
                <input id="cbx_check_certificates" type="checkbox" class="w-100" @bind="configData!.ImportCheckCertificates" />
            </div>
        </div>
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5498"))">
            <label for="cbx_suppress_certificate_warnings" class="col-form-label col-sm-4">@(userConfig.GetText("importSuppressCertificateWarnings")):</label>
            <div class="col-sm-1">
                <input id="cbx_suppress_certificate_warnings" type="checkbox" class="w-100" @bind="configData!.ImportSuppressCertificateWarnings" />
            </div>
        </div>
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5499"))">
            <label class="col-form-label col-sm-4">@(userConfig.GetText("fwApiElementsPerFetch")):</label>
            <div class="col-sm-2">
                <input type="number" min="0" @bind="configData!.FwApiElementsPerFetch" />
            </div>
        </div>
    </form>
    <hr />
    <h3>@(userConfig.GetText("custom_field_import_Settings"))</h3>
    <OwnerMappingSourceEditor Handler="@ownerMappingSourceHandler" />
    @* shown for every owner mapping source: the change-ID keys are read by rule reports, notification mails and the rule REST API *@
    <div class="form-group row mb-4" data-toggle="tooltip" title="@(userConfig.PureLine("H5678"))">
        <label class="col-form-label col-sm-4">@userConfig.GetText("custom_field_ChangeID_key"):</label>
        <div class="col-sm-5">
            <EditList ElementType="string" Elements="ChangeIdKeys.ToArray()" ElementsToAdd="ChangeIdKeysToAdd"
                      ElementsToDelete="ChangeIdKeysToDelete" StdLayout="false">
                <Display>
                    <div class="row">
                        <div class="col-sm-12 border bg-transparent">@context</div>
                    </div>
                </Display>
            </EditList>
            <div class="row col-sm-12 mt-1">
                <input type="text" class="col-sm-10" @bind="ActiveChangeIdKey" />
                <button type="button" class="col-sm-2 btn btn-sm btn-primary" @onclick="AddChangeIdKey"
                        @onclick:preventDefault>
                    @(DisplayService.DisplayButton(userConfig, "add", Icons.Add))
                </button>
            </div>
        </div>
    </div>
    <ExecutionModeAuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(userConfig.GetText("save"))</button>
        </Authorized>
        <NotAuthorized>
            <button type="button" class="btn btn-sm btn-primary" disabled>@(userConfig.GetText("save"))</button>
        </NotAuthorized>
    </ExecutionModeAuthorizeView>
}
else
{
    <Loading />
}



@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private UpdateRuleOwnerMapping? updateOwnerRuleMappings;
    private readonly OwnerMappingSourceHandler ownerMappingSourceHandler = new();

    private string ActiveChangeIdKey = "";
    private List<string> ChangeIdKeys = [];
    private List<string> ChangeIdKeysToAdd = [];
    private List<string> ChangeIdKeysToDelete = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            updateOwnerRuleMappings = new UpdateRuleOwnerMapping(apiConnection, globalConfig);
            EventMediator.Subscribe<UpdateRuleOwnerMappingEvent>("UpdateOwnerRuleMappings", evt => _ = updateOwnerRuleMappings.HandleEvent(evt));
            configData = await globalConfig.GetEditableConfig();
            ownerMappingSourceHandler.Init(configData);
            ChangeIdKeys = DeserializeChangeIdKeys(configData.CustomFieldChangeIdKey);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    /// <summary>
    /// Triggers a full rule-owner mapping rebuild after mapping configuration changes were saved.
    /// </summary>
    private async Task<bool> TriggerFullRuleOwnerReinitialize()
    {
        var tcs = new TaskCompletionSource<bool>();
        var args = new UpdateRuleOwnerMappingEventArgs { isFullReInitialize = true, TriggeredByChange = true, Changes = ownerMappingSourceHandler.AppliedChanges, Completion = tcs };
        EventMediator.Publish("UpdateOwnerRuleMappings", new UpdateRuleOwnerMappingEvent(args));
        return await tcs.Task;
    }

    private async Task Save()
    {
        try
        {
            if (configData != null)
            {
                List<string> mergedChangeIdKeys = MergeChangeIdKeys();
                string serializedChangeIdKeys = JsonSerializer.Serialize(mergedChangeIdKeys);

                string? ownerMappingErrorKey = ownerMappingSourceHandler.Validate();
                if (ownerMappingErrorKey != null)
                {
                    // the change-ID keys are read by rule reports, notification mails and the rule REST API,
                    // so an incomplete owner mapping must not block them
                    await SaveChangeIdKeysOnly(serializedChangeIdKeys);
                    configData.CustomFieldChangeIdKey = serializedChangeIdKeys;
                    CommitChangeIdKeys(mergedChangeIdKeys);
                    DisplayMessageInUi(null, userConfig.GetText("modelling_settings"), $"{userConfig.GetText(ownerMappingErrorKey)} {userConfig.GetText("E5506")}", true);
                    return;
                }

                configData.CustomFieldChangeIdKey = serializedChangeIdKeys;
                bool ruleOwnerReinitializeNeeded = ownerMappingSourceHandler.ApplyTo(configData);

                await globalConfig.WriteToDatabase(configData, apiConnection);
                ownerMappingSourceHandler.TakeOverStoredSettings(configData);
                CommitChangeIdKeys(mergedChangeIdKeys);

                if (ruleOwnerReinitializeNeeded)
                {
                    // recorded before the rebuild is triggered: the configuration is already saved, so if the
                    // rebuild fails the note is what keeps the later rebuild from reporting the intended
                    // change as drift - whichever path finally runs it
                    await new RuleOwnerMappingRunHistory(apiConnection).RecordPendingChanges(ownerMappingSourceHandler.AppliedChanges);

                    bool rebuildSuccess = await TriggerFullRuleOwnerReinitialize();
                    if (!rebuildSuccess)
                    {
                        DisplayMessageInUi(null, userConfig.GetText("owner_mapping"), userConfig.GetText("E5502"), true);
                        return;
                    }
                    ownerMappingSourceHandler.ConfirmRuleOwnerRebuild();
                }

                DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
            }
            else
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    /// <summary>
    /// Persists the change-ID keys on their own, leaving every other importer setting on this page untouched.
    /// A fresh config copy is used because <see cref="configData"/> is two-way bound to the other settings of
    /// the form, which must not reach the database while the form is rejected.
    /// </summary>
    /// <param name="serializedChangeIdKeys">Serialized change-ID key list.</param>
    private async Task SaveChangeIdKeysOnly(string serializedChangeIdKeys)
    {
        ConfigData changeIdKeyConfig = await globalConfig.GetEditableConfig();
        changeIdKeyConfig.CustomFieldChangeIdKey = serializedChangeIdKeys;
        await globalConfig.WriteToDatabase(changeIdKeyConfig, apiConnection);
    }

    /// <summary>
    /// Adds the pending change-ID custom field key to the editor list.
    /// </summary>
    private void AddChangeIdKey()
    {
        string key = ActiveChangeIdKey.Trim();
        if (key.Length > 0 && !ChangeIdKeys.Contains(key) && !ChangeIdKeysToAdd.Contains(key))
        {
            ChangeIdKeysToAdd.Add(key);
            ActiveChangeIdKey = "";
        }
    }

    /// <summary>
    /// Builds the key list resulting from the additions and removals collected by the change-ID key editor,
    /// leaving the editor state untouched so a failed save keeps the pending changes.
    /// </summary>
    /// <returns>The merged keys.</returns>
    private List<string> MergeChangeIdKeys()
    {
        List<string> mergedKeys = [.. ChangeIdKeys.Where(key => !ChangeIdKeysToDelete.Contains(key))];
        mergedKeys.AddRange(ChangeIdKeysToAdd);
        return mergedKeys;
    }

    /// <summary>
    /// Applies the successfully persisted change-ID keys to the editor and clears the pending queues.
    /// </summary>
    /// <param name="persistedKeys">Keys written to the database.</param>
    private void CommitChangeIdKeys(List<string> persistedKeys)
    {
        ChangeIdKeys = persistedKeys;
        ChangeIdKeysToDelete = [];
        ChangeIdKeysToAdd = [];
    }

    /// <summary>
    /// Reads a JSON key list while retaining compatibility with legacy single-key values.
    /// </summary>
    /// <param name="keysJson">JSON list or legacy plain-text key.</param>
    /// <returns>The configured keys, or an empty list if the stored value cannot be parsed.</returns>
    private static List<string> DeserializeChangeIdKeys(string keysJson)
    {
        if (string.IsNullOrWhiteSpace(keysJson))
        {
            return [];
        }

        string trimmedKeys = keysJson.Trim();
        if (!trimmedKeys.StartsWith('[') || !trimmedKeys.EndsWith(']'))
        {
            return [trimmedKeys];
        }

        try
        {
            return JsonSerializer.Deserialize<List<string>>(trimmedKeys) ?? [];
        }
        catch (JsonException exception)
        {
            // keep the settings page usable so the invalid value can be corrected here
            Log.WriteWarning("Read Config", $"Config item \"CustomFieldChangeIdKey\" contains unsupported value \"{keysJson}\". Using empty key list. {exception.Message}");
            return [];
        }
    }

    public void Dispose()
    {
        EventMediator.Unsubscribe<UpdateRuleOwnerMappingEvent>("UpdateOwnerRuleMappings");
    }
}
