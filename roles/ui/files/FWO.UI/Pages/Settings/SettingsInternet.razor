                        </div>
                        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5820"))">
                            <input id="cbx_internalZoneRange_172_16_0_0_12" type="checkbox" class="form-check-input" @bind="configData!.InternalZoneRange_172_16_0_0_12" />
                            <label for="cbx_internalZoneRange_172_16_0_0_12" class="form-check-label">172.16.0.0/12 (RFC 1918)</label>
