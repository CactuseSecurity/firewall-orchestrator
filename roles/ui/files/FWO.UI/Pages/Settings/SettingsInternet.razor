                        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5820"))">
                            <input id="cbx_internalZoneRange_192_168_0_0_16" type="checkbox" class="form-check-input" @bind="configData!.InternalZoneRange_192_168_0_0_16" />
