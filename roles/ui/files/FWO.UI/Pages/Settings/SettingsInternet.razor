                            <label for="cbx_internalZoneRange_192_0_2_0_24" class="form-check-label">192.0.2.0/24 (RFC 5737)</label>
                        </div>
                        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5828"))">
                            <input id="cbx_internalZoneRange_198_51_100_0_24" type="checkbox" class="form-check-input" @bind="configData!.InternalZoneRange_198_51_100_0_24" />
                            <label for="cbx_internalZoneRange_198_51_100_0_24" class="form-check-label">198.51.100.0/24 (RFC 5737)</label>
                        </div>
                        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5829"))">
                            <input id="cbx_internalZoneRange_203_0_113_0_24" type="checkbox" class="form-check-input" @bind="configData!.InternalZoneRange_203_0_113_0_24" />
