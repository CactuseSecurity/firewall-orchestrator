                    </div>
                </div>
                <div class="settings-check-group">
                    <div class="settings-check-group-title">@(userConfig.GetText("loopbackLocal"))</div>
                    <div class="settings-check-grid">
                        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5821"))">
                            <input id="cbx_internalZoneRange_0_0_0_0_8" type="checkbox" class="form-check-input" @bind="configData!.InternalZoneRange_0_0_0_0_8" />
                            <label for="cbx_internalZoneRange_0_0_0_0_8" class="form-check-label">0.0.0.0/8 (RFC 1122)</label>
                        </div>
                        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5822"))">
                            <input id="cbx_internalZoneRange_127_0_0_0_8" type="checkbox" class="form-check-input" @bind="configData!.InternalZoneRange_127_0_0_0_8" />
                            <label for="cbx_internalZoneRange_127_0_0_0_8" class="form-check-label">127.0.0.0/8 (RFC 1122)</label>
                        </div>
                        <div class="form-check" data-toggle="tooltip" title="@(userConfig.PureLine("H5823"))">
                            <input id="cbx_internalZoneRange_169_254_0_0_16" type="checkbox" class="form-check-input" @bind="configData!.InternalZoneRange_169_254_0_0_16" />
