@page "/settings/logging"

@using System.Text.Json
@using FWO.Basics
@using FWO.Config.File
@using FWO.Data.Enums
@using FWO.Logging
@using FWO.Ui.Data.Extensions

@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig

<div class="input-group">
    <h3>@(userConfig.GetText("logging"))</h3>
    <HelpLink Page="settings/logging" />
</div>
<hr />

@if (configData != null)
{
    <form onsubmit="return false">
        <SettingsRow LabelKey="importLogDataPath" TooltipKey="H5694" AlignTop="true">
            <div class="settings-input-lg">
                <EditList ElementType="string" Elements="logDataPaths.ToArray()" ElementsToAdd="pathsToAdd"
                          ElementsToDelete="pathsToDelete" StdLayout="false">
                    <Display>
                        <div class="row">
                            <div class="col-sm-12 border bg-transparent">@context</div>
                        </div>
                    </Display>
                </EditList>
                <div class="input-group input-group-sm mt-1">
                    <input type="text" class="form-control" @bind="activePath" placeholder="@AllowedImportPathPlaceholder" />
                    <button type="button" class="btn btn-sm btn-primary" disabled="@(string.IsNullOrWhiteSpace(activePath))" @onclick="AddPath"
                            @onclick:preventDefault>@(DisplayService.DisplayButton(userConfig, "add", Icons.Add))</button>
                </div>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="importLogDataScriptArgs" TooltipKey="H5695" LabelFor="importLogDataScriptArgs">
            <input id="importLogDataScriptArgs" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData.ImportLogDataScriptArgs" />
        </SettingsRow>
        <SettingsRow LabelKey="importLogDataSleepTime" TooltipKey="H5696" LabelFor="importLogDataSleepTime">
            <input id="importLogDataSleepTime" class="form-control form-control-sm settings-input-sm" type="number" min="0" @bind="configData.ImportLogDataSleepTime" />
            <select class="form-select form-select-sm settings-input-sm" @bind="configData.ImportLogDataSleepTimeUnit">
                @foreach (LogDataImportIntervalUnit unit in Enum.GetValues(typeof(LogDataImportIntervalUnit)))
                {
                    <option value="@unit">@unit.ToString(userConfig)</option>
                }
            </select>
        </SettingsRow>
        <SettingsRow LabelKey="importLogDataMaxEntries" TooltipKey="H5697" LabelFor="importLogDataMaxEntries">
            <input id="importLogDataMaxEntries" type="number" min="1" class="form-control form-control-sm settings-input-sm" @bind="configData.ImportLogDataMaxEntries" />
        </SettingsRow>
        <SettingsRow LabelKey="logDataRetentionDays" TooltipKey="H5699" LabelFor="logDataRetentionDays">
            <input id="logDataRetentionDays" type="number" min="1" class="form-control form-control-sm settings-input-sm" @bind="configData.LogDataRetentionDays" />
        </SettingsRow>
        <SettingsRow LabelKey="allowLogDataPortWithoutProtocol" TooltipKey="H5700" LabelFor="cbx_port_without_protocol">
            <div class="form-check form-switch">
                <input id="cbx_port_without_protocol" type="checkbox" role="switch" class="form-check-input" @bind="configData.AllowLogDataPortWithoutProtocol" />
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="resolveLogDataDns" TooltipKey="H5707" LabelFor="cbx_resolve_log_dns">
            <div class="form-check form-switch">
                <input id="cbx_resolve_log_dns" type="checkbox" role="switch" class="form-check-input" @bind="configData.ResolveLogDataDns" />
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="replaceExistingLogData" TooltipKey="H5692" LabelFor="cbx_replace_existing_log_data">
            <div class="form-check form-switch">
                <input id="cbx_replace_existing_log_data" type="checkbox" role="switch" class="form-check-input" @bind="configData.ReplaceExistingLogData" />
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="showLogDataInConnections" TooltipKey="H5698" LabelFor="cbx_show_log_data">
            <div class="form-check form-switch">
                <input id="cbx_show_log_data" type="checkbox" role="switch" class="form-check-input" @bind="configData.ShowLogDataInConnections" />
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="hideLogTimeColumn" TooltipKey="H5705" LabelFor="cbx_hide_log_time_column">
            <div class="form-check form-switch">
                <input id="cbx_hide_log_time_column" type="checkbox" role="switch" class="form-check-input" @bind="configData.HideLogTimeColumn" />
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="showLogImportTimeInHeading" TooltipKey="H5709" LabelFor="cbx_show_log_import_time_in_heading">
            <div class="form-check form-switch">
                <input id="cbx_show_log_import_time_in_heading" type="checkbox" role="switch" class="form-check-input" @bind="configData.ShowLogImportTimeInHeading" />
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="defaultLogTimeRange" TooltipKey="H5706" LabelFor="defaultLogTimeRange">
            <input id="defaultLogTimeRange" class="form-control form-control-sm settings-input-sm" type="number" min="1" @bind="logTimeRangeValue" @bind:after="ApplyLogTimeRange" />
            <select class="form-select form-select-sm settings-input-sm" @bind="logTimeRangeUnit" @bind:after="ApplyLogTimeRange">
                @foreach (LogTimeRangeUnit unit in Enum.GetValues<LogTimeRangeUnit>())
                {
                    <option value="@unit">@unit.ToString(userConfig)</option>
                }
            </select>
        </SettingsRow>
    </form>

    <hr />
    <ExecutionModeAuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>
                @(DisplayService.DisplayButton(userConfig, "save", Icons.Save))
            </button>
        </Authorized>
        <NotAuthorized>
            <button type="button" class="btn btn-sm btn-primary" disabled>
                @(DisplayService.DisplayButton(userConfig, "save", Icons.Save))
            </button>
        </NotAuthorized>
    </ExecutionModeAuthorizeView>
}
else
{
    <Loading />
}

@code
{
    private const int kMinLogDataMaxEntries = 1;
    private const int kMinLogDataRetentionDays = 1;
    private const int kMinLogTimeRangeInSeconds = 1;

    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private List<string> logDataPaths = [];
    private List<string> pathsToAdd = [];
    private List<string> pathsToDelete = [];
    private string activePath = "";
    // the default log time range is stored in seconds and edited in the largest unit representing it exactly
    private int logTimeRangeValue;
    private LogTimeRangeUnit logTimeRangeUnit = LogTimeRangeUnit.Days;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configData = await globalConfig.GetEditableConfig();
            logDataPaths = JsonSerializer.Deserialize<List<string>>(configData.ImportLogDataPath) ?? [];
            (logTimeRangeValue, logTimeRangeUnit) = LogTimeRange.ToLargestExactUnit(configData.DefaultLogTimeRangeInSeconds);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    /// <summary>
    /// Writes the entered default log time range to the edited config as seconds.
    /// </summary>
    private void ApplyLogTimeRange()
    {
        if (configData is not null)
        {
            configData.DefaultLogTimeRangeInSeconds = LogTimeRange.ToSeconds(logTimeRangeValue, logTimeRangeUnit);
        }
    }

    private void AddPath()
    {
        if (!string.IsNullOrWhiteSpace(activePath))
        {
            pathsToAdd.Add(activePath);
            activePath = "";
        }
    }

    private async Task Save()
    {
        try
        {
            if (configData is null)
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }

            string oldPath = globalConfig.ImportLogDataPath;
            string oldScriptArgs = globalConfig.ImportLogDataScriptArgs;
            int oldInterval = globalConfig.ImportLogDataSleepTime;
            LogDataImportIntervalUnit oldIntervalUnit = globalConfig.ImportLogDataSleepTimeUnit;
            int oldMaxEntries = globalConfig.ImportLogDataMaxEntries;
            bool oldShowLogData = globalConfig.ShowLogDataInConnections;
            LogDataSettings oldSettings = new(globalConfig.LogDataRetentionDays, globalConfig.AllowLogDataPortWithoutProtocol,
                globalConfig.ReplaceExistingLogData, globalConfig.HideLogTimeColumn, globalConfig.DefaultLogTimeRangeInSeconds,
                globalConfig.ResolveLogDataDns, globalConfig.ShowLogImportTimeInHeading);
            PrepareConfigData();
            await globalConfig.WriteToDatabase(configData, apiConnection);
            WriteSettingsAudit(oldPath, oldScriptArgs, oldInterval, oldIntervalUnit, oldMaxEntries, oldShowLogData, oldSettings);
            pathsToAdd = [];
            pathsToDelete = [];
            DisplayMessageInUi(null, userConfig.GetText("logging"), userConfig.GetText("U5301"), false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("logging"), "", true);
        }
    }

    /// <summary>
    /// Builds the paths to be saved and validates them before the displayed list is changed,
    /// so a rejected path leaves the page in the state the user can correct.
    /// </summary>
    private void PrepareConfigData()
    {
        List<string> preparedPaths = logDataPaths.Where(path => !pathsToDelete.Contains(path))
            .Concat(pathsToAdd.Select(ImportPathPolicy.RemoveAllowedExtension))
            .Distinct()
            .ToList();
        foreach (string path in preparedPaths)
        {
            ImportPathPolicy.ValidateImportSourceShape(path, ConfigFile.AllowedCustomizationRoots);
        }

        logDataPaths = preparedPaths;
        configData!.ImportLogDataPath = JsonSerializer.Serialize(logDataPaths);
        configData.ImportLogDataMaxEntries = Math.Max(kMinLogDataMaxEntries, configData.ImportLogDataMaxEntries);
        // a retention of 0 days would delete every entry right after it was imported
        configData.LogDataRetentionDays = Math.Max(kMinLogDataRetentionDays, configData.LogDataRetentionDays);
        configData.DefaultLogTimeRangeInSeconds = Math.Max(kMinLogTimeRangeInSeconds, configData.DefaultLogTimeRangeInSeconds);
        (logTimeRangeValue, logTimeRangeUnit) = LogTimeRange.ToLargestExactUnit(configData.DefaultLogTimeRangeInSeconds);
    }

    /// <summary>
    /// Settings of the log data page which are only needed for the audit entry.
    /// </summary>
    private record LogDataSettings(int RetentionDays, bool AllowPortWithoutProtocol, bool ReplaceExisting, bool HideLogTimeColumn,
        int DefaultLogTimeRangeInSeconds, bool ResolveDns, bool ShowLogImportTimeInHeading);

    private void WriteSettingsAudit(string oldPath, string oldScriptArgs, int oldInterval, LogDataImportIntervalUnit oldIntervalUnit,
        int oldMaxEntries, bool oldShowLogData, LogDataSettings oldSettings)
    {
        List<string> changes = [];
        AddSettingChange(changes, nameof(ConfigData.ImportLogDataPath), oldPath, configData!.ImportLogDataPath);
        AddSettingChange(changes, nameof(ConfigData.ImportLogDataScriptArgs), oldScriptArgs, configData.ImportLogDataScriptArgs, redactValues: true);
        AddSettingChange(changes, nameof(ConfigData.ImportLogDataSleepTime), oldInterval.ToString(), configData.ImportLogDataSleepTime.ToString());
        AddSettingChange(changes, nameof(ConfigData.ImportLogDataSleepTimeUnit), oldIntervalUnit.ToString(), configData.ImportLogDataSleepTimeUnit.ToString());
        AddSettingChange(changes, nameof(ConfigData.ImportLogDataMaxEntries), oldMaxEntries.ToString(), configData.ImportLogDataMaxEntries.ToString());
        AddSettingChange(changes, nameof(ConfigData.ShowLogDataInConnections), oldShowLogData.ToString(), configData.ShowLogDataInConnections.ToString());
        AddSettingChange(changes, nameof(ConfigData.LogDataRetentionDays), oldSettings.RetentionDays.ToString(), configData.LogDataRetentionDays.ToString());
        AddSettingChange(changes, nameof(ConfigData.AllowLogDataPortWithoutProtocol), oldSettings.AllowPortWithoutProtocol.ToString(),
            configData.AllowLogDataPortWithoutProtocol.ToString());
        AddSettingChange(changes, nameof(ConfigData.ReplaceExistingLogData), oldSettings.ReplaceExisting.ToString(),
            configData.ReplaceExistingLogData.ToString());
        AddSettingChange(changes, nameof(ConfigData.ResolveLogDataDns), oldSettings.ResolveDns.ToString(), configData.ResolveLogDataDns.ToString());
        AddSettingChange(changes, nameof(ConfigData.HideLogTimeColumn), oldSettings.HideLogTimeColumn.ToString(),
            configData.HideLogTimeColumn.ToString());
        AddSettingChange(changes, nameof(ConfigData.ShowLogImportTimeInHeading), oldSettings.ShowLogImportTimeInHeading.ToString(),
            configData.ShowLogImportTimeInHeading.ToString());
        AddSettingChange(changes, nameof(ConfigData.DefaultLogTimeRangeInSeconds), oldSettings.DefaultLogTimeRangeInSeconds.ToString(),
            configData.DefaultLogTimeRangeInSeconds.ToString());

        if (changes.Count > 0)
        {
            Log.WriteAudit(
                Title: "Log Data Import Settings",
                Text: $"Log data import settings changed at {DateTimeOffset.Now:O}: {string.Join("; ", changes)}",
                UserName: userConfig.User.Name,
                UserDN: userConfig.User.Dn);
        }
    }

    private static void AddSettingChange(List<string> changes, string settingName, string oldValue, string newValue, bool redactValues = false)
    {
        if (oldValue != newValue)
        {
            changes.Add(redactValues ? $"{settingName}: changed" : $"{settingName}: '{oldValue}' -> '{newValue}'");
        }
    }

    private static string AllowedImportPathPlaceholder =>
        string.Join(" | ", ConfigFile.AllowedCustomizationRoots.Select(root => $"{root}/..."));
}
