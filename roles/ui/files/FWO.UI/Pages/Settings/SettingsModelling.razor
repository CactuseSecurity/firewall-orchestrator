@using System.Text.Json
@using FWO.Api.Client.Queries
@using FWO.Basics
@using FWO.Data
@using FWO.Data.Middleware
@using FWO.Middleware.Client
@using FWO.Services
@using FWO.Ui.Data
@using FWO.Ui.Pages.NetworkModelling

@page "/settings/modelling"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig
@inject MiddlewareClient middlewareClient

<div class="input-group">
    <h3>@(userConfig.GetText("modelling_general_settings"))</h3>
    <HelpLink Page="settings/modelling" />
</div>
@(userConfig.GetText("U5322"))
<hr />

@if(configData != null && initComplete)
{
    <form onsubmit="return false">
        <SettingsRow LabelKey="predef_services" TooltipKey="H5602">
            <button type="button" class="btn btn-sm btn-dark" @onclick="PredefServices">
                @(DisplayService.DisplayButton(userConfig, "predef_services", Icons.ServiceGroup))
            </button>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="allowServerInConn" TooltipKey="H5603" LabelFor="cbx_allow_server_in_conn">
            <div class="form-check form-switch">
                <input id="cbx_allow_server_in_conn" type="checkbox" role="switch" class="form-check-input" @bind="configData!.AllowServerInConn">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="allowServiceInConn" TooltipKey="H5604" LabelFor="cbx_allow_service_in_conn">
            <div class="form-check form-switch">
                <input id="cbx_allow_service_in_conn" type="checkbox" role="switch" class="form-check-input" @bind="configData!.AllowServiceInConn">
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="overviewDisplayLines" TooltipKey="H5605" Marked="true" LabelFor="overviewDisplayLines">
            <input id="overviewDisplayLines" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.OverviewDisplayLines" />
        </SettingsRow>
        <SettingsRow LabelKey="reducedProtocolSet" TooltipKey="H5617" LabelFor="cbx_reduced_protocol_set">
            <div class="form-check form-switch">
                <input id="cbx_reduced_protocol_set" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ReducedProtocolSet">
            </div>
            <button type="button" class="btn btn-sm btn-warning" @onclick="OpenReducedProtocolSelection">
                @(DisplayService.DisplayButton(userConfig, "select_visible_protocols", Icons.Edit))
            </button>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="app_server_types" TooltipKey="H5627" AlignTop="true">
            <div class="settings-input-lg">
                <div class="settings-subgrid mb-1">
                    <label for="appServerDefaultTypeName">@userConfig.GetText("default_app_server_type"):</label>
                    <input id="appServerDefaultTypeName" type="text" class="form-control form-control-sm" @bind="appServerDefaultTypeName" />
                </div>
                <EditList ElementType="AppServerType" Elements="appServerTypes.Where(x => x.Id != 0).ToArray()" ElementsToAdd="appServerTypesToAdd" ElementsToDelete="appServerTypesToDelete" StdLayout="false">
                    <Display>
                        <div class="row">
                            <div class="col-sm-2 border bg-transparent">@context.Id</div>
                            <div class="col-sm-10 border bg-transparent">@context.Name</div>
                        </div>
                    </Display>
                </EditList>
                <div class="input-group input-group-sm mt-1">
                    <input type="number" class="form-control settings-input-sm" @bind="actAppServerType.Id" />
                    <input type="text" class="form-control" @bind="actAppServerType.Name" />
                    <button type="button" class="btn btn-sm btn-primary" @onclick="AddAppServerType" @onclick:preventDefault>@(DisplayService.DisplayButton(userConfig, "add", Icons.Add))</button>
                </div>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="common_areas" TooltipKey="H5620" AlignTop="true">
            <CommonAreaSelection CommonAreas="CommonAreas" CommAreasToDelete="CommAreasToDelete" SearchCommonArea="SearchCommonArea"/>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="extra_params" TooltipKey="H5637" AlignTop="true">
            <div class="settings-input-md">
                <EditList ElementType="string" Elements="ExtraConfigs.ToArray()" ElementsToAdd="ExtraConfigsToAdd" ElementsToDelete="ExtraConfigsToDelete" StdLayout="false">
                    <Display>
                        <div class="row">
                            <div class="col-sm-12 border bg-transparent">@context</div>
                        </div>
                    </Display>
                </EditList>
                <div class="input-group input-group-sm mt-1">
                    <input type="text" class="form-control" @bind="actExtraConfig" />
                    <button type="button" class="btn btn-sm btn-primary" @onclick="AddExtraConfig" @onclick:preventDefault>@(DisplayService.DisplayButton(userConfig, "add", Icons.Add))</button>
                </div>
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="special_user_areas" TooltipKey="H5655" AlignTop="true">
            <CommonAreaSelection CommonAreas="SpecUserAreas" CommAreasToDelete="SpecUserAreasToDelete" SearchCommonArea="SearchSpecUserArea"/>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="updatable_obj_areas" TooltipKey="H5659" AlignTop="true">
            <CommonAreaSelection CommonAreas="UpdObjAreas" CommAreasToDelete="UpdObjAreasToDelete" SearchCommonArea="SearchUpdObjArea"/>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="com_svc_excluded_areas" TooltipKey="H5659a" AlignTop="true">
            <CommonAreaSelection CommonAreas="ComSvcExcludedAreas" CommAreasToDelete="ComSvcExcludedAreasToDelete" SearchCommonArea="SearchComSvcExcludedArea" ShowUsageFlags="false"/>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="networkAreaRequired" TooltipKey="H5606" LabelFor="cbx_network_area_required">
            <div class="form-check form-switch">
                <input id="cbx_network_area_required" type="checkbox" role="switch" class="form-check-input" @bind="namingConvention.NetworkAreaRequired">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="networkAreaPattern" TooltipKey="H5609" LabelFor="networkAreaPattern">
            <input id="networkAreaPattern" type="text" class="form-control form-control-sm settings-input-md" @bind="namingConvention.NetworkAreaPattern" />
        </SettingsRow>
        <SettingsRow LabelKey="appRolePattern" TooltipKey="H5610" LabelFor="appRolePattern">
            <input id="appRolePattern" type="text" class="form-control form-control-sm settings-input-md" @bind="namingConvention.AppRolePattern" />
        </SettingsRow>
        <SettingsRow LabelKey="fixedPartLength" TooltipKey="H5607" LabelFor="fixedPartLength">
            <input id="fixedPartLength" type="number" min="@(namingConvention.NetworkAreaRequired ? namingConvention.NetworkAreaPattern.Length + 1 : 0)" class="form-control form-control-sm settings-input-sm" @bind="namingConvention.FixedPartLength" />
        </SettingsRow>
        <SettingsRow LabelKey="useAppPart" TooltipKey="H5619" LabelFor="cbx_use_app_part">
            <div class="form-check form-switch">
                <input id="cbx_use_app_part" type="checkbox" role="switch" class="form-check-input" @bind="namingConvention.UseAppPart">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="freePartLength" TooltipKey="H5608" LabelFor="freePartLength">
            <input id="freePartLength" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="namingConvention.FreePartLength" />
        </SettingsRow>
        <SettingsRow LabelKey="app_zone_creation" TooltipKey="H5636" LabelFor="cbx_create_app_zones">
            <div class="form-check form-switch">
                <input id="cbx_create_app_zones" type="checkbox" role="switch" class="form-check-input" @bind="configData!.CreateAppZones">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="app_zone_pattern" TooltipKey="H5635" LabelFor="appZonePattern">
            <input id="appZonePattern" type="text" disabled="@(!configData.CreateAppZones)" class="form-control form-control-sm settings-input-md" @bind="namingConvention.AppZone" />
        </SettingsRow>
        <SettingsRow LabelKey="appServerPrefix" TooltipKey="H5633" LabelFor="appServerPrefix">
            <input id="appServerPrefix" type="text" class="form-control form-control-sm settings-input-md" @bind="namingConvention.AppServerPrefix" />
        </SettingsRow>
        <SettingsRow LabelKey="networkPrefix" TooltipKey="H5645" LabelFor="networkPrefix">
            <input id="networkPrefix" type="text" class="form-control form-control-sm settings-input-md" @bind="namingConvention.NetworkPrefix" />
        </SettingsRow>
        <SettingsRow LabelKey="ipRangePrefix" TooltipKey="H5646" LabelFor="ipRangePrefix">
            <input id="ipRangePrefix" type="text" class="form-control form-control-sm settings-input-md" @bind="namingConvention.IpRangePrefix" />
        </SettingsRow>
        <SettingsRow LabelKey="dns_lookup" TooltipKey="H5643" LabelFor="cbx_dns_lookup">
            <div class="form-check form-switch">
                <input id="cbx_dns_lookup" type="checkbox" role="switch" class="form-check-input" @bind="configData!.DnsLookup">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="overwrite_exiting_names" TooltipKey="H5644" LabelFor="cbx_overwrite_names">
            <div class="form-check form-switch">
                <input id="cbx_overwrite_names" type="checkbox" role="switch" class="form-check-input" @bind="configData!.OverwriteExistingNames">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="auto_replace_app_server" TooltipKey="H5647" LabelFor="cbx_replace_appserver">
            <div class="form-check form-switch">
                <input id="cbx_replace_appserver" type="checkbox" role="switch" class="form-check-input" @bind="configData!.AutoReplaceAppServer">
            </div>
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="modIntegrationMode" TooltipKey="H5679">
            <div class="settings-input-md">
                <Dropdown ElementType="ModIntegrationMode" @bind-SelectedElement="configData!.ModIntegrationMode"
                        ElementToString="@(mode => userConfig.GetText(mode.ToString()))"
                        Elements="Enum.GetValues(typeof(ModIntegrationMode)).Cast<ModIntegrationMode>()">
                    <ElementTemplate Context="mode">
                        @(userConfig.GetText(mode.ToString()))
                    </ElementTemplate>
                </Dropdown>
            </div>
            @if (configData.ModIntegrationMode == ModIntegrationMode.WorkflowNotifications)
            {
                <button type="button" class="btn btn-sm btn-primary" @onclick="ModIntegrationStates" @onclick:preventDefault>
                    @(DisplayService.DisplayButton(userConfig, "modIntegrationStates", Icons.Edit))
                </button>
            }
        </SettingsRow>
        <SettingsRow LabelKey="modRolloutActive" TooltipKey="H5634" LabelFor="cbx_rollout_active">
            <div class="form-check form-switch">
                <input id="cbx_rollout_active" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModRolloutActive">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modRolloutResolveServiceGroups" TooltipKey="H5631" LabelFor="cbx_rollout_resolve_service_groups">
            <div class="form-check form-switch">
                <input id="cbx_rollout_resolve_service_groups" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModRolloutResolveServiceGroups">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modRolloutBundleTasks" TooltipKey="H5632" LabelFor="cbx_rollout_bundle_tasks">
            <div class="form-check form-switch">
                <input id="cbx_rollout_bundle_tasks" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModRolloutBundleTasks">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modRolloutNatHeuristic" TooltipKey="H5656" LabelFor="cbx_request_nat">
            <div class="form-check form-switch">
                <input id="cbx_request_nat" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModRolloutNatHeuristic">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modRolloutRemovedAppServers" TooltipKey="H5667" LabelFor="cbx_rollout_removed">
            <div class="form-check form-switch">
                <input id="cbx_rollout_removed" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModRolloutRemovedAppServers">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modRequestOnlyOwnObjects" TooltipKey="H5668" LabelFor="cbx_request_only_own_objects">
            <div class="form-check form-switch">
                <input id="cbx_request_only_own_objects" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModRequestOnlyOwnObjects">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modRolloutErrorText" TooltipKey="H5639" LabelFor="modRolloutErrorText">
            <input id="modRolloutErrorText" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.ModRolloutErrorText" />
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="modelledMarker" TooltipKey="H5648" LabelFor="modModelledMarker">
            <input id="modModelledMarker" type="text" class="form-control form-control-sm settings-input-md" @bind="configData!.ModModelledMarker" />
        </SettingsRow>
        <SettingsRow LabelKey="modelledMarkerLocation" TooltipKey="H5649" LabelFor="modModelledMarkerLocation">
            <input id="modModelledMarkerLocation" type="text" class="form-control form-control-sm settings-input-md" @bind="configData!.ModModelledMarkerLocation" />
        </SettingsRow>
        <SettingsRow LabelKey="rule_recognition_options" TooltipKey="H5650">
            <button type="button" class="btn btn-sm btn-warning" @onclick="VarianceOptions"
                    @onclick:preventDefault>@(DisplayService.DisplayButton(userConfig, "rule_recognition_options", Icons.Edit))</button>
        </SettingsRow>
        <SettingsRow LabelKey="varianceAnalysisSync" TooltipKey="H5651" LabelFor="cbx_var_ana_sync">
            <div class="form-check form-switch">
                <input id="cbx_var_ana_sync" type="checkbox" role="switch" class="form-check-input" @bind="configData!.VarianceAnalysisSync">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="varianceAnalysisRefresh" TooltipKey="H5654" LabelFor="cbx_var_ana_refresh">
            <div class="form-check form-switch">
                <input id="cbx_var_ana_refresh" type="checkbox" role="switch" class="form-check-input" @bind="configData!.VarianceAnalysisRefresh">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="varianceAnalysisSleepTime" TooltipKey="H5652" LabelFor="varianceAnalysisSleepTime">
            <input id="varianceAnalysisSleepTime" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.VarianceAnalysisSleepTime" />
        </SettingsRow>
        <SettingsRow LabelKey="varianceAnalysisStartAt" TooltipKey="H5653" LabelFor="varianceAnalysisStartTime">
            <input id="varianceAnalysisStartTime" type="time" step="60" class="form-control form-control-sm w-auto" @bind="varAnalysisTime" />
            <input type="date" class="form-control form-control-sm w-auto" @bind="varAnalysisDate" />
        </SettingsRow>
        <hr />
        <SettingsRow LabelKey="modRecertActive" TooltipKey="H5657" LabelFor="cbx_recert_active">
            <div class="form-check form-switch">
                <input id="cbx_recert_active" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModRecertActive">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modRecertExpectAllModelled" TooltipKey="H5663" LabelFor="cbx_expect_modelled">
            <div class="form-check form-switch">
                <input id="cbx_expect_modelled" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModRecertExpectAllModelled">
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="modRecertText" TooltipKey="H5658" LabelFor="modRecertText" AlignTop="true">
            <textarea id="modRecertText" class="form-control form-control-sm settings-input-lg" rows="4" name="text" @bind="configData!.ModRecertText"></textarea>
        </SettingsRow>
        <hr />
    </form>

    <ExecutionModeAuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
        </Authorized>
        <NotAuthorized>
            <button type="button" class="btn btn-sm btn-primary" disabled>@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
        </NotAuthorized>
    </ExecutionModeAuthorizeView>
    <br>
    <br>
    <p>@(userConfig.GetText("U5303"))</p>

    <VarianceOptionsSelection @bind-Display="varOptMode" @bind-ConfigValue="ruleRecognitionOption"/>
    <ModIntegrationStatesEditor @bind-Display="modIntegrationStatesMode" @bind-ConfigValue="configData.ModIntegrationStates" @bind-ConfigMarker="configData.ModIntegrationStateMarker"/>
    <ReducedProtocolSelection @bind-Display="reducedProtocolSelectionMode" @bind-ConfigValue="configData.ReducedProtocolSetProtocols" AvailableProtocols="availableProtocols" />
}
else
{
    <Loading/>
}
<PredefServices @bind-Display="predefServices" />
<SearchNwObject @bind-Display="searchCommonArea" ObjectList="CommonAreas.ConvertAll(x => x.Area)" Add="AddCommonArea" CommonAreaMode="true" />
<SearchNwObject @bind-Display="searchSpecUserArea" ObjectList="SpecUserAreas.ConvertAll(x => x.Area)" Add="AddSpecUserArea" SpecUserMode="true"/>
<SearchNwObject @bind-Display="searchUpdObjArea" ObjectList="UpdObjAreas.ConvertAll(x => x.Area)" Add="AddUpdObjArea" UpdObjMode="true"/>
<SearchNwObject @bind-Display="searchComSvcExcludedArea" ObjectList="ComSvcExcludedAreas.ConvertAll(x => x.Area)" Add="AddComSvcExcludedArea" ComSvcExcludedMode="true"/>
@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private List<AppServerType> appServerTypes = [];
    private List<AppServerType> appServerTypesToAdd = [];
    private List<AppServerType> appServerTypesToDelete = [];
    private AppServerType actAppServerType = new();
    private string appServerDefaultTypeName = "";

    private List<string> ExtraConfigs = [];
    private List<string> ExtraConfigsToAdd = [];
    private List<string> ExtraConfigsToDelete = [];
    private string actExtraConfig = "";

    private List<ModellingNwGroup> allAreas = [];
    private List<CommonArea> CommonAreas = [];
    private List<CommonArea> CommAreasToDelete = [];
    private List<CommonArea> SpecUserAreas = [];
    private readonly List<CommonArea> SpecUserAreasToDelete = [];
    private List<CommonArea> UpdObjAreas = [];
    private readonly List<CommonArea> UpdObjAreasToDelete = [];
    private List<CommonArea> ComSvcExcludedAreas = [];
    private readonly List<CommonArea> ComSvcExcludedAreasToDelete = [];
    private bool predefServices = false;
    private bool searchCommonArea = false;
    private bool searchSpecUserArea = false;
    private bool searchUpdObjArea = false;
    private bool searchComSvcExcludedArea = false;
    private ModellingNamingConvention namingConvention = new();
    private List<IpProtocol> availableProtocols = [];
    private DateTime varAnalysisDate = DateTime.Today;
    private DateTime varAnalysisTime = DateTime.Now.AddSeconds(-DateTime.Now.Second);
    private RuleRecognitionOption ruleRecognitionOption = new();

    private bool initComplete = false;
    private bool varOptMode = false;
    private bool modIntegrationStatesMode = false;
    private bool reducedProtocolSelectionMode = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configData = await globalConfig.GetEditableConfig();
            availableProtocols = ProtocolDisplayHelper.CustomSortProtocols(
                ProtocolDisplayHelper.GetSelectableProtocols(await apiConnection.SendQueryAsync<List<IpProtocol>>(StmQueries.getIpProtocols)),
                null,
                false);
            ExtraConfigs = JsonSerializer.Deserialize<List<string>>(configData.ModExtraConfigs) ?? [];
            namingConvention = ModellingNamingConvention.FromJson(configData.ModNamingConvention);
            if (configData.ModAppServerTypes != "")
            {
                appServerTypes = JsonSerializer.Deserialize<List<AppServerType>>(configData.ModAppServerTypes) ?? [];
                if (appServerTypes.Count > 0)
                {
                    appServerDefaultTypeName = appServerTypes.FirstOrDefault(x => x.Id == 0)?.Name ?? "";
                }
            }
            allAreas = await apiConnection.SendQueryAsync<List<ModellingNwGroup>>(ModellingQueries.getNwGroupObjects,
                new { grpType = (int)ModellingTypes.ModObjectType.NetworkArea });
            CommonAreas = RefreshAreas(configData.ModCommonAreas);
            SpecUserAreas = RefreshAreas(configData.ModSpecUserAreas);
            UpdObjAreas = RefreshAreas(configData.ModUpdatableObjAreas);
            ComSvcExcludedAreas = RefreshAreas(configData.ModComSvcExcludedAreas);
            varAnalysisDate = varAnalysisTime = configData.VarianceAnalysisStartAt;

            ruleRecognitionOption = string.IsNullOrEmpty(configData.RuleRecognitionOption) ? new() : JsonSerializer.Deserialize<RuleRecognitionOption>(configData.RuleRecognitionOption) ?? new();
            initComplete = true;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    private List<CommonArea> RefreshAreas(string configItem)
    {
        List<CommonArea> areas = [];
        if (configData != null && configItem != "")
        {
             foreach (var areaInfo in JsonSerializer.Deserialize<List<CommonAreaConfig>>(configItem) ?? [])
            {
                ModellingNwGroup? area = allAreas.FirstOrDefault(a => a.Id == areaInfo.AreaId);
                if (area != null)
                {
                    areas.Add(new() { Area = new() { Content = area }, UseInSrc = areaInfo.UseInSrc, UseInDst = areaInfo.UseInDst });
                }
            }
        }
        return areas;
    }

    public bool AddCommonArea(ModellingNwGroup area)
    {
        CommonAreas.Add(new() { Area = new() { Content = area } });
        return true;
    }

    public bool AddSpecUserArea(ModellingNwGroup area)
    {
        SpecUserAreas.Add(new() { Area = new() { Content = area } });
        return true;
    }

    public bool AddUpdObjArea(ModellingNwGroup area)
    {
        UpdObjAreas.Add(new() { Area = new() { Content = area } });
        return true;
    }

    public bool AddComSvcExcludedArea(ModellingNwGroup area)
    {
        ComSvcExcludedAreas.Add(new() { Area = new() { Content = area } });
        return true;
    }

    private void AddExtraConfig()
    {
        if (actExtraConfig != "")
        {
            ExtraConfigsToAdd.Add(actExtraConfig);
            actExtraConfig = "";
        }
    }


    private void AddAppServerType()
    {
        if (actAppServerType.Id > 0 && actAppServerType.Name != ""
            && ( appServerTypesToAdd.FirstOrDefault(a => a.Id == actAppServerType.Id) == null )
            && ( appServerTypes.FirstOrDefault(a => a.Id == actAppServerType.Id) == null ))
        {
            appServerTypesToAdd.Add(actAppServerType);
            actAppServerType = new();
        }
    }

    private void PredefServices()
    {
        predefServices = true;
    }

    private bool SearchCommonArea()
    {
        searchCommonArea = true;
        StateHasChanged();
        return true;
    }

    private bool SearchSpecUserArea()
    {
        searchSpecUserArea = true;
        StateHasChanged();
        return true;
    }

    private bool SearchUpdObjArea()
    {
        searchUpdObjArea = true;
        StateHasChanged();
        return true;
    }

    private bool SearchComSvcExcludedArea()
    {
        searchComSvcExcludedArea = true;
        StateHasChanged();
        return true;
    }

    private void VarianceOptions()
    {
        varOptMode = true;
    }

    private void ModIntegrationStates()
    {
        modIntegrationStatesMode = true;
    }

    private void OpenReducedProtocolSelection()
    {
        reducedProtocolSelectionMode = true;
    }

    private async Task Save()
    {
        try
        {
            namingConvention.Normalize();
            string? namingConventionError = GetNamingConventionError();
            if (namingConventionError != null)
            {
                DisplayMessageInUi(null, userConfig.GetText("modelling_settings"), userConfig.GetText(namingConventionError), true);
                return;
            }
            if (configData != null)
            {
                PrepareConfigData();
                await globalConfig.WriteToDatabase(configData, apiConnection);

                CommAreasToDelete = [];
                appServerTypesToAdd = [];
                appServerTypesToDelete = [];
                ExtraConfigsToAdd = [];
                ExtraConfigsToDelete = [];
                CommonAreas = RefreshAreas(configData.ModCommonAreas);
                SpecUserAreas = RefreshAreas(configData.ModSpecUserAreas);
                UpdObjAreas = RefreshAreas(configData.ModUpdatableObjAreas);
                ComSvcExcludedAreas = RefreshAreas(configData.ModComSvcExcludedAreas);
                DisplayMessageInUi(null, userConfig.GetText("modelling_general_settings"), userConfig.GetText("U5301"), false);
            }
            else
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("modelling_general_settings"), "", true);
        }
    }

    /// <summary>
    /// Determines the message key if converting a network area would not preserve the area-specific part of its fixed identifier.
    /// Only relevant for conventions using network areas, as no conversion takes place otherwise.
    /// </summary>
    private string? GetNamingConventionError()
    {
        if (namingConvention.IsAreaConversionValid())
        {
            return null;
        }
        return namingConvention.IsFixedPartLengthValid() ? "E5602" : "E5601";
    }

    private void PrepareConfigData()
    {
        PrepareExtraConfigs();
        configData!.ModNamingConvention = JsonSerializer.Serialize(namingConvention);
        PrepareAppServerTypes();
        configData!.ModCommonAreas = PrepareAreas(CommonAreas, CommAreasToDelete);
        configData!.ModSpecUserAreas = PrepareAreas(SpecUserAreas, SpecUserAreasToDelete);
        configData!.ModUpdatableObjAreas = PrepareAreas(UpdObjAreas, UpdObjAreasToDelete);
        configData!.ModComSvcExcludedAreas = PrepareAreas(ComSvcExcludedAreas, ComSvcExcludedAreasToDelete);
        configData!.VarianceAnalysisStartAt = varAnalysisDate.Date.Add(varAnalysisTime.TimeOfDay);
        configData!.RuleRecognitionOption = JsonSerializer.Serialize(ruleRecognitionOption);
    }

    private string PrepareAreas(List<CommonArea> areas, List<CommonArea> areasToDelete)
    {
        List<CommonAreaConfig> commAreaConfigItems = areas.ConvertAll(x => x.ToConfigItem());
        foreach (var area in areasToDelete)
        {
            CommonAreaConfig? existingItem = commAreaConfigItems.FirstOrDefault(x => x.AreaId == area.Area.Content.Id);
            if (existingItem != null)
            {
                commAreaConfigItems.Remove(existingItem);
            }
        }
        return JsonSerializer.Serialize(commAreaConfigItems);
    }

    private void PrepareAppServerTypes()
    {
        AppServerType? defaultType = appServerTypes.FirstOrDefault(x => x.Id == 0);
        if (defaultType != null)
        {
            defaultType.Name = appServerDefaultTypeName;
        }
        else
        {
            appServerTypes.Add(new() { Id = 0, Name = appServerDefaultTypeName });
        }
        foreach (var appServerType in appServerTypesToDelete)
        {
            appServerTypes.Remove(appServerType);
        }
        foreach (var appServerType in appServerTypesToAdd)
        {
            appServerTypes.Add(appServerType);
        }
        configData!.ModAppServerTypes = JsonSerializer.Serialize(appServerTypes);
    }

    private void PrepareExtraConfigs()
    {
        foreach (var config in ExtraConfigsToDelete)
        {
            ExtraConfigs.Remove(config);
        }
        foreach (var config in ExtraConfigsToAdd)
        {
            ExtraConfigs.Add(config);
        }
        configData!.ModExtraConfigs = JsonSerializer.Serialize(ExtraConfigs);
    }
}
