@using FWO.Basics
@using FWO.Config.Api.Data
@using FWO.Data
@using FWO.Services

@page "/settings/modellingnotifications"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig

<div class="input-group">
    <h3>@(userConfig.GetText("notifications"))</h3>
    <HelpLink Page="settings/modellingnotifications" />
</div>
<hr />

@if (configData != null && initComplete)
{
    <form onsubmit="return false">
        <h4>@(userConfig.GetText("request_interface"))</h4>
        <SettingsRow LabelKey="modReqInterfaceName" TooltipKey="H5622" LabelFor="modReqInterfaceName">
            <input id="modReqInterfaceName" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData.ModReqInterfaceName" />
        </SettingsRow>
        <SettingsRow LabelKey="modReqTicketTitle" TooltipKey="H5625" LabelFor="modReqTicketTitle">
            <input id="modReqTicketTitle" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData.ModReqTicketTitle" />
        </SettingsRow>
        <SettingsRow LabelKey="modReqTaskTitle" TooltipKey="H5626" LabelFor="modReqTaskTitle">
            <input id="modReqTaskTitle" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData.ModReqTaskTitle" />
        </SettingsRow>
        <div class="mt-4 mb-3">
            <ExecutionModeAuthorizeView Roles="@Roles.Admin">
                <Authorized>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>
                        @(DisplayService.DisplayButton(userConfig, "save", Icons.Save))
                    </button>
                </Authorized>
                <NotAuthorized>
                    <button type="button" class="btn btn-sm btn-primary" disabled>
                        @(DisplayService.DisplayButton(userConfig, "save", Icons.Save))
                    </button>
                </NotAuthorized>
            </ExecutionModeAuthorizeView>
        </div>
        <hr />
        <h4>@(userConfig.GetText("initial_request"))</h4>
        <div class="mt-4">
            <EditNotifications Client="NotificationClient.InterfaceRequest"
                               DeadlineFilter="NotificationDeadline.None" />
        </div>
        <hr />
        <div class="mt-4">
            <h4>@(userConfig.GetText("reminder"))</h4>
            <EditNotifications Client="NotificationClient.InterfaceRequest"
                               DeadlineFilter="NotificationDeadline.RequestDate" />
        </div>
        <hr class="mt-4" />
        <div class="mt-4">
            <h4>@(userConfig.GetText("decomm_interface"))</h4>
        </div>
        <div class="mt-4">
            <EditNotifications Client="NotificationClient.InterfaceDecomm"
                               DeadlineFilter="NotificationDeadline.None" />
        </div>
    </form>
}
else
{
    <Loading />
}

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private bool initComplete;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ConfigData editableConfig = await globalConfig.GetEditableConfig();
            configData = editableConfig;
            initComplete = true;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    private async Task Save()
    {
        try
        {
            if (configData == null)
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }

            await globalConfig.WriteToDatabase(configData, apiConnection);
            DisplayMessageInUi(null, userConfig.GetText("interfaces"), userConfig.GetText("U5301"), false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("interfaces"), "", true);
        }
    }
}
