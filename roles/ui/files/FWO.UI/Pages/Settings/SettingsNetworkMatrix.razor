@page "/settings/matrix"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}, {Roles.FwAdmin}")]

@using FWO.Services.EventMediator.Events
@using FWO.Services.EventMediator.Interfaces
@using FWO.Ui.Data

@implements IDisposable
@inject ApiConnection ApiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig
@inject IEventMediator EventMediator

<div class="input-group">
    <h3>@(userConfig.GetText("matrix"))</h3>
    <HelpLink Page="settings/matrix" />
</div>
@(userConfig.GetText("U5328"))
<hr />
<div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5812"))">
    <label class="col-form-label col-sm-4">@userConfig.GetText("import_matrix"):</label>
    <div class="row col-sm-6">
        <ImportFileUpload SupportedFileFormats=".json" AuthorizedRoles="@Roles.Admin" UploadCase="FileUploadCase.ImportMatrix" />
    </div>
</div>
@if (configData != null)
{
    <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5842"))">
        <label for="lbl_imported_matrix_readonly" class="col-form-label col-sm-4">@(userConfig.GetText("importedMatrixReadOnly")):</label>
        <div class="col-sm-7">
            <input id="lbl_imported_matrix_readonly" type="checkbox" @bind="configData.ImportedMatrixReadOnly" />
        </div>
    </div>
    <hr />
    <form onsubmit="return false">
        <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5891"))">
            <label class="col-form-label col-sm-4">@(userConfig.GetText("designated_zone_matrix")):</label>
            <div class="col-sm-2">
                <Dropdown ElementType="ComplianceCriterion"
                          ElementToString="@(matrix => matrix.Name)"
                          @bind-SelectedElement="designatedZoneMatrix"
                          Elements="matrices"
                          Nullable="true"
                          NoneSelectedText="@(userConfig.GetText("undefined"))">
                    <ElementTemplate Context="matrix">
                        @matrix.Name
                    </ElementTemplate>
                </Dropdown>
            </div>
        </div>
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5809"))">
            <label class="col-form-label col-sm-4">@(userConfig.GetText("matrixAllowNestedZones"))</label>
            <div class="col-sm-7">
                <input type="checkbox" @bind="configData!.MatrixAllowNestedZones" />
            </div>
        </div>
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5815"))">
            <label class="col-form-label col-sm-4">@(userConfig.GetText("sortMatrixByID"))</label>
            <div class="col-sm-7">
                <input type="checkbox" @bind="configData!.SortMatrixByID" />
            </div>
        </div>
    </form>
    <hr />
    <div class="pb-5">
        <ExecutionModeAuthorizeView Roles="@Roles.Admin">
            <Authorized>
                <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(userConfig.GetText("save"))</button>
            </Authorized>
            <NotAuthorized>
                <button type="button" class="btn btn-sm btn-primary" disabled>@(userConfig.GetText("save"))</button>
            </NotAuthorized>
        </ExecutionModeAuthorizeView>
    </div>
    <br />
}
else
{
    <Loading />
}

<PopUp Title="@(userConfig.GetText("import_matrix"))" Show="@ShowImportPopUp" Size=PopupSize.Small OnClose="() => ShowImportPopUp = false">
    <Body>
        @if (ImportSuccess)
        {
            <div class="mt-3">
                @($"{userConfig.GetText("E9401")}: {ImportMessage}")
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3" role="alert">
                @($"{userConfig.GetText("E9402")}: {ImportMessage}")
            </div>
        }
    </Body>
    <Footer>
        <div class="btn-group">
            <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowImportPopUp = false">@(userConfig.GetText("ok"))</button>
        </div>
    </Footer>
</PopUp>

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private List<ComplianceCriterion> matrices = [];
    private ComplianceCriterion? designatedZoneMatrix;
    private bool ShowImportPopUp { get; set; }
    private string ImportMessage = "";
    private bool ImportSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configData = await globalConfig.GetEditableConfig();
            matrices = (await ApiConnection.SendQueryAsync<List<ComplianceCriterion>>(ComplianceQueries.getMatrices) ?? [])
                .OrderBy(matrix => matrix.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(matrix => matrix.Id)
                .ToList();
            if (configData.ComplianceDesignatedZoneMatrixId > 0)
            {
                designatedZoneMatrix = matrices.FirstOrDefault(matrix => matrix.Id == configData.ComplianceDesignatedZoneMatrixId);
            }
            EventMediator.Subscribe<FileUploadEvent>(nameof(FileUploadService.ReadFileToBytes), _ => OnFileUploadEvent(_.EventArgs));
            EventMediator.Subscribe<FileUploadEvent>(nameof(FileUploadService.ImportMatrix), _ => OnMatrixImportEvent(_.EventArgs));
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    private void OnFileUploadEvent(FileUploadEventArgs? e)
    {
        if (e is null)
        {
            return;
        }
        if (!e.Success && e.Error is not null)
        {
            DisplayMessageInUi(e.Error.InternalException, userConfig.GetText("import_matrix"), e.Error.Message ?? "", true);
            return;
        }
    }

    private void OnMatrixImportEvent(FileUploadEventArgs? e)
    {
        if (e is null)
        {
            return;
        }
        ImportSuccess = e.Success;
        ImportMessage = e.Data?.ToString() ?? "";
        ShowImportPopUp = true;
        StateHasChanged();
    }

    private async Task Save()
    {
        try
        {
            if (configData is null)
            {
                throw new InvalidOperationException(
                    "Network matrix settings were saved before loading completed.");
            }

            ConfigData currentConfig = await globalConfig.GetEditableConfig();

            currentConfig.ImportedMatrixReadOnly = configData.ImportedMatrixReadOnly;
            currentConfig.ComplianceDesignatedZoneMatrixId = designatedZoneMatrix?.Id ?? 0;
            currentConfig.MatrixAllowNestedZones = configData.MatrixAllowNestedZones;
            currentConfig.SortMatrixByID = configData.SortMatrixByID;

            await globalConfig.WriteToDatabase(currentConfig, ApiConnection);

            configData = currentConfig;

            DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    /// <summary>
    /// Unsubscribes from file upload events when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        EventMediator.Unsubscribe<FileUploadEvent>(nameof(FileUploadService.ReadFileToBytes));
        EventMediator.Unsubscribe<FileUploadEvent>(nameof(FileUploadService.ImportMatrix));
    }
}
