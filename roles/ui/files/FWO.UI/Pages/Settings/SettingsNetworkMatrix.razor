@page "/settings/matrix"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@using FWO.Data.Middleware
@using FWO.Middleware.Client
@using FWO.Services.EventMediator.Events
@using FWO.Services.EventMediator.Interfaces
@using FWO.Ui.Data
@using RestSharp
@using FWO.Logging;

@implements IDisposable
@inject MiddlewareClient MiddlewareClient
@inject ApiConnection ApiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig
@inject IEventMediator EventMediator

<div class="input-group">
    <h3>@(userConfig.GetText("matrix"))</h3>
    <HelpLink Page="settings/matrix" />
</div>
@(userConfig.GetText("U5328"))
<hr />
<div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5812"))">
    <label class="col-form-label col-sm-4">@userConfig.GetText("import_matrix"):</label>
    <div class="row col-sm-6">
        <ImportFileUpload SupportedFileFormats=".json" AuthorizedRoles="@Roles.Admin" UploadCase="FileUploadCase.ImportComplianceMatrix" />
    </div>
</div>
<div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5842"))">
    <label for="lbl_imported_matrix_readonly" class="col-form-label col-sm-4">@(userConfig.GetText("importedMatrixReadOnly")):</label>
    <div class="col-sm-7">
        <input id="lbl_imported_matrix_readonly" type="checkbox" @bind="configData!.ImportedMatrixReadOnly" />
    </div>
</div>
<hr />
@if (configData != null)
{
    <form onsubmit="return false">
        <div class="form-group row mt-2" data-toggle="tooltip" title="@(userConfig.PureLine("H5891"))">
            <label class="col-form-label col-sm-4">@(userConfig.GetText("designated_zone_matrix")):</label>
            <div class="col-sm-2">
                <Dropdown ElementType="ComplianceCriterion"
                          ElementToString="@(matrix => matrix.Name)"
                          @bind-SelectedElement="designatedZoneMatrix"
                          Elements="matrices"
                          Nullable="true"
                          NoneSelectedText="@(userConfig.GetText("undefined"))">
                    <ElementTemplate Context="matrix">
                        @matrix.Name
                    </ElementTemplate>
                </Dropdown>
            </div>
        </div>
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5809"))">
            <label class="col-form-label col-sm-4">@(userConfig.GetText("zoneMatrixAllowNestedZones"))</label>
            <div class="col-sm-7">
                <input type="checkbox" @bind="configData!.zoneMatrixAllowNestedZones" />
            </div>
        </div>
        <div class="form-group row" data-toggle="tooltip" title="@(userConfig.PureLine("H5815"))">
            <label class="col-form-label col-sm-4">@(userConfig.GetText("sortMatrixByID"))</label>
            <div class="col-sm-7">
                <input type="checkbox" @bind="configData!.sortMatrixByID" />
            </div>
        </div>
    </form>
    <hr />
    <div class="pb-5">
        <ExecutionModeAuthorizeView Roles="@Roles.Admin">
            <Authorized>
                <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(userConfig.GetText("save"))</button>
            </Authorized>
            <NotAuthorized>
                <button type="button" class="btn btn-sm btn-primary" disabled>@(userConfig.GetText("save"))</button>
            </NotAuthorized>
        </ExecutionModeAuthorizeView>
    </div>
    <br />
}
else
{
    <Loading />
}

<PopUp Title="@(userConfig.GetText("import_matrix"))" Show="@ShowImportPopUp" Size=PopupSize.Small OnClose="() => ShowImportPopUp = false">
    <Body>
        @if (ImportSuccess)
        {
            <div class="mt-3">
                @($"{userConfig.GetText("E9401")}: {ImportMessage}")
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3" role="alert">
                @($"{userConfig.GetText("E9402")}: {ImportMessage}")
            </div>
        }
    </Body>
    <Footer>
        <div class="btn-group">
            <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowImportPopUp = false">@(userConfig.GetText("ok"))</button>
        </div>
    </Footer>
</PopUp>

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private DateTime complianceCheckStartDate = DateTime.Today;
    private DateTime complianceCheckStartTime = DateTime.UtcNow.AddSeconds(-DateTime.UtcNow.Second);
    private List<ComplianceCriterion> matrices = [];
    private List<CompliancePolicy> policies = [];
    private ComplianceCriterion? designatedZoneMatrix;
    private CompliancePolicy? actPolicy;
    private bool ShowImportPopUp { get; set; }
    private ErrorBaseModel? ImportError;
    private string ImportMessage = "";
    private bool ImportSuccess = false;
    private bool complianceCheckRunning;
    private bool violationsDeleteRunning;
    private string? complianceCheckJobId;
    private ComplianceCheckJobStatus? complianceCheckStatus;
    private ComplianceCheckJobStatus? violationsDeleteStatus;
    private PeriodicTimer? compliancePollingTimer;
    private CancellationTokenSource? compliancePollingCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configData = await globalConfig.GetEditableConfig();
            complianceCheckStartDate = complianceCheckStartTime = configData.ComplianceCheckStartAt;
            matrices = (await ApiConnection.SendQueryAsync<List<ComplianceCriterion>>(ComplianceQueries.getMatrices) ?? [])
                .OrderBy(matrix => matrix.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(matrix => matrix.Id)
                .ToList();
            if (configData.ComplianceDesignatedZoneMatrixId > 0)
            {
                designatedZoneMatrix = matrices.FirstOrDefault(matrix => matrix.Id == configData.ComplianceDesignatedZoneMatrixId);
            }
            EventMediator.Subscribe<FileUploadEvent>(nameof(FileUploadService.ReadFileToBytes), _ => OnFileUploadEvent(_.EventArgs));
            EventMediator.Subscribe<FileUploadEvent>(nameof(FileUploadService.ImportComplianceMatrix), _ => OnMatrixImportEvent(_.EventArgs));
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    private void OnFileUploadEvent(FileUploadEventArgs? e)
    {
        if (e is null)
        {
            return;
        }
        if (!e.Success && e.Error is not null)
        {
            DisplayMessageInUi(e.Error.InternalException, userConfig.GetText("modelling_settings"), e.Error.Message ?? "", true);
            return;
        }
    }

    private void OnMatrixImportEvent(FileUploadEventArgs? e)
    {
        if (e is null)
        {
            return;
        }
        ImportSuccess = e.Success;
        ImportError = e.Error;
        ImportMessage = e.Data?.ToString() ?? "";
        ShowImportPopUp = true;
        StateHasChanged();
    }

    private async Task Save()
    {
        try
        {
            if (configData != null)
            {
                configData.ComplianceDesignatedZoneMatrixId = designatedZoneMatrix?.Id ?? 0;
                await globalConfig.WriteToDatabase(configData, ApiConnection);
                DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
            }
            else
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    /// <summary>
    /// Sends a query to the middleware server to run a compliance check
    /// </summary>
    /// <returns>
    /// A task that represents the asynchronous operation.
    /// </returns>
    private async Task RunComplianceCheck()
    {
        complianceCheckStatus = new()
        {
            Status = ComplianceCheckExecutionStatus.Running
        };

        complianceCheckRunning = true;

        try
        {
            RestResponse<ComplianceCheckStartResult> response = await MiddlewareClient.StartComplianceCheck();

            if (!response.IsSuccessful || string.IsNullOrWhiteSpace(response.Data?.JobId))
            {
                InvalidOperationException invalidOperation = new(response.ErrorMessage ?? response.StatusDescription ?? "Compliance check start failed.");

                DisplayMessageInUi(invalidOperation, userConfig.GetText("H5849"), response.Content ?? string.Empty, true);

                return;
            }

            complianceCheckJobId = response.Data.JobId;

            await StartComplianceStatusPolling();
        }
        catch (Exception exception)
        {
            complianceCheckStatus.Status = ComplianceCheckExecutionStatus.Failed;
            complianceCheckStatus.Message = exception.Message;
            DisplayMessageInUi(exception, userConfig.GetText("H5849"), exception.Message, true);
        }
    }

    private async Task StartComplianceStatusPolling()
    {
        compliancePollingCts?.CancelAsync();
        compliancePollingTimer?.Dispose();

        compliancePollingCts = new CancellationTokenSource();
        compliancePollingTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        await RefreshComplianceStatus();
        _ = PollComplianceStatus(compliancePollingCts.Token);
    }

    private async Task PollComplianceStatus(CancellationToken token)
    {
        PeriodicTimer? timer = compliancePollingTimer;

        if (timer == null)
        {
            return;
        }

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshComplianceStatus();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException opCancelEx)
        {
            Log.WriteDebug(userConfig.GetText("H5849"), "Compliance Polling stopped.", opCancelEx.Message);
        }
        catch (Exception ex)
        {
            Log.WriteError(userConfig.GetText("H5849"), ex.Message, ex);
            DisplayMessageInUi(ex, userConfig.GetText("H5849"), ex.Message, true);
        }

    }

    private async Task RefreshComplianceStatus()
    {
        if (string.IsNullOrWhiteSpace(complianceCheckJobId))
        {
            return;
        }

        RestResponse<ComplianceCheckJobStatus> response = await MiddlewareClient.GetComplianceCheckStatus(complianceCheckJobId);

        if (!response.IsSuccessful || response.Data == null)
        {
            InvalidOperationException invalidOperationException = new(response.ErrorMessage ?? response.StatusDescription ?? "Compliance status fetch failed.");

            DisplayMessageInUi(invalidOperationException, userConfig.GetText("H5849"), response.Content ?? string.Empty, true);

            StopComplianceStatusPolling();

            complianceCheckRunning = false;

            return;
        }

        complianceCheckStatus = response.Data;
        complianceCheckRunning = complianceCheckStatus.Status is ComplianceCheckExecutionStatus.Queued or ComplianceCheckExecutionStatus.Running;

        if (!complianceCheckRunning)
        {
            StopComplianceStatusPolling();
        }
    }

    private void StopComplianceStatusPolling()
    {
        compliancePollingCts?.Cancel();
        compliancePollingTimer?.Dispose();
        compliancePollingTimer = null;

        if (compliancePollingCts != null)
        {
            compliancePollingCts.Dispose();
            compliancePollingCts = null;
        }
    }

    private string GetComplianceStatusTextKey()
    {
        return complianceCheckStatus?.Status switch
        {
            ComplianceCheckExecutionStatus.Queued => "compliance_check_status_queued",
            ComplianceCheckExecutionStatus.Running => "in_progress",
            ComplianceCheckExecutionStatus.Succeeded => "compliance_check_status_succeeded",
            ComplianceCheckExecutionStatus.Failed => "compliance_check_status_failed",
            _ => "in_progress"
        };
    }

    private string GetStatusCssClasses(ComplianceCheckExecutionStatus complianceCheckStatus)
    {
        return complianceCheckStatus switch
        {
            ComplianceCheckExecutionStatus.Succeeded => "alert alert-success",
            ComplianceCheckExecutionStatus.Failed => "alert alert-danger",
            _ => "alert alert-info"
        };
    }

    /// <summary>
    /// Unsubscribes from file upload events when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        EventMediator.Unsubscribe<FileUploadEvent>(nameof(FileUploadService.ReadFileToBytes));
        EventMediator.Unsubscribe<AppServerImportEvent>(nameof(FileUploadService.ImportComplianceMatrix));

        StopComplianceStatusPolling();
    }
}
