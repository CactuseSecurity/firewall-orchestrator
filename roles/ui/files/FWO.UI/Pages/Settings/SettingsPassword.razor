@using FWO.Middleware.Client
@using FWO.Ui.Services

@page "/settings/password"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Reporter}, {Roles.ReporterViewAll}, {Roles.Modeller}, {Roles.Recertifier}, {Roles.Auditor}, {Roles.WorkflowRolesList}")]

@inject GlobalConfig globalConfig
@inject UserConfig userConfig
@inject MiddlewareClient middlewareClient

<div class="input-group">
    <h3>@(userConfig.GetText("change_password"))</h3>
    <HelpLink Page="settings/password"/>
</div>
@(userConfig.GetText("U5411"))
<hr />

<form onsubmit="return false">
    <SettingsRow LabelKey="old_password" Marked="true" LabelFor="oldPw">
        <input id="oldPw" type="password" class="form-control form-control-sm settings-input-md" @bind="oldPassword" />
    </SettingsRow>
    <SettingsRow LabelKey="new_password" Marked="true" LabelFor="newPw1">
        <input id="newPw1" type="password" class="form-control form-control-sm settings-input-md" @bind="newPassword1" />
    </SettingsRow>
    <SettingsRow LabelKey="new_password" Marked="true" LabelFor="newPw2">
        <input id="newPw2" type="password" class="form-control form-control-sm settings-input-md" @bind="newPassword2" />
    </SettingsRow>
</form>

<hr />
<ExecutionModeAuthorizeView Roles="@($"{Roles.Admin}, {Roles.Reporter}, {Roles.ReporterViewAll}, {Roles.Modeller}, {Roles.Recertifier}, {Roles.WorkflowRolesList}")">
    <Authorized>
        <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanChangePassword())" @onclick:preventDefault="true" @onclick="ChangePassword">@(DisplayService.DisplayButton(userConfig, "change_password", Icons.Save))</button>
    </Authorized>
    <NotAuthorized>
        <button type="button" class="btn btn-sm btn-primary" disabled>@(DisplayService.DisplayButton(userConfig, "change_password", Icons.Save))</button>
    </NotAuthorized> 
</ExecutionModeAuthorizeView>

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private string oldPassword = "";
    private string newPassword1 = "";
    private string newPassword2 = "";

    protected override void OnInitialized()
    {

    }

    private async Task ChangePassword()
    {
        if (!CanChangePassword())
        {
            return;
        }

        try
        {
            string errorMsg = await (new PasswordChanger(middlewareClient)).ChangePassword(oldPassword, newPassword1, newPassword2, userConfig, globalConfig);
            if(errorMsg == "")
            {
                DisplayMessageInUi(null, userConfig.GetText("change_password"), userConfig.GetText("U5401"), false);
            }
            else
            {
                DisplayMessageInUi(null, userConfig.GetText("change_password"), errorMsg, true);
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_password"), "", true);
        }
    }

    private bool CanChangePassword()
    {
        return !userConfig.CanUseAnyRole(Roles.Auditor);
    }
}
