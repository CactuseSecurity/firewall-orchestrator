@page "/settings/personal"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Reporter}, {Roles.ReporterViewAll}, {Roles.Modeller}, {Roles.Recertifier}, {Roles.Auditor}, {Roles.WorkflowRolesList}")]

@using System.Linq
@using FWO.Config.Api.Data
@using FWO.Basics.Enums
@using FWO.Ui.Data.Extensions
@using FWO.Ui.Services

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig

<div class="input-group">
    <h3>@(userConfig.GetText("personal_settings"))</h3>
    <HelpLink Page="settings/personal" />
</div>
<hr />

@if (configData != null)
{
    <form onsubmit="return false">
        <h4>@(userConfig.GetText("language_settings"))</h4>
        <SettingsRow LabelKey="language" TooltipKey="U5412">
            <div class="settings-input-md">
                <Dropdown ElementType="Language" ElementToString="@(l => userConfig.GetText(l.Name))" @bind-SelectedElement="selectedLanguage" Elements="globalConfig.UiLanguages">
                    <ElementTemplate Context="language">
                        @(userConfig.GetText(language.Name))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>

        <hr />
        <h4>@(userConfig.GetText("display_settings"))</h4>
        <SettingsRow LabelKey="modIconify" TooltipKey="H5618" LabelFor="cbx_personal_iconify">
            <div class="form-check form-switch">
                <input id="cbx_personal_iconify" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ModIconify">
            </div>
        </SettingsRow>

        <ExecutionModeAuthorizeView Roles="@($"{Roles.Admin}, {Roles.Reporter}, {Roles.ReporterViewAll}, {Roles.Recertifier}, {Roles.Modeller}, {Roles.Auditor}")">
            <hr />
            <h4>@(userConfig.GetText("report_settings"))</h4>
            <SettingsRow LabelKey="default_rules_view" TooltipKey="H5460" LabelFor="defaultRulesView">
                <div class="settings-input-md">
                    <RulesViewSelect Id="defaultRulesView" @bind-ManagementRulebaseView="configData!.DefaultManagementRulebaseView" />
                </div>
            </SettingsRow>
            <SettingsRow LabelKey="elementsPerFetch" TooltipKey="H5412" LabelFor="elementsPerFetch">
                <input id="elementsPerFetch" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.ElementsPerFetch" />
            </SettingsRow>
            <SettingsRow LabelKey="minCollapseAllDevices" TooltipKey="H5422" LabelFor="minCollapseAllDevices">
                <input id="minCollapseAllDevices" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.MinCollapseAllDevices">
            </SettingsRow>
            <SettingsRow LabelKey="messageViewTime" TooltipKey="H5423" LabelFor="messageViewTime">
                <input id="messageViewTime" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.MessageViewTime">
            </SettingsRow>
            <SettingsRow LabelKey="resolveNetworkAreas" TooltipKey="H5456" LabelFor="resolveNAs">
                <div class="form-check form-switch">
                    <input id="resolveNAs" type="checkbox" role="switch" class="form-check-input" @bind="configData!.ResolveNetworkAreas">
                </div>
            </SettingsRow>
            <hr />
            <SettingsRow LabelKey="unusedTolerance" TooltipKey="H5447" LabelFor="unusedTolerance">
                <input id="unusedTolerance" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.UnusedTolerance" />
            </SettingsRow>
            <SettingsRow LabelKey="creationTolerance" TooltipKey="H5448" LabelFor="creationTolerance">
                <input id="creationTolerance" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.CreationTolerance" />
            </SettingsRow>
            <hr />
            <SettingsRow LabelKey="PreferredCollapseState" TooltipKey="H5462">
                <div class="settings-input-md">
                    <Dropdown ElementType="PreferredCollapseState" ElementToString="_ => _.ToString(userConfig)"
                              Elements="Enum.GetValues<PreferredCollapseState>().Where(state => state != PreferredCollapseState.Intermediate)"
                              @bind-SelectedElement="configData!.ReportingPersonalPreferredCollapseState" />
                </div>
            </SettingsRow>
        </ExecutionModeAuthorizeView>

        @if (userConfig.RecertificationMode == RecertificationMode.RuleByRule)
        {
            <ExecutionModeAuthorizeView Roles="@($"{Roles.Admin}, {Roles.Recertifier}, {Roles.Auditor}")">
                <hr />
                <h4>@(userConfig.GetText("recert_settings"))</h4>
                <SettingsRow LabelKey="recertificationDisplayPeriod" TooltipKey="H5419" LabelFor="recertificationDisplayPeriod">
                    <input id="recertificationDisplayPeriod" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.RecertificationDisplayPeriod" />
                </SettingsRow>
            </ExecutionModeAuthorizeView>
        }

        <ExecutionModeAuthorizeView Roles="@($"{Roles.Admin}, {Roles.Modeller}, {Roles.Auditor}")">
            <hr />
            <h4>@(userConfig.GetText("modelling_settings"))</h4>
            <SettingsRow LabelKey="overviewDisplayLines" TooltipKey="H5605" LabelFor="overviewDisplayLines">
                <input id="overviewDisplayLines" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.OverviewDisplayLines" />
            </SettingsRow>
        </ExecutionModeAuthorizeView>
    </form>
    <hr />
    <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
}
else
{
    <Loading />
}

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private Language selectedLanguage = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configData = await userConfig.GetEditableConfig();
            selectedLanguage = globalConfig.UiLanguages.FirstOrDefault(l => l.Name == userConfig.User.Language) ?? new Language();
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    private async Task Save()
    {
        try
        {
            if (configData == null)
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }

            if (selectedLanguage.Name != userConfig.User.Language)
            {
                try
                {
                    await ChangeLanguage(selectedLanguage);
                }
                catch (Exception exception)
                {
                    DisplayMessageInUi(exception, userConfig.GetText("change_language"), "", true);
                    return;
                }
            }

            await userConfig.WriteToDatabase(configData, apiConnection);
            DisplayMessageInUi(null, userConfig.GetText("personal_settings"), userConfig.GetText("U5301"), false);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("personal_settings"), "", true);
        }
    }

    private async Task ChangeLanguage(Language language)
    {
        Log.WriteDebug("Change language", $"new language: {language.Name}");
        await userConfig.ChangeLanguage(language.Name, apiConnection);
    }
}
