@using FWO.Data
@using FWO.Recert
@using System.Text.Json

@page "/settings/recertificationgeneral"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig

<div class="input-group">
    <h3>@(userConfig.GetText("recert_settings"))</h3>
    <HelpLink Page="settings/recertificationgeneral"/>
</div>
@(userConfig.GetText("U5311"))
<hr />

@if (configData != null)
{
    <form onsubmit="return false">
        <SettingsRow LabelKey="recertificationMode" TooltipKey="H5458">
            <div class="settings-input-md">
                <Dropdown ElementType="RecertificationMode" @bind-SelectedElement="configData!.RecertificationMode" ElementToString="@(t => userConfig.GetText(t.ToString()))"
                        Elements="Enum.GetValues(typeof(RecertificationMode)).Cast<RecertificationMode>()" >
                    <ElementTemplate Context="recertMode">
                        @(userConfig.GetText(recertMode.ToString()))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="recertificationPeriod" TooltipKey="H5417" LabelFor="recertificationPeriod">
            <input id="recertificationPeriod" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.RecertificationPeriod" />
        </SettingsRow>
        @if(configData!.RecertificationMode == RecertificationMode.RuleByRule)
        {
            <SettingsRow LabelKey="recertificationNoticePeriod" TooltipKey="H5418" LabelFor="recertificationNoticePeriod">
                <input id="recertificationNoticePeriod" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.RecertificationNoticePeriod" />
            </SettingsRow>
            <SettingsRow LabelKey="recertificationDisplayPeriod" TooltipKey="H5419" Marked="true" LabelFor="recertificationDisplayPeriod">
                <input id="recertificationDisplayPeriod" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.RecertificationDisplayPeriod" />
            </SettingsRow>
            <SettingsRow LabelKey="ruleRemovalGracePeriod" TooltipKey="H5420" LabelFor="ruleRemovalGracePeriod">
                <input id="ruleRemovalGracePeriod" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.RuleRemovalGracePeriod" />
            </SettingsRow>
            <SettingsRow LabelKey="commentRequired" TooltipKey="H5421" LabelFor="cbx_comment_required">
                <div class="form-check form-switch">
                    <input id="cbx_comment_required" type="checkbox" role="switch" class="form-check-input" @bind="configData!.CommentRequired" />
                </div>
            </SettingsRow>
        }
        else
        {
            <SettingsRow LabelKey="initialRecertificationPeriod" TooltipKey="H5417a" LabelFor="initialRecertificationPeriod">
                <input id="initialRecertificationPeriod" type="number" min="0" class="form-control form-control-sm settings-input-sm" @bind="configData!.InitialRecertificationPeriod" />
            </SettingsRow>
            <SettingsRow LabelKey="initialRecertifier" TooltipKey="H5417b" LabelFor="initialRecertifier">
                <input id="initialRecertifier" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.InitialRecertifier" />
            </SettingsRow>
        }
        <hr />
        <SettingsRow LabelKey="recCheckActive" TooltipKey="H5428" LabelFor="cbx_rec_check_active">
            <div class="form-check form-switch">
                <input id="cbx_rec_check_active" type="checkbox" role="switch" class="form-check-input" @bind="configData!.RecCheckActive" />
            </div>
        </SettingsRow>
        <SettingsRow LabelKey="recert_check_every" TooltipKey="H5429" Marked="true" LabelFor="recertCheckOffset">
            <input id="recertCheckOffset" type="number" min="1" class="form-control form-control-sm settings-input-sm" @bind="recCheckParams.RecertCheckOffset" />
            <div class="settings-input-sm">
                <Dropdown ElementType="SchedulerInterval" @bind-SelectedElement="recCheckParams.RecertCheckInterval" ElementToString="@(i => userConfig.GetText(i.ToString()))"
                        Elements="Enum.GetValues(typeof(SchedulerInterval)).Cast<SchedulerInterval>().Where(x => x.OfferedForRecert())" >
                    <ElementTemplate Context="interval">
                        @(userConfig.GetText(interval.ToString()))
                    </ElementTemplate>
                </Dropdown>
            </div>
            @if(recCheckParams.RecertCheckInterval == SchedulerInterval.Weeks)
            {
                <span>@(userConfig.GetText("each_on")):</span>
                <div class="settings-input-sm">
                    <Dropdown ElementType="DayOfWeek?" ElementToString="@(d => userConfig.GetText(d?.ToString() ?? "undefined"))" @bind-SelectedElement="selectedDayOfWeek"
                            Elements="Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek?>()" Nullable="true">
                        <ElementTemplate Context="weekday">
                            @(weekday != null ? userConfig.GetText(weekday.ToString() ?? "undefined") : "-")
                        </ElementTemplate>
                    </Dropdown>
                </div>
            }
            else if(recCheckParams.RecertCheckInterval == SchedulerInterval.Months)
            {
                <label for="recertCheckDayOfMonth">@(userConfig.GetText("each_on")):</label>
                <input id="recertCheckDayOfMonth" type="number" min="0" max="31" class="form-control form-control-sm settings-input-sm" @bind="recCheckParams.RecertCheckDayOfMonth" />
            }
        </SettingsRow>
        @if(configData!.RecertificationMode == RecertificationMode.OwnersAndRules)
        {
            <SettingsRow LabelKey="recCheckNotifications" TooltipKey="H5459" AlignTop="true">
                <div class="w-100">
                    <EditNotifications Client="NotificationClient.Recertification"/>
                </div>
            </SettingsRow>
        }
        else if(configData!.RecertificationMode == RecertificationMode.RuleByRule)
        {
            <SettingsRow LabelKey="recCheckNotifications" TooltipKey="H5459" AlignTop="true">
                <div class="w-100">
                    <EditNotifications Client="NotificationClient.RuleRecertification" DeadlineFilter="NotificationDeadline.None"/>
                </div>
            </SettingsRow>
        }
        <SettingsRow LabelKey="recCheckEmailUpcomingText" TooltipKey="H5446" LabelFor="recCheckEmailUpcomingText">
            <input id="recCheckEmailUpcomingText" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.RecCheckEmailUpcomingText" />
        </SettingsRow>
        <SettingsRow LabelKey="recCheckEmailOverdueText" TooltipKey="H5432" LabelFor="recCheckEmailOverdueText">
            <input id="recCheckEmailOverdueText" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.RecCheckEmailOverdueText" />
        </SettingsRow>
        @if(configData!.RecertificationMode == RecertificationMode.RuleByRule)
        {
            <hr />
            <SettingsRow LabelKey="recAutocreateDeleteTicket" TooltipKey="H5433" LabelFor="cbx_rec_auto_create_delete_ticket">
                <div class="form-check form-switch">
                    <input id="cbx_rec_auto_create_delete_ticket" type="checkbox" role="switch" class="form-check-input" @bind="configData!.RecAutoCreateDeleteTicket" />
                </div>
            </SettingsRow>
            <SettingsRow LabelKey="recDeleteRuleTicketTitle" TooltipKey="H5434" LabelFor="recDeleteRuleTicketTitle">
                <input id="recDeleteRuleTicketTitle" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.RecDeleteRuleTicketTitle" />
            </SettingsRow>
            <SettingsRow LabelKey="recDeleteRuleTicketReason" TooltipKey="H5435" LabelFor="recDeleteRuleTicketReason">
                <input id="recDeleteRuleTicketReason" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.RecDeleteRuleTicketReason" />
            </SettingsRow>
            <SettingsRow LabelKey="recDeleteRuleReqTaskTitle" TooltipKey="H5436" LabelFor="recDeleteRuleReqTaskTitle">
                <input id="recDeleteRuleReqTaskTitle" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.RecDeleteRuleReqTaskTitle" />
            </SettingsRow>
            <SettingsRow LabelKey="recDeleteRuleReqTaskReason" TooltipKey="H5437" LabelFor="recDeleteRuleReqTaskReason">
                <input id="recDeleteRuleReqTaskReason" type="text" class="form-control form-control-sm settings-input-lg" @bind="configData!.RecDeleteRuleReqTaskReason" />
            </SettingsRow>
            <SettingsRow LabelKey="recDeleteRuleTicketPriority" TooltipKey="H5438">
                <div class="settings-input-md">
                    <Dropdown ElementType="WfPriority" ElementToString="@(p => p.Name)" @bind-SelectedElement="selectedPriority" Elements="PrioList">
                        <ElementTemplate Context="prio">
                            @prio.Name
                        </ElementTemplate>
                    </Dropdown>
                </div>
            </SettingsRow>
            <SettingsRow LabelKey="recDeleteRuleInitState" TooltipKey="H5439">
                <div class="settings-input-md">
                    <Dropdown ElementType="WfState" ElementToString="@(s => s.Name)" @bind-SelectedElement="selectedState" Elements="states">
                        <ElementTemplate Context="state">
                            @state.Name
                        </ElementTemplate>
                    </Dropdown>
                </div>
            </SettingsRow>
            <hr />
            <SettingsRow LabelKey="recalc_recerts" TooltipKey="H5440">
                <div class="form-check">
                    <input id="cbx_rec_refresh_startup" type="checkbox" class="form-check-input" @bind="configData!.RecRefreshStartup" />
                    <label for="cbx_rec_refresh_startup" class="form-check-label">@(userConfig.GetText("at_startup"))</label>
                </div>
                <div class="form-check">
                    <input id="cbx_rec_refresh_daily" type="checkbox" class="form-check-input" @bind="configData!.RecRefreshDaily" />
                    <label for="cbx_rec_refresh_daily" class="form-check-label">@(userConfig.GetText("daily"))</label>
                </div>
                <ExecutionModeAuthorizeView Roles="@Roles.Admin">
                    <Authorized>
                        @if (!recertCalcInProgress)
                        {
                            <button type="button" class="btn btn-sm btn-info" @onclick:preventDefault="true" @onclick="@( async () => { 
                                recertCalcInProgress = true; 
                                if (await RecertRefresh.RecalcRecerts(apiConnection))
                                {
                                    DisplayMessageInUi(null, userConfig.GetText("fetch_data"), "Error during recertification refresh", true);
                                }
                                recertCalcInProgress = false; 
                            })">@(userConfig.GetText("recalc_now"))</button>
                        }
                        else
                        {
                            <Loading/>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <button type="button" class="btn btn-sm btn-info" disabled>@(userConfig.GetText("recalc_now"))</button>
                    </NotAuthorized>
                </ExecutionModeAuthorizeView>
            </SettingsRow>
        }
    </form>

    <hr />
    <ExecutionModeAuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <button type="button" class="btn btn-sm btn-primary" @onclick="Save" @onclick:preventDefault>@(userConfig.GetText("save"))</button>
        </Authorized>
        <NotAuthorized>
            <button type="button" class="btn btn-sm btn-primary" disabled>@(userConfig.GetText("save"))</button>
        </NotAuthorized>
    </ExecutionModeAuthorizeView>
    <br><br>
    <p>@(userConfig.GetText("U5304"))</p>
}
else
{
    <Loading/>
}


@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private ConfigData? configData;
    private List<WfPriority> PrioList = [];
    private RecertCheckParams recCheckParams = new();
    private List<WfState> states = [];
    private DayOfWeek? selectedDayOfWeek;
    private WfPriority? selectedPriority;
    private WfState? selectedState;
    private bool recertCalcInProgress = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configData = await globalConfig.GetEditableConfig();
            PrioList = System.Text.Json.JsonSerializer.Deserialize<List<WfPriority>>(configData.ReqPriorities) ?? throw new JsonException("Config data could not be parsed.");
            recCheckParams = System.Text.Json.JsonSerializer.Deserialize<RecertCheckParams>(configData.RecCheckParams) ?? throw new JsonException("Config data could not be parsed.");
            states = await apiConnection.SendQueryAsync<List<WfState>>(FWO.Api.Client.Queries.RequestQueries.getStates);
            selectedDayOfWeek = (DayOfWeek?)recCheckParams.RecertCheckWeekday;
            selectedPriority = PrioList.FirstOrDefault(p => p.NumPrio == configData.RecDeleteRuleTicketPriority);
            selectedState = states.FirstOrDefault(s => s.Id == configData.RecDeleteRuleInitState);
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("read_config"), userConfig.GetText("E5301"), false);
        }
    }

    private async Task Save()
    {
        try
        {
            if (configData != null)
            {
                configData.RecDeleteRuleTicketPriority = selectedPriority?.NumPrio ?? 3;
                configData.RecDeleteRuleInitState = selectedState?.Id ?? 0;
                PrepareRecCheckParams();
                await globalConfig.WriteToDatabase(configData, apiConnection);
                DisplayMessageInUi(null, userConfig.GetText("change_default"), userConfig.GetText("U5301"), false);
            }
            else
            {
                throw new ArgumentException("Data saved before loaded. This should be impossible.");
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("change_default"), "", true);
        }
    }

    private void PrepareRecCheckParams()
    {
        if(recCheckParams.RecertCheckDayOfMonth == 0)
        {
            recCheckParams.RecertCheckDayOfMonth = null;
        }
        recCheckParams.RecertCheckWeekday = (int?)selectedDayOfWeek;
        configData!.RecCheckParams = System.Text.Json.JsonSerializer.Serialize(recCheckParams);
    }
}
