@using System.Text.Json

@page "/settings/statedefinitions"
@attribute [Authorize(Roles = $"{Roles.Admin}, {Roles.Auditor}")]

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig

@if(InitComplete)
{
    <div class="input-group">
        <h3>@(userConfig.GetText("available_states"))</h3>
        <HelpLink Page="settings/statedefinitions"/>
    </div>
    @(userConfig.GetText("U5313"))
    <hr />
    <div class="btn-group">
        <button type="button" class="btn btn-sm btn-success" @onclick="AddState">
            @(DisplayService.DisplayButton(userConfig, "add_state", Icons.Add))</button>
        <button type="button" class="btn btn-sm btn-warning" data-toggle="tooltip" title="@(userConfig.PureLine("H5532"))" @onclick="EditExtStates">
            @(DisplayService.DisplayButton(userConfig, "ext_states", Icons.Edit, "ext_states"))</button>
    </div>
    <br><br>
    <div class="m-2 vheight75">
        <Table class="table table-bordered th-bg-secondary table-responsive overflow-auto sticky-header" TableItem="WfState" Items="states" PageSize="0" ColumnReorder="true">
            <Column TableItem="WfState" Title="@(userConfig.GetText("actions"))" Field="(x => x.Id)" Sortable="false" Filterable="false">
                <Template>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-warning" @onclick="() => EditState(context)">
                            @(DisplayService.DisplayButton(userConfig, "edit", Icons.Edit))</button>
                        @if(!usedStateIds.Exists(x => x == context.Id))
                        {
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => RequestDeleteState(context)">
                                @(DisplayService.DisplayButton(userConfig, "delete", Icons.Delete))</button>
                        }
                    </div>
                </Template>
            </Column>
            <Column TableItem="WfState" Title="@(userConfig.GetText("id"))" Field="@(x => x.Id)" Sortable="true" Filterable="true" />
            <Column TableItem="WfState" Title="@(userConfig.GetText("name"))" Field="@(x => x.Name)" Sortable="true" Filterable="true" />
            <Column TableItem="WfState" Title="@(userConfig.GetText("automatic"))" Field="@(x => x.AutomaticOnly)" Sortable="true" Filterable="true">
                <Template>
                    @(context.AutomaticOnly.ShowAsHtml())
                </Template>
            </Column>
            <Column TableItem="WfState" Title="@(userConfig.GetText("state_actions"))" Field="@(x => x.Actions)" Sortable="false">
                <Template>
                    @(context.ActionList())
                </Template>
            </Column>
        </Table>
    </div>

    <PopUp Title="@(userConfig.GetText("edit_state"))" Show="@EditStateMode" Size=PopupSize.Large OnClose="CloseEditState">
        <Body>
            @if (EditStateMode)
            {
                <div class="form-group row">
                    <div class="col-sm-2">
                        @if(AddStateMode && !NewStatePersisted)
                        {
                            <input type="number" class="form-control form-control-sm" @bind="actState.Id" />
                        }
                        else
                        {
                            <label class="col-sm-2 col-form-label col-form-label-sm">@(actState.Id)</label>
                        }
                    </div>
                    <div class="col-sm-6">
                        <input type="text" class="form-control form-control-sm" @bind="actState.Name" />
                    </div>
                    <div class="col-sm-4 d-flex align-items-center">
                        <div class="form-check">
                            <input id="stateAutomatic" type="checkbox" class="form-check-input" @bind="actState.AutomaticOnly" />
                            <label class="form-check-label" for="stateAutomatic">@(userConfig.GetText("automatic"))</label>
                        </div>
                    </div>
                </div>
                <br><br>
                <button type="button" class="btn btn-sm btn-success" disabled="@(!HasSelectableActions())" @onclick="SelectAction">
                    @(DisplayService.DisplayButton(userConfig, "add_action", Icons.Add, "action"))</button>
                <br><br>
                <div class="m-2 vheight75">
                    <Table class="table table-bordered th-bg-secondary table-responsive overflow-auto sticky-header" TableItem="WfStateActionDataHelper" Items="actState.Actions" PageSize="0" ColumnReorder="true">
                        <Column TableItem="WfStateActionDataHelper" Title="@(userConfig.GetText("actions"))" Field="(x => x.Action.Id)" Sortable="false" Filterable="false">
                            <Template>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-sm btn-secondary" disabled="@(ActionIndex(context) == 0)" @onclick="() => MoveActionInState(context, -1)">
                                        <span class="@Icons.CollapseUp"></span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-secondary" disabled="@(ActionIndex(context) >= actState.Actions.Count - 1)" @onclick="() => MoveActionInState(context, 1)">
                                        <span class="@Icons.CollapseDown"></span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveActionFromState(context)">
                                        @(DisplayService.DisplayButton(userConfig, "remove", Icons.Delete))</button>
                                </div>
                            </Template>
                        </Column>
                        <Column TableItem="WfStateActionDataHelper" Title="@(userConfig.GetText("sort_order"))" Field="@(x => x.SortOrder)" Sortable="true" Filterable="true" />
                        <Column TableItem="WfStateActionDataHelper" Title="@(userConfig.GetText("id"))" Field="@(x => x.Action.Id)" Sortable="true" Filterable="true" />
                        <Column TableItem="WfStateActionDataHelper" Title="@(userConfig.GetText("name"))" Field="@(x => x.Action.Name)" Sortable="true" Filterable="true" />
                    </Table>
                </div>
            }
        </Body>
        <Footer>
            <div class="btn-group">
                <ExecutionModeAuthorizeView Roles="@Roles.Admin">
                    <Authorized>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveState">@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
                    </Authorized>
                    <NotAuthorized>
                        <button type="button" class="btn btn-sm btn-primary" disabled>@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
                    </NotAuthorized> 
                </ExecutionModeAuthorizeView>
                <button type="button" class="btn btn-sm btn-secondary" @onclick="Cancel">@(DisplayService.DisplayButton(userConfig, "cancel", Icons.Cancel))</button>
            </div>
        </Footer>
    </PopUp>

    <ConfirmDelete @bind-Display="DeleteStateMode" PerformAction="DeleteState" Title="@userConfig.GetText("delete_state")" DeleteMessage="@(userConfig.GetText("U5501") + actState.Name + "?")"/>

    <PopUp Title="@(userConfig.GetText("select_action"))" Show="@SelectActionMode" Size=PopupSize.Small OnClose="() => SelectActionMode = false">
        <Body>
            @if (SelectActionMode)
            {
                <div class="col-sm-8">
                    <Dropdown ElementType="WfStateAction" ElementToString="@(a => a.Name)" @bind-SelectedElement="selectedAction" Elements="@selectableActions">
                        <ElementTemplate Context="action">
                            @action.Name
                        </ElementTemplate>
                    </Dropdown>
                </div>
            }
        </Body>
        <Footer>
            <div class="btn-group">
                <ExecutionModeAuthorizeView Roles="@Roles.Admin">
                    <Authorized>
                        @if(selectedAction != null && !addActionInProgress)
                        {
                            <button type="button" class="btn btn-sm btn-primary" @onclick="AddActionToState">@(DisplayService.DisplayButton(userConfig, "add", Icons.Add))</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-primary" disabled>@(DisplayService.DisplayButton(userConfig, "add", Icons.Add))</button>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <button type="button" class="btn btn-sm btn-primary" disabled>@(DisplayService.DisplayButton(userConfig, "add", Icons.Add))</button>
                    </NotAuthorized> 
                </ExecutionModeAuthorizeView>
                <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelSelect">@(DisplayService.DisplayButton(userConfig, "cancel", Icons.Cancel))</button>
            </div>
        </Footer>
    </PopUp>

    <EditExtStates @bind-Display="EditExtStatesMode" States="states"/>
}
else
{
    <Loading/>
}

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    private List<WfState> states = [];
    private List<int> usedStateIds = [];
    private WfStateDict statesDict = new ();
    private WfState actState = new ();
    private WfState persistedNewState = new ();

    private List<WfStateAction> actions = [];
    private List<WfStateAction> selectableActions = [];
    private WfStateAction? selectedAction;

    private bool EditStateMode = false;
    private bool AddStateMode = false;
    private bool NewStatePersisted = false;
    private bool DeleteStateMode = false;
    private bool InitComplete = false;
    private bool SelectActionMode = false;
    private bool EditExtStatesMode = false;
    private bool addActionInProgress = false;
    private bool saveInProgress = false;
    private readonly HashSet<int> persistedNewStateActionIds = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            actions = await apiConnection.SendQueryAsync<List<WfStateAction>>(RequestQueries.getActions);
            await RefreshStates();
            InitComplete = true;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("fetch_data"), "", true);
        }
    }

    private async Task RefreshStates()
    {
        states = await apiConnection.SendQueryAsync<List<WfState>>(RequestQueries.getStates);
        foreach (WfState state in states)
        {
            state.Actions = [.. state.Actions.OrderBy(action => action.SortOrder).ThenBy(action => action.Action.Id)];
            NormalizeActionSortOrder(state);
        }
        statesDict = new WfStateDict();
        await statesDict.Init(apiConnection);
        await GetUsedStates();
    }

    private async Task GetUsedStates()
    {
        usedStateIds = [];
        GlobalStateMatrix tmpStateMatrix = new();
        foreach(WfTaskType type in Enum.GetValues(typeof(WfTaskType)))
        {
            await tmpStateMatrix.Init(apiConnection, type);
            foreach(var key in tmpStateMatrix.GlobalMatrix.Keys)
            {
                foreach(var stateId in tmpStateMatrix.GlobalMatrix[key].Matrix.Keys)
                {
                    usedStateIds.Add(stateId);
                    foreach(var toState in tmpStateMatrix.GlobalMatrix[key].Matrix[stateId])
                    {
                        usedStateIds.Add(toState);
                    }
                }
                foreach(var stateId in tmpStateMatrix.GlobalMatrix[key].DerivedStates.Keys)
                {
                    usedStateIds.Add(stateId);
                    usedStateIds.Add(tmpStateMatrix.GlobalMatrix[key].DerivedStates[stateId]);
                }
                usedStateIds.Add(tmpStateMatrix.GlobalMatrix[key].LowestInputState);
                usedStateIds.Add(tmpStateMatrix.GlobalMatrix[key].LowestStartedState);
                usedStateIds.Add(tmpStateMatrix.GlobalMatrix[key].LowestEndState);
            }
        }
        foreach(var action in actions)
        {
            if(action.ExternalParams != "")
            {
                if(action.ActionType == nameof(StateActionTypes.AutoPromote))
                {
                    if (WfStateAction.TryParseAutoPromoteParams(action.ExternalParams, out int? toState, out ConditionalAutoPromoteParams? conditionalParams))
                    {
                        if (toState != null && toState >= 0)
                        {
                            usedStateIds.Add((int)toState);
                        }
                        if (conditionalParams != null)
                        {
                            if (conditionalParams.IfCompliantState >= 0)
                            {
                                usedStateIds.Add(conditionalParams.IfCompliantState);
                            }
                            if (conditionalParams.IfNotCompliantState >= 0)
                            {
                                usedStateIds.Add(conditionalParams.IfNotCompliantState);
                            }
                        }
                    }
                }
                else if(action.ActionType == nameof(StateActionTypes.AddApproval))
                {
                    try
                    {
                        usedStateIds.Add((System.Text.Json.JsonSerializer.Deserialize<ApprovalParams>(action.ExternalParams) ?? throw new JsonException("Extparams could not be parsed.")).StateId);
                    }
                    catch(Exception)
                    {}
                }
            }
        }
    }

    private void AddState()
    {
        ResetNewStateTracking();
        int firstFreeId = 0;
        while (states.Find(x => x.Id == firstFreeId) != null)
        {
            firstFreeId++;
        }
        EditState(new WfState(){ Id = firstFreeId });
        AddStateMode = true;
    }

    private void EditState(WfState state)
    {
        ResetNewStateTracking();
        actState = CloneState(state);
        AddStateMode = false;
        EditStateMode = true;
    }

    private static WfState CloneState(WfState state)
    {
        return new WfState
        {
            Id = state.Id,
            Name = state.Name,
            AutomaticOnly = state.AutomaticOnly,
            Actions = [.. state.Actions.Select(action => new WfStateActionDataHelper
            {
                SortOrder = action.SortOrder,
                Action = new WfStateAction(action.Action)
            })]
        };
    }

    private void ResetNewStateTracking()
    {
        NewStatePersisted = false;
        persistedNewState = new WfState();
        persistedNewStateActionIds.Clear();
    }

    private bool StateExistsInDatabase()
    {
        return !AddStateMode || NewStatePersisted;
    }

    private bool ShouldPersistStateAction(WfStateActionDataHelper action)
    {
        return StateExistsInDatabase() && (!AddStateMode || persistedNewStateActionIds.Contains(action.Action.Id));
    }

    private async Task SaveState()
    {
        if (saveInProgress)
        {
            return;
        }

        saveInProgress = true;
        try
        {
            if (AddStateMode && !NewStatePersisted && states.Any(state => state.Id == actState.Id))
            {
                DisplayMessageInUi(null, userConfig.GetText("edit_state"), userConfig.GetText("duplicate_state_id"), true);
                return;
            }

            if (AddStateMode)
            {
                await SaveAddStateAsync();
            }
            else
            {
                await UpdateStateAsync();
            }
            EditStateMode = false;
            AddStateMode = false;
            ResetNewStateTracking();
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("edit_state"), "", true);
        }
        finally
        {
            saveInProgress = false;
        }
    }

    private async Task SaveAddStateAsync()
    {
        await SaveStateRowAsync();
        await SaveMissingStateActionsAsync();
    }

    private async Task SaveStateRowAsync()
    {
        if (!NewStatePersisted)
        {
            ReturnId createResult = await apiConnection.SendQueryAsync<ReturnId>(RequestQueries.createState, new { id = actState.Id, name = actState.Name, automaticOnly = actState.AutomaticOnly });
            if (createResult.AffectedRows != 1)
            {
                throw new InvalidOperationException($"Could not create workflow state with id {actState.Id}.");
            }
            NewStatePersisted = true;
            states.Add(actState);
            states = states.OrderBy(x => x.Id).ToList();
            persistedNewState = CloneState(actState);
            NormalizeActionSortOrder(actState);
            return;
        }

        await UpdateStateAsync();
    }

    private async Task SaveMissingStateActionsAsync()
    {
        foreach (var action in actState.Actions.Where(action => !persistedNewStateActionIds.Contains(action.Action.Id)).ToList())
        {
            await apiConnection.SendQueryAsync<ReturnId>(RequestQueries.addStateAction, new { stateId = actState.Id, actionId = action.Action.Id, sortOrder = action.SortOrder });
            persistedNewStateActionIds.Add(action.Action.Id);
        }
    }

    private async Task UpdateStateAsync()
    {
        ReturnId updateResult = await apiConnection.SendQueryAsync<ReturnId>(RequestQueries.updateState, new { id = actState.Id, name = actState.Name, automaticOnly = actState.AutomaticOnly });
        if (updateResult.AffectedRows != 1)
        {
            throw new InvalidOperationException($"Workflow state with id {actState.Id} no longer exists.");
        }

        int stateIndex = states.FindIndex(x => x.Id == actState.Id);
        if (stateIndex < 0)
        {
            throw new InvalidOperationException($"Workflow state with id {actState.Id} no longer exists.");
        }

        states[stateIndex] = actState;
        if (AddStateMode && NewStatePersisted)
        {
            persistedNewState = CloneState(actState);
        }
    }

    private void Cancel()
    {
        ReconcilePartiallyPersistedNewState();
        CancelSelect();
        EditStateMode = false;
        AddStateMode = false;
        DeleteStateMode = false;
        EditExtStatesMode = false;
        ResetNewStateTracking();
    }

    private void CloseEditState()
    {
        ReconcilePartiallyPersistedNewState();
        CancelSelect();
        EditStateMode = false;
        AddStateMode = false;
        ResetNewStateTracking();
    }

    private void ReconcilePartiallyPersistedNewState()
    {
        if (!AddStateMode || !NewStatePersisted)
        {
            return;
        }

        HashSet<int> persistedActionIds = persistedNewStateActionIds.ToHashSet();
        if (persistedActionIds.Count != actState.Actions.Count)
        {
            actState.Actions = actState.Actions.Where(action => persistedActionIds.Contains(action.Action.Id)).ToList();
            NormalizeActionSortOrder(actState);
        }

        RestorePersistedNewStateFields();
    }

    private void RestorePersistedNewStateFields()
    {
        actState.Id = persistedNewState.Id;
        actState.Name = persistedNewState.Name;
        actState.AutomaticOnly = persistedNewState.AutomaticOnly;
    }

    private void RequestDeleteState(WfState state)
    {
        actState = state;
        DeleteStateMode = true;
    }

    private async Task DeleteState()
    {
        try
        {
            await apiConnection.SendQueryAsync<object>(RequestQueries.deleteState, new { id = actState.Id });
            states.Remove(actState);
            DeleteStateMode = false;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("delete_state"), "", true);
        }
        StateHasChanged();
    }

    private void SelectAction()
    {
        selectableActions = GetSelectableActions();
        selectedAction = selectableActions.FirstOrDefault();
        SelectActionMode = selectedAction != null;
    }

    private void CancelSelect()
    {
        selectableActions = [];
        selectedAction = null;
        SelectActionMode = false;
    }

    private async Task AddActionToState()
    {
        if (addActionInProgress)
        {
            return;
        }

        addActionInProgress = true;
        try
        {
            WfStateAction selectedActionValue = selectedAction ?? throw new ArgumentException("no action selected");
            if (actState.Actions.Any(action => action.Action.Id == selectedActionValue.Id))
            {
                return;
            }

            if (StateExistsInDatabase())
            {
                await apiConnection.SendQueryAsync<object>(RequestQueries.addStateAction, new { stateId = actState.Id, actionId = selectedActionValue.Id, sortOrder = NextActionSortOrder() });
            }
            WfStateActionDataHelper newAction = new()
            {
                Action = selectedActionValue,
                SortOrder = NextActionSortOrder()
            };
            actState.Actions.Add(newAction);
            if (StateExistsInDatabase() && AddStateMode)
            {
                persistedNewStateActionIds.Add(newAction.Action.Id);
            }
            NormalizeActionSortOrder(actState);
            selectableActions = GetSelectableActions();
            selectedAction = selectableActions.FirstOrDefault();
            SelectActionMode = false;
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("edit_state"), "", true);
        }
        finally
        {
            addActionInProgress = false;
        }
    }

    private async Task RemoveActionFromState(WfStateActionDataHelper action)
    {
        try
        {
            bool shouldPersistAction = ShouldPersistStateAction(action);
            if (shouldPersistAction)
            {
                await apiConnection.SendQueryAsync<object>(RequestQueries.removeStateAction, new { stateId = actState.Id, actionId = action.Action.Id });
                persistedNewStateActionIds.Remove(action.Action.Id);
            }
            actState.Actions.Remove(action);
            NormalizeActionSortOrder(actState);
            if (StateExistsInDatabase())
            {
                await SaveActionSortOrder(actState.Actions.Where(ShouldPersistStateAction));
            }
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("edit_state"), "", true);
        }
    }

    private void EditExtStates()
    {
        EditExtStatesMode = true;
    }

    private int ActionIndex(WfStateActionDataHelper action)
    {
        return actState.Actions.IndexOf(action);
    }

    private int NextActionSortOrder()
    {
        return actState.Actions.Count == 0 ? 1 : actState.Actions.Max(action => action.SortOrder) + 1;
    }

    private List<WfStateAction> GetSelectableActions()
    {
        return actions.Where(action => !actState.Actions.Any(existingAction => existingAction.Action.Id == action.Id)).ToList();
    }

    private bool HasSelectableActions()
    {
        return actions.Any(action => !actState.Actions.Any(existingAction => existingAction.Action.Id == action.Id));
    }

    private static void NormalizeActionSortOrder(WfState state)
    {
        for (int index = 0; index < state.Actions.Count; ++index)
        {
            state.Actions[index].SortOrder = index + 1;
        }
    }

    private async Task MoveActionInState(WfStateActionDataHelper action, int offset)
    {
        int index = ActionIndex(action);
        int targetIndex = index + offset;
        if (index < 0 || targetIndex < 0 || targetIndex >= actState.Actions.Count)
        {
            return;
        }

        WfStateActionDataHelper movedAction = actState.Actions[index];
        actState.Actions[index] = actState.Actions[targetIndex];
        actState.Actions[targetIndex] = movedAction;
        NormalizeActionSortOrder(actState);
        if (StateExistsInDatabase())
        {
            List<WfStateActionDataHelper> changedActions =
            [
                actState.Actions[index],
                actState.Actions[targetIndex]
            ];
            await SaveActionSortOrder(changedActions.Where(ShouldPersistStateAction));
        }
    }

    private async Task SaveActionSortOrder(IEnumerable<WfStateActionDataHelper> stateActions)
    {
        foreach (WfStateActionDataHelper stateAction in stateActions)
        {
            await apiConnection.SendQueryAsync<object>(RequestQueries.updateStateActionSortOrder, new
            {
                stateId = actState.Id,
                actionId = stateAction.Action.Id,
                sortOrder = stateAction.SortOrder
            });
        }
    }
}
