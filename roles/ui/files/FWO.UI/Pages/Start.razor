@using FWO.Services
@using System.Text.Json

@inject GlobalConfig globalConfig
@inject UserConfig userConfig
@inject NavigationManager NavigationManager

@page "/{appId?}"

@* <h3>@(userConfig.GetText("welcome"))</h3> *@

<div style="text-align: center;">
    <div style="display: inline-block; text-align: left;">
        <h3>@(DisplayService.DisplayConfigurableText(userConfig, "welcome_to")) @(globalConfig.ProductVersion)</h3>
        <br>
        <ul>
            <li><b>@(DisplayService.DisplayConfigurableText(userConfig, "whats_new_in_version")) @(globalConfig.ProductVersion)</b></li>
             @(DisplayService.DisplayConfigurableText(userConfig, "whats_new_facts"))
            <br>
            <li><b>@(DisplayService.DisplayConfigurableText(userConfig, "getting_started"))</b></li>
                @(DisplayService.DisplayConfigurableText(userConfig, "getting_started_facts"))
            <br>
            <li><b>@(DisplayService.DisplayConfigurableText(userConfig, "getting_support"))</b></li>
                @(DisplayService.DisplayConfigurableText(userConfig, "support_details"))
            <br>
        </ul>
    </div>
</div>

@code
{
    private int uiUserDbId = -1;

    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    [Parameter]
    public string? AppId { get; set; }

    private List<Module> availableModules { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        uiUserDbId = userConfig.User.DbId;
        await authenticationStateTask!;
        availableModules = string.IsNullOrEmpty(userConfig.AvailableModules) ? [.. Enum.GetValues(typeof(Module)).Cast<Module>()]
                : JsonSerializer.Deserialize<List<Module>>(userConfig.AvailableModules) ?? throw new JsonException("Config data could not be parsed.");
 

        if(userConfig.CanUseAnyRole(Roles.Modeller) && availableModules.Contains(Module.Modelling))
        {
            NavigationManager.NavigateTo($"/{PageName.Modelling}/{AppId ?? ""}");
        }
    }

}
