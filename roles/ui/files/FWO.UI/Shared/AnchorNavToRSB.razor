@using System.Text.RegularExpressions

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject UserConfig userConfig

@implements IDisposable

@code {
    [Parameter]
    public FWO.Ui.Shared.TabSet TabSet { get; set; } = default!;

    [Parameter]
    public FWO.Ui.Data.CollapseState CollapseState { get; set; } = default!;

    /// <summary>
    /// True while the object a report link points to has not been found in the right sidebar yet,
    /// e.g. because its objects are still being fetched.
    /// </summary>
    public bool HasPendingScrollTarget { get; private set; }

    /// <summary>
    /// Right sidebar element the last report link pointed to, kept until <see cref="ScrollToLastTarget"/> was called.
    /// </summary>
    private string? lastTargetElementId;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await NavigateAndScrollToFragment();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await NavigateAndScrollToFragment();
    }

    /// <returns>The html element id to an object in the right side bar.</returns>
    /// <summary>
    /// Expects the URI to contain link to rsb object in form of #goto-{obj-link}. Example URI: localhost/report#goto-report-m8-nwobj31473
    /// </summary>
    private async Task<string> GetIdFromURI()
    {
        var currentUrl = await JSRuntime.InvokeAsync<string>("getCurrentUrl");
        var uri = new Uri(currentUrl, UriKind.Absolute);
        var fragment = uri.Fragment;
        if (fragment.StartsWith("#goto-"))
        {
            // Handle text fragment (https://example.org/#test:~:text=foo)
            // https://github.com/WICG/scroll-to-text-fragment/
            var elementId = fragment.Substring(1);
            var index = elementId.IndexOf(":~:", StringComparison.Ordinal);
            if (index > 5)
            {
                elementId = elementId.Substring(5, index);
            }
            return elementId.Substring(5);
        }
        return "";
        //NOTE: cannot use NavigationManager.GetUri() since it does not reflect change made by JS (removing the fragment)
        //      cannot remove fragment in URI with NavigationManager since it will result in a scroll to top
    }

    public async Task NavigateAndScrollToFragment()
    {
        if (CollapseState == null || !CollapseState.HasExpandSubscribers)
            return; // collapses not fully rendered yet

        string elementId = await GetIdFromURI();

        if (!string.IsNullOrEmpty(elementId))
        {
            var uri = new Uri(NavigationManager.Uri, UriKind.Absolute);

            // need to check if recert page since tabs are different
            bool recertPage = uri.AbsolutePath == $"/{PageName.Certification}";

            if (elementId.StartsWith("all"))
                TabSet?.SetActiveTab(TabSet.Tabs.FirstOrDefault(t => t.Title == userConfig.GetText("all")));
            else if (elementId.StartsWith("report"))
                TabSet?.SetActiveTab(TabSet.Tabs.FirstOrDefault(t => t.Title == userConfig.GetText("report")));
            else if (elementId.StartsWith("rule"))
                TabSet?.SetActiveTab(TabSet.Tabs.FirstOrDefault(t => t.Title == userConfig.GetText("rule")));
            else
                return;

            HasPendingScrollTarget = true;
            lastTargetElementId = elementId;
            CollapseState.Expand(elementId);

            // smooth if the object is already loaded; if not, the scroll is retried instantly once it is fetched
            await ScrollToFragment(elementId, true);
        }
    }

    /// <summary>
    /// Scrolls once more to the element the last report link pointed to. Used after lazily fetched objects are
    /// rendered completely: a scroll started while they were still being added gets cancelled by the next render.
    /// </summary>
    public async Task ScrollToLastTarget()
    {
        string? elementId = lastTargetElementId;
        lastTargetElementId = null;
        if (string.IsNullOrEmpty(elementId))
        {
            return;
        }
        if (await JSRuntime.InvokeAsync<bool>("scrollIntoRSBView", elementId, false))
        {
            HasPendingScrollTarget = false;
            await JSRuntime.InvokeVoidAsync("removeUrlFragment");
        }
    }

    /// <summary>
    /// Scrolls the right sidebar to the object the current link (url fragment) points to, if it is rendered already.
    /// </summary>
    /// <param name="elementId">Element to scroll to, taken from the url if not given.</param>
    /// <param name="smooth">Smooth scrolling; only safe if no render follows, which would cancel the scroll.</param>
    public async Task ScrollToFragment(string? elementId = null, bool smooth = false)
    {
        if (elementId == null)
            elementId = await GetIdFromURI();
        
        if (!string.IsNullOrEmpty(elementId))
        {
            bool foundObj = await JSRuntime.InvokeAsync<bool>("scrollIntoRSBView", elementId, smooth);

            if (foundObj)
            {
                HasPendingScrollTarget = false;
                // remove #goto-{obj-link} fragment from uri
                await JSRuntime.InvokeVoidAsync("removeUrlFragment");
            }
        }
    }
}
