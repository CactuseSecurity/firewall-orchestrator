@using FWO.Data.Report

@inject UserConfig userConfig

@if (UseFormLayout)
{
    <div class="form-group row mt-2" data-toggle="tooltip" title="@TooltipText">
        <label class="@SummaryLabelClass" for="@SummaryId">@(userConfig.GetText("label")):</label>
        <div class="col-sm-9">
            @SummaryContent
        </div>
    </div>
}
else
{
    <div class="mt-2" data-toggle="tooltip" title="@TooltipText">
        <label class="@SummaryLabelClass" for="@SummaryId">@(userConfig.GetText("label")):</label>
        @SummaryContent
    </div>
}

<PopUp Size=PopupSize.Small Title="@(userConfig.GetText("label"))" Show="@showLabelFilterDialog" OnClose="CloseLabelFilterDialog">
    <Body>
        <div class="form-group row mt-2" data-toggle="tooltip" title="@TooltipText">
            <label for="@NameDropdownId" class="@PopupLabelClass">@(userConfig.GetText("name")):</label>
            <div class="col-sm-9">
                <Dropdown Id="@NameDropdownId" ElementType="string" SelectedElement="labelFilterDraft.Name" SelectedElementChanged="HandleLabelNameChanged" ElementToString="labelName => labelName" Elements="availableLabelNames" AllowFreeText="AllowFreeText">
                    <ElementTemplate Context="labelName">
                        @labelName
                    </ElementTemplate>
                </Dropdown>
            </div>
        </div>
        <div class="form-group row mt-2">
            <label for="@ModeDropdownId" class="@PopupLabelClass">@(userConfig.GetText("select")):</label>
            <div class="col-sm-9">
                <Dropdown Id="@ModeDropdownId" ElementType="LabelFilterMode" @bind-SelectedElement="labelFilterDraft.Mode" ElementToString="LabelFilterModeToString" Elements="availableLabelFilterModes">
                    <ElementTemplate Context="mode">
                        @(LabelFilterModeToString(mode))
                    </ElementTemplate>
                </Dropdown>
            </div>
        </div>
        @if (labelFilterDraft.Mode == LabelFilterMode.value)
        {
            <div class="form-group row mt-2">
                <label for="@ValueInputId" class="@PopupLabelClass">@(userConfig.GetText("value")):</label>
                <div class="col-sm-9">
                    <input id="@ValueInputId" type="text" class="form-control form-control-sm" @bind="labelFilterDraft.Value" />
                </div>
            </div>
        }
        <div class="mt-3 d-flex justify-content-end">
            <div class="btn-group">
                <button id="@SaveButtonId" type="button" class="btn btn-sm btn-primary" @onclick="ApplyLabelFilterDialog">@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
                <button id="@DeleteButtonId" type="button" class="btn btn-sm btn-danger" @onclick="DeleteLabelFilterDialog">@(DisplayService.DisplayButton(userConfig, "delete", Icons.Delete))</button>
                <button id="@CancelButtonId" type="button" class="btn btn-sm btn-secondary" @onclick="CloseLabelFilterDialog">@(DisplayService.DisplayButton(userConfig, "cancel", Icons.Cancel))</button>
            </div>
        </div>
    </Body>
</PopUp>

@code
{
    [Parameter]
    public LabelFilter LabelFilter { get; set; } = new();

    [Parameter]
    public EventCallback<LabelFilter> LabelFilterChanged { get; set; }

    [Parameter]
    public IEnumerable<string> AvailableLabelNames { get; set; } = [];

    [Parameter]
    public bool UseFormLayout { get; set; }

    [Parameter]
    public bool UseLightText { get; set; } = true;

    [Parameter]
    public bool AllowFreeText { get; set; }

    [Parameter]
    public LabelFilterMode DefaultMode { get; set; } = LabelFilterMode.display_only;

    [Parameter]
    public string TooltipTextKey { get; set; } = "";

    [Parameter]
    public string IdPrefix { get; set; } = "labelFilter";

    private readonly List<LabelFilterMode> availableLabelFilterModes = [.. Enum.GetValues<LabelFilterMode>()];
    private List<string> availableLabelNames = [];
    private bool showLabelFilterDialog;
    private LabelFilter labelFilterDraft = new();

    private string Prefix => string.IsNullOrWhiteSpace(IdPrefix) ? "labelFilter" : IdPrefix;
    private string SummaryId => $"{Prefix}-summary";
    private string EditButtonId => $"{Prefix}-editButton";
    private string NameDropdownId => $"{Prefix}-nameDropdown";
    private string ModeDropdownId => $"{Prefix}-modeDropdown";
    private string ValueInputId => $"{Prefix}-value";
    private string SaveButtonId => $"{Prefix}-saveButton";
    private string DeleteButtonId => $"{Prefix}-deleteButton";
    private string CancelButtonId => $"{Prefix}-cancelButton";
    private string TooltipText => string.IsNullOrWhiteSpace(TooltipTextKey) ? string.Empty : userConfig.PureLine(TooltipTextKey);
    private string SummaryLabelClass
    {
        get
        {
            string labelClass = UseFormLayout
                ? "col-sm-3 col-form-label col-form-label-sm"
                : "form-label";
            if (UseLightText)
            {
                labelClass += " text-white";
            }
            return labelClass;
        }
    }
    private string PopupLabelClass => "col-sm-3 col-form-label col-form-label-sm";

    private RenderFragment SummaryContent => @<div class="input-group">
        <input id="@SummaryId" type="text" class="form-control form-control-sm" value="@GetLabelFilterSummary()" readonly />
        <button id="@EditButtonId" type="button" class="btn btn-sm btn-secondary" @onclick="OpenLabelFilterDialog">@(DisplayService.DisplayButton(userConfig, "change", Icons.Edit))</button>
    </div>;

    protected override void OnParametersSet()
    {
        availableLabelNames = [.. (AvailableLabelNames ?? [])];
        EnsureSelectedLabelNameIsAvailable();
    }

    private string GetLabelFilterSummary()
    {
        if (string.IsNullOrWhiteSpace(LabelFilter.Name))
        {
            return "-";
        }

        if (LabelFilter.Mode == LabelFilterMode.value)
        {
            return $"{LabelFilter.Name}: {LabelFilter.Value}";
        }

        return $"{LabelFilter.Name}: {LabelFilterModeToString(LabelFilter.Mode)}";
    }

    private string LabelFilterModeToString(LabelFilterMode mode)
    {
        return userConfig.GetText(mode.ToString());
    }

    private void OpenLabelFilterDialog()
    {
        EnsureSelectedLabelNameIsAvailable();
        labelFilterDraft = new(LabelFilter);
        if (string.IsNullOrWhiteSpace(labelFilterDraft.Name)
            && string.IsNullOrWhiteSpace(labelFilterDraft.Value)
            && labelFilterDraft.Mode == LabelFilterMode.existing)
        {
            labelFilterDraft.Mode = DefaultMode;
        }
        showLabelFilterDialog = true;
    }

    private Task HandleLabelNameChanged(string? labelName)
    {
        labelFilterDraft.Name = labelName ?? string.Empty;
        if (AllowFreeText
            && !string.IsNullOrWhiteSpace(labelFilterDraft.Name)
            && !availableLabelNames.Any(label => string.Equals(label, labelFilterDraft.Name, StringComparison.OrdinalIgnoreCase)))
        {
            labelFilterDraft.Mode = DefaultMode;
        }

        return Task.CompletedTask;
    }

    private void CloseLabelFilterDialog()
    {
        showLabelFilterDialog = false;
    }

    private async Task ApplyLabelFilterDialog()
    {
        LabelFilter = new(labelFilterDraft);
        showLabelFilterDialog = false;
        await LabelFilterChanged.InvokeAsync(LabelFilter);
    }

    private async Task DeleteLabelFilterDialog()
    {
        LabelFilter = new();
        showLabelFilterDialog = false;
        await LabelFilterChanged.InvokeAsync(LabelFilter);
    }

    private void EnsureSelectedLabelNameIsAvailable()
    {
        if (string.IsNullOrWhiteSpace(LabelFilter.Name))
        {
            return;
        }

        if (availableLabelNames.Any(label => string.Equals(label, LabelFilter.Name, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        availableLabelNames.Add(LabelFilter.Name);
        availableLabelNames = [.. availableLabelNames.Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(label => label, StringComparer.OrdinalIgnoreCase)];
    }
}
