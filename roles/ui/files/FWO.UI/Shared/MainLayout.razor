@inherits LayoutComponentBase
@using System.Security.Authentication
@using System.Security.Claims;
@using System.Timers
@using FWO.Api.Client.ExceptionHandling
@using FWO.Data.Middleware
@using FWO.Middleware.Client
@using FWO.Services
@using FWO.Services.EventMediator.Events
@using FWO.Services.EventMediator.Interfaces
@using FWO.Ui.Auth
@using FWO.Ui.Data
@using FWO.Ui.Services
@using RestSharp

@inject ApiConnection apiConnection
@inject GlobalConfig globalConfig
@inject UserConfig userConfig
@inject MiddlewareClient middlewareClient
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider authenticationProvider
@inject ITokenRefreshCoordinator tokenRefreshCoordinator
@inject IEventMediator EventMediator
@inject TokenService TokenService

@implements IDisposable

<NavigationMenu @bind-ShowAlert="showAlert" />

<div class="main">
    <div class="content px-4">
        @* DON'T DELETE THESE BUTTONS / They might be needed for testing *@
        @*         <button type="button" @onclick="@(() => ShowMessage("info", "info", MessageType.Info))">info</button>
        <button type="button" @onclick="@(() => ShowMessage("warning", "warning", MessageType.Warning))">warning</button>
        <button type="button" @onclick="@(() => ShowMessage("error", "error", MessageType.Error))">error</button>
        <button type="button" @onclick="@(() => ShowMessage("success", "success", MessageType.Success))">success</button>
        <button type="button" @onclick="@(() => {  UIMessageQue.Clear(); UIMessages.Clear(); })">clear</button> *@
        <CascadingValue Value="@DisplayMessageInUiFunction">
            @if (ambientRoleInitialized)
            {
                @Body
            }
            else
            {
                <Loading />
            }
        </CascadingValue>
    </div>
</div>

<div class="footer">
    <div class="mx-2">
        @foreach (UIMessage uiMessage in UIMessages)
        {
            <div class="@uiMessage.CSSClass">
                <div class="d-flex flex-row justify-content-between">
                    <div>@uiMessage.Title - @uiMessage.Message</div>
                    <div class="@Icons.Close cursor-pointer" @onclick="@(() => HideUIMessage(uiMessage.Id))"></div>
                </div>
            </div>
        }
    </div>
</div>
<PopUp Title="@(reloginDialogTitle)" Show="@(showReloginDialog)" Size=PopupSize.Auto OnClose="@(async () => await ((AuthStateProvider)authenticationProvider).Deauthenticate())">

    <Body>
        <p>@(reloginDialogText)</p>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text"><span class="@Icons.Locked"></span></span>
            </div>
            <input type="password" class="form-control @reloginCssClass" @bind="password"
                   placeholder="@(userConfig.GetText("password"))" @bind:event="oninput" @onkeypress="@KeyHandler">
        </div>
        @if (!string.IsNullOrEmpty(reloginErrorMessage))
        {
            <label class="mt-1 mb-1 text-danger">@reloginErrorMessage</label>
        }
    </Body>
    <Footer>
        <div class="btn-group">
            @if (reloginAbortable)
            {
                <button type="button" class="btn btn-secondary" @onclick="@(() => showReloginDialog = false)">
                    @(userConfig.GetText("cancel"))
                </button>
            }
            else
            {
                <a class="btn btn-danger" href="/logout">@(userConfig.GetText("logout"))</a>
            }
            <button type="button" class="btn btn-primary" @onclick="Relogin">@(userConfig.GetText("relogin"))</button>
        </div>
    </Footer>
</PopUp>

<KeyboardInput />

@code
{
    Action<Exception?, string, string, bool> DisplayMessageInUiFunction = DefaultInit.DoNothing;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private GraphQlApiSubscription<List<Alert>>? alertSubscription;
    private bool showAlert = false;
    private object errorLock = new object();

    private string reloginErrorMessage = "";
    private string reloginCssClass = "";
    private string reloginDialogTitle = "";
    private string reloginDialogText = "";
    private bool showReloginDialog;
    private bool reloginAbortable;
    private string? password;
    private ClaimsPrincipal? user;
    private List<UIMessage> UIMessages = [];
    private Queue<UIMessage> UIMessageQue = [];
    private Timer? UIMessageQueTimer;
    private IDisposable? locationChangingRegistration;
    private bool ambientRoleInitialized;

    protected override async Task OnInitializedAsync()
    {
        EventMediator.Subscribe<PermissionChangedEvent>(nameof(PermissionChangedEvent), _ => OnPermissionsChanged(_.EventArgs));
        EventMediator.Subscribe<ReloginRequiredEvent>(nameof(ReloginRequiredEvent), _ => OnReloginRequired(_.EventArgs));
        apiConnection.OnExecutionModeChanged += OnExecutionModeChanged;

        DisplayMessageInUiFunction = DisplayMessageInUi;

        locationChangingRegistration = NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);

        AuthenticationState authState = await ((AuthStateProvider)authenticationProvider).GetAuthenticationStateAsync();
        ClaimsPrincipal authUser = authState.User;

        UpdateAmbientModuleRole(NavigationManager.Uri);
        ambientRoleInitialized = true;

        if (userConfig.CanUseAnyRole(Roles.Admin, Roles.FwAdmin, Roles.Auditor))
        {
            alertSubscription = await apiConnection.RunWithMonitoringRole(authUser,
                () => Task.FromResult(apiConnection.GetSubscription<List<Alert>>(GraphqlExceptionHandler.Handle, OnAlertUpdate, MonitorQueries.subscribeAlertChanges)));
        }

        UIMessageQueTimer = new()
        {
            AutoReset = true,
            Enabled = false,
            Interval = 500
        };

        UIMessageQueTimer.Elapsed += OnUIMessageTimerTick;

        await tokenRefreshCoordinator.StartAsync();
    }

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        UpdateAmbientModuleRole(context.TargetLocation);
        return ValueTask.CompletedTask;
    }

    private void OnExecutionModeChanged(object? sender, string executionMode)
    {
        UpdateAmbientModuleRole(NavigationManager.Uri);
    }

    private void UpdateAmbientModuleRole(string location)
    {
        if (authenticationStateTask == null)
        {
            return;
        }

        apiConnection.SetAmbientRole(authenticationStateTask.Result.User, GetAmbientRolesForLocation(location));
    }

    private List<string> GetAmbientRolesForLocation(string location)
    {
        string path = GetRelativeLocationPath(location);

        if (string.IsNullOrWhiteSpace(path))
        {
            return [];
        }

        if (path.StartsWith("networkmodelling"))
        {
            return [Roles.Modeller, Roles.Admin, Roles.Auditor];
        }
        if (path.StartsWith("request"))
        {
            return GetRequestAmbientRoles(path);
        }
        if (path.StartsWith("report"))
        {
            return [Roles.ReporterViewAll, Roles.Reporter, Roles.Modeller, Roles.Recertifier, Roles.Admin, Roles.Auditor, Roles.FwAdmin];
        }
        if (path.StartsWith("certification"))
        {
            return [Roles.Recertifier, Roles.Modeller, Roles.Admin, Roles.Auditor];
        }
        if (path.StartsWith("monitoring"))
        {
            return [Roles.Admin, Roles.FwAdmin, Roles.Auditor];
        }
        if (path.StartsWith("compliance"))
        {
            return [Roles.Admin, Roles.FwAdmin, Roles.Auditor];
        }
        if (path.StartsWith("network_analysis"))
        {
            return [Roles.Planner, Roles.FwAdmin, Roles.Admin, Roles.Auditor];
        }
        if (path.StartsWith("settings/user"))
        {
            return GetUserSettingsAmbientRoles();
        }
        if (path.StartsWith("settings"))
        {
            return [Roles.Admin, Roles.FwAdmin, Roles.Auditor];
        }
        return [];
    }

    private string GetRelativeLocationPath(string location)
    {
        return NavigationPathHelper.GetBaseRelativePath(location, NavigationManager.BaseUri);
    }

    private static List<string> GetRequestAmbientRoles(string path)
    {
        if (path.StartsWith("request/tickets") || path.StartsWith("request/ticketsoverview"))
        {
            return [Roles.Requester, Roles.Admin, Roles.FwAdmin, Roles.Auditor];
        }
        if (path.StartsWith("request/approvals"))
        {
            return [Roles.Approver, Roles.Admin, Roles.FwAdmin, Roles.Auditor];
        }
        if (path.StartsWith("request/plannings"))
        {
            return [Roles.Planner, Roles.Admin, Roles.FwAdmin, Roles.Auditor];
        }
        if (path.StartsWith("request/implementations"))
        {
            return [Roles.Implementer, Roles.Reviewer, Roles.Admin, Roles.FwAdmin, Roles.Auditor];
        }
        if (path.StartsWith("request/reviews"))
        {
            return [Roles.Reviewer, Roles.Admin, Roles.FwAdmin, Roles.Auditor];
        }
        return [Roles.Requester, Roles.Approver, Roles.Planner, Roles.Implementer, Roles.Reviewer, Roles.Admin, Roles.FwAdmin, Roles.Auditor];
    }

    private static List<string> GetUserSettingsAmbientRoles()
    {
        return [Roles.Modeller, Roles.Recertifier, Roles.ReporterViewAll, Roles.Reporter,
            Roles.Requester, Roles.Approver, Roles.Planner, Roles.Implementer, Roles.Reviewer,
            Roles.Admin, Roles.FwAdmin, Roles.Auditor];
    }

    private async Task KeyHandler(KeyboardEventArgs ev)
    {
        if (ev.Code == "Enter")
        {
            await Relogin();
        }
        reloginCssClass = "";
    }

    private void OnPermissionsChanged(PermissionChangedEventArgs? e)
    {
        if (DistName.DnEquals(e?.UserDn, userConfig.User.Dn))
        {
            ShowReloginDialog(userConfig.GetText("permissions"), userConfig.GetText("permissions_text"), reloginAbortable: false);
        }
    }

    private void OnReloginRequired(ReloginRequiredEventArgs? e)
    {
        if (user?.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(e?.UserDn) && DistName.DnEquals(e.UserDn, userConfig.User.Dn))
        {
            ShowReloginDialog(userConfig.GetText("jwt_expired_title"), userConfig.GetText("jwt_expired_text"), reloginAbortable: false);
        }
    }

    private void ShowReloginDialog(string title, string text, bool reloginAbortable)
    {
        reloginErrorMessage = "";
        password = "";
        this.reloginAbortable = reloginAbortable;
        reloginDialogTitle = title;
        reloginDialogText = text;
        showReloginDialog = true;

        InvokeAsync(StateHasChanged);
    }

    private async Task Relogin()
    {
        string errorMessage = userConfig.GetText("relogin_error");

        if (password == null)
        {
            password = "";
        }
        try
        {
            RestResponse<TokenPair> authResponse = await ((AuthStateProvider)authenticationProvider)
                .Authenticate(userConfig.User.Name, password, apiConnection, middlewareClient, userConfig);

            if (authResponse.StatusCode == System.Net.HttpStatusCode.OK)
            {
                showReloginDialog = false;
                reloginErrorMessage = "";
                password = "";
                return;
            }
            // There was an error trying to authenticate the user. Probably invalid credentials
            errorMessage = (authResponse.Content != null ? userConfig.GetApiText(authResponse.Content) : "Middleware Api Error: " + authResponse.Content);
        }
        catch (Exception ex)
        {
            Log.WriteError("Re-login", "Re-login unsuccessful.", ex, userConfig.User.Name);
        }

        reloginErrorMessage = errorMessage;
        reloginCssClass = "is-invalid";
    }

    private void OnAlertUpdate(List<Alert> alerts)
    {
        user = authenticationStateTask!.Result.User;
        showAlert = userConfig.CanUseAnyRole(Roles.Admin, Roles.FwAdmin, Roles.Auditor) && alerts.Count > 0;

        InvokeAsync(StateHasChanged);
    }

    private void ShowMessage(string title, string message, MessageType type, int? showtime = null)
    {
        // Needed so there is no chance an error is announced by 2 threads at the same time.
        lock (errorLock)
        {
            if (showtime == null || showtime == 0)
            {
                showtime = userConfig.MessageViewTime * 1000; // convert to milliseconds
            }

            switch (type)
            {
                case MessageType.Error:
                    Task.Run(async () => await setAlert(title, message));
                    showtime = showtime * 3; // show errors a bit longer
                    break;
                default:
                    break;
            }

            UIMessage uiMessage = new()
            {
                Message = message,
                Title = title,
                Type = type
            };

            Timer? messageTimer = null;
            if (showtime > 0)
            {
                messageTimer = new Timer(showtime.Value);
                messageTimer.Elapsed += (sender, e) => HideMessage(sender, e, uiMessage.Id);
                messageTimer.AutoReset = false;
                uiMessage.ShowTimer = messageTimer;
            }

            if (UIMessages.Count < userConfig.MaxMessages)
            {
                messageTimer?.Start();
                UIMessages.Add(uiMessage);
                InvokeAsync(StateHasChanged);
            }
            else
            {
                UIMessageQue.Enqueue(uiMessage);
            }

            UIMessageQueTimer?.Start();
        }
    }

    private void HideMessage(object? _, ElapsedEventArgs __, string messageId)
    {
        HideUIMessage(messageId);
    }

    private void OnUIMessageTimerTick(object? _, ElapsedEventArgs __)
    {
        if (UIMessageQueTimer is null)
        {
            return;
        }

        if (UIMessageQue == null || UIMessageQue.Count == 0)
        {
            UIMessageQueTimer.Stop();
            return;
        }

        if (UIMessageQue.Count > 0 && UIMessages.Count < userConfig.MaxMessages)
        {
            UIMessage uiMessage = UIMessageQue.Dequeue();
            uiMessage.ShowTimer?.Start();
            UIMessages.Add(uiMessage);

            InvokeAsync(StateHasChanged);
        }
    }

    private void HideUIMessage(string messageId)
    {
        UIMessage? uiMessage = UIMessages.FirstOrDefault(_ => _.Id == messageId);

        if (uiMessage is null)
        {
            return;
        }

        uiMessage.Dispose();

        UIMessages.RemoveAll(_ => _.Id == messageId);

        InvokeAsync(StateHasChanged);
    }

    private async void DisplayMessageInUi(Exception? exception = null, string title = "", string message = "", bool errorFlag = false)
    {
        try
        {
            if (exception == null)
            {
                await DisplayUserMessage(title, message, errorFlag);
                return;
            }

            if (await HandleSpecialException(exception))
            {
                return;
            }

            await DisplayExceptionMessage(exception, title, message, errorFlag);
        }
        catch (Exception displayException)
        {
            Log.WriteError(
                "Display UI Message",
                "Could not display UI message.",
                displayException);
        }
    }

    private async Task<string> GetCurrentRole()
    {
        if (apiConnection is GraphQlApiConnection graphQl)
        {
            return graphQl.GetActRole();
        }

        return await TryLoadRole();
    }

    private async Task DisplayExceptionMessage(Exception exception, string title, string message, bool errorFlag)
    {
        var role = await GetCurrentRole();

        Log.WriteError(
            string.IsNullOrEmpty(title) ? "Unspecified Error" : title,
            string.IsNullOrEmpty(message)
                ? "Unspecified error occured:"
                : message,
            exception,
            userConfig.User.Name,
            role);

        var cause = string.IsNullOrEmpty(title)
            ? userConfig.GetText("unspecified_error")
            : title;

        var description =
            $"{(string.IsNullOrEmpty(message) ? userConfig.GetText("E0001") : message)}" +
            $"{(errorFlag ? $": {exception.Message}" : string.Empty)}" +
            $" . {userConfig.GetText("E0002")}";

        ShowMessage(cause, description, MessageType.Error);

        await AddUiLogEntry(2, cause, description);
    }

    private async Task DisplayUserMessage(string title, string message, bool errorFlag)
    {
        var messageType = errorFlag ? MessageType.Warning : MessageType.Success;
        var severity = errorFlag ? 1 : 0;

        if (errorFlag)
        {
            Log.WriteWarning(title, message);
        }

        ShowMessage(title, message, messageType);
        await AddUiLogEntry(severity, title, message);
    }

    private async Task<bool> HandleSpecialException(Exception exception)
    {
        if (exception.Message == "no such type exists in the schema: 'cidr'")
        {
            var cause = userConfig.GetText("api_access");
            var description = userConfig.GetText("E0004");

            ShowMessage(cause, description, MessageType.Error);
            await AddUiLogEntry(2, cause, description);

            return true;
        }

        return false;
    }

    private async Task<string> TryLoadRole()
    {
        try
        {
            string? accessToken = await TokenService.GetAccessToken();

            if (string.IsNullOrWhiteSpace(accessToken))
            {
                accessToken = "";
            }

            JwtReader jwt = new JwtReader(accessToken);
            JwtValidationResult validationResult = await jwt.ValidateToken();

            if (validationResult.IsSuccess)
            {
                return jwt.GetRole();
            }

            return "";

        }
        catch (Exception)
        {
            return "";
        }
    }

    public async Task AddUiLogEntry(int severity, string cause, string description)
    {
        try
        {
            var Variables = new
            {
                user = userConfig.User.DbId,
                severity = severity,
                suspectedCause = cause,
                description = description,
            };

            ReturnId[]? returnIds = (await apiConnection.SendQueryAsync<ReturnIdWrapper>(MonitorQueries.addUiLogEntry, Variables)).ReturnIds;

            if (returnIds == null)
            {
                Log.WriteError("Write Log", "Log could not be written to database");
            }
        }
        catch (Exception exc)
        {
            Log.WriteError("Write Log", $"Could not write log for user {userConfig.User.DbId}: ", exc);
        }
    }

    public async Task setAlert(string title, string message)
    {
        Log.WriteAlert($"source: \"{GlobalConst.kUi}\"", $"userId: \"{userConfig.User.DbId}\", title: \"{title}\", description: \"{message}\", alertCode: \"{AlertCode.UiError}\"");
        AlertHelper.AdditionalAlertData alertData = new()
        {
            UserId = userConfig.User.DbId,
            CompareTitle = true
        };
        await AlertHelper.SetAlert(apiConnection, title, message, GlobalConst.kUi, AlertCode.UiError, alertData);
    }

    public void Dispose()
    {
        if (UIMessageQueTimer is not null)
        {
            UIMessageQueTimer.Stop();
            UIMessageQueTimer.Elapsed -= OnUIMessageTimerTick;
            UIMessageQueTimer.Dispose();
        }

        alertSubscription?.Dispose();
        locationChangingRegistration?.Dispose();
        apiConnection.OnExecutionModeChanged -= OnExecutionModeChanged;
        apiConnection?.Dispose();
        middlewareClient?.Dispose();
        EventMediator.Unsubscribe<PermissionChangedEvent>(nameof(PermissionChangedEvent));
        EventMediator.Unsubscribe<ReloginRequiredEvent>(nameof(ReloginRequiredEvent));
        tokenRefreshCoordinator.Stop();
    }
}
