@using BlazorTable
@using FWO.Data
@using FWO.Data.Workflow

@inject ApiConnection apiConnection
@inject UserConfig userConfig
@implements IDisposable

@* FlowObjectTable is a generic search field with result table: it only reports the search text, which suits
   the server side search here, although its name stems from the flow settings pages using it first. *@
@if (Kind == ObjectTaskKind.Service)
{
    <FlowObjectTable TItem="NetworkService"
                     FilteredItems="foundServices"
                     FilteredCount="foundServices.Count"
                     TotalCount="foundServices.Count"
                     PageSize="kPageSize"
                     SearchLabel="@SearchLabel"
                     ClearSearchLabel="@(userConfig.GetText("clear_input"))"
                     SearchText="@searchText"
                     SearchTextChanged="Search">
        <ChildContent>
            <Column TableItem="NetworkService" Title="@(userConfig.GetText("name"))" Field="@(service => service.Name)" Sortable="true" />
            <Column TableItem="NetworkService" Title="@(userConfig.GetText(GroupMode ? "members" : "service"))" Field="@(service => service.DestinationPort)" Sortable="true" Context="service">
                <Template>
                    @(GroupMode ? service.MemberNames : DisplayServicePorts(service))
                </Template>
            </Column>
            <Column TableItem="NetworkService" Title="@(userConfig.GetText("actions"))" Field="@(service => service.Id)" Sortable="false" Context="service">
                <Template>
                    <button type="button" class="btn btn-sm @(SelectedService?.Id == service.Id ? "btn-success" : "btn-outline-primary")"
                            @onclick:stopPropagation="true" @onclick="() => SelectService(service)">
                        @(DisplayService.DisplayButton(userConfig, "select", Icons.Use))
                    </button>
                </Template>
            </Column>
            <Pager ShowPageNumber="true" ShowTotalCount="true" />
        </ChildContent>
    </FlowObjectTable>
}
else if (Kind == ObjectTaskKind.Time)
{
    <FlowObjectTable TItem="TimeObject"
                     FilteredItems="foundTimeObjects"
                     FilteredCount="foundTimeObjects.Count"
                     TotalCount="foundTimeObjects.Count"
                     PageSize="kPageSize"
                     SearchLabel="@SearchLabel"
                     ClearSearchLabel="@(userConfig.GetText("clear_input"))"
                     SearchText="@searchText"
                     SearchTextChanged="Search">
        <ChildContent>
            <Column TableItem="TimeObject" Title="@(userConfig.GetText("name"))" Field="@(timeObject => timeObject.Name)" Sortable="true" />
            <Column TableItem="TimeObject" Title="@(userConfig.GetText("time_object"))" Field="@(timeObject => timeObject.StartTime)" Sortable="true" Context="timeObject">
                <Template>
                    @WfObjectTaskHelper.FormatTimeRange(timeObject.StartTime, timeObject.EndTime)
                </Template>
            </Column>
            <Column TableItem="TimeObject" Title="@(userConfig.GetText("actions"))" Field="@(timeObject => timeObject.Id)" Sortable="false" Context="timeObject">
                <Template>
                    <button type="button" class="btn btn-sm @(SelectedTimeObject?.Id == timeObject.Id ? "btn-success" : "btn-outline-primary")"
                            @onclick:stopPropagation="true" @onclick="() => SelectTimeObject(timeObject)">
                        @(DisplayService.DisplayButton(userConfig, "select", Icons.Use))
                    </button>
                </Template>
            </Column>
            <Pager ShowPageNumber="true" ShowTotalCount="true" />
        </ChildContent>
    </FlowObjectTable>
}
else
{
    <FlowObjectTable TItem="NetworkObject"
                     FilteredItems="foundNetworkObjects"
                     FilteredCount="foundNetworkObjects.Count"
                     TotalCount="foundNetworkObjects.Count"
                     PageSize="kPageSize"
                     SearchLabel="@SearchLabel"
                     ClearSearchLabel="@(userConfig.GetText("clear_input"))"
                     SearchText="@searchText"
                     SearchTextChanged="Search">
        <ChildContent>
            <Column TableItem="NetworkObject" Title="@(userConfig.GetText("name"))" Field="@(networkObject => networkObject.Name)" Sortable="true" />
            <Column TableItem="NetworkObject" Title="@(userConfig.GetText(GroupMode ? "members" : "ip"))" Field="@(networkObject => networkObject.IP)" Sortable="true" Context="networkObject">
                <Template>
                    @(GroupMode ? networkObject.MemberNames : DisplayBase.DisplayIp(networkObject.IP ?? "", networkObject.IpEnd ?? ""))
                </Template>
            </Column>
            <Column TableItem="NetworkObject" Title="@(userConfig.GetText("actions"))" Field="@(networkObject => networkObject.Id)" Sortable="false" Context="networkObject">
                <Template>
                    <button type="button" class="btn btn-sm @(SelectedNetworkObject?.Id == networkObject.Id ? "btn-success" : "btn-outline-primary")"
                            @onclick:stopPropagation="true" @onclick="() => SelectNetworkObject(networkObject)">
                        @(DisplayService.DisplayButton(userConfig, "select", Icons.Use))
                    </button>
                </Template>
            </Column>
            <Pager ShowPageNumber="true" ShowTotalCount="true" />
        </ChildContent>
    </FlowObjectTable>
}
@if (limitReached)
{
    <small class="text-muted">@(userConfig.GetText("refine_search"))</small>
}

@code
{
    [CascadingParameter]
    Action<Exception?, string, string, bool> DisplayMessageInUi { get; set; } = DefaultInit.DoNothing;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    /// <summary>
    /// Management the searched object belongs to.
    /// </summary>
    [Parameter]
    public int ManagementId { get; set; }

    /// <summary>
    /// Kind of the searched object.
    /// </summary>
    [Parameter]
    public ObjectTaskKind Kind { get; set; }

    [Parameter]
    public bool GroupMode { get; set; }

    [Parameter]
    public List<IpProtocol> IpProtos { get; set; } = [];

    [Parameter]
    public NetworkObject? SelectedNetworkObject { get; set; }

    [Parameter]
    public EventCallback<NetworkObject?> SelectedNetworkObjectChanged { get; set; }

    [Parameter]
    public NetworkService? SelectedService { get; set; }

    [Parameter]
    public EventCallback<NetworkService?> SelectedServiceChanged { get; set; }

    [Parameter]
    public TimeObject? SelectedTimeObject { get; set; }

    [Parameter]
    public EventCallback<TimeObject?> SelectedTimeObjectChanged { get; set; }

    /// <summary>
    /// Pause after the last keystroke before the search is sent, so that typing does not query every character.
    /// </summary>
    private const int kSearchDelayMilliseconds = 300;
    private const int kPageSize = 5;

    private string searchText = "";
    private string SearchLabel => userConfig.GetText(GetSearchLabelKey());
    private List<NetworkObject> foundNetworkObjects = [];
    private List<NetworkService> foundServices = [];
    private List<TimeObject> foundTimeObjects = [];
    private bool limitReached;
    private CancellationTokenSource? searchCancellation;

    private async Task Search(string newSearchText)
    {
        searchText = newSearchText;
        if (searchCancellation != null)
        {
            await searchCancellation.CancelAsync();
            searchCancellation.Dispose();
        }
        searchCancellation = new CancellationTokenSource();
        CancellationToken token = searchCancellation.Token;
        try
        {
            await Task.Delay(kSearchDelayMilliseconds, token);
            if (authenticationStateTask == null)
            {
                return;
            }
            WfObjectSearch search = new(apiConnection, (await authenticationStateTask).User);
            int? hitCount = await SearchKind(search, newSearchText, token);
            if (hitCount == null)
            {
                return;
            }
            limitReached = hitCount >= WfObjectTaskHelper.kSearchLimit;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // superseded by a newer keystroke
        }
        catch (Exception exception)
        {
            DisplayMessageInUi(exception, userConfig.GetText("search_object"), "", true);
        }
    }

    /// <summary>
    /// Runs the search for the selected kind and keeps its hits. Returns the number of hits, or null when a
    /// newer keystroke superseded the search.
    /// </summary>
    private async Task<int?> SearchKind(WfObjectSearch search, string text, CancellationToken token)
    {
        if (GroupMode)
        {
            return Kind == ObjectTaskKind.Service
                ? await KeepHits(search.SearchServiceGroups(ManagementId, text), hits => foundServices = hits, token)
                : await KeepHits(search.SearchNetworkGroups(ManagementId, text), hits => foundNetworkObjects = hits, token);
        }
        return Kind switch
        {
            ObjectTaskKind.Service => await KeepHits(search.SearchServices(ManagementId, text), hits => foundServices = hits, token),
            ObjectTaskKind.Time => await KeepHits(search.SearchTimeObjects(ManagementId, text), hits => foundTimeObjects = hits, token),
            _ => await KeepHits(search.SearchNetworkObjects(ManagementId, text), hits => foundNetworkObjects = hits, token)
        };
    }

    private string GetSearchLabelKey()
    {
        if (Kind == ObjectTaskKind.Time)
        {
            return "search_time_object";
        }
        if (Kind == ObjectTaskKind.Service)
        {
            return "search_service_object";
        }
        return "search_network_object";
    }

    /// <summary>
    /// Waits for the search and keeps its hits unless a newer keystroke superseded it.
    /// </summary>
    private static async Task<int?> KeepHits<T>(Task<List<T>> pendingSearch, Action<List<T>> keep, CancellationToken token)
    {
        List<T> hits = await pendingSearch;
        if (token.IsCancellationRequested)
        {
            return null;
        }
        keep(hits);
        return hits.Count;
    }

    private async Task SelectNetworkObject(NetworkObject networkObject)
    {
        SelectedNetworkObject = networkObject;
        await SelectedNetworkObjectChanged.InvokeAsync(networkObject);
    }

    private async Task SelectService(NetworkService service)
    {
        SelectedService = service;
        await SelectedServiceChanged.InvokeAsync(service);
    }

    private async Task SelectTimeObject(TimeObject timeObject)
    {
        SelectedTimeObject = timeObject;
        await SelectedTimeObjectChanged.InvokeAsync(timeObject);
    }

    private string DisplayServicePorts(NetworkService service)
    {
        string? protocolName = IpProtos.FirstOrDefault(protocol => protocol.Id == service.ProtoId)?.Name;
        string ports = DisplayBase.DisplayPort(service.DestinationPort, service.DestinationPortEnd, false, protocolName);
        return string.IsNullOrWhiteSpace(ports) ? protocolName ?? "" : ports;
    }

    public void Dispose()
    {
        searchCancellation?.Cancel();
        searchCancellation?.Dispose();
        GC.SuppressFinalize(this);
    }
}
