@using FWO.Data.Enums

@inject UserConfig userConfig

@* editor for the rule owner mapping source settings, shared by every settings page offering them *@
<SettingsRow LabelKey="source" LabelFor="ownerMappingSourceDropdown">
    <div class="settings-input-md">
        @* not nullable: "Disabled" is the selection for "no owner mapping", so the selection must never be empty *@
        <Dropdown ElementType="OwnerMappingSourceStm?" ElementToString="GetOwnerMappingSourceText" SelectedElement="@Handler.SelectedSource"
                  SelectedElementChanged="@(src => { Handler.SelectSource(src); ownerKeyMessage = ""; StateHasChanged(); })" Elements="Handler.OwnerMappingSources" Nullable="false" id="ownerMappingSourceDropdown">
            <ElementTemplate Context="source">
                @GetOwnerMappingSourceText(source)
            </ElementTemplate>
        </Dropdown>
    </div>
</SettingsRow>
@if (Handler.SelectedSource == OwnerMappingSourceStm.CustomField)
{
    <SettingsRow LabelKey="custom_field_Owner_key" TooltipKey="H5677" AlignTop="true">
        <div class="settings-input-lg">
            <EditList ElementType="string" Elements="Handler.OwnerKeys.ToArray()" ElementsToAdd="Handler.OwnerKeysToAdd"
                      ElementsToDelete="Handler.OwnerKeysToDelete" StdLayout="false">
                <Display>
                    <div class="row">
                        <div class="col-sm-12 border bg-transparent">@context</div>
                    </div>
                </Display>
            </EditList>
            <div class="input-group input-group-sm mt-1">
                <input type="text" class="form-control" @bind="Handler.ActiveOwnerKey" />
                <button type="button" class="btn btn-sm btn-primary" @onclick="AddOwnerKey"
                        @onclick:preventDefault>
                    @(DisplayService.DisplayButton(userConfig, "add", Icons.Add))
                </button>
            </div>
            @if (ownerKeyMessage.Length > 0)
            {
                <div class="mt-1 text-danger">@ownerKeyMessage</div>
            }
        </div>
    </SettingsRow>
}
@if (Handler.SelectedSource == OwnerMappingSourceStm.NameField)
{
    <SettingsRow LabelKey="modelledMarker" TooltipKey="H5648" LabelFor="modelledMarker">
        <input id="modelledMarker" type="text" class="form-control form-control-sm settings-input-md" @bind="Handler.ModelledMarker" />
    </SettingsRow>
}
@if (Handler.SelectedSource != OwnerMappingSourceStm.Disabled)
{
    <SettingsRow LabelKey="ruleOwnerMappingLogLevel" TooltipKey="H5916" LabelFor="ruleOwnerMappingLogLevelDropdown">
        <div class="settings-input-md">
            <Dropdown ElementType="RuleOwnerMappingLogLevel?" ElementToString="GetLogLevelText" SelectedElement="@Handler.LogLevel"
                      SelectedElementChanged="@(level => { Handler.LogLevel = level ?? RuleOwnerMappingLogLevel.Warning; StateHasChanged(); })"
                      Elements="Handler.LogLevels" Nullable="false" id="ruleOwnerMappingLogLevelDropdown">
                <ElementTemplate Context="level">
                    @GetLogLevelText(level)
                </ElementTemplate>
            </Dropdown>
        </div>
    </SettingsRow>
}

@code
{
    /// <summary>
    /// Editor state of the mapping source settings.
    /// </summary>
    [Parameter]
    public OwnerMappingSourceHandler Handler { get; set; } = new();

    private string ownerKeyMessage = "";

    /// <summary>
    /// Queues the owner key currently typed into the editor and reports a rejected key.
    /// </summary>
    private void AddOwnerKey()
    {
        string? errorTextKey = Handler.AddOwnerKey();
        ownerKeyMessage = errorTextKey == null ? "" : userConfig.GetText(errorTextKey);
    }

    /// <summary>
    /// Resolves the display text of a mapping source.
    /// </summary>
    /// <param name="source">Mapping source to display.</param>
    /// <returns>The localized text.</returns>
    private string GetOwnerMappingSourceText(OwnerMappingSourceStm? source)
    {
        return userConfig.GetText(source?.ToString() ?? "");
    }

    /// <summary>
    /// Resolves the display text of a log level.
    /// </summary>
    /// <param name="level">Log level to display.</param>
    /// <returns>The localized text.</returns>
    private string GetLogLevelText(RuleOwnerMappingLogLevel? level)
    {
        return userConfig.GetText(level?.ToString() ?? "");
    }
}
