@if (Show)
{
    <div class="modal-backdrop popup-outer">
        <div class="modal-open" tabindex="-1">
            <div class="popup-dialog @(SizeClass()) @(AdjustClass())">
                <div class="modal-content @(SizeClassContent())">
                    <div class="modal-header popup-header justify-content-between">
                        <div class="popup-title">
                            <h5 class="mb-0">@Title</h5>
                            @if (!string.IsNullOrWhiteSpace(HelpPage))
                            {
                                <HelpLink Page="@HelpPage" />
                            }
                        </div>
                        <button type="button" class="modern-close" @onclick="Close">
                            <span>&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        @Body
                    </div>
                </div>
                @if (Size != PopupSize.XSmall)
                {
                    <div class="custom-modal-footer">
                        <hr>
                        <div class="@FooterCssClass">
                            @Footer
                        </div>
                    </div>
                }
                @if (CanResize)
                {
                    <div class="popup-resize-handle" aria-hidden="true"></div>
                }
            </div>
        </div>
    </div>
}

@code
{
    [Parameter]
    public string Title { get; set; } = "EMPTY_TITLE";

    [Parameter]
    public string? HelpPage { get; set; }

    [Parameter]
    public RenderFragment? Body { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public bool Show { get; set; } = false;

    [Parameter]
    public PopupSize Size { get; set; } = PopupSize.Small;

    [Parameter]
    public bool Scrollable { get; set; } = true;

    [Parameter]
    public Action OnClose { get; set; } = new Action(() => { });

    [Parameter]
    public string FooterCssClass { get; set; } = "modal-footer";

    /// <summary>
    /// Allows the user to drag the popup around by its header. Ignored for full screen popups.
    /// </summary>
    [Parameter]
    public bool Movable { get; set; } = true;

    /// <summary>
    /// Allows the user to resize the popup with the handle in its lower right corner (see wwwroot/js/popup.js).
    /// Ignored for full screen and extra small popups.
    /// </summary>
    [Parameter]
    public bool Resizable { get; set; } = true;

    private bool CanMove => Movable && Size != PopupSize.FullScreen;

    private bool CanResize => Resizable && Size != PopupSize.FullScreen && Size != PopupSize.XSmall;

    /// <summary>
    /// Marks the dialog for the delegated move and resize handlers in wwwroot/js/popup.js.
    /// </summary>
    private string AdjustClass()
    {
        List<string> adjustClasses = [];
        if (CanMove)
        {
            adjustClasses.Add("popup-movable");
        }
        if (CanResize)
        {
            adjustClasses.Add("popup-resizable");
        }
        return string.Join(" ", adjustClasses);
    }

    private string SizeClass()
    {
        switch (Size)
        {
            case PopupSize.Auto: return "custom-modal-auto custom-modal-center";
            case PopupSize.FullScreen: return "custom-modal-fs";
            case PopupSize.XLarge: return "custom-modal-xl custom-modal-center";
            case PopupSize.Large: return "custom-modal-lg custom-modal-center";
            case PopupSize.Medium: return "custom-modal-md custom-modal-center";
            case PopupSize.Small: return "custom-modal-sm custom-modal-center";
            case PopupSize.XSmall: return "custom-modal-xs custom-modal-center";
            default: return "custom-modal-sm";
        }
    }

    private string SizeClassContent()
    {
        switch (Size)
        {
            case PopupSize.Auto: return "custom-modal-content-auto"; // Auto sized content grows with its content, but has to stop at the viewport so the footer stays reachable
            case PopupSize.FullScreen: return "custom-modal-content-fs";
            case PopupSize.XLarge: return "custom-modal-content-xl";
            case PopupSize.Large: return "custom-modal-content-lg ";
            case PopupSize.Medium: return "custom-modal-content-md";
            case PopupSize.Small: return "custom-modal-content-sm";
            case PopupSize.XSmall: return "custom-modal-content-xs";
            default: return "custom-modal-content-sm";
        }
    }

    private void Close()
    {
        Show = false;
        OnClose();
    }
}
