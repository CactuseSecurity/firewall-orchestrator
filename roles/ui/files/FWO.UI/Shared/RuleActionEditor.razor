@using FWO.Data
@using FWO.Ui.Display
@using FWO.Ui.Services

@inject UserConfig userConfig

<PopUp Title="@(userConfig.GetText("edit") + ": " + userConfig.GetText("rule_action"))" Show="@Display" Size="PopupSize.Small" OnClose="Close">
    <Body>
        @if (Display)
        {
            <Dropdown ElementType="RuleAction" SelectedElement="selectedRuleAction" SelectedElementChanged="RuleActionChanged"
                ElementToString="@(action => action.Name)" Elements="RuleActions" Nullable="true">
                <ElementTemplate Context="action">
                    @action.Name
                </ElementTemplate>
            </Dropdown>
        }
    </Body>
    <Footer>
        <button type="button" class="btn btn-sm btn-primary" @onclick="Save">@(DisplayService.DisplayButton(userConfig, "save", Icons.Save))</button>
        <button type="button" class="btn btn-sm btn-secondary" @onclick="Close">@(DisplayService.DisplayButton(userConfig, "cancel", Icons.Cancel))</button>
    </Footer>
</PopUp>

@code {
    [Parameter] public bool Display { get; set; }
    [Parameter] public EventCallback<bool> DisplayChanged { get; set; }
    [Parameter] public RuleAction? SelectedRuleAction { get; set; }
    [Parameter] public List<RuleAction> RuleActions { get; set; } = [];
    [Parameter] public EventCallback<RuleAction?> Saved { get; set; }

    private RuleAction? selectedRuleAction;
    private bool initialized;

    protected override void OnParametersSet()
    {
        if (!Display || initialized)
        {
            return;
        }

        selectedRuleAction = RuleActions.FirstOrDefault(action => action.Id == SelectedRuleAction?.Id);
        initialized = true;
    }

    private Task RuleActionChanged(RuleAction action)
    {
        selectedRuleAction = action;
        return Task.CompletedTask;
    }

    private async Task Save()
    {
        await Saved.InvokeAsync(selectedRuleAction);
        Close();
    }

    private void Close()
    {
        initialized = false;
        _ = DisplayChanged.InvokeAsync(false);
    }
}
