@inject UserConfig userConfig

<Dropdown Id="@(Id ?? generatedId)" ElementType="bool" SelectedElement="ManagementRulebaseView" SelectedElementChanged="OnChange" Elements="kViewOptions"
          ElementToString="@(managementView => managementView
              ? userConfig.GetText("management_rulebases_view")
              : userConfig.GetText("gateway_rules_view"))"
          InputClass="form-control form-control-sm">
    <ElementTemplate Context="managementView">
        @(managementView
            ? userConfig.GetText("management_rulebases_view")
            : userConfig.GetText("gateway_rules_view"))
    </ElementTemplate>
</Dropdown>

@code
{
    private static readonly IReadOnlyList<bool> kViewOptions = [false, true];
    private readonly string generatedId = Guid.NewGuid().ToString();

    /// <summary>
    /// HTML id suffix used to identify the dropdown input element.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// True for the management rulebases view, false for the gateway rules view.
    /// </summary>
    [Parameter]
    public bool ManagementRulebaseView { get; set; }

    [Parameter]
    public EventCallback<bool> ManagementRulebaseViewChanged { get; set; }

    /// <summary>
    /// Applies a changed rulebase view and notifies the parent component.
    /// </summary>
    /// <param name="selectedView">Whether the management rulebase view is selected.</param>
    private async Task OnChange(bool selectedView)
    {
        if (ManagementRulebaseView == selectedView)
        {
            return;
        }

        ManagementRulebaseView = selectedView;
        await ManagementRulebaseViewChanged.InvokeAsync(selectedView);
    }
}
