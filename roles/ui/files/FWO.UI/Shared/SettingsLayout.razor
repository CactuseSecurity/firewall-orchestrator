@inherits LayoutComponentBase
@layout MainLayout

@using FWO.Ui.Services
@using Microsoft.AspNetCore.Components.Routing

@inject UserConfig userConfig
@implements IDisposable

<Sidebar PositionLeft="true" Collapsible="true" Resizeable="true" @bind-Width="sidebarWidth">
    <div class="settings-sidebar me-2 ms-2 mb-4">
        @{
            IReadOnlyList<SettingsNavSection> navSections = SettingsNavigationService.GetSections(userConfig, searchTerm);
        }
        <div class="settings-search bg-blue py-3">
            <input id="settingsSearch" type="search" class="form-control" placeholder="@userConfig.GetText("search")"
                   aria-label="@userConfig.GetText("search")" @bind="searchTerm" @bind:event="oninput" />
        </div>
        <div class="px-2" role="status" aria-live="polite">
            @if (navSections.Count == 0)
            {
                <span>@(userConfig.GetText("no_search_results"))</span>
            }
        </div>
        <ul class="navbar-nav navbar-dark flex-column">
            @for (int index = 0; index < navSections.Count; index++)
            {
                @RenderSection(navSections[index], index > 0)
            }
        </ul>
        <br />
        <br />
    </div>
</Sidebar>


<div style="margin-left: @($"{sidebarWidth + 20}px");">
    @Body
</div>

@code
{
    private int sidebarWidth = 250;
    private string searchTerm = "";

    /// <summary>
    /// True while the current user is kept in the internal ldap and may therefore change their own password.
    /// </summary>
    private bool IsInternalUser => userConfig.User.Dn.EndsWith(GlobalConst.kLdapInternalPostfix);

    /// <summary>
    /// Renders one navigation section, gating the heading and every entry by the roles they require.
    /// </summary>
    /// <param name="navSection">Section to render, already narrowed down to its matching entries.</param>
    /// <param name="withSeparator">True to draw a separator ahead of the heading.</param>
    private RenderFragment RenderSection(SettingsNavSection navSection, bool withSeparator)
    {
        return @<text>
            @if (navSection.Roles.Length == 0)
            {
                @RenderHeading(navSection, withSeparator)
            }
            else
            {
                <ExecutionModeAuthorizeView Roles="@navSection.Roles">
                    @RenderHeading(navSection, withSeparator)
                </ExecutionModeAuthorizeView>
            }
            @foreach (SettingsNavEntry entry in VisibleEntries(navSection))
            {
                if (entry.Roles.Length == 0)
                {
                    @RenderEntry(entry)
                }
                else
                {
                    <ExecutionModeAuthorizeView Roles="@entry.Roles">
                        @RenderEntry(entry)
                    </ExecutionModeAuthorizeView>
                }
            }
        </text>;
    }

    /// <summary>
    /// Renders the heading of a section together with the separator that precedes it, so that a
    /// separator can never outlive the heading it belongs to.
    /// </summary>
    private RenderFragment RenderHeading(SettingsNavSection navSection, bool withSeparator)
    {
        return @<text>
            @if (withSeparator)
            {
                <li>
                    <hr />
                </li>
            }
            <li class="nav-item px-2" data-toggle="@TooltipToggle(navSection.TooltipKey)" title="@TooltipText(navSection.TooltipKey)">
                <h5>@(userConfig.GetText(navSection.TextKey))</h5>
            </li>
        </text>;
    }

    /// <summary>
    /// Renders one settings page as a navigation link.
    /// </summary>
    private RenderFragment RenderEntry(SettingsNavEntry entry)
    {
        return @<li class="nav-item px-2">
            <NavLink class="nav-link" href="@entry.Href" Match="@(entry.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <span class="@entry.Icon"></span> @(userConfig.GetText(entry.TextKey))
            </NavLink>
        </li>;
    }

    /// <summary>
    /// Drops the entries the current user may not see for reasons other than their roles.
    /// </summary>
    private IEnumerable<SettingsNavEntry> VisibleEntries(SettingsNavSection navSection)
    {
        return navSection.Entries.Where(entry => !entry.InternalUsersOnly || IsInternalUser);
    }

    /// <summary>
    /// Returns the bootstrap tooltip marker, or null for a heading without a tooltip.
    /// </summary>
    private static string? TooltipToggle(string tooltipKey)
    {
        return tooltipKey.Length > 0 ? "tooltip" : null;
    }

    /// <summary>
    /// Returns the localized tooltip text, or null for a heading without a tooltip.
    /// </summary>
    private string? TooltipText(string tooltipKey)
    {
        return tooltipKey.Length > 0 ? userConfig.GetText(tooltipKey) : null;
    }

    protected override void OnInitialized()
    {
        userConfig.OnChange += OnChange;
    }

    private void OnChange(Config _, ConfigItem[] __)
    {
        Task.Run(async () => await InvokeAsync(StateHasChanged));
    }

    public void Dispose()
    {
        userConfig.OnChange -= OnChange;
    }
}
