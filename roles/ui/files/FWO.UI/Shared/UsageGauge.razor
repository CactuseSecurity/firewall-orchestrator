@* Labelled progress bar visualizing a usage percentage, colour coded by severity thresholds. *@
@using System.Globalization

<div class="mb-3">
    <div class="d-flex justify-content-between">
        <span>@Caption</span>
        <span>@Detail</span>
    </div>
    <div class="progress" role="progressbar" aria-label="@Caption" aria-valuenow="@((int)Math.Round(BoundedPercent))" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar @BarClass" style="width: @(BoundedPercent.ToString("0.##", CultureInfo.InvariantCulture))%">
            @(BoundedPercent.ToString("0.#", CultureInfo.InvariantCulture))%
        </div>
    </div>
</div>

@code
{
    private const double kWarningThresholdPercent = 70;
    private const double kCriticalThresholdPercent = 90;

    /// <summary>
    /// Label shown on the left hand side above the bar.
    /// </summary>
    [Parameter]
    public string Caption { get; set; } = "";

    /// <summary>
    /// Additional information shown on the right hand side above the bar, e.g. absolute values.
    /// </summary>
    [Parameter]
    public string Detail { get; set; } = "";

    /// <summary>
    /// Usage in percent.
    /// </summary>
    [Parameter]
    public double Percent { get; set; }

    private double BoundedPercent => Math.Clamp(Percent, 0, 100);

    private string BarClass => GetBarClass(BoundedPercent);

    /// <summary>
    /// Returns the bootstrap colour class matching the severity of the given usage.
    /// </summary>
    /// <param name="percent">Usage in percent.</param>
    /// <returns>The css class of the progress bar.</returns>
    private static string GetBarClass(double percent)
    {
        if (percent >= kCriticalThresholdPercent)
        {
            return "bg-danger";
        }
        if (percent >= kWarningThresholdPercent)
        {
            return "bg-warning";
        }
        return "bg-success";
    }
}
